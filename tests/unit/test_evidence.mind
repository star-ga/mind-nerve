// tests/unit/test_evidence.mind — attestation envelope v2 + chain integrity
// suite for src/evidence.mind. Audit A4 (binding completeness), A5
// (entry_kind), A6 (chain_reset_reason).
//
// Ported to mindc 0.10.2 (wave 4, 2026-08-12) from
// tests/unit/dormant/test_evidence.mind. Runs through `mindc test` on a
// merged image (src/lib.mind + src/sha256.mind + src/evidence.mind + this
// file), driven by tests/mindc_gate.sh leg 11 with an exact-count
// assertion — a "running 0 tests" output FAILS the gate.
//
// PORT MAPPING: the dormant struct field reads become byte reads at the
// pinned OFFSET_* constants; Result errors become the EV_ERR_* negative
// return codes. The dormant §1 `@[layout(Packed)]` annotation test has no
// 0.10.2 equivalent (the envelope is built byte-wise over a caller buffer;
// there is no struct to annotate) — the packed layout is pinned instead by
// the offset const tests + the §2 wire spot checks.
//
// ASSERT-EAGERNESS (r9 hazard): every verify/emit result is let-bound
// before assert, and fixture buffers mutated mid-test are never read by an
// earlier assert's condition.

// ── helpers (ev_ prefix) ────────────────────────────────────────────────────

fn ev_fill(dst: i64, n: i64, c: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(dst + i, c);
        i = i + 1;
    }
    0
}

fn ev_zeros32() -> i64 {
    let h: i64 = __mind_alloc(32);
    ev_fill(h, 32, 0);
    h
}

fn ev_fixture(c: i64) -> i64 {
    let h: i64 = __mind_alloc(32);
    ev_fill(h, 32, c);
    h
}

fn ev_hash_eq(a: i64, b: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 32 {
        if __mind_load_i8(a + i) != __mind_load_i8(b + i) { return 0; }
        i = i + 1;
    }
    1
}

fn ev_read_u16_le(buf: i64, off: i64) -> i64 {
    (__mind_load_i8(buf + off) & 255) + (__mind_load_i8(buf + off + 1) & 255) * 256
}

fn ev_read_u32_le(buf: i64, off: i64) -> i64 {
    (__mind_load_i8(buf + off) & 255)
        + (__mind_load_i8(buf + off + 1) & 255) * 256
        + (__mind_load_i8(buf + off + 2) & 255) * 65536
        + (__mind_load_i8(buf + off + 3) & 255) * 16777216
}

fn ev_read_i64_le(buf: i64, off: i64) -> i64 {
    let mut v: i64 = 0;
    let mut i: i64 = 0;
    while i < 8 {
        v = v + (__mind_load_i8(buf + off + i) & 255) * (1 << (i * 8));
        i = i + 1;
    }
    v
}

// Standard envelope: model=0x01, tokenizer=0x02 fixtures; catalog/request/
// result bytes, k, wire_version, timestamp, entry_kind, chain_prev pointer
// and reset reason are parameters. Returns the emit rc; the 212 bytes land
// in `out`.
fn ev_mk(out: i64, cat_b: i64, req_b: i64, res_b: i64, k: i64, wv: i64,
         ts: i64, ek: i64, prev: i64, reason: i64) -> i64 {
    let m: i64 = ev_fixture(1);
    let t: i64 = ev_fixture(2);
    let c: i64 = ev_fixture(cat_b);
    let q: i64 = ev_fixture(req_b);
    let r: i64 = ev_fixture(res_b);
    let rc: i64 = evidence_emit(m, t, c, q, r, prev, k, wv, ARCH_X86_64, ts,
                                ek, reason, out);
    __mind_free(r);
    __mind_free(q);
    __mind_free(c);
    __mind_free(t);
    __mind_free(m);
    rc
}

// emit + verify, returning the verify rc and writing chain_curr to `cc`.
fn ev_mk_verify(out: i64, cc: i64, cat_b: i64, req_b: i64, res_b: i64,
                k: i64, wv: i64, ts: i64, ek: i64, prev: i64,
                reason: i64) -> i64 {
    let erc: i64 = ev_mk(out, cat_b, req_b, res_b, k, wv, ts, ek, prev, reason);
    if erc != EV_OK { return erc; }
    return evidence_verify(out, 212, prev, cc);
}

// ── §1: layout pins ─────────────────────────────────────────────────────────

#[test]
fn test_envelope_size_is_212_bytes() {
    assert ATTESTATION_V2_SIZE == 212, "envelope is 212 bytes";
    assert ATTESTATION_BYTES == 212, "lib.mind agrees";
}

#[test]
fn test_envelope_offsets_pinned() {
    // The single source of truth for the wire layout (dormant §1 offset_of!
    // suite, folded into one test over the const table).
    assert OFFSET_VERSION == 0, "version @ 0";
    assert OFFSET_ENTRY_KIND == 1, "entry_kind @ 1";
    assert OFFSET_WIRE_VERSION == 2, "wire_version @ 2";
    assert OFFSET_K == 4, "k @ 4";
    assert OFFSET_TIMESTAMP_MS == 8, "timestamp_ms @ 8";
    assert OFFSET_ARCHITECTURE == 16, "architecture @ 16";
    assert OFFSET_RESERVED == 17, "reserved @ 17";
    assert OFFSET_CHAIN_RESET_REASON == 18, "chain_reset_reason @ 18";
    assert OFFSET_MODEL_HASH == 20, "model_hash @ 20";
    assert OFFSET_TOKENIZER_HASH == 52, "tokenizer_hash @ 52 (closes A4)";
    assert OFFSET_CATALOG_HASH == 84, "catalog_hash @ 84";
    assert OFFSET_REQUEST_HASH == 116, "request_hash @ 116";
    assert OFFSET_RESULT_HASH == 148, "result_hash @ 148";
    assert OFFSET_CHAIN_PREV == 180, "chain_prev @ 180";
}

// ── §2: emit / round-trip ───────────────────────────────────────────────────

#[test]
fn test_envelope_emit_produces_valid_wire_bytes() {
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let rc: i64 = ev_mk(out, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert rc == EV_OK, "emit ok";
    assert __mind_load_i8(out + OFFSET_VERSION) == 2, "version byte is 2";
    assert __mind_load_i8(out + OFFSET_ENTRY_KIND) == 1, "entry_kind byte is 1";
    assert ev_read_u16_le(out, OFFSET_WIRE_VERSION) == 1, "wire_version LE";
    assert ev_read_u32_le(out, OFFSET_K) == 5, "k LE";
    assert ev_read_i64_le(out, OFFSET_TIMESTAMP_MS) == 1000000, "timestamp LE";
    assert __mind_load_i8(out + OFFSET_ARCHITECTURE) == 1, "arch byte";
    assert __mind_load_i8(out + OFFSET_RESERVED) == 0, "reserved zero";
    assert ev_read_u16_le(out, OFFSET_CHAIN_RESET_REASON) == 0, "reason LE";
    __mind_free(out);
    __mind_free(z);
}

#[test]
fn test_envelope_round_trip_fields_preserved() {
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let cc: i64 = __mind_alloc(32);
    let erc: i64 = ev_mk(out, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert erc == EV_OK, "emit ok";
    let vrc: i64 = evidence_verify(out, 212, z, cc);
    assert vrc == EV_OK, "verify ok";
    // Every caller-supplied field survives on the wire.
    let tok_ok: i64 = ev_hash_eq(out + OFFSET_TOKENIZER_HASH, ev_fixture(2));
    assert tok_ok == 1, "tokenizer_hash region";
    let cat_ok: i64 = ev_hash_eq(out + OFFSET_CATALOG_HASH, ev_fixture(3));
    assert cat_ok == 1, "catalog_hash region";
    let req_ok: i64 = ev_hash_eq(out + OFFSET_REQUEST_HASH, ev_fixture(4));
    assert req_ok == 1, "request_hash region";
    let res_ok: i64 = ev_hash_eq(out + OFFSET_RESULT_HASH, ev_fixture(5));
    assert res_ok == 1, "result_hash region";
    let prev_ok: i64 = ev_hash_eq(out + OFFSET_CHAIN_PREV, z);
    assert prev_ok == 1, "chain_prev region";
    __mind_free(cc);
    __mind_free(out);
    __mind_free(z);
}

#[test]
fn test_envelope_verify_returns_sha256_of_bytes_as_chain_curr() {
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let erc: i64 = ev_mk(out, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert erc == EV_OK, "emit ok";
    let expected: i64 = __mind_alloc(32);
    mn_sha256(out, 212, expected);
    let cc: i64 = __mind_alloc(32);
    let vrc: i64 = evidence_verify(out, 212, z, cc);
    assert vrc == EV_OK, "verify ok";
    let eq: i64 = ev_hash_eq(cc, expected);
    assert eq == 1, "chain_curr == SHA-256(envelope bytes)";
    __mind_free(cc);
    __mind_free(expected);
    __mind_free(out);
    __mind_free(z);
}

// ── §3: chain integrity ─────────────────────────────────────────────────────

#[test]
fn test_chain_first_envelope_has_zero_chain_prev() {
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let cc: i64 = __mind_alloc(32);
    let rc: i64 = ev_mk_verify(out, cc, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert rc == EV_OK, "first envelope verifies against zeros32";
    let prev_ok: i64 = ev_hash_eq(out + OFFSET_CHAIN_PREV, z);
    assert prev_ok == 1, "chain_prev is zeros32";
    __mind_free(cc);
    __mind_free(out);
    __mind_free(z);
}

#[test]
fn test_chain_three_link_chain_prev_references_are_correct() {
    let z: i64 = ev_zeros32();
    let e1: i64 = __mind_alloc(212);
    let e2: i64 = __mind_alloc(212);
    let e3: i64 = __mind_alloc(212);
    let cc1: i64 = __mind_alloc(32);
    let cc2: i64 = __mind_alloc(32);
    let cc3: i64 = __mind_alloc(32);

    let rc1: i64 = ev_mk_verify(e1, cc1, 3, 16, 17, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert rc1 == EV_OK, "link 1";
    let rc2: i64 = ev_mk_verify(e2, cc2, 3, 32, 33, 5, 1, 1000001, ENTRY_INFERENCE, cc1, REASON_CONTINUATION);
    assert rc2 == EV_OK, "link 2 verifies against link 1 chain_curr";
    let p2: i64 = ev_hash_eq(e2 + OFFSET_CHAIN_PREV, cc1);
    assert p2 == 1, "link 2 chain_prev == link 1 chain_curr";
    let rc3: i64 = ev_mk_verify(e3, cc3, 3, 48, 49, 5, 1, 1000002, ENTRY_INFERENCE, cc2, REASON_CONTINUATION);
    assert rc3 == EV_OK, "link 3 verifies against link 2 chain_curr";
    let p3: i64 = ev_hash_eq(e3 + OFFSET_CHAIN_PREV, cc2);
    assert p3 == 1, "link 3 chain_prev == link 2 chain_curr";
    __mind_free(cc3);
    __mind_free(cc2);
    __mind_free(cc1);
    __mind_free(e3);
    __mind_free(e2);
    __mind_free(e1);
    __mind_free(z);
}

#[test]
fn test_chain_tampered_middle_envelope_breaks_next_link() {
    let z: i64 = ev_zeros32();
    let e1: i64 = __mind_alloc(212);
    let e2: i64 = __mind_alloc(212);
    let e3: i64 = __mind_alloc(212);
    let cc1: i64 = __mind_alloc(32);
    let cc2: i64 = __mind_alloc(32);
    let cc3: i64 = __mind_alloc(32);

    let rc1: i64 = ev_mk_verify(e1, cc1, 3, 160, 161, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert rc1 == EV_OK, "link 1";
    let rc2: i64 = ev_mk_verify(e2, cc2, 3, 176, 177, 5, 1, 1000001, ENTRY_INFERENCE, cc1, REASON_CONTINUATION);
    assert rc2 == EV_OK, "link 2 (original)";

    // Tamper: flip the low bit of link 2's request_hash first byte.
    __mind_store_i8(e2 + OFFSET_REQUEST_HASH, __mind_load_i8(e2 + OFFSET_REQUEST_HASH) ^ 1);
    let cc2t: i64 = __mind_alloc(32);
    mn_sha256(e2, 212, cc2t);
    let differs: i64 = 1 - ev_hash_eq(cc2t, cc2);
    assert differs == 1, "tampered chain_curr differs";

    // Link 3 was emitted against the ORIGINAL cc2; verifying it against the
    // tampered chain_curr must fail ChainBroken.
    let erc3: i64 = ev_mk(e3, 3, 192, 193, 5, 1, 1000002, ENTRY_INFERENCE, cc2, REASON_CONTINUATION);
    assert erc3 == EV_OK, "link 3 emit ok";
    let vrc: i64 = evidence_verify(e3, 212, cc2t, cc3);
    assert vrc == EV_ERR_CHAIN_BROKEN, "tampered predecessor rejected";
    __mind_free(cc2t);
    __mind_free(cc3);
    __mind_free(cc2);
    __mind_free(cc1);
    __mind_free(e3);
    __mind_free(e2);
    __mind_free(e1);
    __mind_free(z);
}

#[test]
fn test_verify_chain_sequence_api_accepts_valid_chain() {
    // The sequence API (dormant verify_chain) over a contiguous buffer.
    let z: i64 = ev_zeros32();
    let envs: i64 = __mind_alloc(636);
    let cc1: i64 = __mind_alloc(32);
    let cc2: i64 = __mind_alloc(32);
    let cc3: i64 = __mind_alloc(32);
    let r1: i64 = ev_mk_verify(envs, cc1, 3, 16, 17, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r1 == EV_OK, "link 1";
    let r2: i64 = ev_mk_verify(envs + 212, cc2, 3, 32, 33, 5, 1, 1000001, ENTRY_INFERENCE, cc1, REASON_CONTINUATION);
    assert r2 == EV_OK, "link 2";
    let r3: i64 = ev_mk_verify(envs + 424, cc3, 3, 48, 49, 5, 1, 1000002, ENTRY_INFERENCE, cc2, REASON_CONTINUATION);
    assert r3 == EV_OK, "link 3";
    let rc: i64 = evidence_verify_chain(envs, 3);
    assert rc == EV_OK, "sequence verify accepts the 3-link chain";
    let rc0: i64 = evidence_verify_chain(envs, 0);
    assert rc0 == EV_OK, "empty sequence is valid";
    __mind_free(cc3);
    __mind_free(cc2);
    __mind_free(cc1);
    __mind_free(envs);
    __mind_free(z);
}

#[test]
fn test_verify_chain_sequence_api_detects_tamper() {
    let z: i64 = ev_zeros32();
    let envs: i64 = __mind_alloc(424);
    let cc1: i64 = __mind_alloc(32);
    let cc2: i64 = __mind_alloc(32);
    let r1: i64 = ev_mk_verify(envs, cc1, 3, 16, 17, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r1 == EV_OK, "link 1";
    let r2: i64 = ev_mk_verify(envs + 212, cc2, 3, 32, 33, 5, 1, 1000001, ENTRY_INFERENCE, cc1, REASON_CONTINUATION);
    assert r2 == EV_OK, "link 2";
    // Flip a byte in link 1 after the chain was built: link 2's recorded
    // chain_prev no longer matches SHA-256(link 1).
    __mind_store_i8(envs + OFFSET_RESULT_HASH, __mind_load_i8(envs + OFFSET_RESULT_HASH) ^ 1);
    let rc: i64 = evidence_verify_chain(envs, 2);
    assert rc == EV_ERR_CHAIN_BROKEN, "sequence verify detects the tamper";
    __mind_free(cc2);
    __mind_free(cc1);
    __mind_free(envs);
    __mind_free(z);
}

// ── §4: entry_kind discriminator (audit A5) ─────────────────────────────────

#[test]
fn test_envelope_entry_kind_inference_parses() {
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let cc: i64 = __mind_alloc(32);
    let rc: i64 = ev_mk_verify(out, cc, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert rc == EV_OK, "inference parses";
    assert __mind_load_i8(out + OFFSET_ENTRY_KIND) == 1, "discriminant 1";
    __mind_free(cc);
    __mind_free(out);
    __mind_free(z);
}

