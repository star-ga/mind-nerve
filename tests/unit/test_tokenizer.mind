// tests/unit/test_tokenizer.mind — BPE 32k tokenizer contract suite for
// src/tokenizer.mind. Audit T-1 (tokenizer determinism), T-2 (hash binding).
//
// Ported to mindc 0.10.2 (wave 2, 2026-08-12) from
// tests/unit/dormant/test_tokenizer.mind. Runs through `mindc test` on a
// merged image (src/lib.mind + src/sha256.mind + src/tokenizer.mind + this
// file), driven by tests/mindc_gate.sh leg 7 with an exact-count
// assertion — a "running 0 tests" output FAILS the gate.
//
// ORACLE PROVENANCE: the tokenizer_hash digest and the two multi-merge
// encodings were computed 2026-08-12 against CPython hashlib + a reference
// Python implementation of the lowest-rank-applicable BPE encode over the
// 32-entry placeholder table:
//   tokenizer_hash      85bbfe5265c2b684a3560313ffbc15833cf4bc20f6140db66d099fa789ec622c
//   " the at"           -> [256, 258, 257, 116]
//   "llssee"            -> [272, 273, 274]
//
// ABI: input bytes at one byte per offset; output tokens are i64 lanes
// (8-byte stride); tokenize_bpe returns the token count or a negative
// TOKENIZE_ERR_* code.

// ── helpers (tk_ prefix) ────────────────────────────────────────────────────

fn tk_digest_word(out: i64, w: i64) -> i64 {
    let b0: i64 = __mind_load_i8(out + w * 4) & 255;
    let b1: i64 = __mind_load_i8(out + w * 4 + 1) & 255;
    let b2: i64 = __mind_load_i8(out + w * 4 + 2) & 255;
    let b3: i64 = __mind_load_i8(out + w * 4 + 3) & 255;
    b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
}

// Fill `dst` with `n` copies of byte `c`.
fn tk_fill(dst: i64, n: i64, c: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(dst + i, c);
        i = i + 1;
    }
    0
}

// ── Section 1: vocabulary parameter parity ──────────────────────────────────

#[test]
fn test_bpe_base_vocab_is_byte_range() {
    assert BPE_BASE_VOCAB == 256, "byte-level base occupies 0..255";
}

#[test]
fn test_bpe_total_vocab_matches_global_vocab_size() {
    assert BPE_TOTAL_VOCAB == VOCAB_SIZE, "tokenizer vocab == lib VOCAB_SIZE";
    assert BPE_TOTAL_VOCAB == 32768, "total vocab is 32k";
}

#[test]
fn test_bpe_merge_count_placeholder_size() {
    // Canary for the placeholder -> real-merges transition: bump to
    // BPE_TOTAL_VOCAB - BPE_BASE_VOCAB = 32512 when the real table lands.
    assert BPE_MERGE_COUNT == 32, "placeholder ships exactly 32 merges";
}

// ── Section 2: error surface ────────────────────────────────────────────────

#[test]
fn test_tokenize_empty_input_rejected() {
    let input: i64 = __mind_alloc(1);
    let out: i64 = __mind_alloc(8);
    let rc: i64 = tokenize_bpe(input, 0, out);
    assert rc == TOKENIZE_ERR_EMPTY, "empty input rejected";
    __mind_free(out);
    __mind_free(input);
}

#[test]
fn test_tokenize_too_long_rejected() {
    // 1025 bytes > MAX_REQUEST_TOKENS: byte-level init would already exceed
    // the cap, so rejection precedes any merge work.
    let input: i64 = __mind_alloc(MAX_REQUEST_TOKENS + 1);
    tk_fill(input, MAX_REQUEST_TOKENS + 1, 65);
    let out: i64 = __mind_alloc(8);
    let rc: i64 = tokenize_bpe(input, MAX_REQUEST_TOKENS + 1, out);
    assert rc == TOKENIZE_ERR_TOO_LONG, "over-cap input rejected";
    __mind_free(out);
    __mind_free(input);
}

#[test]
fn test_tokenize_exact_cap_accepted() {
    // Exactly MAX_REQUEST_TOKENS bytes of 'A' (no rule applies) pass
    // through unchanged.
    let input: i64 = __mind_alloc(MAX_REQUEST_TOKENS);
    tk_fill(input, MAX_REQUEST_TOKENS, 65);
    let out: i64 = __mind_alloc(MAX_REQUEST_TOKENS * 8);
    let n: i64 = tokenize_bpe(input, MAX_REQUEST_TOKENS, out);
    assert n == MAX_REQUEST_TOKENS, "at-cap input accepted, identity output";
    assert __mind_load_i64(out) == 65, "first token is 'A'";
    assert __mind_load_i64(out + (MAX_REQUEST_TOKENS - 1) * 8) == 65, "last token is 'A'";
    __mind_free(out);
    __mind_free(input);
}

// ── Section 3: encode behaviour ─────────────────────────────────────────────

#[test]
fn test_tokenize_single_ascii_byte_is_identity() {
    let input: i64 = __mind_alloc(1);
    __mind_store_i8(input, 65);
    let out: i64 = __mind_alloc(8);
    let n: i64 = tokenize_bpe(input, 1, out);
    assert n == 1, "single byte -> single token";
    assert __mind_load_i64(out) == 65, "token id equals byte value";
    __mind_free(out);
    __mind_free(input);
}

#[test]
fn test_tokenize_no_merge_applies_is_byte_identity() {
    // 'A' (65) and 'B' (66) appear in no rule.
    let input: i64 = __mind_alloc(4);
    __mind_store_i8(input + 0, 65);
    __mind_store_i8(input + 1, 66);
    __mind_store_i8(input + 2, 65);
    __mind_store_i8(input + 3, 66);
    let out: i64 = __mind_alloc(32);
    let n: i64 = tokenize_bpe(input, 4, out);
    assert n == 4, "no merge -> identity length";
    assert __mind_load_i64(out + 0) == 65, "token 0";
    assert __mind_load_i64(out + 8) == 66, "token 1";
    assert __mind_load_i64(out + 16) == 65, "token 2";
    assert __mind_load_i64(out + 24) == 66, "token 3";
    __mind_free(out);
    __mind_free(input);
}

#[test]
fn test_tokenize_repeated_double_letter_merges() {
    // "ll" is rank 16 -> learned id 272.
    let input: i64 = __mind_alloc(2);
    __mind_store_i8(input + 0, 108);
    __mind_store_i8(input + 1, 108);
    let out: i64 = __mind_alloc(16);
    let n: i64 = tokenize_bpe(input, 2, out);
    assert n == 1, "ll collapses to one token";
    assert __mind_load_i64(out) == 272, "ll -> 272";
    __mind_free(out);
    __mind_free(input);
}

#[test]
fn test_tokenize_two_independent_merges() {
    // "llss": "ll" (rank 16 -> 272) fires before "ss" (rank 17 -> 273);
    // the pairs do not overlap so the output is order-invariant, but the
    // determinism contract pins the scan order.
    let input: i64 = __mind_alloc(4);
    __mind_store_i8(input + 0, 108);
    __mind_store_i8(input + 1, 108);
    __mind_store_i8(input + 2, 115);
    __mind_store_i8(input + 3, 115);
    let out: i64 = __mind_alloc(32);
    let n: i64 = tokenize_bpe(input, 4, out);
    assert n == 2, "llss -> two tokens";
    assert __mind_load_i64(out) == 272, "ll -> 272";
    assert __mind_load_i64(out + 8) == 273, "ss -> 273";
    __mind_free(out);
    __mind_free(input);
}

#[test]
fn test_tokenize_leftmost_position_wins_for_same_merge() {
    // "lllll": collapse (0,1) -> [272, l, l, l]; leftmost remaining match
    // is the residue's first pair -> [272, 272, l]; fixpoint. Length 3.
    let input: i64 = __mind_alloc(5);
    tk_fill(input, 5, 108);
    let out: i64 = __mind_alloc(40);
    let n: i64 = tokenize_bpe(input, 5, out);
    assert n == 3, "lllll -> three tokens";
    assert __mind_load_i64(out + 0) == 272, "token 0 = 272";
    assert __mind_load_i64(out + 8) == 272, "token 1 = 272";
    assert __mind_load_i64(out + 16) == 108, "token 2 = 'l'";
    __mind_free(out);
    __mind_free(input);
}

#[test]
fn test_tokenize_mixed_sentence_pinned() {
    // " the at" exercises ranks 0, 1, 2 across restarts. Reference-Python
    // verified 2026-08-12: [256, 258, 257, 116].
    let input: i64 = __mind_alloc(7);
    __mind_store_i8(input + 0, 32);
    __mind_store_i8(input + 1, 116);
    __mind_store_i8(input + 2, 104);
    __mind_store_i8(input + 3, 101);
    __mind_store_i8(input + 4, 32);
    __mind_store_i8(input + 5, 97);
    __mind_store_i8(input + 6, 116);
    let out: i64 = __mind_alloc(56);
    let n: i64 = tokenize_bpe(input, 7, out);
    assert n == 4, "four tokens";
    assert __mind_load_i64(out + 0) == 256, "' t' -> 256";
    assert __mind_load_i64(out + 8) == 258, "'he' -> 258";
    assert __mind_load_i64(out + 16) == 257, "' a' -> 257";
    assert __mind_load_i64(out + 24) == 116, "trailing 't'";
    __mind_free(out);
    __mind_free(input);
}

#[test]
fn test_tokenize_llssee_pinned() {
    // "llssee": [272, 273, 274] — reference-Python verified 2026-08-12.
    let input: i64 = __mind_alloc(6);
    __mind_store_i8(input + 0, 108);
    __mind_store_i8(input + 1, 108);
    __mind_store_i8(input + 2, 115);
    __mind_store_i8(input + 3, 115);
    __mind_store_i8(input + 4, 101);
    __mind_store_i8(input + 5, 101);
    let out: i64 = __mind_alloc(48);
    let n: i64 = tokenize_bpe(input, 6, out);
    assert n == 3, "three tokens";
    assert __mind_load_i64(out + 0) == 272, "ll -> 272";
    assert __mind_load_i64(out + 8) == 273, "ss -> 273";
    assert __mind_load_i64(out + 16) == 274, "ee -> 274";
    __mind_free(out);
    __mind_free(input);
}

#[test]
fn test_tokenize_output_length_within_cap() {
    // Mix of merge-friendly and merge-hostile inputs: every successful
    // output has 1 <= len <= MAX_REQUEST_TOKENS.
    let abc: i64 = __mind_alloc(3);
    __mind_store_i8(abc + 0, 65);
    __mind_store_i8(abc + 1, 66);
    __mind_store_i8(abc + 2, 67);
    let llssee: i64 = __mind_alloc(6);
    __mind_store_i8(llssee + 0, 108);
    __mind_store_i8(llssee + 1, 108);
    __mind_store_i8(llssee + 2, 115);
    __mind_store_i8(llssee + 3, 115);
    __mind_store_i8(llssee + 4, 101);
    __mind_store_i8(llssee + 5, 101);
    let sent: i64 = __mind_alloc(7);
    __mind_store_i8(sent + 0, 32);
    __mind_store_i8(sent + 1, 116);
    __mind_store_i8(sent + 2, 104);
    __mind_store_i8(sent + 3, 101);
    __mind_store_i8(sent + 4, 32);
    __mind_store_i8(sent + 5, 97);
    __mind_store_i8(sent + 6, 116);
    let out: i64 = __mind_alloc(64);

    let n1: i64 = tokenize_bpe(abc, 3, out);
    assert n1 >= 1, "abc len >= 1";
    assert n1 <= MAX_REQUEST_TOKENS, "abc len within cap";
    let n2: i64 = tokenize_bpe(llssee, 6, out);
    assert n2 >= 1, "llssee len >= 1";
    assert n2 <= MAX_REQUEST_TOKENS, "llssee len within cap";
    let n3: i64 = tokenize_bpe(sent, 7, out);
    assert n3 >= 1, "sent len >= 1";
    assert n3 <= MAX_REQUEST_TOKENS, "sent len within cap";
    __mind_free(out);
    __mind_free(sent);
    __mind_free(llssee);
    __mind_free(abc);
}

// ── Section 4: determinism ──────────────────────────────────────────────────

#[test]
fn test_tokenize_deterministic_across_calls() {
    // " the" + " at" + "ll": two calls must produce byte-identical output —
    // the property that makes the token stream safe to hash into
    // request_hash.
    let input: i64 = __mind_alloc(9);
    __mind_store_i8(input + 0, 32);
    __mind_store_i8(input + 1, 116);
    __mind_store_i8(input + 2, 104);
    __mind_store_i8(input + 3, 101);
    __mind_store_i8(input + 4, 32);
    __mind_store_i8(input + 5, 97);
    __mind_store_i8(input + 6, 116);
    __mind_store_i8(input + 7, 108);
    __mind_store_i8(input + 8, 108);
    let a: i64 = __mind_alloc(72);
    let b: i64 = __mind_alloc(72);

    let na: i64 = tokenize_bpe(input, 9, a);
    let nb: i64 = tokenize_bpe(input, 9, b);
    assert na == nb, "same length across calls";
    let mut i: i64 = 0;
    while i < na {
        assert __mind_load_i64(a + i * 8) == __mind_load_i64(b + i * 8), "bit-identical tokens across calls";
        i = i + 1;
    }
    __mind_free(b);
    __mind_free(a);
    __mind_free(input);
}

#[test]
fn test_tokenize_distinct_inputs_distinct_outputs() {
    // "ll" -> [272], "ss" -> [273]: different merge rules must not collapse
    // to the same id (defence against a constant-splice regression).
    let in_a: i64 = __mind_alloc(2);
    __mind_store_i8(in_a + 0, 108);
    __mind_store_i8(in_a + 1, 108);
    let in_b: i64 = __mind_alloc(2);
    __mind_store_i8(in_b + 0, 115);
    __mind_store_i8(in_b + 1, 115);
    let out_a: i64 = __mind_alloc(16);
    let out_b: i64 = __mind_alloc(16);

    let na: i64 = tokenize_bpe(in_a, 2, out_a);
    let nb: i64 = tokenize_bpe(in_b, 2, out_b);
    assert na == 1, "a collapses to one token";
    assert nb == 1, "b collapses to one token";
    assert __mind_load_i64(out_a) != __mind_load_i64(out_b), "distinct rules yield distinct ids";
    __mind_free(out_b);
    __mind_free(out_a);
    __mind_free(in_b);
    __mind_free(in_a);
}

// ── Section 5: tokenizer_hash ───────────────────────────────────────────────

#[test]
fn test_tokenizer_hash_oracle() {
    // Pinned against CPython hashlib over the canonical serialization
    // (u32-LE header + u32-LE merge pairs, 268 bytes), computed 2026-08-12:
    // 85bbfe5265c2b684a3560313ffbc15833cf4bc20f6140db66d099fa789ec622c.
    // Subsumes the dormant is-32-bytes / non-zero checks: a stub or a
    // serialization drift breaks the digest.
    let h: i64 = __mind_alloc(32);
    tokenizer_hash(h);
    let mut rc: i64 = 0;
    if tk_digest_word(h, 0) != 2243690066 { rc = 1; }
    if tk_digest_word(h, 1) != 1707259524 { rc = 2; }
    if tk_digest_word(h, 2) != 2740323091 { rc = 3; }
    if tk_digest_word(h, 3) != 4290516355 { rc = 4; }
    if tk_digest_word(h, 4) != 1022671904 { rc = 5; }
    if tk_digest_word(h, 5) != 4128509366 { rc = 6; }
    if tk_digest_word(h, 6) != 1829347239 { rc = 7; }
    if tk_digest_word(h, 7) != 2313970220 { rc = 8; }
    assert rc == 0, "tokenizer_hash matches the hashlib-verified oracle";
    __mind_free(h);
}

#[test]
fn test_tokenizer_hash_is_stable_across_calls() {
    // Within-build stability (the cross-build pattern changes when the real
    // merge table lands — see src/tokenizer.mind header).
    let h1: i64 = __mind_alloc(32);
    let h2: i64 = __mind_alloc(32);
    tokenizer_hash(h1);
    tokenizer_hash(h2);
    let mut i: i64 = 0;
    while i < 32 {
        assert __mind_load_i8(h1 + i) == __mind_load_i8(h2 + i), "hash stable across calls";
        i = i + 1;
    }
    __mind_free(h2);
    __mind_free(h1);
}
