#[test]
fn test_envelope_emit_rejects_k_out_of_range() {
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let r0: i64 = ev_mk(out, 3, 4, 5, 0, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r0 == EV_ERR_INVALID_K, "k=0 rejected";
    let r65: i64 = ev_mk(out, 3, 4, 5, 65, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r65 == EV_ERR_INVALID_K, "k=65 rejected (MAX_TOP_K = 64)";
    let r64: i64 = ev_mk(out, 3, 4, 5, 64, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r64 == EV_OK, "k=64 accepted (boundary)";
    let r1: i64 = ev_mk(out, 3, 4, 5, 1, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r1 == EV_OK, "k=1 accepted (boundary)";
    __mind_free(out);
    __mind_free(z);
}

