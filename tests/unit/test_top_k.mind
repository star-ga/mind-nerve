#[test]
fn test_top_k_mask_all_tied_tiebreak_by_route_id() {
    // All scores q16(7); ascending SHA-256 order is d < c < b < e < a, so
    // k=2 shortlists catalog positions 3 (d) and 2 (c) — NOT the first two
    // indices.
    let ids: i64 = __mind_alloc(160);
    let scores: i64 = __mind_alloc(40);
    let sbuf: i64 = __mind_alloc(16);
    let mut i: i64 = 0;
    while i < 5 {
        tt_mkid(ids, i, sbuf, tt_str1(sbuf, 97 + i));
        __mind_store_i64(scores + i * 8, 458752);
        i = i + 1;
    }
    let mask: i64 = __mind_alloc(5);

    extract_top_k_mask(scores, ids, 5, 2, mask);
    assert tt_popcount(mask, 5) == 2, "popcount 2";
    assert __mind_load_i8(mask + 3) == 1, "d (lowest sha) shortlisted";
    assert __mind_load_i8(mask + 2) == 1, "c (second-lowest sha) shortlisted";
    assert __mind_load_i8(mask + 0) == 0, "a (highest sha) not shortlisted";
    assert __mind_load_i8(mask + 1) == 0, "b not shortlisted";
    assert __mind_load_i8(mask + 4) == 0, "e not shortlisted";
    __mind_free(mask);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_mask_tiebreak_two_tied_one_clear() {
    // apple 9, banana 5, zebra 5; SHA-256("zebra") = 676c… <
    // SHA-256("banana") = b493… → mask positions 0 and 2.
    let ids: i64 = __mind_alloc(96);
    let scores: i64 = __mind_alloc(24);
    let sbuf: i64 = __mind_alloc(16);
    tt_mkid(ids, 0, sbuf, tt_str_apple(sbuf));
    tt_mkid(ids, 1, sbuf, tt_str_banana(sbuf));
    tt_mkid(ids, 2, sbuf, tt_str_zebra(sbuf));
    __mind_store_i64(scores + 0, 589824);
    __mind_store_i64(scores + 8, 327680);
    __mind_store_i64(scores + 16, 327680);
    let mask: i64 = __mind_alloc(3);

    extract_top_k_mask(scores, ids, 3, 2, mask);
    assert tt_popcount(mask, 3) == 2, "popcount 2";
    assert __mind_load_i8(mask + 0) == 1, "apple (clear winner) shortlisted";
    assert __mind_load_i8(mask + 2) == 1, "zebra wins the 5-5 tie";
    assert __mind_load_i8(mask + 1) == 0, "banana loses the tie-break";
    __mind_free(mask);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_mask_agrees_with_extract_top_k() {
    // THE equivalence index recovery must preserve: the set of positions the
    // mask flips is exactly the set of route ids extract_top_k returns.
    // scores [4,9,1,9,7,2,7,0], k=4.
    let ids: i64 = __mind_alloc(256);
    let scores: i64 = __mind_alloc(64);
    let sbuf: i64 = __mind_alloc(16);
    let mut i: i64 = 0;
    while i < 8 {
        tt_mkid(ids, i, sbuf, tt_str_r(sbuf, i));
        i = i + 1;
    }
    __mind_store_i64(scores + 0, 262144);
    __mind_store_i64(scores + 8, 589824);
    __mind_store_i64(scores + 16, 65536);
    __mind_store_i64(scores + 24, 589824);
    __mind_store_i64(scores + 32, 458752);
    __mind_store_i64(scores + 40, 131072);
    __mind_store_i64(scores + 48, 458752);
    __mind_store_i64(scores + 56, 0);
    let out_ids: i64 = __mind_alloc(128);
    let out_scores: i64 = __mind_alloc(32);
    let mask: i64 = __mind_alloc(8);

    let n: i64 = extract_top_k(scores, ids, 8, 4, out_ids, out_scores);
    extract_top_k_mask(scores, ids, 8, 4, mask);
    assert n == 4, "four survivors";
    assert tt_popcount(mask, 8) == n, "mask popcount equals survivor count";

    let mut t: i64 = 0;
    while t < n {
        let mut found: i64 = 0;
        let mut r: i64 = 0;
        while r < 8 {
            if tt_id_eq(out_ids + t * 32, ids + r * 32) == 1 {
                assert __mind_load_i8(mask + r) == 1, "selected route set in mask at its own index";
                found = 1;
            }
            r = r + 1;
        }
        assert found == 1, "every top-K route id exists in the catalog";
        t = t + 1;
    }
    __mind_free(mask);
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_mask_determinism_100_runs() {
    // Tie-heavy catalog: [3,9,3,3,9,3,3,3], k=4. 100 invocations must
    // produce the exact same mask bytes every time.
    let ids: i64 = __mind_alloc(256);
    let scores: i64 = __mind_alloc(64);
    let sbuf: i64 = __mind_alloc(16);
    let mut i: i64 = 0;
    while i < 8 {
        tt_mkid(ids, i, sbuf, tt_str_r(sbuf, i));
        i = i + 1;
    }
    __mind_store_i64(scores + 0, 196608);
    __mind_store_i64(scores + 8, 589824);
    __mind_store_i64(scores + 16, 196608);
    __mind_store_i64(scores + 24, 196608);
    __mind_store_i64(scores + 32, 589824);
    __mind_store_i64(scores + 40, 196608);
    __mind_store_i64(scores + 48, 196608);
    __mind_store_i64(scores + 56, 196608);
    let reference: i64 = __mind_alloc(8);
    extract_top_k_mask(scores, ids, 8, 4, reference);

    let mask: i64 = __mind_alloc(8);
    let mut run: i64 = 0;
    while run < 100 {
        extract_top_k_mask(scores, ids, 8, 4, mask);
        let mut b: i64 = 0;
        while b < 8 {
            let got: i64 = __mind_load_i8(mask + b);
            let want: i64 = __mind_load_i8(reference + b);
            assert got == want, "mask bit-identical across runs";
            b = b + 1;
        }
        run = run + 1;
    }
    __mind_free(mask);
    __mind_free(reference);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}
