// BPE 32k tokenizer — byte-level Byte-Pair Encoding, pure MIND. Ported to
// the mindc 0.10.2 dialect 2026-08-12 (wave 2 of the pure-MIND migration;
// the dormant pre-port source is preserved at src/dormant/tokenizer.mind).
//
// Audit anchors: T-1 (tokenizer determinism), T-2 (tokenizer hash binding).
//
// MODEL
// -----
// Standard byte-level BPE:
//   1. Byte-level base. Every byte 0..255 maps to a token id equal to its
//      value. Guarantees no OOV — any UTF-8 input is representable.
//   2. Merge table. An ordered list of `(left_id, right_id) -> merged_id`
//      rules. The encoder iteratively applies the lowest-rank applicable
//      merge until no merge applies. Lower rank = higher priority. The
//      learned token id for rule at rank `i` is `256 + i`.
//   3. Vocabulary. IDs 0..255 = byte-level base. IDs 256..32767 = learned
//      merges, of which Phase 1.2 ships only 32 placeholders (real 32k
//      merges arrive bundled with the first reference checkpoint).
//
// PHASE 1.2 STATUS
// ----------------
// THIS FILE SHIPS THE PLACEHOLDER MERGE TABLE (32 entries), unchanged from
// the dormant source. The placeholder merges are NOT the trained 32k table;
// the drop replaces BPE_MERGE_LEFT/RIGHT wholesale and grows
// BPE_MERGE_COUNT from 32 to 32512. `tokenizer_hash` is computed against
// the placeholder table and WILL change at that transition.
//
// DETERMINISM
// -----------
// The algorithm uses only integer equality and integer comparisons; no
// floats, no clocks, no platform-dependent ordering. The byte stream →
// token stream mapping is bit-identical across backends because the token
// sequence feeds `request_hash` in the attestation envelope. The dormant
// `@[determinism(BitIdentical)]` attribute has no 0.10.2 equivalent; the
// discipline is by construction and pinned by tests/unit/test_tokenizer.mind
// (including the hashlib-verified tokenizer_hash oracle).
//
// PORT NOTES (0.10.2 reality):
//   - Byte-slice I/O contract: input bytes and output token ids cross the
//     API as raw i64 buffer handles (input: one byte per offset; output
//     tokens: i64 lanes at an 8-byte stride), matching src/sha256.mind,
//     src/top_k.mind, mind/luts. The dormant `&[u8]` in / `[u32]` out
//     surface is not expressible in 0.10.2.
//   - Result<[u32], TokenizeError> becomes a signed return convention:
//     tokenize_bpe returns the token count (>= 1) on success, or a
//     negative error code (TOKENIZE_ERR_EMPTY / TOKENIZE_ERR_TOO_LONG).
//   - The merge table is two parallel const arrays (0.10.2 has no tuple
//     type); runtime indexing of const arrays is verified to execute in
//     the `mindc test` interpreter.
//   - The encode loop avoids `break`/`continue`: found-flags gate the
//     scans (same discipline as src/top_k.mind).

import src.lib;
import src.sha256;

// ─────────────────────────────────────────────────────────────────────────────
// Vocabulary parameters (part of model_hash via the tokenizer manifest)
// ─────────────────────────────────────────────────────────────────────────────

// Number of byte-level base tokens. IDs 0..255 are the raw bytes.
pub const BPE_BASE_VOCAB: i64 = 256;

// Total vocabulary size. Must equal VOCAB_SIZE (src/lib.mind) — the parity
// is asserted in tests/unit/test_tokenizer.mind.
pub const BPE_TOTAL_VOCAB: i64 = 32768;

// Number of learned merges in the current artifact. Placeholder = 32;
// real reference checkpoint = 32512 (= 32768 - 256). Changing this is a
// model-architecture change requiring a new model_hash and tokenizer_hash.
pub const BPE_MERGE_COUNT: i64 = 32;

// Signed return codes for tokenize_bpe (the dormant TokenizeError enum,
// flattened for the handle ABI).
pub const TOKENIZE_ERR_EMPTY:    i64 = -1;
pub const TOKENIZE_ERR_TOO_LONG: i64 = -2;

// ─────────────────────────────────────────────────────────────────────────────
// Placeholder merge table
// ─────────────────────────────────────────────────────────────────────────────
//
// Rank i pairs (BPE_MERGE_LEFT[i], BPE_MERGE_RIGHT[i]); the learned token id
// is BPE_BASE_VOCAB + i. All operands are byte-level ids (< 256) in the
// placeholder table. Byte values (decimal):
//   rank 0..15  — common English bigrams and " <letter>" pairs:
//                 " t" " a" "he" "in" "er" "on" " s" "at"
//                 "en" "nd" "ti" "es" "or" "te" "of" "ed"
//   rank 16..23 — repeated letters: "ll" "ss" "ee" "oo" "tt" "ff" "pp" "nn"
//   rank 24..31 — Cyrillic UTF-8 lead-byte pairs: 0xD0/0xD1 + a common
//                 continuation byte (U+0430 U+0435 U+0438 U+043E U+043D
//                 U+0442 U+0440 U+0441).

const BPE_MERGE_LEFT: [i64; 32] = [
    32, 32, 104, 105, 101, 111, 32, 97,
    101, 110, 116, 101, 111, 116, 111, 101,
    108, 115, 101, 111, 116, 102, 112, 110,
    208, 208, 208, 208, 208, 209, 209, 209,
];

const BPE_MERGE_RIGHT: [i64; 32] = [
    116, 97, 101, 110, 114, 110, 115, 116,
    110, 100, 105, 115, 114, 101, 102, 100,
    108, 115, 101, 111, 116, 102, 112, 110,
    176, 181, 184, 190, 189, 130, 128, 129,
];

// ─────────────────────────────────────────────────────────────────────────────
// tokenize_bpe
//
// Encode `n` UTF-8 bytes at `bytes_addr` (one byte per offset) into BPE
// token ids written as i64 lanes to `out_tokens` (caller-allocated,
// capacity >= n lanes — merges never grow the sequence).
//
// Returns:
//   TOKENIZE_ERR_EMPTY    (-1)  n == 0 — the tokenizer refuses empty input
//                               explicitly so callers cannot hash an empty
//                               preimage into request_hash.
//   TOKENIZE_ERR_TOO_LONG (-2)  n > MAX_REQUEST_TOKENS — byte-level init
//                               would already exceed the cap.
//   token count (>= 1)          otherwise; count <= n.
//
// Algorithm: standard lowest-rank-applicable encode. Scan ranks top-down;
// for each rule, walk the current tokens left-to-right for the leftmost
// matching adjacent pair; splice (overwrite + shift-left, no allocation);
// restart. Terminates at fixpoint or single token. Worst-case iterations
// n - 1 (each merge shrinks the sequence by exactly one).
// ─────────────────────────────────────────────────────────────────────────────

pub fn tokenize_bpe(bytes_addr: i64, n: i64, out_tokens: i64) -> i64 {
    if n == 0 { return TOKENIZE_ERR_EMPTY; }
    if n > MAX_REQUEST_TOKENS { return TOKENIZE_ERR_TOO_LONG; }

    // Step 1 — byte-level initialisation (one token per byte).
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i64(out_tokens + i * 8, __mind_load_i8(bytes_addr + i) & 255);
        i = i + 1;
    }

    // Step 2 — iterative lowest-rank merge (found-flags instead of break).
    let mut tlen: i64 = n;
    let mut cont: i64 = 1;
    while cont == 1 {
        if tlen < 2 {
            cont = 0;
        } else {
            let mut best_rank: i64 = BPE_MERGE_COUNT;
            let mut best_pos: i64 = 0;
            let mut found: i64 = 0;
            let mut rank: i64 = 0;
            while rank < BPE_MERGE_COUNT {
                if found == 0 {
                    let left: i64 = BPE_MERGE_LEFT[rank];
                    let right: i64 = BPE_MERGE_RIGHT[rank];
                    let mut p: i64 = 0;
                    let limit: i64 = tlen - 1;
                    while p < limit {
                        if found == 0 {
                            if __mind_load_i64(out_tokens + p * 8) == left {
                                if __mind_load_i64(out_tokens + (p + 1) * 8) == right {
                                    best_rank = rank;
                                    best_pos = p;
                                    found = 1;
                                }
                            }
                        }
                        p = p + 1;
                    }
                }
                rank = rank + 1;
            }

            if found == 0 {
                cont = 0;
            } else {
                // Splice: tokens[best_pos] = merged id, shift left, shrink.
                __mind_store_i64(out_tokens + best_pos * 8, BPE_BASE_VOCAB + best_rank);
                let mut j: i64 = best_pos + 1;
                while j + 1 < tlen {
                    __mind_store_i64(out_tokens + j * 8, __mind_load_i64(out_tokens + (j + 1) * 8));
                    j = j + 1;
                }
                tlen = tlen - 1;
            }
        }
    }

    // Defence-in-depth: merges never grow the sequence, so the initial gate
    // already bounds the output; re-check so a future signature change
    // cannot slip past the cap silently.
    if tlen > MAX_REQUEST_TOKENS { return TOKENIZE_ERR_TOO_LONG; }
    tlen
}

// ─────────────────────────────────────────────────────────────────────────────
// tokenizer_hash — SHA-256 of the canonical tokenizer serialization:
//
//   BPE_BASE_VOCAB  (u32 LE, 4 bytes) ||
//   BPE_TOTAL_VOCAB (u32 LE, 4 bytes) ||
//   BPE_MERGE_COUNT (u32 LE, 4 bytes) ||
//   for rank i in 0..BPE_MERGE_COUNT:
//       BPE_MERGE_LEFT[i]  (u32 LE, 4 bytes) ||
//       BPE_MERGE_RIGHT[i] (u32 LE, 4 bytes)
//
// Total preimage length = 12 + 8 * BPE_MERGE_COUNT = 268 bytes.
//
// Writes the 32-byte digest to `out_addr` (caller-allocated), returns 0.
// The hash enters ModelWeights.tokenizer_hash and is bound into every
// attestation envelope. The placeholder-table byte pattern is NOT stable
// across Phase 1.2 commits (see header). Pinned against CPython hashlib in
// tests/unit/test_tokenizer.mind.
// ─────────────────────────────────────────────────────────────────────────────

fn store_u32_le(buf: i64, off: i64, v: i64) -> i64 {
    __mind_store_i8(buf + off + 0, v & 255);
    __mind_store_i8(buf + off + 1, (v >> 8) & 255);
    __mind_store_i8(buf + off + 2, (v >> 16) & 255);
    __mind_store_i8(buf + off + 3, (v >> 24) & 255);
    0
}

pub fn tokenizer_hash(out_addr: i64) -> i64 {
    let buf: i64 = __mind_alloc(12 + BPE_MERGE_COUNT * 8);
    store_u32_le(buf, 0, BPE_BASE_VOCAB);
    store_u32_le(buf, 4, BPE_TOTAL_VOCAB);
    store_u32_le(buf, 8, BPE_MERGE_COUNT);
    let mut i: i64 = 0;
    while i < BPE_MERGE_COUNT {
        store_u32_le(buf, 12 + i * 8, BPE_MERGE_LEFT[i]);
        store_u32_le(buf, 12 + i * 8 + 4, BPE_MERGE_RIGHT[i]);
        i = i + 1;
    }
    mn_sha256(buf, 12 + BPE_MERGE_COUNT * 8, out_addr);
    __mind_free(buf);
    0
}
