def log(record: dict) -> None:
    """Best-effort JSONL log. Never raises."""
    try:
        LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
        record["ts"] = time.time()
        with LOG_PATH.open("a") as f:
            f.write(json.dumps(record) + "\n")
    except Exception:
        pass


def telemetry(record: dict) -> None:
    """Append one routing-decision line. Local file, no network. Never raises.

    Nothing previously recorded what was injected versus what was actually
    used, so no change to the router could be measured and there was no
    labelled data to calibrate against. This is that record; the companion
    `mind-nerve-observe` hook appends the `skill_read` half.
    """
    try:
        TELEMETRY_PATH.parent.mkdir(parents=True, exist_ok=True)
        record.setdefault("ts", time.time())
        record.setdefault("v", 1)
        with TELEMETRY_PATH.open("a") as f:
            f.write(json.dumps(record) + "\n")
    except Exception:
        pass


def query_digest(text: str) -> str:
    """Short stable digest. The prompt itself is never written to telemetry."""
    return hashlib.sha256(text.encode("utf-8", "replace")).hexdigest()[:16]


def read_stdin() -> dict:
    try:
        raw = sys.stdin.read()
    except Exception:
        return {}
    if not raw:
        return {}
    try:
        parsed = json.loads(raw)
    except Exception:
        # Malformed JSON on stdin is a fail-open case, not a crash.
        return {}
    return parsed if isinstance(parsed, dict) else {}


def prompt_from(data: dict, depth: int = 0) -> str:
    """Extract the user prompt across the CLIs' differing stdin shapes."""
    if depth > 3:
        return ""
    for k in ("prompt", "user_prompt", "userPrompt", "message", "text"):
        v = data.get(k)
        if isinstance(v, str) and v.strip():
            return v.strip()
    for k in ("input", "payload"):
        inner = data.get(k)
        if isinstance(inner, dict):
            p = prompt_from(inner, depth + 1)
            if p:
                return p
    return ""


# ---------------------------------------------------------------------------
# Intent gate — runs BEFORE the encoder
# ---------------------------------------------------------------------------
#
# The hook used to embed whatever arrived on stdin. Observed live: it routed on
# an injected system prompt ("You are a personal assistant running inside
# OpenClaw...") and a two-word reply ("all 3") triggered a full projection.
# Those score 0.39-0.46 — INSIDE the range real hits occupy — so no score
# threshold can reject them. They have to be rejected on SHAPE, before they are
# ever encoded.

# Harness / non-user text. Matched against the raw newest turn.
_HARNESS_PATTERNS = (
    re.compile(r"^\s*You are\s", re.I),
    re.compile(r"^\s*##+\s*Tooling", re.I),
    re.compile(r"^\s*<(system|environment|task)[-_ ]", re.I),
    re.compile(r'Background command\s+".*?"\s+completed', re.I),
    re.compile(r"\[SYSTEM NOTIFICATION", re.I),
    re.compile(r"^\s*<system-reminder>", re.I),
    re.compile(r"^\s*Caveat: The messages below", re.I),
    re.compile(r"^\s*\[Request interrupted", re.I),
    re.compile(r"^\s*Your task is to (read|summari)", re.I),
)

# Bare acknowledgements and continuations: real user text, zero intent.
_ACK_RE = re.compile(
    r"^\s*(?:"
    r"y|n|k|ok|okay|yes|no|yep|yeah|nope|sure|thanks|thank you|ty|"
    r"proceed|continue|go|go on|go ahead|next|more|again|"
    r"do it|please do|sounds good|looks good|lgtm|nice|cool|great|perfect|"
    r"right|correct|exactly|indeed|hmm|hm|huh|oh|ah|wow|"
    r"all\s+\d+|both|either|that one|this one|the first|the second|"
    r"stop|wait|hold on|nvm|never mind"
    r")"
    r"[\s.!?,]*$",
    re.I,
)

# Blocks that are transcript/tool payload rather than a request.
_TOOL_OUTPUT_RE = re.compile(
    r"^\s*(?:"
    r"\{[\s\S]*\}|\[[\s\S]*\]|"          # a bare JSON blob
    r"(?:PASS|FAIL|OK|ERROR|WARN)\b[\s\S]*|"
    r"(?:\d+ (?:passed|failed|tests?|files? changed))[\s\S]*"
    r")\s*$"
)

_STOPWORDS = frozenset(
    """a an the this that these those and or but if then else so than as at by for from in into of on
    to with without is are was were be been being am do does did doing have has had having i me my we
    our you your it its they them their he she his her there here what which who whom whose when where
    why how all any both each few more most other some such no nor not only own same too very can will
    just should now please ok okay yeah yes thanks""".split()
)

# A request almost always carries one of these. Presence of an action verb is
# what separates a short-but-real request ("fix the build") from a short
# non-request ("the build"). Deliberately generous: a false ALLOW costs one
# routing call, a false SKIP costs a missed skill.
_ACTION_VERBS = frozenset(
    """add adapt analyse analyze apply audit automate benchmark bootstrap break build bump check clean
    compare compile configure connect convert create debug decode decompile deploy design detect
    diagnose diff document draft dump enable encrypt evaluate examine execute explain explore export
    extract find fix format generate get grep handle harden help implement import improve init inspect
    install integrate investigate lint list load lower make measure migrate mock modify monitor move
    optimise optimize package parse patch perform pick plan port probe profile prove publish pull push
    query read rebase refactor release remove rename render repair replace report research restore
    review rewrite run scaffold scan schedule search set setup ship show simplify solve sort speed
    split start stop stub summarise summarize sweep switch sync test trace track train translate
    trigger tune undo update upgrade upload validate verify wire write
    broken breaking crash crashes crashing fail fails failing failed error errors throwing throws
    slow slower regression regressed leak leaks hang hangs stuck wrong incorrect""".split()
)


def newest_user_turn(text: str) -> str:
    """Reduce a possibly-composite stdin payload to the newest USER turn.

    CLIs hand the hook whatever they have: sometimes the bare prompt,
    sometimes the prompt with a system preamble, an appended
    <system-reminder>, or a pasted tool result. Routing on the whole blob
    routes on the preamble, which is how a system prompt ended up choosing
    skills. Keep the last block that still looks like something a person
    typed.
    """
    if not text:
        return ""
    cleaned = text
    # Drop wrapped injected blocks wholesale (they are never the request).
    cleaned = re.sub(
        r"<system-reminder>[\s\S]*?</system-reminder>", " ", cleaned, flags=re.I
    )
    cleaned = re.sub(
        r"<(task-notification|command-name|local-command-stdout)>[\s\S]*?"
        r"</\1>",
        " ",
        cleaned,
        flags=re.I,
    )
    cleaned = re.sub(r"```[\s\S]*?```", " ", cleaned)

    blocks = [b.strip() for b in re.split(r"\n\s*\n", cleaned) if b.strip()]
    if not blocks:
        return cleaned.strip()

    for block in reversed(blocks):
        if any(p.search(block) for p in _HARNESS_PATTERNS):
            continue
        if _TOOL_OUTPUT_RE.match(block) and len(block) > 40:
            continue
        return block
    # Everything looked like harness text — hand back the last block and let
    # the shape checks below reject it, rather than silently routing block 0.
    return blocks[-1]


def content_words(text: str) -> list[str]:
    words = re.findall(r"[A-Za-z][A-Za-z0-9_.\-]*", text.lower())
    return [w for w in words if w not in _STOPWORDS and len(w) > 1]


def has_action_verb(text: str) -> bool:
    words = set(re.findall(r"[a-z]+", text.lower()))
    return bool(words & _ACTION_VERBS)


def intent_gate(raw: str) -> tuple[bool, str, str]:
    """Decide whether *raw* is a routable request.

    Returns ``(should_route, reason, evaluated_text)``. ``reason`` names the
    rule that fired so telemetry can show which shape is doing the filtering.
    """
    turn = newest_user_turn(raw)
    if not INTENT_GATE_ON:
        return True, "gate_disabled", turn
    if not turn:
        return False, "empty", turn
    if any(p.search(turn) for p in _HARNESS_PATTERNS):
        return False, "harness_shape", turn
    if _ACK_RE.match(turn):
        return False, "bare_ack", turn
    if not re.search(r"[A-Za-z]", turn):
        return False, "no_letters", turn
    words = content_words(turn)
    if len(words) < MIN_CONTENT_WORDS and not has_action_verb(turn):
        return False, "too_short_no_verb", turn
    if _TOOL_OUTPUT_RE.match(turn) and len(turn) > 40:
        return False, "tool_output", turn
    return True, "ok", turn


# ---------------------------------------------------------------------------
# Hub listing
# ---------------------------------------------------------------------------


def list_source_skills() -> dict[str, Path]:
    """name -> resolved skill dir, for every hub entry holding a SKILL.md.

    Dot-directories are skipped, which excludes `.system/` — the hub's own
    internals. That exclusion matters beyond tidiness: `.system/` shadows four
    real hub skills by name (plugin-creator, openai-docs, skill-creator,
    imagegen all exist BOTH as `.system/<name>/SKILL.md` and `<name>/SKILL.md`),
    and a projection keyed on name alone silently picked one of the two.
    """
    skills: dict[str, Path] = {}
    if not SOURCE_DIR.is_dir():
        return skills
    try:
        children = list(SOURCE_DIR.iterdir())
    except Exception:
        return skills
    for child in children:
        if child.name.startswith("."):
            continue
        try:
            if not (child / "SKILL.md").is_file():
                continue
            skills[child.name] = child.resolve() if child.is_symlink() else child
        except Exception:
            continue
    return skills


def is_system_route(r: dict) -> bool:
    """True for a catalog row that points into the hub's `.system/` internals."""
    sp = str(r.get("source_path") or "")
    return "/.system/" in sp or sp.startswith(".system/")


def query_daemon(prompt: str, k: int) -> list[dict] | None:
    """Ask mind-nerve-routed for routes. None means 'pass through silently'."""
    if not prompt or not os.path.exists(SOCKET_PATH):
        return None
    s = None
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(SOCKET_TIMEOUT)
        s.connect(SOCKET_PATH)
        s.sendall((json.dumps({"prompt": prompt, "top_k": k}) + "\n").encode())
        s.shutdown(socket.SHUT_WR)
        buf = b""
        while True:
            chunk = s.recv(8192)
            if not chunk:
                break
            buf += chunk
            if len(buf) > 1_000_000:
                break
        reply = json.loads(buf.decode("utf-8", errors="replace"))
    except Exception as e:
        log({"event": "socket_err", "err": str(e)})
        return None
    finally:
        if s is not None:
            try:
                s.close()
            except Exception:
                pass
    if not isinstance(reply, dict):
        log({"event": "daemon_bad_shape"})
        return None
    if "error" in reply:
        log({"event": "daemon_err", "err": reply["error"]})
        return None
    routes = reply.get("routes")
    return list(routes) if isinstance(routes, list) else []


# ---------------------------------------------------------------------------
# Resolution: route name -> hub skill or agent .md
# ---------------------------------------------------------------------------


def slug(name: str) -> str:
    return _slug_re.sub("-", name.lower()).strip("-")


def resolve_name(name: str, source: dict[str, Path]) -> str | None:
    if not name:
        return None
    if name in source:
        return name
    s = slug(name)
    if s in source:
        return s
    for src_name in source:
        if slug(src_name) == s:
            return src_name
    return None


def skill_path(name: str, source: dict[str, Path]) -> str | None:
    match = resolve_name(name, source)
    return str(source[match] / "SKILL.md") if match else None


def _plausible_agent_filename(fn: str) -> bool:
    """True when *fn* could ever name a real agent file.

    Route names are catalog-controlled text. A malformed catalog row can carry
    a whole document as its "name" (observed live: a 300+ char Reddit runbook
    with newlines). Turning that into a filename and stat()ing it raises
    ENAMETOOLONG on Linux — Path.is_file() does NOT swallow it — and the hook
    died via the fatal handler, silently killing routing for that prompt.
    """
    if not fn or "/" in fn or "\0" in fn:
        return False
    # NAME_MAX is 255; leave headroom for the extension and stay portable.
    return len(fn.encode("utf-8", "replace")) <= 200


def agent_path(name: str) -> str | None:
    if not name:
        return None
    candidates = [name, slug(name), name.replace("_", "-")]
    for root in AGENT_DIRS:
        if not root.is_dir():
            continue
        for c in candidates:
            for fn in (f"{c}.md", f"{c}.yaml", f"{c}.yml"):
                if not _plausible_agent_filename(fn):
                    continue
                p = root / fn
                try:
                    if p.is_file():
                        return str(p)
                except OSError:
                    continue
        try:
            lower = {f.name.lower(): f for f in root.iterdir() if f.is_file()}
        except Exception:
            continue
        for c in candidates:
            hit = lower.get(f"{c}.md".lower()) or lower.get(f"{c}.yaml".lower())
            if hit:
                return str(hit)
    return None


def classify_route(name: str, source: dict[str, Path]) -> tuple[str, str | None]:
    """(kind, absolute path) where kind is skill | agent | unknown."""
    sp = skill_path(name, source)
    if sp:
        return "skill", sp
    ap = agent_path(name)
    if ap:
        return "agent", ap
    return "unknown", None


def _confined_source_path(r: dict) -> str | None:
    """The daemon-provided source_path, only when it resolves inside a known
    root (the skills hub or an agent dir) and names a real file.

    Acquired agents live at hub/<pkg>/agents/foo.md — name-based resolution
    never finds them (no SKILL.md in the hub dir, not in AGENT_DIRS), so
    they were reclassified as unknown and dropped (audit, 2026-08 r4 /
    codex#12). The path is still catalog data feeding model-facing context,
    so a row pointing OUTSIDE those roots is never honoured.
    """
    sp = str(r.get("source_path") or "")
    if not sp:
        return None
    try:
        resolved = Path(sp).resolve()
    except OSError:
        return None
    for root in (SOURCE_DIR, *AGENT_DIRS):
        try:
            rr = root.resolve()
        except OSError:
            continue
        if resolved != rr and rr not in resolved.parents:
            continue
        try:
            if resolved.is_file():
                return str(resolved)
        except OSError:
            continue
    return None


# ---------------------------------------------------------------------------
# Ranking: dedup across source_repo, then apply the gates
# ---------------------------------------------------------------------------


def route_score(r: dict) -> float:
    try:
        return float(r.get("score"))
    except (TypeError, ValueError):
        return 0.0


def dedup_routes(routes: list[dict], source: dict[str, Path]) -> list[dict]:
    """Collapse duplicates that differ only by `source_repo`.

    The route table carries the same skill under "starga" and "local"; a raw
    top-5 is effectively a top-3 distinct. Identity is the resolved hub name
    when the route resolves, else the slug — so `Deploying-X` and `deploying-x`
    collapse too. Daemon order is preserved and the best-scoring row wins.

    Rows pointing into `.system/` are dropped here rather than deduped: they
    are hub internals that shadow real skills of the same name.
    """
    out: list[dict] = []
    seen: dict[str, int] = {}
    for r in routes:
        name = str(r.get("name") or "").strip()
        if not name or is_system_route(r):
            continue
        # The daemon's own classification wins when its source_path is
        # root-confined (acquired agents/skills); name-based resolution is
        # the fallback for rows that carry no usable path.
        daemon_kind = str(r.get("kind") or "")
        confined = _confined_source_path(r)
        if daemon_kind in ("skill", "agent") and confined is not None:
            kind, path = daemon_kind, confined
        else:
            kind, path = classify_route(name, source)
        resolved = resolve_name(name, source)
        identity = resolved or slug(name)
        enriched = dict(r)
        enriched["name"] = name
        enriched["kind"] = kind
        enriched["path"] = path
        enriched["score_f"] = route_score(r)

        prev_idx = seen.get(identity)
        if prev_idx is None:
            seen[identity] = len(out)
            out.append(enriched)
        elif enriched["score_f"] > out[prev_idx]["score_f"]:
            # Same skill under a different source_repo scored higher — keep the
            # better row in the position the first occurrence already earned.
            out[prev_idx] = enriched
    return out


def apply_threshold(routes: list[dict], min_score: float) -> list[dict]:
    """Drop routes below the score floor. Sub-threshold rows are noise."""
    return [r for r in routes if r.get("score_f", 0.0) >= min_score]


def top2_ratio(routes: list[dict]) -> float | None:
    """score(runner-up) / score(leader) over ALREADY-DEDUPED routes.

    Computed for telemetry ONLY — see APPLY_RATIO_GATE for why this never
    gates. Deduping first matters even for a logged value: near-duplicate
    skills drive the raw top2/top1 to ~1.0 for reasons that have nothing to do
    with confidence, so an un-deduped ratio would be measuring the catalog's
    redundancy rather than the ranker's certainty.
    """
    if len(routes) < 2:
        return None
    top = routes[0].get("score_f", 0.0)
    if top <= 0:
        return None
    return round(routes[1].get("score_f", 0.0) / top, 4)


