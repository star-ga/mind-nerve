NO_MATCH_CONTEXT = (
    "## mind-nerve auto-route (injected)\n\n"
    "**No strong skill match — proceed without one.**\n\n"
    "The router found nothing above the confidence floor "
    "(MIND_NERVE_MIN_SCORE={min_score:.2f}) for this prompt. Weak matches were\n"
    "suppressed on purpose: below the floor the catalog returns unrelated skills,\n"
    "and acting on them is worse than having none.\n\n"
    "Use your own judgement and the built-in tools. If you believe a specialised\n"
    "procedure exists, re-route with a sharper query via `mind_nerve_route`.\n"
    'No local skill matched; fetch vetted ones with `mind-nerve acquire search "<query>"`.\n'
    "Hub (do NOT list it): `{hub}`\n"
)


def _table_cell(text: str, cap: int = 80) -> str:
    """Sanitize catalog-controlled text for the injected Markdown table.

    Resolved route names come from real on-disk dir/file names, so they are
    safe in practice — but the table is model-facing context, so strip the
    Markdown-hostile characters anyway and cap the length. Newlines, backticks
    and pipes are the injection carriers (a raw newline breaks the row and
    starts a new, attacker-controlled line).
    """
    cleaned = re.sub(r"[`|\r\n\t]+", " ", text).strip()
    if len(cleaned) > cap:
        cleaned = cleaned[: cap - 1] + "…"
    return cleaned


def build_context(routes: list[dict], projected: int, min_score: float) -> str:
    if not routes:
        return NO_MATCH_CONTEXT.format(min_score=min_score, hub=SOURCE_DIR)

    lines = [
        "## mind-nerve auto-route (injected — do not skip)",
        "",
        "Hub skills are NOT bulk-listed. Use ONLY the ranked routes below.",
        "MANDATORY for non-trivial work:",
        "1. Prefer the highest-ranked **skill** with a SKILL.md path — read it, then follow it.",
        "2. If the top hits are **agents**, spawn that subagent type (or read the agent .md).",
        "3. Do not dump the hub. Do not invent skill/agent bodies from memory.",
        "",
        f"Hub: `{SOURCE_DIR}`  |  Projected skills this turn: {projected}  "
        f"|  Score floor: {min_score:.2f}",
        "",
        "| rank | name | kind | score | path |",
        "|-----:|------|------|------:|------|",
    ]
    skill_n = agent_n = 0
    for i, r in enumerate(routes, 1):
        kind = str(r.get("kind") or "unknown")
        if kind == "skill":
            skill_n += 1
        elif kind == "agent":
            agent_n += 1
        path = r.get("path")
        # The path carries the hub dir name, which is NOT slugified for
        # first-party / hand-made hub entries — a backtick/pipe/newline in
        # it would break the row just like a hostile route name. Sanitize
        # with a wider cap: a truncated path is one the agent cannot read.
        path_s = f"`{_table_cell(str(path), cap=240)}`" if path else "_(unresolved)_"
        lines.append(
            f"| {i} | `{_table_cell(str(r.get('name') or ''))}` | {kind} | {r.get('score_f', 0.0):.3f} | {path_s} |"
        )
    lines += [
        "",
        f"Resolved: {skill_n} skill(s), {agent_n} agent(s).",
        "",
        "### Tool discipline (token save)",
        "- Skills/agents: the routes above only; load one body.",
        "- MCP: search for a tool, then call it — do not list every MCP tool.",
        "- Re-rank only if these are wrong: call `mind_nerve_route` with a sharper query.",
        "- Built-in tools (read, grep, shell, ...) are always available.",
        "",
    ]
    return "\n".join(lines)


def emit(event_name: str, context: str | None) -> None:
    """Emit the Claude-compatible hook reply that all six CLIs understand."""
    if not context:
        print("{}")
        return
    hook_event = (
        "UserPromptSubmit"
        if event_name.lower() in PROMPT_EVENTS
        else (event_name or "UserPromptSubmit")
    )
    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": hook_event,
                    "additionalContext": context,
                }
            }
        )
    )


