    wp_tables_free(t);
}

#[test]
fn test_wp_overlong_word_is_unk() {
    // 101 x 'z' — over the 100-codepoint WordPiece cap: one [UNK] word.
    let t: i64 = wp_tables_init();
    let buf: i64 = __mind_alloc(101);
    let mut i: i64 = 0;
    while i < 101 {
        __mind_store_i8(buf + i, 122);
        i = i + 1;
    }
    let exp: i64 = __mind_alloc(3 * 8);
    __mind_store_i64(exp + 0, 101);
    __mind_store_i64(exp + 8, 100);
    __mind_store_i64(exp + 16, 102);
    let rc: i64 = wt_run(t, buf, 101, exp, 3);
    assert rc == 0, "overlong word -> [CLS] [UNK] [SEP]";
    __mind_free(exp);
    __mind_free(buf);
    wp_tables_free(t);
}
