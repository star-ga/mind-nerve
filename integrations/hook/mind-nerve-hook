def _router_body_candidates() -> list[Path]:
    return [
        Path(__file__).resolve().parent / "assets" / "mind-nerve-router.SKILL.md",
        PROJECTED_DIR / ROUTER_NAME / "SKILL.md",
        SOURCE_DIR / ROUTER_NAME / "SKILL.md",
    ]


ROUTER_FALLBACK = (
    "---\n"
    "name: mind-nerve-router\n"
    "description: Route intents to hub skills via mind-nerve; Read the winning SKILL.md.\n"
    "---\n\n"
    "# mind-nerve-router\n\n"
    "Follow the injected auto-route context. Read the highest-ranked SKILL.md path\n"
    "and follow it. Do not list or dump the hub.\n"
)


def generation_key(selected: list[tuple[str, Path]]) -> str:
    """Stable hash of the projected route SET (names + resolved targets).

    Order-sensitive on purpose: the projection's rank order is part of what the
    model sees. Same set in the same order -> same key -> zero work.
    """
    h = hashlib.sha256()
    for name, src in selected:
        h.update(name.encode("utf-8", "replace"))
        h.update(b"\0")
        h.update(str(src).encode("utf-8", "replace"))
        h.update(b"\n")
    return h.hexdigest()[:16]


def _gen_root() -> Path:
    return PROJECTED_DIR.parent / ".mind-nerve-gen"


def _populate_generation(gen_dir: Path, selected: list[tuple[str, Path]]) -> None:
    """Fill a fresh generation dir. Caller guarantees it does not exist."""
    gen_dir.mkdir(parents=True)

    # Router skill body is always present — the projection is replaced every
    # turn, so it cannot be left to survive on its own.
    rdir = gen_dir / ROUTER_NAME
    rdir.mkdir(exist_ok=True)
    copied = False
    for rc in _router_body_candidates():
        try:
            if rc.is_file():
                shutil.copy2(rc, rdir / "SKILL.md")
                copied = True
                break
        except Exception:
            continue
    if not copied:
        (rdir / "SKILL.md").write_text(ROUTER_FALLBACK)

    # Collision-safe by construction: the destination name is claimed once.
    # Two hub entries can slug-collide (and `.system/` used to shadow four real
    # skills outright); first writer wins and the loser is skipped rather than
    # silently overwriting the winner's link.
    claimed: set[str] = {ROUTER_NAME}
    for name, src in selected:
        if name in claimed:
            continue
        dest = gen_dir / name
        if dest.exists() or dest.is_symlink():
            continue
        try:
            dest.symlink_to(src)
            claimed.add(name)
        except Exception:
            pass

    (gen_dir / "README.md").write_text(
        "# mind-nerve projected skills\n\n"
        "Auto-projected top-K hub skills for the current prompt. The full hub is at\n"
        f"`{SOURCE_DIR}` and is deliberately NOT announced.\n\n"
        "Do not list the hub. Read only the SKILL.md paths in the injected route table.\n"
    )


def _gc_generations(keep: str) -> None:
    """Retain the newest few generations; drop the rest.

    Only ever removes directories under our own `.mind-nerve-gen` root, and
    only ones whose name is a 16-hex generation key — never a user directory.
    """
    root = _gen_root()
    try:
        entries = [
            d
            for d in root.iterdir()
            if d.is_dir()
            and not d.is_symlink()
            and re.fullmatch(r"[0-9a-f]{16}", d.name)
            and d.name != keep
        ]
    except Exception:
        return
    entries.sort(key=lambda d: d.stat().st_mtime, reverse=True)
    for stale in entries[KEEP_GENERATIONS - 1 :]:
        shutil.rmtree(stale, ignore_errors=True)


def write_projection(selected: list[tuple[str, Path]]) -> int:
    """Publish *selected* as the CLI's skills dir. Returns entry count, or -1.

    symlink mode (default): build `.mind-nerve-gen/<key>/`, then flip
    PROJECTED_DIR to point at it with an atomic rename over a temp symlink.
    Interruption at any point leaves either the previous generation or the new
    one — never a half-populated skills dir. An unchanged route set resolves to
    the same key and costs one readlink: zero writes, no churn.

    dir mode: the previous behaviour (build a sibling temp dir, two renames)
    for any CLI that cannot follow a symlinked skills directory.
    """
    if str(PROJECTED_DIR) in ("", "."):
        return -1
    if PROJECT_MODE == "dir":
        return _write_projection_dir(selected)

    key = generation_key(selected)
    gen_root = _gen_root()
    gen_dir = gen_root / key
    try:
        gen_root.mkdir(parents=True, exist_ok=True)

        # Zero-work path: already published and intact.
        if PROJECTED_DIR.is_symlink():
            try:
                if os.readlink(PROJECTED_DIR) == str(gen_dir) and gen_dir.is_dir():
                    return sum(
                        1 for c in gen_dir.iterdir() if c.is_dir() or c.is_symlink()
                    )
            except OSError:
                pass

        if not gen_dir.is_dir():
            staging = gen_root / f".build.{secrets.token_hex(4)}"
            _populate_generation(staging, selected)
            try:
                os.rename(staging, gen_dir)
            except OSError:
                # Another hook process published this key first — same content
                # by construction (the key IS the content); drop our copy.
                shutil.rmtree(staging, ignore_errors=True)

        # A real directory sitting where the symlink belongs is the pre-upgrade
        # layout (or a CLI that recreated it). NEVER rm -rf it: rename it aside
        # so the previous state is always recoverable.
        if PROJECTED_DIR.is_dir() and not PROJECTED_DIR.is_symlink():
            backup = PROJECTED_DIR.parent / (
                f".{PROJECTED_DIR.name}.pre-mind-nerve."
                f"{time.strftime('%Y%m%d-%H%M%S')}.{secrets.token_hex(2)}"
            )
            os.rename(PROJECTED_DIR, backup)
            log({"event": "projection_dir_backed_up", "backup": str(backup)})

        tmp_link = PROJECTED_DIR.parent / f".mind-nerve-link.{secrets.token_hex(4)}"
        os.symlink(gen_dir, tmp_link)
        os.rename(tmp_link, PROJECTED_DIR)  # atomic publish

        _gc_generations(key)
        return sum(1 for c in gen_dir.iterdir() if c.is_dir() or c.is_symlink())
    except Exception as e:
        log({"event": "projection_fail", "err": str(e), "mode": "symlink"})
        return -1


def _write_projection_dir(selected: list[tuple[str, Path]]) -> int:
    """Real-directory projection (MIND_NERVE_PROJECT_MODE=dir)."""
    parent = PROJECTED_DIR.parent
    tmp = parent / f".mind-nerve-skills.tmp.{secrets.token_hex(4)}"
    old = parent / f".mind-nerve-skills.old.{secrets.token_hex(4)}"
    try:
        parent.mkdir(parents=True, exist_ok=True)
        _populate_generation(tmp, selected)

        existed = PROJECTED_DIR.exists() or PROJECTED_DIR.is_symlink()
        if existed:
            os.rename(PROJECTED_DIR, old)
        os.rename(tmp, PROJECTED_DIR)

        if existed:
            if old.is_symlink():
                old.unlink()
            else:
                shutil.rmtree(old, ignore_errors=True)

        return sum(
            1 for c in PROJECTED_DIR.iterdir() if c.is_dir() or c.is_symlink()
        )
    except Exception as e:
        log({"event": "projection_fail", "err": str(e), "mode": "dir"})
        shutil.rmtree(tmp, ignore_errors=True)
        return -1


def select_for_projection(
    routes: list[dict], source: dict[str, Path]
) -> list[tuple[str, Path]]:
    """Core skills first, then the above-threshold skill routes in rank order."""
    selected: list[tuple[str, Path]] = []
    seen: set[str] = set()
    for name in CORE_ALWAYS_ON:
        m = resolve_name(name, source)
        if m and m not in seen:
            seen.add(m)
            selected.append((m, source[m]))
    for r in routes:
        if r.get("kind") != "skill":
            continue
        m = resolve_name(str(r["name"]), source)
        if m and m not in seen:
            seen.add(m)
            selected.append((m, source[m]))
    return selected


