// Session-scoped attestation envelope chain log. Ported to the mindc
// 0.10.2 dialect 2026-08-12 (wave 2 of the pure-MIND migration; the
// dormant pre-port source is preserved at src/dormant/chain_log.mind).
//
// Audit anchor: Phase 1.3 — closes the "chain-of-one" gap where
// `chain_prev` was hard-wired to zeros. With a ChainLog threaded through
// preselect, every envelope's `chain_prev` is the *previous* envelope's
// chain_curr, and evidence::verify_chain can walk the full sequence.
//
// DISCIPLINE (unchanged from dormant)
//
// - The first envelope minted in a session has chain_prev = zeros32.
// - Every subsequent envelope's chain_prev equals SHA-256 of the previous
//   envelope's serialized form (= the previous envelope's chain_curr).
// - There is no "reset" inside a session. A reset is a new session (a new
//   ChainLog handle).
// - session_id is pinned for the life of the ChainLog. It is NOT
//   serialized into the envelope (the v2 wire layout has no slot for it) —
//   host-local diagnostic only.
//
// PORT NOTES (0.10.2 reality):
//   - The ChainLog struct becomes a 56-byte heap buffer handle:
//       [0..32)   last_chain_curr  (SHA-256 of the most recent envelope;
//                                   zeros before the first append)
//       [32..40)  envelopes_emitted (u64, i64 lane)
//       [40..56)  session_id        (16 bytes)
//     Matching the handle discipline of src/sha256.mind / src/top_k.mind —
//     structs do not cross this ABI.
//   - `#[cfg(has_getrandom)]` BRANCH DECISION (operator-settled, 2026-08-12):
//     neither dormant branch is portable to 0.10.2 — the bundled std has no
//     random module and the pure-MIND surface never reads clocks or entropy
//     by itself (determinism contract). The port therefore takes entropy as
//     an explicit caller-supplied seed: `chain_log_new_session(seed)` sets
//     session_id = SHA-256(seed)[0..16]. Wiring OS entropy / clock fallback
//     to that seed is the wave-3 runtime_ffi/clock layer's job — a host
//     concern, not a chain-log concern. The BitIdentical test-fixture
//     constructor (`chain_log_new_with_id`) is the primary path here.
//   - `append` hashes the envelope with the one-shot mn_sha256 (the dormant
//     streaming note referred to the dormant sha256's internal API; the
//     ported sha256 is one-shot over materialised bytes — the 212-byte
//     envelope is always materialised). No allocation on the hot path
//     beyond the caller-managed log handle itself: append reuses the
//     caller's out buffer.
//   - env_len is a parameter (ATTESTATION_BYTES = 212 in production) so the
//     log never parses the envelope; the chain_prev/chain_curr discipline
//     is the caller's, exactly as in the dormant source.

import src.lib;
import src.sha256;

// Byte offsets inside the ChainLog handle.
pub const CHAIN_LOG_BYTES: i64 = 56;
const CL_OFF_LAST:  i64 = 0;
const CL_OFF_COUNT: i64 = 32;
const CL_OFF_SESSID: i64 = 40;

// ─────────────────────────────────────────────────────────────────────────────
// Constructors
// ─────────────────────────────────────────────────────────────────────────────

// Test-fixture / BitIdentical entry point: caller pins the 16-byte
// session_id at `id_addr`. Every downstream chain_prev value is then
// bit-identical across runs.
pub fn chain_log_new_with_id(id_addr: i64) -> i64 {
    let log: i64 = __mind_alloc(CHAIN_LOG_BYTES);
    let mut i: i64 = 0;
    while i < 32 {
        __mind_store_i8(log + CL_OFF_LAST + i, 0);
        i = i + 1;
    }
    __mind_store_i64(log + CL_OFF_COUNT, 0);
    i = 0;
    while i < 16 {
        __mind_store_i8(log + CL_OFF_SESSID + i, __mind_load_i8(id_addr + i));
        i = i + 1;
    }
    log
}

// Production entry point: derives session_id = SHA-256(seed)[0..16] from
// caller-supplied entropy. NotBitIdentical iff the seed is — the pure-MIND
// surface takes no position on where the seed comes from (see PORT NOTES).
pub fn chain_log_new_session(seed_addr: i64, seed_len: i64) -> i64 {
    let digest: i64 = __mind_alloc(32);
    mn_sha256(seed_addr, seed_len, digest);
    let log: i64 = chain_log_new_with_id(digest);
    __mind_free(digest);
    log
}

// ─────────────────────────────────────────────────────────────────────────────
// Hot-path API
// ─────────────────────────────────────────────────────────────────────────────

// The value the NEXT envelope's chain_prev MUST equal, copied to
// `out_addr` (32 bytes). Zeros before the first append.
pub fn chain_prev_for_next(log: i64, out_addr: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 32 {
        __mind_store_i8(out_addr + i, __mind_load_i8(log + CL_OFF_LAST + i));
        i = i + 1;
    }
    0
}

// Append an envelope: chain_curr = SHA-256(envelope bytes) is stored into
// the log, copied to `out_addr` (32 bytes), and the counter increments by
// exactly 1. session_id is unchanged. Returns 0.
//
// Caller discipline (unchanged from dormant): invoke chain_prev_for_next
// BEFORE evidence::emit_inference, pass it as chain_prev; invoke
// chain_log_append AFTER the envelope is serialized. Reversing the order
// produces a chain-broken sequence.
pub fn chain_log_append(log: i64, env_addr: i64, env_len: i64, out_addr: i64) -> i64 {
    mn_sha256(env_addr, env_len, log + CL_OFF_LAST);
    __mind_store_i64(log + CL_OFF_COUNT, __mind_load_i64(log + CL_OFF_COUNT) + 1);
    chain_prev_for_next(log, out_addr)
}

// Number of envelopes appended in this session. Never decreases.
pub fn chain_log_count(log: i64) -> i64 {
    __mind_load_i64(log + CL_OFF_COUNT)
}

// Diagnostic accessor: copy the 16-byte session id to `out_addr`.
pub fn chain_log_session_id(log: i64, out_addr: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 16 {
        __mind_store_i8(out_addr + i, __mind_load_i8(log + CL_OFF_SESSID + i));
        i = i + 1;
    }
    0
}

// Release the log handle.
pub fn chain_log_free(log: i64) -> i64 {
    __mind_free(log);
    0
}
