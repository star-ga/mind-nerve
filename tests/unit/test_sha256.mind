// tests/unit/test_sha256.mind — FIPS 180-4 KAT suite for src/sha256.mind.
//
// Ported to mindc 0.10.2 (wave 1, 2026-08-10) from
// tests/unit/dormant/test_sha256.mind. Every expected digest below was
// computed with CPython hashlib (the reference implementation) — see the
// per-test comment. The suite runs through `mindc test` on a merged image
// (src/sha256.mind + this file), driven by tests/mindc_gate.sh leg 3
// with an exact-count assertion — a "running 0 tests" output FAILS the
// gate.
//
// Coverage vs the dormant 24: the five RFC 6234 vectors, the six padding
// boundaries (55/56/64/65/127/128), determinism, the 100-input folding
// hash, the 172-byte attestation-envelope fixture, field sensitivity, and
// the output-length constant are all preserved. The 8 streaming-API tests
// (init/update/final chunking) are DROPPED because the streaming API
// itself is deferred (see src/sha256.mind header); they return with the
// streaming wrapper, with chunking-equivalence KATs.
//
// Byte transport in these tests is the raw i64 handle ABI: buffers are
// __mind_alloc'ed, bytes written with __mind_store_i8, digest bytes read
// with __mind_load_i8 & 255 (loads sign-extend). Words are assembled
// big-endian as i64.

// ── helpers ─────────────────────────────────────────────────────────────────

// Deterministic fill: byte[i] = (i*7 + 3) & 255. The Python oracle uses
// the identical formula.
fn fill_pattern(buf: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(buf + i, (i * 7 + 3) & 255);
        i = i + 1;
    }
    0
}

// Assemble digest word w (0..7) big-endian as i64.
fn digest_word(out: i64, w: i64) -> i64 {
    let b0: i64 = __mind_load_i8(out + w * 4) & 255;
    let b1: i64 = __mind_load_i8(out + w * 4 + 1) & 255;
    let b2: i64 = __mind_load_i8(out + w * 4 + 2) & 255;
    let b3: i64 = __mind_load_i8(out + w * 4 + 3) & 255;
    b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
}

// Returns 0 when all 8 words match, else (word index + 1) of the first
// mismatch — a failing return value doubles as the failure locator.
fn check_digest(out: i64, w0: i64, w1: i64, w2: i64, w3: i64, w4: i64, w5: i64, w6: i64, w7: i64) -> i64 {
    if digest_word(out, 0) != w0 { return 1; }
    if digest_word(out, 1) != w1 { return 2; }
    if digest_word(out, 2) != w2 { return 3; }
    if digest_word(out, 3) != w3 { return 4; }
    if digest_word(out, 4) != w4 { return 5; }
    if digest_word(out, 5) != w5 { return 6; }
    if digest_word(out, 6) != w6 { return 7; }
    if digest_word(out, 7) != w7 { return 8; }
    0
}

// Hash pattern(n) and check against the given oracle words. Returns
// 100 + check_digest result on mismatch so the failing length is visible.
fn kat_pattern(n: i64, w0: i64, w1: i64, w2: i64, w3: i64, w4: i64, w5: i64, w6: i64, w7: i64) -> i64 {
    let data: i64 = __mind_alloc(n);
    fill_pattern(data, n);
    let out: i64 = __mind_alloc(32);
    mn_sha256(data, n, out);
    let rc: i64 = check_digest(out, w0, w1, w2, w3, w4, w5, w6, w7);
    __mind_free(data);
    __mind_free(out);
    rc
}

// ── RFC 6234 known-answer vectors ───────────────────────────────────────────

#[test]
fn test_kat_empty() {
    // hashlib.sha256(b"")
    let out: i64 = __mind_alloc(32);
    mn_sha256(0, 0, out);
    let rc: i64 = check_digest(out, 3820012610, 2566659092, 2600203464, 2574235940, 665731556, 1687917388, 2761267483, 2018687061);
    __mind_free(out);
    assert rc == 0, "sha256(empty) mismatch at word (rc-1)";
}

#[test]
fn test_kat_abc() {
    // hashlib.sha256(b"abc")
    let data: i64 = __mind_alloc(3);
    __mind_store_i8(data + 0, 97);
    __mind_store_i8(data + 1, 98);
    __mind_store_i8(data + 2, 99);
    let out: i64 = __mind_alloc(32);
    mn_sha256(data, 3, out);
    let rc: i64 = check_digest(out, 3128432319, 2399260650, 1094795486, 1571693091, 2953011619, 2518121116, 3021012833, 4060091821);
    __mind_free(data);
    __mind_free(out);
    assert rc == 0, "sha256(abc) mismatch at word (rc-1)";
}

