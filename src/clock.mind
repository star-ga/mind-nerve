// Monotonic clock provider for evidence-chain timestamping. Ported to the
// mindc 0.10.2 dialect 2026-08-12 (wave 3 of the pure-MIND migration; the
// dormant pre-port source is preserved at src/dormant/clock.mind).
//
// Audit anchor: Phase 1.3 — eliminates the `timestamp_ms = 0` placeholder
// in evidence::emit_inference and unblocks the chain-prev integrity gate
// (FP-9 in the threat model).
//
// CONTRACT (unchanged from dormant)
//
// A monotonically non-decreasing i64 millisecond timestamp. NOT wall-clock;
// MUST NOT be derived from operator-settable clock state. Replays compare
// timestamps for monotonicity only. The clock value lives in the envelope
// WRAPPER: it contributes to chain_curr via the envelope preimage, so two
// replays at different moments produce different envelopes — intended.
// Bit-identity of result_hash (the route_id ordering) is preserved
// regardless.
//
// PORT NOTES (0.10.2 reality) — the cfg/statics removal decisions:
//
//   - `#[cfg(has_runtime_clock)]` BRANCH DECISION: 0.10.2 has no cfg
//     surface, so the probe order is replaced by EXPLICIT clock selection.
//     The caller picks its time source once at session init:
//       * host monotonic clock  -> clock_host_now_ms()   (extern; not
//         executed under `mindc test`; NotBitIdentical by construction)
//       * per-session counter   -> clock_counter_* handle API (pure;
//         BitIdentical given the call sequence; the test/fixture path)
//     No hidden fallback: a caller that wants host time calls the host
//     path, a caller without a clock calls the counter path, and the
//     choice is visible in the call graph instead of a compile-time switch.
//   - `static COUNTER: ThreadLocal<i64>` REPLACEMENT: 0.10.2 has no
//     thread-local statics. The counter becomes an explicit 8-byte state
//     handle allocated by the caller (one per session/process, threaded
//     like the ChainLog handle). This is strictly stronger than the
//     dormant design for auditability: two sessions never share counter
//     state, and the monotonicity invariant is per-handle by construction.
//     Concurrency is the host's concern (one handle per inference thread,
//     or host-side serialisation), documented here instead of hidden in a
//     runtime cell primitive that never shipped.
//   - ns → ms conversion is a pure function (clock_ms_from_ns), unit-gated
//     on boundary values.

import src.runtime_ffi;

// ─────────────────────────────────────────────────────────────────────────────
// Host monotonic clock (extern path — NotBitIdentical, not unit-executed)
// ─────────────────────────────────────────────────────────────────────────────

// ns → ms. Pure; the only arithmetic the host path performs in-MIND.
// i64 ms saturates at ≈292 million years — unreachable in practice.
pub fn clock_ms_from_ns(ns: i64) -> i64 {
    return ns / 1000000;
}

// Read the host's monotonic millisecond clock: runtime_ffi's steady-ns
// primitive divided to ms. Intentionally NOT bit-identical across runs —
// each call returns a fresh, advancing value. Determinism of result_hash
// is preserved because the timestamp goes into the envelope wrapper, never
// the score computation. Not executed under `mindc test` (no host shim in
// the test interpreter); exercised by the host integration harness.
pub fn clock_host_now_ms() -> i64 {
    return clock_ms_from_ns(rt_monotonic_ns());
}

// Test-fixture entry point (unchanged semantics from dormant): pins the
// clock value so envelopes produced by cross-arch replays compare
// byte-for-byte. Production paths MUST NOT use this.
pub fn clock_now_ms_with_injection(inject_ms: i64) -> i64 {
    return inject_ms;
}

// ─────────────────────────────────────────────────────────────────────────────
// Counter fallback (explicit state handle — pure, BitIdentical by sequence)
// ─────────────────────────────────────────────────────────────────────────────
//
// State layout: 8-byte buffer holding the post-increment count of the last
// call (0 at construction). clock_counter_next returns previous + 1, so the
// first call yields 1 and values are strictly increasing per handle.

pub fn clock_counter_new() -> i64 {
    let state: i64 = __mind_alloc(8);
    __mind_store_i64(state, 0);
    state
}

pub fn clock_counter_next(state: i64) -> i64 {
    let next: i64 = __mind_load_i64(state) + 1;
    __mind_store_i64(state, next);
    next
}

pub fn clock_counter_free(state: i64) -> i64 {
    __mind_free(state);
    0
}
