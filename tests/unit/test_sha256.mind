    __mind_store_i8(data + 9, 100);
    __mind_store_i8(data + 10, 101);
    __mind_store_i8(data + 11, 102);
    __mind_store_i8(data + 12, 100);
    __mind_store_i8(data + 13, 101);
    __mind_store_i8(data + 14, 102);
    __mind_store_i8(data + 15, 103);
    __mind_store_i8(data + 16, 101);
    __mind_store_i8(data + 17, 102);
    __mind_store_i8(data + 18, 103);
    __mind_store_i8(data + 19, 104);
    __mind_store_i8(data + 20, 102);
    __mind_store_i8(data + 21, 103);
    __mind_store_i8(data + 22, 104);
    __mind_store_i8(data + 23, 105);
    __mind_store_i8(data + 24, 103);
    __mind_store_i8(data + 25, 104);
    __mind_store_i8(data + 26, 105);
    __mind_store_i8(data + 27, 106);
    __mind_store_i8(data + 28, 104);
    __mind_store_i8(data + 29, 105);
    __mind_store_i8(data + 30, 106);
    __mind_store_i8(data + 31, 107);
    __mind_store_i8(data + 32, 105);
    __mind_store_i8(data + 33, 106);
    __mind_store_i8(data + 34, 107);
    __mind_store_i8(data + 35, 108);
    __mind_store_i8(data + 36, 106);
    __mind_store_i8(data + 37, 107);
    __mind_store_i8(data + 38, 108);
    __mind_store_i8(data + 39, 109);
    __mind_store_i8(data + 40, 107);
