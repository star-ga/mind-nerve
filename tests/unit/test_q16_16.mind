    assert tq_load(y, 1) == 0, "const [1]";
    assert tq_load(y, 2) == 0, "const [2]";
    assert tq_load(y, 3) == 0, "const [3]";
    __mind_free(x);
    __mind_free(y);
    rsqrt_q16_free(h);
}

#[test]
fn test_q16_layernorm_constant_negative() {
    let h: i64 = rsqrt_q16_init();
