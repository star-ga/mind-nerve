// tests/unit/test_inference.mind — end-to-end preselect suite for
// src/inference.mind (wave 4, 2026-08-12).
//
// Ported from tests/unit/dormant/test_inference.mind over the handle ABI.
// Runs through `mindc test` on a COMPLETE merged image (pinned luts +
// src/lib + src/q16_16 + src/encoder_kernels + src/model + src/runtime_ffi
// + src/sha256 + src/top_k + src/tokenizer + src/evidence + src/chain_log
// + src/loader + src/inference + this file), driven by tests/mindc_gate.sh
// leg 15 with an exact-count assertion — a "running 0 tests" output FAILS
// the gate.
//
// ORACLE PROVENANCE (CPython hashlib, computed 2026-08-12). Fixture: zero
// weights, 3-route catalog with ids SHA-256("a"/"b"/"c"), zero embeddings,
// zero prior, catalog-hash fixture 0x03*32, model 0x01*32 / tokenizer
// 0x02*32 fixtures, k=2, ts=1000, arch=x86_64, wire=2:
//   tokens [5,6,7]:
//     request_hash  2e4c4603cb0dea8636f8e802bfa0f24caef5f9943377f91d89fd6fbd9577cd1c
//     result_hash   e304894fab101e73f57e6274db924135597d74bdc35bb2f8300443812727587c
//     chain_curr    fe6bade0e1f13c81fe6bb93689b624505f5d83bab80b189ceae9ba61d412e4b1
//   bytes "AB" (tokens [65,66]):
//     request_hash  e3d6ccee318fc8372e4396daa62213a829aadec40d289a56478b159979b46ffe
//     chain_curr    1cb2be0e9c484551d2762565bcbea0b2cc3dd0b5ebdd5a8a43566be1ca1a18fc
// All-tied zero logits make the SHA-256 route-id tie-break the sole
// discriminator: sha order c < b < a, so k=2 selects [c, b].
//
// ASSERT-EAGERNESS (r9 hazard): all results let-bound before asserts.

// ── helpers (in_ prefix) ────────────────────────────────────────────────────

fn in_zero(dst: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i64(dst + i * 8, 0);
        i = i + 1;
    }
    0
}

fn in_fill8(dst: i64, n: i64, c: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(dst + i, c);
        i = i + 1;
    }
    0
}

fn in_word(out: i64, w: i64) -> i64 {
    let b0: i64 = __mind_load_i8(out + w * 4) & 255;
    let b1: i64 = __mind_load_i8(out + w * 4 + 1) & 255;
    let b2: i64 = __mind_load_i8(out + w * 4 + 2) & 255;
    let b3: i64 = __mind_load_i8(out + w * 4 + 3) & 255;
    b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
}

fn in_check8(out: i64, w0: i64, w1: i64, w2: i64, w3: i64, w4: i64, w5: i64, w6: i64, w7: i64) -> i64 {
    if in_word(out, 0) != w0 { return 1; }
    if in_word(out, 1) != w1 { return 2; }
    if in_word(out, 2) != w2 { return 3; }
    if in_word(out, 3) != w3 { return 4; }
    if in_word(out, 4) != w4 { return 5; }
    if in_word(out, 5) != w5 { return 6; }
    if in_word(out, 6) != w6 { return 7; }
    if in_word(out, 7) != w7 { return 8; }
    0
}

// The 3-route fixture catalog handle: ids = sha256("a"/"b"/"c"), zero
// embeddings + prior, hash fixture 0x03*32.
fn in_catalog() -> i64 {
    let cat: i64 = __mind_alloc(5 * 8);
    __mind_store_i64(cat + LOADER_CAT_N * 8, 3);
    let ids: i64 = __mind_alloc(96);
    let one: i64 = __mind_alloc(1);
    __mind_store_i8(one, 97);
    mn_sha256(one, 1, ids);
    __mind_store_i8(one, 98);
    mn_sha256(one, 1, ids + 32);
    __mind_store_i8(one, 99);
    mn_sha256(one, 1, ids + 64);
    __mind_free(one);
    __mind_store_i64(cat + LOADER_CAT_IDS * 8, ids);
    let emb: i64 = __mind_alloc(3 * 256 * 8);
    in_zero(emb, 3 * 256);
    __mind_store_i64(cat + LOADER_CAT_EMB * 8, emb);
    let prior: i64 = __mind_alloc(3 * 8);
    in_zero(prior, 3);
    __mind_store_i64(cat + LOADER_CAT_PRIOR * 8, prior);
    let hash: i64 = __mind_alloc(32);
    in_fill8(hash, 32, 3);
    __mind_store_i64(cat + LOADER_CAT_HASH * 8, hash);
    cat
}

// An all-zero 18-slot weight table with an 8-row embedding stand-in and an
// all-alive head mask; mh = 0x01*32, th = 0x02*32. Matrix slots are full
// [H, H] buffers — under-sized stand-ins pass the interpreter (OOB reads
// return 0 there) but segfault native execution; found 2026-08-15 via the
// run-harness bisect.
fn in_weights(mh: i64, th: i64) -> i64 {
    let wtab: i64 = __mind_alloc(18 * 8);
    let emb: i64 = __mind_alloc(8 * 256 * 8);
    in_zero(emb, 8 * 256);
    __mind_store_i64(wtab + 0, emb);
    let mut slot: i64 = 1;
    while slot < 17 {
        let layer_slot: i64 = (slot - 1) % 7;
        let mut buf: i64 = 0;
        if layer_slot < 4 {
            buf = __mind_alloc(256 * 256 * 8);   // wq/wk/wv/wo matrices
            in_zero(buf, 256 * 256);
        } else {
            buf = __mind_alloc(256 * 8);         // ln_gain/ln_bias/gate
            in_zero(buf, 256);
        }
        __mind_store_i64(wtab + slot * 8, buf);
        slot = slot + 1;
    }
    let mask: i64 = __mind_alloc(1);
    __mind_store_i8(mask, 255);
    __mind_store_i64(wtab + 17 * 8, mask);
    in_fill8(mh, 32, 1);
    in_fill8(th, 32, 2);
    wtab
}

fn in_tokens567() -> i64 {
    let t: i64 = __mind_alloc(3 * 8);
    __mind_store_i64(t + 0, 5);
    __mind_store_i64(t + 8, 6);
    __mind_store_i64(t + 16, 7);
    t
}

// ── gates ───────────────────────────────────────────────────────────────────

#[test]
fn test_infer_error_codes_pinned() {
    assert INF_ERR_INVALID_K == -1, "InvalidK";
    assert INF_ERR_TOO_LONG == -2, "RequestTooLong";
    assert INF_ERR_EMPTY_CATALOG == -3, "EmptyCatalog";
    assert INF_ERR_MODEL_MISMATCH == -4, "ModelMismatch";
    assert INF_ERR_ENVELOPE == -5, "EnvelopeBuildFailed";
}

#[test]
fn test_infer_k_gate() {
    let exp_h: i64 = exp_q16_init();
    let rsqrt_h: i64 = rsqrt_q16_init();
    let cat: i64 = in_catalog();
    let mh: i64 = __mind_alloc(32);
    let th: i64 = __mind_alloc(32);
    let wtab: i64 = in_weights(mh, th);
    let log: i64 = chain_log_new_with_id(mh);
    let t: i64 = in_tokens567();
    let oi: i64 = __mind_alloc(64);
    let os: i64 = __mind_alloc(16);
    let oe: i64 = __mind_alloc(212);

    let r0: i64 = infer_preselect_pre_tokenized(t, 3, cat, wtab, mh, th, 0, 1000, mh, 0, log, exp_h, rsqrt_h, oi, os, oe);
    let r65: i64 = infer_preselect_pre_tokenized(t, 3, cat, wtab, mh, th, 65, 1000, mh, 0, log, exp_h, rsqrt_h, oi, os, oe);
    assert r0 == INF_ERR_INVALID_K, "k=0 rejected";
    assert r65 == INF_ERR_INVALID_K, "k=65 rejected";
    let cnt: i64 = chain_log_count(log);
    assert cnt == 0, "no envelope minted on gate failures";
    __mind_free(oe);
    __mind_free(os);
    __mind_free(oi);
    __mind_free(t);
    chain_log_free(log);
    __mind_free(wtab);
    __mind_free(th);
    __mind_free(mh);
    __mind_free(cat);
    __mind_free(rsqrt_h);
    __mind_free(exp_h);
}

