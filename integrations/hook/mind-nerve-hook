def _load_shared_env() -> None:
    """Fill UNSET env vars from the shared env file (~/.mind-nerve/env).

    One place for the pins every CLI config would otherwise repeat
    (MIND_NERVE_RUNTIME_DIR, MIND_NERVE_BACKEND, ...). An explicitly
    exported variable ALWAYS wins — the file only fills what is unset.
    Inlined here (rather than imported from the package) so the hook stays
    a standalone script; keep this parser byte-compatible with
    mind_nerve.shared_env.load_shared_env. Never raises.
    """
    try:
        path = os.environ.get("MIND_NERVE_ENV_FILE") or os.path.join(_HOME, ".mind-nerve", "env")
        with open(path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line or len(line) > 4096:
                    continue
                key, _, value = line.partition("=")
                key = key.strip()
                if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key) and key not in os.environ:
                    os.environ[key] = value.strip()
    except Exception:
        pass


_load_shared_env()


def _default_socket() -> str:
    """XDG runtime socket when the runtime dir exists, else a /tmp fallback."""
    uid = os.getuid()
    xdg = f"/run/user/{uid}/mind-nerve.sock"
    if os.path.isdir(os.path.dirname(xdg)):
        return xdg
    return f"/tmp/mind-nerve-{uid}.sock"


def _env_float(key: str, default: float) -> float:
    try:
        return float(os.environ[key])
    except (KeyError, TypeError, ValueError):
        return default


def _env_int(key: str, default: int) -> int:
    try:
        return int(os.environ[key])
    except (KeyError, TypeError, ValueError):
        return default


def _env_list(key: str, default: str, sep: str) -> list[str]:
    raw = os.environ.get(key, default)
    return [p.strip() for p in raw.split(sep) if p.strip()]


def _env_flag(key: str, default: bool) -> bool:
    raw = os.environ.get(key)
    if raw is None:
        return default
    return raw.strip().lower() not in ("0", "false", "no", "off")


