// tests/unit/test_chain_log.mind — session chain-log suite for
// src/chain_log.mind. Audit: Phase 1.3 chain-of-one closure.
//
// Authored for the 0.10.2 port 2026-08-12 (the dormant tree carried no
// dedicated chain_log suite — its coverage lived inside the dormant
// test_evidence multi-link test; evidence.mind arrives in wave 4). Runs
// through `mindc test` on a merged image (src/lib.mind + src/sha256.mind +
// src/chain_log.mind + this file), driven by tests/mindc_gate.sh leg 8
// with an exact-count assertion — a "running 0 tests" output FAILS the
// gate.
//
// ORACLE PROVENANCE: every digest below is SHA-256 over a fixed fixture,
// computed 2026-08-12 against CPython hashlib:
//   e1 = 212 x 0xAB -> ce6b98c6bfd9eb57e64b0e2f7ff035ce7141563778d23ebc49adf24f1d7422bf
//   e2 = 212 x 0xCD -> 81b252729be4fff911efa2ed82f0333675a4bd700461297d8a4a4812116b8ef6
//   e3 = 212 x 0xEF -> f7fb2d00b643e3b0af64923b98849164a7fe2f94cac242c366aa706e5505ea89
//   session id seed "mind-nerve-test-seed" -> SHA-256[0..16] = 174db38c2ff357bae3a16fbd98c5eb31
//
// NOTE (0.10.2 test-interpreter hazard, repro
// mind-flow/target/repro-0.10.2/r9_test_assert_deferred.mind): `assert`
// conditions are evaluated LAZILY — a condition that reads state mutated
// later in the same test is mis-evaluated. Discipline in this file: any
// assert followed by a mutation of the state it reads (the multi-link
// chain) binds the condition with `let` first, forcing eager evaluation.

fn cl_word(out: i64, w: i64) -> i64 {
    let b0: i64 = __mind_load_i8(out + w * 4) & 255;
    let b1: i64 = __mind_load_i8(out + w * 4 + 1) & 255;
    let b2: i64 = __mind_load_i8(out + w * 4 + 2) & 255;
    let b3: i64 = __mind_load_i8(out + w * 4 + 3) & 255;
    b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
}

fn cl_check8(out: i64, w0: i64, w1: i64, w2: i64, w3: i64, w4: i64, w5: i64, w6: i64, w7: i64) -> i64 {
    if cl_word(out, 0) != w0 { return 1; }
    if cl_word(out, 1) != w1 { return 2; }
    if cl_word(out, 2) != w2 { return 3; }
    if cl_word(out, 3) != w3 { return 4; }
    if cl_word(out, 4) != w4 { return 5; }
    if cl_word(out, 5) != w5 { return 6; }
    if cl_word(out, 6) != w6 { return 7; }
    if cl_word(out, 7) != w7 { return 8; }
    0
}

// Fill `n` bytes at `dst` with byte `c`.
fn cl_fill(dst: i64, n: i64, c: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(dst + i, c);
        i = i + 1;
    }
    0
}

fn cl_all_zero(addr: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        if __mind_load_i8(addr + i) != 0 { return 0; }
        i = i + 1;
    }
    1
}

// The 16-byte fixture session id: 0x10, 0x11, ..., 0x1F.
fn cl_fixture_id(id: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 16 {
        __mind_store_i8(id + i, 16 + i);
        i = i + 1;
    }
    0
}

#[test]
fn test_chain_log_new_with_id_zero_state() {
    let id: i64 = __mind_alloc(16);
    cl_fixture_id(id);
    let log: i64 = chain_log_new_with_id(id);

    let prev: i64 = __mind_alloc(32);
    chain_prev_for_next(log, prev);
    assert cl_all_zero(prev, 32) == 1, "first-envelope chain_prev is zeros32";
    assert chain_log_count(log) == 0, "no envelopes appended yet";

    let sid: i64 = __mind_alloc(16);
    chain_log_session_id(log, sid);
    let mut i: i64 = 0;
    while i < 16 {
        assert __mind_load_i8(sid + i) == 16 + i, "session id round-trips";
        i = i + 1;
    }
    __mind_free(sid);
    __mind_free(prev);
    chain_log_free(log);
    __mind_free(id);
}

#[test]
fn test_chain_log_append_first_envelope() {
    let id: i64 = __mind_alloc(16);
    cl_fixture_id(id);
    let log: i64 = chain_log_new_with_id(id);
    let e1: i64 = __mind_alloc(212);
    cl_fill(e1, 212, 171);

    let out: i64 = __mind_alloc(32);
    chain_log_append(log, e1, 212, out);
    // Oracle ce6b98c6… (hashlib, 2026-08-12).
    assert cl_check8(out, 3463157958, 3218729815, 3863678511, 2146448846, 1900107319, 2027044540, 1236136527, 494150335) == 0, "chain_curr == SHA-256(envelope)";
    assert chain_log_count(log) == 1, "count advanced to 1";

    let prev: i64 = __mind_alloc(32);
    chain_prev_for_next(log, prev);
    assert cl_check8(prev, 3463157958, 3218729815, 3863678511, 2146448846, 1900107319, 2027044540, 1236136527, 494150335) == 0, "next chain_prev == appended chain_curr";
    __mind_free(prev);
    __mind_free(out);
    __mind_free(e1);
    chain_log_free(log);
    __mind_free(id);
}

#[test]
fn test_chain_log_multi_link_chain() {
    // Three envelopes appended in order; after each append the log's
    // chain_prev-for-next is exactly that envelope's SHA-256. This is the
    // walk evidence::verify_chain replays end-to-end.
    let id: i64 = __mind_alloc(16);
    cl_fixture_id(id);
    let log: i64 = chain_log_new_with_id(id);
    let e1: i64 = __mind_alloc(212);
    cl_fill(e1, 212, 171);
    let e2: i64 = __mind_alloc(212);
    cl_fill(e2, 212, 205);
    let e3: i64 = __mind_alloc(212);
    cl_fill(e3, 212, 239);
    let out: i64 = __mind_alloc(32);

    chain_log_append(log, e1, 212, out);
    let rc1: i64 = cl_check8(out, 3463157958, 3218729815, 3863678511, 2146448846, 1900107319, 2027044540, 1236136527, 494150335);
    assert rc1 == 0, "link 1";
    chain_log_append(log, e2, 212, out);
    let rc2: i64 = cl_check8(out, 2175947378, 2615476217, 300917485, 2196779830, 1973730672, 73476477, 2320123922, 292261622);
    assert rc2 == 0, "link 2";
    chain_log_append(log, e3, 212, out);
    let rc3: i64 = cl_check8(out, 4160433408, 3057902512, 2942603835, 2558824804, 2818453396, 3401728707, 1722445934, 1426451081);
    assert rc3 == 0, "link 3";
    assert chain_log_count(log) == 3, "three envelopes appended";
    __mind_free(out);
    __mind_free(e3);
    __mind_free(e2);
    __mind_free(e1);
    chain_log_free(log);
    __mind_free(id);
}

#[test]
fn test_chain_log_session_seed_derivation() {
    // session_id = SHA-256(seed)[0..16]; same seed -> same id (BitIdentical
    // given the seed), different seed -> different id.
    let seed: i64 = __mind_alloc(20);
    // "mind-nerve-test-seed"
    __mind_store_i8(seed + 0, 109);
    __mind_store_i8(seed + 1, 105);
    __mind_store_i8(seed + 2, 110);
    __mind_store_i8(seed + 3, 100);
    __mind_store_i8(seed + 4, 45);
    __mind_store_i8(seed + 5, 110);
    __mind_store_i8(seed + 6, 101);
    __mind_store_i8(seed + 7, 114);
    __mind_store_i8(seed + 8, 118);
    __mind_store_i8(seed + 9, 101);
    __mind_store_i8(seed + 10, 45);
    __mind_store_i8(seed + 11, 116);
    __mind_store_i8(seed + 12, 101);
    __mind_store_i8(seed + 13, 115);
    __mind_store_i8(seed + 14, 116);
    __mind_store_i8(seed + 15, 45);
    __mind_store_i8(seed + 16, 115);
    __mind_store_i8(seed + 17, 101);
    __mind_store_i8(seed + 18, 101);
    __mind_store_i8(seed + 19, 100);

    let log_a: i64 = chain_log_new_session(seed, 20);
    let log_b: i64 = chain_log_new_session(seed, 20);
    let sa: i64 = __mind_alloc(16);
    let sb: i64 = __mind_alloc(16);
    chain_log_session_id(log_a, sa);
    chain_log_session_id(log_b, sb);
    let mut i: i64 = 0;
    while i < 16 {
        assert __mind_load_i8(sa + i) == __mind_load_i8(sb + i), "same seed -> same session id";
        i = i + 1;
    }
    // Oracle 174db38c2ff357bae3a16fbd98c5eb31 (hashlib, 2026-08-12).
    assert cl_word(sa, 0) == 390968204, "session id word 0";
    assert cl_word(sa, 1) == 804476858, "session id word 1";
    assert cl_word(sa, 2) == 3819007933, "session id word 2";
    assert cl_word(sa, 3) == 2563107633, "session id word 3";

    __mind_store_i8(seed + 19, 101);
    let log_c: i64 = chain_log_new_session(seed, 20);
    let sc: i64 = __mind_alloc(16);
    chain_log_session_id(log_c, sc);
    let mut differ: i64 = 0;
    i = 0;
    while i < 16 {
        if __mind_load_i8(sa + i) != __mind_load_i8(sc + i) { differ = 1; }
        i = i + 1;
    }
    assert differ == 1, "different seed -> different session id";
    __mind_free(sc);
    chain_log_free(log_c);
    __mind_free(sb);
    __mind_free(sa);
    chain_log_free(log_b);
    chain_log_free(log_a);
    __mind_free(seed);
}

#[test]
fn test_chain_log_session_id_untouched_by_append() {
    let id: i64 = __mind_alloc(16);
    cl_fixture_id(id);
    let log: i64 = chain_log_new_with_id(id);
    let e1: i64 = __mind_alloc(212);
    cl_fill(e1, 212, 171);
    let out: i64 = __mind_alloc(32);
    chain_log_append(log, e1, 212, out);
    chain_log_append(log, e1, 212, out);

    let sid: i64 = __mind_alloc(16);
    chain_log_session_id(log, sid);
    let mut i: i64 = 0;
    while i < 16 {
        assert __mind_load_i8(sid + i) == 16 + i, "session id unchanged by appends";
        i = i + 1;
    }
    __mind_free(sid);
    __mind_free(out);
    __mind_free(e1);
    chain_log_free(log);
    __mind_free(id);
}
