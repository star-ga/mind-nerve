#[test]
fn test_infer_model_pin_gate() {
    // The pin lives on the full preselect path (dormant structure).
    let exp_h: i64 = exp_q16_init();
    let rsqrt_h: i64 = rsqrt_q16_init();
    let cat: i64 = in_catalog();
    let mh: i64 = __mind_alloc(32);
    let th: i64 = __mind_alloc(32);
    let wtab: i64 = in_weights(mh, th);
    let log: i64 = chain_log_new_with_id(mh);
    let wrong: i64 = __mind_alloc(32);
    in_fill8(wrong, 32, 255);
    let bytes: i64 = __mind_alloc(2);
    __mind_store_i8(bytes, 65);
    __mind_store_i8(bytes + 1, 66);
    let oi: i64 = __mind_alloc(64);
    let os: i64 = __mind_alloc(16);
    let oe: i64 = __mind_alloc(212);

    let rbad: i64 = infer_preselect(bytes, 2, cat, wtab, mh, th, 2, 1000, wrong, 1, log, exp_h, rsqrt_h, oi, os, oe);
    assert rbad == INF_ERR_MODEL_MISMATCH, "wrong expected model hash refused";
    let cnt: i64 = chain_log_count(log);
    assert cnt == 0, "no envelope minted on pin failure";
    __mind_free(oe);
    __mind_free(os);
    __mind_free(oi);
    __mind_free(bytes);
    __mind_free(wrong);
    chain_log_free(log);
    __mind_free(wtab);
    __mind_free(th);
    __mind_free(mh);
    __mind_free(cat);
    __mind_free(rsqrt_h);
    __mind_free(exp_h);
}

// ── end-to-end (zero-weight fixture, hashlib-pinned) ────────────────────────
// ── end-to-end scenarios ──────────────────────────────────────────────────
// Mirrored natively by tests/harness/inference_main.mind (leg 15c): the
// native ELF execution is the stronger evidence; these interpreter cases
// pin the same oracles. Box discipline: bindings hoisted, return values
// captured via direct heap stores, asserts read heap/hoisted state (see
// header note on interpreter hazards).

#[test]
fn test_infer_end_to_end_oracle() {
    let exp_h: i64 = exp_q16_init();
    let rsqrt_h: i64 = rsqrt_q16_init();
    let cat: i64 = in_catalog();
    let mh: i64 = __mind_alloc(32);
    let th: i64 = __mind_alloc(32);
    let wtab: i64 = in_weights(mh, th);
    let zid: i64 = __mind_alloc(16);
    in_fill8(zid, 16, 0);
    let log: i64 = chain_log_new_with_id(zid);
    let t: i64 = in_tokens567();
    let oi: i64 = __mind_alloc(64);
    let os: i64 = __mind_alloc(16);
    let oe: i64 = __mind_alloc(212);
    let oe2: i64 = __mind_alloc(212);
    let zeros: i64 = __mind_alloc(32);
    in_fill8(zeros, 32, 0);
    let cc: i64 = __mind_alloc(32);
    let cc2: i64 = __mind_alloc(32);
    let n_box: i64 = __mind_alloc(8);
    let n2_box: i64 = __mind_alloc(8);
    let vrc_box: i64 = __mind_alloc(8);
    let vrc2_box: i64 = __mind_alloc(8);
    let cnt_box: i64 = __mind_alloc(8);
    let cnt2_box: i64 = __mind_alloc(8);
    let ids: i64 = __mind_load_i64(cat + LOADER_CAT_IDS * 8);
    let d0: i64 = __mind_alloc(8);
    let d1: i64 = __mind_alloc(8);

    __mind_store_i64(n_box, infer_preselect_pre_tokenized(t, 3, cat, wtab, mh, th, 2, 1000, mh, 0, log, exp_h, rsqrt_h, oi, os, oe));
    __mind_store_i64(vrc_box, evidence_verify(oe, 212, zeros, cc));
    __mind_store_i64(cnt_box, chain_log_count(log));
    __mind_store_i64(n2_box, infer_preselect_pre_tokenized(t, 3, cat, wtab, mh, th, 2, 1001, mh, 0, log, exp_h, rsqrt_h, oi, os, oe2));
    __mind_store_i64(vrc2_box, evidence_verify(oe2, 212, cc, cc2));
    __mind_store_i64(cnt2_box, chain_log_count(log));
    let mut i: i64 = 0;
    let mut x0: i64 = 0;
    let mut x1: i64 = 0;
    while i < 32 {
        x0 = x0 | (__mind_load_i8(oi + i) ^ __mind_load_i8(ids + 64 + i));
        x1 = x1 | (__mind_load_i8(oi + 32 + i) ^ __mind_load_i8(ids + 32 + i));
        i = i + 1;
    }
    __mind_store_i64(d0, x0);
    __mind_store_i64(d1, x1);

    assert __mind_load_i64(n_box) == 2, "k=2 returns 2 entries";
    assert __mind_load_i64(d0) == 0, "first is route c (lowest sha)";
    assert __mind_load_i64(d1) == 0, "second is route b";
    assert __mind_load_i64(os) == 0, "score 0 first";
    assert __mind_load_i64(os + 8) == 0, "score 0 second";
    assert __mind_load_i64(vrc_box) == 0, "envelope verifies as chain start";
    assert in_check8(oe + OFFSET_REQUEST_HASH, 776750595, 3406686854, 922281986, 3214996044, 2935355796, 863500573, 2315087805, 2507656476) == 0, "request_hash oracle";
    assert in_check8(oe + OFFSET_RESULT_HASH, 3808725327, 2869960307, 4118700660, 3683795253, 1501394109, 3277566712, 805585793, 656889980) == 0, "result_hash oracle";
    assert in_check8(cc, 4268469728, 3790683265, 4268472630, 2310415440, 1599964090, 3087734940, 3941186145, 3558007985) == 0, "chain_curr oracle (whole-envelope byte equality)";
    assert __mind_load_i64(cnt_box) == 1, "chain log advanced";
    assert __mind_load_i64(n2_box) == 2, "second inference ok";
    assert __mind_load_i64(vrc2_box) == 0, "second envelope chains from the first";
    assert __mind_load_i64(cnt2_box) == 2, "chain log at 2";
}

#[test]
fn test_infer_full_path_bytes_oracle() {
    // bytes "AB" -> tokens [65, 66] through the BPE tokenizer, then the
    // same zero-weight forward path.
    let exp_h: i64 = exp_q16_init();
    let rsqrt_h: i64 = rsqrt_q16_init();
    let cat: i64 = in_catalog();
    let mh: i64 = __mind_alloc(32);
    let th: i64 = __mind_alloc(32);
    let wtab: i64 = in_weights(mh, th);
    let zid: i64 = __mind_alloc(16);
    in_fill8(zid, 16, 0);
    let log: i64 = chain_log_new_with_id(zid);
    let bytes: i64 = __mind_alloc(2);
    __mind_store_i8(bytes, 65);
    __mind_store_i8(bytes + 1, 66);
    let oi: i64 = __mind_alloc(64);
    let os: i64 = __mind_alloc(16);
    let oe: i64 = __mind_alloc(212);
    let zeros: i64 = __mind_alloc(32);
    in_fill8(zeros, 32, 0);
    let cc: i64 = __mind_alloc(32);
    let n_box: i64 = __mind_alloc(8);
    let vrc_box: i64 = __mind_alloc(8);

    __mind_store_i64(n_box, infer_preselect(bytes, 2, cat, wtab, mh, th, 2, 1000, mh, 0, log, exp_h, rsqrt_h, oi, os, oe));
    __mind_store_i64(vrc_box, evidence_verify(oe, 212, zeros, cc));

    assert __mind_load_i64(n_box) == 2, "full path returns 2";
    assert in_check8(oe + OFFSET_REQUEST_HASH, 3822505198, 831506487, 776181466, 2787251112, 699064004, 220764758, 1200297369, 2041868286) == 0, "full-path request_hash oracle (tokens [65,66])";
    assert __mind_load_i64(vrc_box) == 0, "envelope verifies";
    assert in_check8(cc, 481476110, 2621982033, 3530958181, 3166609586, 3426603189, 3957152394, 1129737185, 3390707964) == 0, "full-path chain_curr oracle";
}

#[test]
fn test_infer_stateless_is_chain_of_one() {
    let exp_h: i64 = exp_q16_init();
    let rsqrt_h: i64 = rsqrt_q16_init();
    let cat: i64 = in_catalog();
    let mh: i64 = __mind_alloc(32);
    let th: i64 = __mind_alloc(32);
    let wtab: i64 = in_weights(mh, th);
    let t: i64 = in_tokens567();
    let oi: i64 = __mind_alloc(64);
    let os: i64 = __mind_alloc(16);
    let oe1: i64 = __mind_alloc(212);
    let oe2: i64 = __mind_alloc(212);
    let zeros: i64 = __mind_alloc(32);
    in_fill8(zeros, 32, 0);
    let cc: i64 = __mind_alloc(32);
    let n1_box: i64 = __mind_alloc(8);
    let n2_box: i64 = __mind_alloc(8);
    let v1_box: i64 = __mind_alloc(8);
    let v2_box: i64 = __mind_alloc(8);

    __mind_store_i64(n1_box, infer_preselect_pre_tokenized_stateless(t, 3, cat, wtab, mh, th, 2, 1000, mh, 0, exp_h, rsqrt_h, oi, os, oe1));
    __mind_store_i64(n2_box, infer_preselect_pre_tokenized_stateless(t, 3, cat, wtab, mh, th, 2, 1000, mh, 0, exp_h, rsqrt_h, oi, os, oe2));
    __mind_store_i64(v1_box, evidence_verify(oe1, 212, zeros, cc));
    __mind_store_i64(v2_box, evidence_verify(oe2, 212, zeros, cc));

    assert __mind_load_i64(n1_box) == 2, "first stateless call";
    assert __mind_load_i64(n2_box) == 2, "second stateless call";
    assert __mind_load_i64(v1_box) == 0, "first envelope is a chain start";
    assert __mind_load_i64(v2_box) == 0, "second envelope is ALSO a chain start (chain-of-one)";
}

#[test]
fn test_infer_empty_bytes_maps_to_invalid_k() {
    let exp_h: i64 = exp_q16_init();
    let rsqrt_h: i64 = rsqrt_q16_init();
    let cat: i64 = in_catalog();
    let mh: i64 = __mind_alloc(32);
    let th: i64 = __mind_alloc(32);
    let wtab: i64 = in_weights(mh, th);
    let log: i64 = chain_log_new_with_id(mh);
    let bytes: i64 = __mind_alloc(1);
    let oi: i64 = __mind_alloc(64);
    let os: i64 = __mind_alloc(16);
    let oe: i64 = __mind_alloc(212);

    let rc: i64 = infer_preselect(bytes, 0, cat, wtab, mh, th, 2, 1000, mh, 0, log, exp_h, rsqrt_h, oi, os, oe);
    assert rc == INF_ERR_INVALID_K, "tokenizer InputEmpty maps to InvalidK";
    __mind_free(oe);
    __mind_free(os);
    __mind_free(oi);
    __mind_free(bytes);
    chain_log_free(log);
    __mind_free(wtab);
    __mind_free(th);
    __mind_free(mh);
    __mind_free(cat);
    __mind_free(rsqrt_h);
    __mind_free(exp_h);
}
