// cli/main.mind — mind-nerve single-binary entry (raw-i64 kernel ABI).
//
// PORT-DOWN 2026-08-17: rewritten from the high-level Rust-like dialect
// (growable `[u8]` + `.push`, `&[u8]` slices, `[[u8]]`, tuple `Result`,
// `match`/`enum`) — none of which the shipping mindc lowers — to the raw
// i64 kernel-ABI idiom used throughout mind/ and src/ (fixed buffers, raw
// i64 addresses, explicit lengths, `while`/`if` only). The dormant
// high-level source is preserved at git rev a11484b (cli/main.mind) and in
// src/dormant/ siblings. Behaviour and wire format are unchanged.
//
// CPU-first intent-classification preselector. Reads a preselect request
// from stdin (mic@2 text frame), runs the pre-tokenized stateless forward
// path, writes the top-K result + 212-byte attestation envelope to stdout
// (mic-b binary frame). On error, writes a mic@2 text frame to stderr and
// returns a documented non-zero exit code.
//
// =============================================================================
// WIRE PROTOCOL — stdin (mic@2 text, line-oriented)
//
//     mic@2/mind-nerve/preselect
//     model: <abs path to weights file>
//     catalog: <abs path to skills catalog>
//     k: <decimal, 1..=MAX_TOP_K>
//     tokens: <CSV decimal u32 BPE token ids, len <= MAX_REQUEST_TOKENS>
//     .
//
// Max stdin buffer: MN_MAX_STDIN_BYTES = 64 KiB (inputs above -> ParseError).
//
// WIRE PROTOCOL — stdout (mic-b binary, little-endian, no length prefix)
//
//     0        4        magic "MNB1" (0x4D 0x4E 0x42 0x31)
//     4        2        k (u16-LE, number of routes)
//     6        32*k     k x RouteId (raw 32-byte SHA-256 each)
//     6+32k    4*k      k x score (i32-LE Q16.16 each, low 32 bits of lane)
//     6+36k    212      attestation envelope v2 (from out_envelope)
//     TOTAL    218+36k
//
// WIRE PROTOCOL — stderr (mic@2 text, error frames only)
//
//     mic@2/mind-nerve/error
//     code: <decimal exit code>
//     .
//
// Exit codes (operators rely on these — do not renumber):
//     0 OK · 2 RequestTooLong · 3 InvalidK · 4 EmptyCatalog
//     5 ModelMismatch · 6 ParseError · 7 IoError
// =============================================================================

import src.lib;
import src.inference;
import src.loader;
import src.runtime_ffi;
import src.mcp;
import mind.luts.exp_q16;
import mind.luts.sqrt_q16;

// ---------------------------------------------------------------------------
// Constants
// ---------------------------------------------------------------------------

pub const MN_MAX_STDIN_BYTES: i64 = 65536;

const MN_EXIT_OK:               i64 = 0;
const MN_EXIT_REQUEST_TOO_LONG: i64 = 2;
const MN_EXIT_INVALID_K:        i64 = 3;
const MN_EXIT_EMPTY_CATALOG:    i64 = 4;
const MN_EXIT_MODEL_MISMATCH:   i64 = 5;
const MN_EXIT_PARSE_ERROR:      i64 = 6;
const MN_EXIT_IO_ERROR:         i64 = 7;

// mic@2 request key discriminants (returned by mn_key_id).
const MN_KEY_NONE:    i64 = 0;
const MN_KEY_MODEL:   i64 = 1;
const MN_KEY_CATALOG: i64 = 2;
const MN_KEY_K:       i64 = 3;
const MN_KEY_TOKENS:  i64 = 4;

// ---------------------------------------------------------------------------
// Byte helpers (raw i64 ABI). Every loaded byte is masked to [0,255] so a
// high-bit byte never sign-extends into a comparison.
// ---------------------------------------------------------------------------

fn mn_byte(addr: i64) -> i64 {
    __mind_load_i8(addr) & 255
}

// Byte-range equality: [a, a+len) == [b, b+blen) ?  1 if equal, else 0.
fn mn_range_eq(a: i64, len: i64, b: i64, blen: i64) -> i64 {
    if len != blen { return 0; }
    let mut i: i64 = 0;
    while i < len {
        if mn_byte(a + i) != mn_byte(b + i) { return 0; }
        i = i + 1;
    }
    1
}

// Store a byte, return the next offset (small builder helper).
fn mn_put(buf: i64, off: i64, val: i64) -> i64 {
    __mind_store_i8(buf + off, val & 255);
    off + 1
}

// Write a non-negative decimal into buf at off; return the next offset.
fn mn_put_dec(buf: i64, off: i64, val: i64) -> i64 {
    if val < 0 { return mn_put(buf, off, 45); } // '-' guard; never expected
    if val == 0 { return mn_put(buf, off, 48); }
    // Emit digits into a 20-byte scratch, then copy reversed.
    let scratch: i64 = __mind_alloc(24);
    let mut n: i64 = val;
    let mut d: i64 = 0;
    while n > 0 {
        __mind_store_i8(scratch + d, 48 + (n % 10));
        n = n / 10;
        d = d + 1;
    }
    let mut o: i64 = off;
    let mut j: i64 = d - 1;
    while j >= 0 {
        o = mn_put(buf, o, __mind_load_i8(scratch + j) & 255);
        j = j - 1;
    }
    __mind_free(scratch);
    o
}

// ---------------------------------------------------------------------------
// mic@2 key-name classification. The grammar is closed (exactly four keys),
// each with a distinct byte string; we compare against inline-built literals
// so an unknown key is rejected rather than mis-bound.
// ---------------------------------------------------------------------------

fn mn_key_id(name: i64, nlen: i64) -> i64 {
    // "model"
    let m: i64 = __mind_alloc(5);
    __mind_store_i8(m + 0, 109); __mind_store_i8(m + 1, 111);
    __mind_store_i8(m + 2, 100); __mind_store_i8(m + 3, 101);
    __mind_store_i8(m + 4, 108);
    if mn_range_eq(name, nlen, m, 5) == 1 { __mind_free(m); return MN_KEY_MODEL; }
    __mind_free(m);
    // "catalog"
    let c: i64 = __mind_alloc(7);
    __mind_store_i8(c + 0, 99);  __mind_store_i8(c + 1, 97);
    __mind_store_i8(c + 2, 116); __mind_store_i8(c + 3, 97);
    __mind_store_i8(c + 4, 108); __mind_store_i8(c + 5, 111);
    __mind_store_i8(c + 6, 103);
    if mn_range_eq(name, nlen, c, 7) == 1 { __mind_free(c); return MN_KEY_CATALOG; }
    __mind_free(c);
    // "k"
    if nlen == 1 { if mn_byte(name) == 107 { return MN_KEY_K; } }
    // "tokens"
    let t: i64 = __mind_alloc(6);
    __mind_store_i8(t + 0, 116); __mind_store_i8(t + 1, 111);
    __mind_store_i8(t + 2, 107); __mind_store_i8(t + 3, 101);
    __mind_store_i8(t + 4, 110); __mind_store_i8(t + 5, 115);
    if mn_range_eq(name, nlen, t, 6) == 1 { __mind_free(t); return MN_KEY_TOKENS; }
    __mind_free(t);
    MN_KEY_NONE
}

// Strict decimal parse of [bytes, bytes+len). Returns value >= 0, or -1 on
// empty / non-digit / overflow past u32.
fn mn_parse_u32(bytes: i64, len: i64) -> i64 {
    if len <= 0 { return -1; }
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < len {
        let c: i64 = mn_byte(bytes + i);
        if c < 48 { return -1; }
        if c > 57 { return -1; }
        acc = acc * 10 + (c - 48);
        if acc > 4294967295 { return -1; }
        i = i + 1;
    }
    acc
}

// ---------------------------------------------------------------------------
// main — entry point.
// ---------------------------------------------------------------------------

pub fn main() -> i64 {
    // (1) Read stdin, bounded. Allocate ONE byte past the documented cap and
    //     request cap+1: a request that fills the extra byte proves the input
    //     exceeds MN_MAX_STDIN_BYTES, which must be rejected as RequestTooLong
    //     rather than silently truncated (the >64 KiB wire cap is real, not a
    //     silent clip). Only sbuf[0..MN_MAX_STDIN_BYTES) is ever parsed.
    let sbuf: i64 = __mind_alloc(MN_MAX_STDIN_BYTES + 1);
    let slen: i64 = rt_read_stdin(sbuf, MN_MAX_STDIN_BYTES + 1);
    if slen < 0 {
        return mn_fail(MN_EXIT_IO_ERROR);
    }
    if slen > MN_MAX_STDIN_BYTES {
        return mn_fail(MN_EXIT_REQUEST_TOO_LONG);
    }

    // (1b) Subcommand sniff. A JSON-RPC MCP session opens with '{' (0x7B); a
    //      mic@2 preselect frame opens with 'm' (0x6D). The two wire formats
    //      are unambiguous on the first byte, so mode selection needs no argv
    //      shim (none exists) and leaves the frozen preselect path untouched.
    if slen > 0 {
        if mn_byte(sbuf) == 123 {
            return mcp_run(sbuf, slen);
        }
    }

    // (2) Parse the mic@2 frame. Key values are byte ranges INTO sbuf
    //     (contiguous, no LF), so paths/tokens need no copy.
    // Field state: offset+len into sbuf for model/catalog, plus flags.
    let mut model_off: i64 = 0;  let mut model_len: i64 = 0;  let mut have_model: i64 = 0;
    let mut cat_off:   i64 = 0;  let mut cat_len:   i64 = 0;  let mut have_cat:   i64 = 0;
    let mut k_val:     i64 = 0;  let mut have_k:    i64 = 0;
    let mut tok_off:   i64 = 0;  let mut tok_len:   i64 = 0;  let mut have_tok:   i64 = 0;
    let mut saw_term:  i64 = 0;

    // Header line must be "mic@2/mind-nerve/preselect" (26 bytes).
    let hdr: i64 = __mind_alloc(26);
    __mind_store_i8(hdr + 0, 109);  __mind_store_i8(hdr + 1, 105);
    __mind_store_i8(hdr + 2, 99);   __mind_store_i8(hdr + 3, 64);
    __mind_store_i8(hdr + 4, 50);   __mind_store_i8(hdr + 5, 47);
    __mind_store_i8(hdr + 6, 109);  __mind_store_i8(hdr + 7, 105);
    __mind_store_i8(hdr + 8, 110);  __mind_store_i8(hdr + 9, 100);
    __mind_store_i8(hdr + 10, 45);  __mind_store_i8(hdr + 11, 110);
    __mind_store_i8(hdr + 12, 101); __mind_store_i8(hdr + 13, 114);
    __mind_store_i8(hdr + 14, 118); __mind_store_i8(hdr + 15, 101);
    __mind_store_i8(hdr + 16, 47);  __mind_store_i8(hdr + 17, 112);
    __mind_store_i8(hdr + 18, 114); __mind_store_i8(hdr + 19, 101);
    __mind_store_i8(hdr + 20, 115); __mind_store_i8(hdr + 21, 101);
    __mind_store_i8(hdr + 22, 108); __mind_store_i8(hdr + 23, 101);
    __mind_store_i8(hdr + 24, 99);  __mind_store_i8(hdr + 25, 116);

    // Line-walk state machine. A line is [line_start, i) up to LF (0x0A).
    let mut line_start: i64 = 0;
    let mut i: i64 = 0;
    let mut first_line: i64 = 1;
    let mut parse_err: i64 = 0;

    while i <= slen {
        if i == slen || mn_byte(sbuf + i) == 10 {
            let lstart: i64 = line_start;
            let llen: i64 = i - line_start;
            if first_line == 1 {
                if mn_range_eq(sbuf + lstart, llen, hdr, 26) == 0 {
                    parse_err = 1;
                }
                first_line = 0;
            } else if saw_term == 0 {
                // Terminator "." ?
                if llen == 1 { if mn_byte(sbuf + lstart) == 46 { saw_term = 1; } }
                if saw_term == 0 && llen > 0 {
                    // Split on first ": " (0x3A 0x20).
                    let mut c: i64 = 0;
                    let mut colon: i64 = -1;
                    while c + 1 < llen {
                        if mn_byte(sbuf + lstart + c) == 58 {
                            if mn_byte(sbuf + lstart + c + 1) == 32 { colon = c; c = llen; }
                        }
                        c = c + 1;
                    }
                    if colon < 0 {
                        parse_err = 1;
                    } else {
                        // Absolute addresses into sbuf (sbuf lives for the
                        // whole of main, so stored path/token addresses stay
                        // valid through the loader + inference calls).
                        let name_off: i64 = sbuf + lstart;
                        let name_len: i64 = colon;
                        let val_off:  i64 = sbuf + lstart + colon + 2;
                        let val_len:  i64 = llen - colon - 2;
                        let kid: i64 = mn_key_id(name_off, name_len);
                        if kid == MN_KEY_MODEL {
                            if have_model == 1 { parse_err = 1; }
                            model_off = val_off; model_len = val_len; have_model = 1;
                        } else if kid == MN_KEY_CATALOG {
                            if have_cat == 1 { parse_err = 1; }
                            cat_off = val_off; cat_len = val_len; have_cat = 1;
                        } else if kid == MN_KEY_K {
                            if have_k == 1 { parse_err = 1; }
                            k_val = mn_parse_u32(val_off, val_len);
                            have_k = 1;
                        } else if kid == MN_KEY_TOKENS {
                            if have_tok == 1 { parse_err = 1; }
                            tok_off = val_off; tok_len = val_len; have_tok = 1;
                        } else {
                            parse_err = 1;
                        }
                    }
                }
            }
            line_start = i + 1;
        }
        i = i + 1;
    }
    __mind_free(hdr);

    if parse_err == 1 { return mn_fail(MN_EXIT_PARSE_ERROR); }
    if saw_term == 0 { return mn_fail(MN_EXIT_PARSE_ERROR); }
    if have_model == 0 { return mn_fail(MN_EXIT_PARSE_ERROR); }
    if have_cat == 0 { return mn_fail(MN_EXIT_PARSE_ERROR); }
    if have_k == 0 { return mn_fail(MN_EXIT_PARSE_ERROR); }
    if have_tok == 0 { return mn_fail(MN_EXIT_PARSE_ERROR); }

    // (3) k range gate (0 or > MAX_TOP_K -> InvalidK; parse failure -> Parse).
    if k_val < 0 { return mn_fail(MN_EXIT_PARSE_ERROR); }
    if k_val == 0 { return mn_fail(MN_EXIT_INVALID_K); }
    if k_val > MAX_TOP_K { return mn_fail(MN_EXIT_INVALID_K); }

    // (4) Tokens: count cells, cap at MAX_REQUEST_TOKENS, parse into i64 lanes.
    let tokens: i64 = __mind_alloc(MAX_REQUEST_TOKENS * 8);
    let n_tokens: i64 = mn_parse_tokens(tok_off, tok_len, tokens);
    if n_tokens == -1 { __mind_free(tokens); return mn_fail(MN_EXIT_PARSE_ERROR); }
    if n_tokens == -2 { __mind_free(tokens); return mn_fail(MN_EXIT_REQUEST_TOO_LONG); }

    // (5) Load catalog (5-slot table) and weights (18-slot table + 2 hashes).
    //     model_off / cat_off are absolute addresses into sbuf (see the
    //     parse loop) — the loaders take a raw (addr, len) pair, no copy,
    //     no NUL terminator.
    let cat: i64  = __mind_alloc(LOADER_CAT_SLOTS * 8);
    if loader_load_catalog(cat_off, cat_len, cat) != LD_OK {
        __mind_free(tokens);
        return mn_fail(MN_EXIT_IO_ERROR);
    }
    let wtab: i64 = __mind_alloc(18 * 8);
    let mh:   i64 = __mind_alloc(32);
    let th:   i64 = __mind_alloc(32);
    if loader_load_weights(model_off, model_len, wtab, mh, th) != LD_OK {
        __mind_free(tokens);
        return mn_fail(MN_EXIT_IO_ERROR);
    }

    // (6) Pinned LUT handles (self-contained deterministic tables).
    let exp_h:   i64 = exp_q16_init();
    let rsqrt_h: i64 = rsqrt_q16_init();

    // (7) Clock: tolerable non-determinism — the envelope strips the
    //     timestamp_ms field (offset 8) before hashing, so top-K bytes are
    //     unaffected. rt_monotonic_ns returns NANOSECONDS; convert to the
    //     milliseconds the envelope's timestamp_ms field is documented to
    //     carry (evidence.mind OFFSET_TIMESTAMP_MS).
    let ts: i64 = rt_monotonic_ns() / 1000000;

    // (8) Inference (pre-tokenized, stateless chain-of-one).
    let out_ids:      i64 = __mind_alloc(k_val * 32);
    let out_scores:   i64 = __mind_alloc(k_val * 8);
    let out_envelope: i64 = __mind_alloc(ATTESTATION_BYTES);
    let rc: i64 = infer_preselect_pre_tokenized_stateless(
        tokens, n_tokens, cat, wtab, mh, th, k_val, ts,
        0, 0, exp_h, rsqrt_h, out_ids, out_scores, out_envelope);

    if rc > 0 {
        // A short or failed stdout write (broken pipe, full disk) must NOT
        // exit 0 with a truncated/absent MNB1 envelope — surface it as an IO
        // error so a downstream consumer never mistakes a partial frame for a
        // complete attestation.
        if mn_emit_mic_b(rc, out_ids, out_scores, out_envelope) != MN_EXIT_OK {
            return mn_fail(MN_EXIT_IO_ERROR);
        }
        return MN_EXIT_OK;
    }
    if rc == INF_ERR_TOO_LONG       { return mn_fail(MN_EXIT_REQUEST_TOO_LONG); }
    if rc == INF_ERR_INVALID_K      { return mn_fail(MN_EXIT_INVALID_K); }
    if rc == INF_ERR_EMPTY_CATALOG  { return mn_fail(MN_EXIT_EMPTY_CATALOG); }
    if rc == INF_ERR_MODEL_MISMATCH { return mn_fail(MN_EXIT_MODEL_MISMATCH); }
    mn_fail(MN_EXIT_IO_ERROR)
}

// ---------------------------------------------------------------------------
// CSV token parser. Writes each decimal u32 as an i64 lane into `out`.
// Returns count (>= 0), -1 on malformed CSV, -2 if the cap is exceeded.
// ---------------------------------------------------------------------------
fn mn_parse_tokens(bytes: i64, len: i64, out: i64) -> i64 {
    if len == 0 { return 0; } // empty token list is legal
    let mut count: i64 = 0;
    let mut start: i64 = 0;
    let mut i: i64 = 0;
    while i <= len {
        if i == len || mn_byte(bytes + i) == 44 { // ',' or end
            if i == start { return -1; }          // empty cell / trailing comma
            let v: i64 = mn_parse_u32(bytes + start, i - start);
            if v < 0 { return -1; }
            if count >= MAX_REQUEST_TOKENS { return -2; }
            __mind_store_i64(out + count * 8, v);
            count = count + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    count
}

// ---------------------------------------------------------------------------
// mic-b stdout serializer. k = number of routes returned (rc).
//   "MNB1" | k:u16-LE | k x RouteId(32) | k x score:i32-LE | env(212)
// Returns MN_EXIT_OK when every byte reached fd 1, else MN_EXIT_IO_ERROR
// (short write or negative RT_ERR_*). With SIGPIPE ignored (see the C-shim
// constructor in nerve_rt_shims.c) a broken pipe surfaces as RT_ERR_IO here
// instead of a signal kill, so the caller can exit non-zero deterministically.
// ---------------------------------------------------------------------------
fn mn_emit_mic_b(k: i64, out_ids: i64, out_scores: i64, out_envelope: i64) -> i64 {
    let total: i64 = 6 + 36 * k + ATTESTATION_BYTES;
    let frame: i64 = __mind_alloc(total);
    let mut o: i64 = 0;

    // Magic "MNB1".
    o = mn_put(frame, o, 77);  // 'M'
    o = mn_put(frame, o, 78);  // 'N'
    o = mn_put(frame, o, 66);  // 'B'
    o = mn_put(frame, o, 49);  // '1'

    // k as u16-LE.
    o = mn_put(frame, o, k & 255);
    o = mn_put(frame, o, (k >> 8) & 255);

    // k x RouteId, 32 raw bytes each.
    let mut r: i64 = 0;
    while r < k {
        let mut b: i64 = 0;
        while b < 32 {
            o = mn_put(frame, o, __mind_load_i8(out_ids + r * 32 + b) & 255);
            b = b + 1;
        }
        r = r + 1;
    }

    // k x score as i32-LE (low 32 bits of each Q16.16 i64 lane).
    let mut s: i64 = 0;
    while s < k {
        let v: i64 = __mind_load_i64(out_scores + s * 8);
        o = mn_put(frame, o, v & 255);
        o = mn_put(frame, o, (v >> 8) & 255);
        o = mn_put(frame, o, (v >> 16) & 255);
        o = mn_put(frame, o, (v >> 24) & 255);
        s = s + 1;
    }

    // 212-byte attestation envelope.
    let mut e: i64 = 0;
    while e < ATTESTATION_BYTES {
        o = mn_put(frame, o, __mind_load_i8(out_envelope + e) & 255);
        e = e + 1;
    }

    let wrote: i64 = rt_write_stdout(frame, total);
    __mind_free(frame);
    if wrote != total { return MN_EXIT_IO_ERROR; }
    MN_EXIT_OK
}

// ---------------------------------------------------------------------------
// Error frame -> stderr, returns the exit code so callers `return mn_fail(x)`.
//   mic@2/mind-nerve/error\ncode: <decimal>\n.\n
// stderr is diagnostic (never part of any hash), so the numeric exit code is
// emitted in place of the dormant symbol string; the exit CODE is the real
// operator contract. deferred: symbol-name text (RequestTooLong, ...) —
// upgrade path: inline per-code literal buffers if wire consumers need names.
// ---------------------------------------------------------------------------
fn mn_fail(code: i64) -> i64 {
    let buf: i64 = __mind_alloc(64);
    let mut o: i64 = 0;
    // "mic@2/mind-nerve/error\n"
    o = mn_put(buf, o, 109); o = mn_put(buf, o, 105); o = mn_put(buf, o, 99);
    o = mn_put(buf, o, 64);  o = mn_put(buf, o, 50);  o = mn_put(buf, o, 47);
    o = mn_put(buf, o, 109); o = mn_put(buf, o, 105); o = mn_put(buf, o, 110);
    o = mn_put(buf, o, 100); o = mn_put(buf, o, 45);  o = mn_put(buf, o, 110);
    o = mn_put(buf, o, 101); o = mn_put(buf, o, 114); o = mn_put(buf, o, 118);
    o = mn_put(buf, o, 101); o = mn_put(buf, o, 47);  o = mn_put(buf, o, 101);
    o = mn_put(buf, o, 114); o = mn_put(buf, o, 114); o = mn_put(buf, o, 111);
    o = mn_put(buf, o, 114); o = mn_put(buf, o, 10);
    // "code: "
    o = mn_put(buf, o, 99); o = mn_put(buf, o, 111); o = mn_put(buf, o, 100);
    o = mn_put(buf, o, 101); o = mn_put(buf, o, 58); o = mn_put(buf, o, 32);
    o = mn_put_dec(buf, o, code);
    // "\n.\n"
    o = mn_put(buf, o, 10); o = mn_put(buf, o, 46); o = mn_put(buf, o, 10);
    let _w: i64 = rt_write_stderr(buf, o);
    __mind_free(buf);
    code
}
