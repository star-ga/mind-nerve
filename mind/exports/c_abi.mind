// mind-nerve/mind/exports/c_abi.mind
//
// Phase A1.3 — C-ABI export surface for the native MIND Q16.16 encoder.
//
// ABI version: 1 (mn_encoder_version returns build-id string addr).
//
// All six encoder pub fn symbols map directly to C-callable exports when
// compiled with `mindc --emit-shared`; the three mn_tokenize_* symbols
// (BERT WordPiece tokenizer, Task 1) follow the same convention. The
// mindc cdylib seam (RFC 0003, D2–D5 of RFC 0002 from mindc 0.2.6) lowers
// `pub fn` to a C symbol with identical name, no name-mangling.
//
// Parameter convention (i64 throughout):
//   - All buffer parameters are i64 values holding a flat heap address.
//   - Lengths are i64 counts of i64 elements (each i64 holds one Q16.16
//     or one int32 token ID depending on context).
//   - No f32 crosses the FFI boundary. Q16.16 fixed-point inside the buffers.
//
// Handle semantics:
//   mn_encoder_init returns an i64 handle. The handle is an opaque
//   heap-allocated record whose first field is the weight blob base address
//   and whose second field is the blob length. All scratch buffers are
//   allocated inside init and stored in the handle record so that encode
//   calls are allocation-free after init.
//
// Weight blob:
//   The weights_blob parameter is an i64 address pointing to a flat byte
//   buffer of Q16.16-quantised weights in the layout defined by encode.mind
//   (emb_block_bytes + 12 * layer_stride_bytes = ~142 MB). The blob is
//   produced offline by the quantize_phase1_to_q16.py converter.
//
//   For A1.3, mn_encoder_init allocates a placeholder handle and stores the
//   blob addr + len without parsing the weight block structure. Full weight
//   validation and scratch-buffer sizing are deferred to the Phase-6.2
//   const-blob support cycle when the offline quantizer ships.
//
// Build:
//   cd <mind-checkout>
//   cargo run --features "std-surface cross-module-imports mlir-build" \
//       --bin mindc -- <mind-nerve>/mind/exports/c_abi.mind \
//       --emit-shared <mind-nerve>/python/mind_nerve/_native/libmind_nerve_encoder.so \
//       --target=x86_64-unknown-linux-gnu \
//       --features "std-surface cross-module-imports"
//
// C header surface (for ctypes / CFFI consumers):
//   int64_t mn_encoder_init(int64_t weights_blob, int64_t len);
//   int64_t mn_encoder_encode(int64_t handle, int64_t token_ids,
//                             int64_t n_tokens, int64_t out_vec);
//   int64_t mn_encoder_score(int64_t handle, int64_t qv,
//                            int64_t catalog, int64_t n_rows,
//                            int64_t out_scores);
//   int64_t mn_encoder_topk(int64_t scores, int64_t n, int64_t k,
//                           int64_t out_idx, int64_t out_scores);
//   int64_t mn_encoder_free(int64_t handle);
//   int64_t mn_encoder_version(void);
//   int64_t mn_tokenize_tables_init(void);
//   int64_t mn_tokenize(int64_t tables, int64_t text_addr, int64_t text_len,
//                       int64_t out_ids, int64_t out_cap);
//   int64_t mn_tokenize_tables_free(int64_t tables);
//
// No f32. No while. Cross-module imports resolved at --emit-shared link time.

import std.vec;
import kernels.encode;
import kernels.matmul_q16;
import kernels.matmul_blas;
import kernels.topk_q16;
import kernels.wordpiece;

// ---------------------------------------------------------------------------
// Handle record layout (flat heap blob, 8 bytes per field):
//   slot 0: weight blob base address (i64)
//   slot 1: weight blob length in bytes (i64)
//   slot 2: scratch x         — (max_seq, H) = (256, 384) Q16.16 buffer addr
//   slot 3: scratch layer_out — (256, 384)
//   slot 4: scratch q_proj    — (256, 384)
//   slot 5: scratch k_proj    — (256, 384)
//   slot 6: scratch v_proj    — (256, 384)
//   slot 7: scratch q_heads   — (12, 256, 32)
//   slot 8: scratch k_heads   — (12, 256, 32)
//   slot 9: scratch v_heads   — (12, 256, 32)
//   slot 10: scratch attn_raw — (12, 256, 256)
//   slot 11: scratch ctx_heads — (12, 256, 32)
//   slot 12: scratch ctx_cat  — (256, 384)
//   slot 13: scratch ffn_buf  — (256, 1536)
//   slot 14: scratch tmp      — (256, 384)
//   slot 15: scratch tmp_word — (256, 384)
//   slot 16: scratch tmp_pos  — (256, 384)
//   slot 17: scratch tmp_type — (256, 384)
//   slot 18: scratch cls_buf  — (384,)
//   slot 19: scratch embed_out — (384,)
//   slot 20: scratch win_tok  — (256,)  sliding-window token ID scratch
//   slot 21: scratch win_typ  — (256,)  sliding-window type ID scratch
//   slot 22: scratch type_ids — (max_seq,) all-zeros type ID buffer
// Total: 23 slots × 8 bytes = 184 bytes for the handle record itself.
// ---------------------------------------------------------------------------

// Handle field offsets (byte offsets from handle base).
pub fn hf_wb() -> i64 {
    0
}
// weight blob addr
pub fn hf_len() -> i64 {
    8
}
// weight blob len
pub fn hf_x() -> i64 {
    16
}
pub fn hf_lo() -> i64 {
    24
}
// layer_out
pub fn hf_qp() -> i64 {
    32
}
// q_proj
pub fn hf_kp() -> i64 {
    40
}
// k_proj
pub fn hf_vp() -> i64 {
    48
}
// v_proj
pub fn hf_qh() -> i64 {
    56
}
// q_heads
pub fn hf_kh() -> i64 {
    64
}
// k_heads
pub fn hf_vh() -> i64 {
    72
}
// v_heads
pub fn hf_ar() -> i64 {
    80
}
// attn_raw
pub fn hf_ch() -> i64 {
    88
}
// ctx_heads
pub fn hf_cc() -> i64 {
    96
}
// ctx_cat
pub fn hf_fb() -> i64 {
    104
}
// ffn_buf
pub fn hf_tmp() -> i64 {
    112
}
pub fn hf_tw() -> i64 {
    120
}
// tmp_word
pub fn hf_tp() -> i64 {
    128
}
// tmp_pos
pub fn hf_tt() -> i64 {
    136
}
// tmp_type
pub fn hf_cls() -> i64 {
    144
}
pub fn hf_emb() -> i64 {
    152
}
// embed_out
pub fn hf_wt() -> i64 {
    160
}
// win_tok
pub fn hf_wty() -> i64 {
    168
}
// win_typ
pub fn hf_tid() -> i64 {
    176
}
// type_ids (all-zero)

// ── Phase A1.6 mt-kernel score path: packed-i32 scratch (slots 23..27). ──
// The multithreaded Q16.16 GEMV intrinsic __mind_blas_gemv_q16_mt reads
// PACKED i32 stride-4 operands and writes i32 stride-4 scores (contrast the
// i64 stride-8 heap layout every other buffer uses). These five slots hold
// the packed-catalog cache (rebuilt only when the catalog address/row count
// changes — the catalog is immutable for the handle lifetime), the per-call
// packed query, and the i32 score buffer. Packing is byte-identical to the
// former C shim's mind_nerve_blas_get_packed_catalog: (int32_t)value, which
// is lossless because a Q16.16 value always fits in 32 bits.
pub fn hf_pcat() -> i64 {
    184
}
// packed catalog (i32 stride-4), 0 = not yet built
pub fn hf_pcat_src() -> i64 {
    192
}
// catalog src addr the packed cache was built from
pub fn hf_pcat_n() -> i64 {
    200
}
// n_rows the packed cache was built for
pub fn hf_pqv() -> i64 {
    208
}
// packed query (384 i32), allocated once at init
pub fn hf_psc() -> i64 {
    216
}
// i32 score buffer (n_rows i32), sized with the packed catalog

// ---------------------------------------------------------------------------
// Scratch buffer sizes (in bytes, each i64 element = 8 bytes):
//   (T,H)        = 256*384*8 = 786432
//   (nh,T,D)     = 12*256*32*8 = 786432
//   (nh,T,T)     = 12*256*256*8 = 6291456
//   (T,F)        = 256*1536*8 = 3145728
//   (H,)         = 384*8 = 3072
//   (T,)         = 256*8 = 2048
// ---------------------------------------------------------------------------
pub fn sz_TH() -> i64 {
    786432
}
// (256, 384)
pub fn sz_nhTD() -> i64 {
    786432
}
// (12, 256, 32)
pub fn sz_nhTT() -> i64 {
    6291456
}
// (12, 256, 256) attn_raw
pub fn sz_TF() -> i64 {
    3145728
}
// (256, 1536)
pub fn sz_H() -> i64 {
    3072
}
// (384,)
pub fn sz_T() -> i64 {
    2048
}
// (256,)
pub fn sz_handle() -> i64 {
    224
}
// 28 × 8 (23 encoder scratch slots + 5 mt-kernel packed-i32 slots)

// ── Minimum weight-blob length (bytes) the encoder is allowed to read. ──
// The encode path gathers from the embedding block (word/pos/type tables +
// embedding LayerNorm) followed by all n_layers() layer blocks. The highest
// address any weight read touches is
//   wb + emb_block_bytes() + n_layers()*layer_stride_bytes().
// A blob shorter than this — or a null (address 0) blob — drives the
// embedding/weight gathers off the end of the mapping (SIGSEGV) or into
// unrelated heap (silent corruption). mn_encoder_encode rejects both
// fail-loud before the first dereference (task #52).
pub fn min_blob_bytes() -> i64 {
    emb_block_bytes() + n_layers() * layer_stride_bytes()
}

// Upper bound on catalog rows accepted by the .so embedder surface. Matches
// src/loader.mind MAX_ROUTES (65536) — well above the 12,468-route production
// catalog. ensure_packed_catalog rejects an out-of-range n_rows before sizing
// __mind_alloc(n_rows*384*4) / __mind_alloc(n_rows*4), a cheap C-ABI trust-
// boundary guard against an over-count / negative n_rows.
pub fn max_cat_rows() -> i64 {
    65536
}

// ---------------------------------------------------------------------------
// Handle field accessors.
// ---------------------------------------------------------------------------
pub fn hget(h: i64, off: i64) -> i64 {
    __mind_load_i64(h + off)
}
pub fn hset(h: i64, off: i64, v: i64) -> i64 {
    __mind_store_i64(h + off, v)
}

// ---------------------------------------------------------------------------
// Zero-fill type_ids buffer (all tokens are segment 0 for single-segment input).
// Tail-recursive over i = 0..n-1.
// ---------------------------------------------------------------------------
pub fn zero_fill(buf: i64, n: i64, i: i64) -> i64 {
    if i >= n {
        return 0;
    }
    __mind_store_i64(buf + i * 8, 0);
    zero_fill(buf, n, i + 1)
}

// ---------------------------------------------------------------------------
// mn_encoder_init — allocate handle + scratch buffers.
//
// weights_blob: i64 address of pre-quantised Q16.16 weight flat buffer.
// len:          length of the blob in bytes.
// Returns:      i64 handle (opaque record), or 0 on failure.
//
// For A1.3, the handle stores the blob addr + len and pre-allocates all
// scratch buffers for max_seq=256. Full weight-structure validation is
// deferred to Phase 6.2.
// ---------------------------------------------------------------------------
pub fn mn_encoder_init(weights_blob: i64, len: i64) -> i64 {
    let h: i64 = __mind_alloc(sz_handle());
    if h == 0 {
        return 0;
    }

    // Store weight blob reference.
    hset(h, hf_wb(), weights_blob);
    hset(h, hf_len(), len);

    // Allocate scratch buffers and store addresses in the handle.
    hset(h, hf_x(), __mind_alloc(sz_TH()));
    hset(h, hf_lo(), __mind_alloc(sz_TH()));
    hset(h, hf_qp(), __mind_alloc(sz_TH()));
    hset(h, hf_kp(), __mind_alloc(sz_TH()));
    hset(h, hf_vp(), __mind_alloc(sz_TH()));
    hset(h, hf_qh(), __mind_alloc(sz_nhTD()));
    hset(h, hf_kh(), __mind_alloc(sz_nhTD()));
    hset(h, hf_vh(), __mind_alloc(sz_nhTD()));
    hset(h, hf_ar(), __mind_alloc(sz_nhTT()));
    hset(h, hf_ch(), __mind_alloc(sz_nhTD()));
    hset(h, hf_cc(), __mind_alloc(sz_TH()));
    hset(h, hf_fb(), __mind_alloc(sz_TF()));
    hset(h, hf_tmp(), __mind_alloc(sz_TH()));
    hset(h, hf_tw(), __mind_alloc(sz_TH()));
    hset(h, hf_tp(), __mind_alloc(sz_TH()));
    hset(h, hf_tt(), __mind_alloc(sz_TH()));
    hset(h, hf_cls(), __mind_alloc(sz_H()));
    hset(h, hf_emb(), __mind_alloc(sz_H()));
    hset(h, hf_wt(), __mind_alloc(sz_T()));
    hset(h, hf_wty(), __mind_alloc(sz_T()));

    // type_ids: (max_seq,) all-zero i64 buffer.
    let tid_buf: i64 = __mind_alloc(sz_T());
    zero_fill(tid_buf, 256, 0);
    hset(h, hf_tid(), tid_buf);

    // mt-kernel score path (Phase A1.6): packed query buffer is fixed size
    // (384 i32 = 1536 bytes), allocated once. The packed catalog + i32 score
    // buffers are sized from n_rows on the first mn_encoder_score call and
    // cached (0 = not yet built).
    hset(h, hf_pqv(), __mind_alloc(384 * 4));
    hset(h, hf_pcat(), 0);
    hset(h, hf_pcat_src(), 0);
    hset(h, hf_pcat_n(), 0);
    hset(h, hf_psc(), 0);

    h
}

// ---------------------------------------------------------------------------
// mn_encoder_encode — run the full BERT encoder for a token ID sequence.
//
// handle:    opaque handle from mn_encoder_init.
// token_ids: i64 buffer of n_tokens token IDs (Python int32 → widened i64).
// n_tokens:  sequence length T (1 ≤ T ≤ 512).
// out_vec:   i64 buffer of 384 elements to receive the Q16.16 L2-normalised
//            embedding (written by encode()).
//
// Returns 0 on success, -1 on null handle.
// ---------------------------------------------------------------------------
pub fn mn_encoder_encode(handle: i64, token_ids: i64, n_tokens: i64, out_vec: i64) -> i64 {
    if handle == 0 {
        return -1;
    }

    // ── Fail-loud validation of untrusted C-ABI inputs (task #52). ──
    // weights_blob (captured in the handle at init), its length, and
    // n_tokens all arrive across the FFI as caller-controlled i64 values.
    // Dereferencing an unvalidated blob address is an arbitrary-read
    // primitive; the reproduced crash is a null (address 0) blob, where the
    // embedding gather issues __mind_load_i64(0) and SIGSEGVs. Validate the
    // blob address, the blob length, and the sequence length here — before
    // encode() performs any load — and refuse with a distinct negative code
    // the ctypes shim surfaces as a RuntimeError. NEVER run the encoder on a
    // blob that cannot back every weight read.
    let wb: i64 = hget(handle, hf_wb());
    if wb == 0 {
        return -2;
    }
    // null weight blob
    let blob_len: i64 = hget(handle, hf_len());
    if blob_len < min_blob_bytes() {
        return -3;
    }
    // blob too short -> OOB read
    if n_tokens < 1 {
        return -4;
    }
    // empty / negative seq len
    // Scratch buffers are sized for max_seq() (256). The sliding-window path
    // for T > 256 writes window outputs at absolute token positions into a
    // 256-row global buffer, so a request longer than the scratch capacity
    // is a heap overflow, not a valid encode. Refuse it fail-loud here.
    // deferred: to restore the documented 1..512 ABI range, size the global
    //   merge/output scratch to the true max sequence length (T-sized, not
    //   max_seq-sized) in mn_encoder_init and encode_sliding, then raise this
    //   cap. Tracked as the sliding-window scratch-sizing follow-up.
    if n_tokens > max_seq() {
        return -5;
    }
    // exceeds scratch capacity

    let x: i64 = hget(handle, hf_x());
    let lo: i64 = hget(handle, hf_lo());
    let qp: i64 = hget(handle, hf_qp());
    let kp: i64 = hget(handle, hf_kp());
    let vp: i64 = hget(handle, hf_vp());
    let qh: i64 = hget(handle, hf_qh());
    let kh: i64 = hget(handle, hf_kh());
    let vh: i64 = hget(handle, hf_vh());
    let ar: i64 = hget(handle, hf_ar());
    let ch: i64 = hget(handle, hf_ch());
    let cc: i64 = hget(handle, hf_cc());
    let fb: i64 = hget(handle, hf_fb());
    let tmp: i64 = hget(handle, hf_tmp());
    let tw: i64 = hget(handle, hf_tw());
    let tp: i64 = hget(handle, hf_tp());
    let tt: i64 = hget(handle, hf_tt());
    let cls: i64 = hget(handle, hf_cls());
    let emb: i64 = hget(handle, hf_emb());
    let wt: i64 = hget(handle, hf_wt());
    let wty: i64 = hget(handle, hf_wty());
    let tid: i64 = hget(handle, hf_tid());

    // Call the encode() driver from kernels.encode (routes single/sliding).
    encode(token_ids, tid, wb, x, lo, qp, kp, vp, qh, kh, vh, ar, ch, cc, fb, tmp, tw, tp, tt, cls, emb, wt, wty, n_tokens);

    // Copy embed_out into caller-provided out_vec.
    copy_vec(emb, out_vec, 384, 0)
}

// ---------------------------------------------------------------------------
// mn_encoder_score — dot-product scoring of a query vector against a catalog.
//
// handle:     opaque handle (unused for scoring, kept for API symmetry).
// qv:         i64 buffer of 384 Q16.16 elements (query embedding).
// catalog:    i64 buffer of n_rows×384 Q16.16 elements (pre-L2-normalised).
// n_rows:     number of catalog entries N.
// out_scores: i64 buffer of N elements to receive Q16.16 dot products.
//
// Returns 0 on success, -1 on null handle.
// ---------------------------------------------------------------------------
pub fn mn_encoder_score(handle: i64, qv: i64, catalog: i64, n_rows: i64, out_scores: i64) -> i64 {
    if handle == 0 {
        return -1;
    }
    // Phase A1.6: pure-MIND score path over the compiler-emitted
    // multithreaded Q16.16 GEMV intrinsic __mind_blas_gemv_q16_mt. The
    // intrinsic consumes PACKED i32 stride-4 operands and returns i32
    // scores; it is byte-for-byte identical to the per-row scalar dot
    // oracle Σ_k (catalog[i,k]*query[k])>>16 and thread-count-independent,
    // so the top-K order and emitted route ids are unchanged (task #57
    // f4524b gate holds). The i64→i32 pack is (int32_t)value — lossless
    // because a Q16.16 value always fits in 32 bits — and reproduces the
    // former blas_shims_i64.c pack byte-for-byte. The i32 scores are
    // widened back to the caller's i64 out_scores buffer via load_i32
    // (sign-extending), which equals the old (int64_t)(int32_t)score.
    let pcat: i64 = ensure_packed_catalog(handle, catalog, n_rows);
    let pqv: i64 = hget(handle, hf_pqv());
    let psc: i64 = hget(handle, hf_psc());
    // Pack the query (384 elements) fresh every call — negligible cost.
    pack_i64_to_i32(qv, pqv, 384, 0);
    __mind_blas_gemv_q16_mt(pcat, pqv, psc, n_rows, 384);
    widen_i32_to_i64(psc, out_scores, n_rows, 0)
}

// ---------------------------------------------------------------------------
// Pack n consecutive i64-stride-8 Q16.16 values into a contiguous i32
// stride-4 buffer. __mind_store_i32 writes the low 32 bits of the loaded
// i64; a Q16.16 value always fits in 32 bits, so this is lossless and
// byte-identical to the C shim's (int32_t)src[i] pack. Tail-recursive over
// i (caller bounds the depth: 384 for the query, cols for a catalog row).
// ---------------------------------------------------------------------------
pub fn pack_i64_to_i32(src: i64, dst: i64, n: i64, i: i64) -> i64 {
    if i >= n {
        return 0;
    }
    __mind_store_i32(dst + i * 4, __mind_load_i64(src + i * 8));
    pack_i64_to_i32(src, dst, n, i + 1)
}

// Pack an (n_rows × cols) i64-stride-8 catalog into a contiguous i32
// stride-4 row-major buffer, one row at a time. Nested tail-recursion keeps
// the per-call depth bounded (cols=384 inner, n_rows outer — the same
// recursion regime as the shipped scalar matmul_score), never the flat
// n_rows*cols depth.
pub fn pack_cat_rows(src: i64, dst: i64, n_rows: i64, cols: i64, r: i64) -> i64 {
    if r >= n_rows {
        return 0;
    }
    pack_i64_to_i32(src + r * cols * 8, dst + r * cols * 4, cols, 0);
    pack_cat_rows(src, dst, n_rows, cols, r + 1)
}

// Widen n i32-stride-4 Q16.16 scores into an i64-stride-8 buffer.
// __mind_load_i32 sign-extends the 32-bit value to i64, reproducing the
// former C shim's (int64_t)(int32_t)score exactly — so out_scores is
// byte-identical to the pre-A1.6 path. Tail-recursive over i (depth n_rows).
pub fn widen_i32_to_i64(src: i64, dst: i64, n: i64, i: i64) -> i64 {
    if i >= n {
        return 0;
    }
    // Sign-extend the low 32 bits explicitly: mask to 32 bits then shift
    // left/arithmetic-right so a negative Q16.16 score (top bit set) becomes
    // a negative i64, reproducing the old (int64_t)(int32_t)score. A bare
    // load_i32 zero-extends here, which would map -903 to 2^32-903.
    let raw: i64 = __mind_load_i32(src + i * 4);
    let lo: i64 = raw & 4294967295;
    let signed: i64 = (lo << 32) >> 32;
    __mind_store_i64(dst + i * 8, signed);
    widen_i32_to_i64(src, dst, n, i + 1)
}

// ---------------------------------------------------------------------------
// Ensure the handle's packed-i32 catalog cache matches (catalog, n_rows),
// rebuilding it only on a miss. The catalog is immutable for the handle
// lifetime and is passed at the same address every call, so this packs the
// ~18 MB catalog exactly once (mirrors the former C shim's single-slot
// packed-catalog cache). Returns the packed catalog address.
// ---------------------------------------------------------------------------
pub fn ensure_packed_catalog(handle: i64, catalog: i64, n_rows: i64) -> i64 {
    // Bound n_rows before any allocation: pack_cat_rows / pack_i64_to_i32
    // recurse n_rows deep (relying on tail-call elimination) and the buffers
    // are sized n_rows*384*4 / n_rows*4, so an over-count or negative n_rows is
    // a heap-blowup / negative-alloc primitive on this C-ABI boundary. Refuse
    // fail-loud with -1 (the caller mn_encoder_score returns it up the FFI).
    if n_rows < 0 || n_rows > max_cat_rows() {
        return -1;
    }
    let cur: i64 = hget(handle, hf_pcat());
    if cur != 0 {
        if hget(handle, hf_pcat_src()) == catalog {
            if hget(handle, hf_pcat_n()) == n_rows {
                return cur;
            }
        }
    }
    // Miss: free any prior packed catalog + score buffers and rebuild sized
    // to n_rows. packed catalog = n_rows*384 i32; score buffer = n_rows i32.
    if cur != 0 {
        __mind_free(cur)
    }
    let oldsc: i64 = hget(handle, hf_psc());
    if oldsc != 0 {
        __mind_free(oldsc)
    }
    let pcat: i64 = __mind_alloc(n_rows * 384 * 4);
    let psc: i64 = __mind_alloc(n_rows * 4);
    pack_cat_rows(catalog, pcat, n_rows, 384, 0);
    hset(handle, hf_pcat(), pcat);
    hset(handle, hf_pcat_src(), catalog);
    hset(handle, hf_pcat_n(), n_rows);
    hset(handle, hf_psc(), psc);
    pcat
}

// ---------------------------------------------------------------------------
// mn_encoder_topk — select top-K candidates from a score array.
//
// scores:     i64 buffer of N Q16.16 scores.
// n:          number of scores N.
// k:          number of top results to return (K ≤ 32).
// out_idx:    i64 buffer of K elements receiving sorted indices (desc score).
// out_scores: i64 buffer of K elements receiving sorted scores (desc).
//
// Returns 0 on success.
// Uses an inline K-min-heap (see kernels.topk_q16). Scratch heap and idx
// are allocated transiently (K ≤ 32 → 512 bytes each, negligible).
// ---------------------------------------------------------------------------
pub fn mn_encoder_topk(scores: i64, n: i64, k: i64, out_idx: i64, out_scores: i64) -> i64 {
    let heap_s: i64 = __mind_alloc(k * 8);
    let heap_i: i64 = __mind_alloc(k * 8);
    topk_q16(scores, n, k, heap_s, heap_i, out_scores, out_idx)
}

// ---------------------------------------------------------------------------
// mn_encoder_free — release the handle and all scratch buffers.
//
// handle: opaque handle from mn_encoder_init.
// Returns 0 always.
//
// Note: __mind_free is the mirror of __mind_alloc. If the runtime does not
// expose a dealloc intrinsic, this is a no-op (GC or arena-collect).
// ---------------------------------------------------------------------------
pub fn mn_encoder_free(handle: i64) -> i64 {
    if handle == 0 {
        return 0;
    }
    // Free the mt-kernel packed-i32 buffers (Phase A1.6). The packed catalog
    // and i32 score buffers are lazily built (0 until the first score call),
    // so guard them; the packed query is always allocated at init.
    let pcat: i64 = hget(handle, hf_pcat());
    if pcat != 0 {
        __mind_free(pcat)
    }
    let psc: i64 = hget(handle, hf_psc());
    if psc != 0 {
        __mind_free(psc)
    }
    __mind_free(hget(handle, hf_pqv()));
    // Free scratch buffers in reverse allocation order.
    __mind_free(hget(handle, hf_tid()));
    __mind_free(hget(handle, hf_wty()));
    __mind_free(hget(handle, hf_wt()));
    __mind_free(hget(handle, hf_emb()));
    __mind_free(hget(handle, hf_cls()));
    __mind_free(hget(handle, hf_tt()));
    __mind_free(hget(handle, hf_tp()));
    __mind_free(hget(handle, hf_tw()));
    __mind_free(hget(handle, hf_tmp()));
    __mind_free(hget(handle, hf_fb()));
    __mind_free(hget(handle, hf_cc()));
    __mind_free(hget(handle, hf_ch()));
    __mind_free(hget(handle, hf_ar()));
    __mind_free(hget(handle, hf_vh()));
    __mind_free(hget(handle, hf_kh()));
    __mind_free(hget(handle, hf_qh()));
    __mind_free(hget(handle, hf_vp()));
    __mind_free(hget(handle, hf_kp()));
    __mind_free(hget(handle, hf_qp()));
    __mind_free(hget(handle, hf_lo()));
    __mind_free(hget(handle, hf_x()));
    __mind_free(handle)
}

// ---------------------------------------------------------------------------
// mn_tokenize_tables_init / mn_tokenize / mn_tokenize_tables_free —
// BERT WordPiece tokenization (Task 1, 2026-08-15), delegating to
// kernels.wordpiece over the pinned tables in luts.vocab_wp.
//
// Token-id output is byte-identical to the HF fast tokenizer for the
// runtime checkpoint (including [CLS]/[SEP], [UNK], non-ASCII
// normalization, and 256-id truncation) — proven by
// tests/python/test_tokenize_corpus.py on a >=500-query corpus.
//
// Tables handle: build once via mn_tokenize_tables_init() and reuse (the
// vocab + normalizer tables are ~500 KB of pinned heap). Passing 0 builds
// and frees the tables per call — correct but slow; for embedders only.
//
//   int64_t mn_tokenize_tables_init(void);
//   int64_t mn_tokenize(int64_t tables, int64_t text_addr, int64_t text_len,
//                       int64_t out_ids, int64_t out_cap);
//   int64_t mn_tokenize_tables_free(int64_t tables);
//
// mn_tokenize parameters follow the same pointer+length convention as the
// encoder exports: text_addr is the address of text_len UTF-8 bytes (one
// byte per offset); out_ids is a caller buffer of out_cap i64 lanes.
// Returns the id count (>= 2 — [CLS]/[SEP] always present), or a negative
// error: -1 tables handle could not be built, -2 out_cap exceeded,
// -3 negative text_len.
// ---------------------------------------------------------------------------
pub fn mn_tokenize_tables_init() -> i64 {
    wp_tables_init()
}

pub fn mn_tokenize(tables: i64, text_addr: i64, text_len: i64, out_ids: i64, out_cap: i64) -> i64 {
    if text_len < 0 {
        return -3;
    }
    let mut own: i64 = 0;
    let mut t: i64 = tables;
    if t == 0 {
        t = wp_tables_init();
        own = 1;
    }
    if t == 0 {
        return -1;
    }
    let rc: i64 = wp_tokenize(t, text_addr, text_len, out_ids, out_cap);
    if own == 1 {
        wp_tables_free(t)
    }
    rc
}

pub fn mn_tokenize_tables_free(tables: i64) -> i64 {
    if tables == 0 {
        return 0;
    }
    wp_tables_free(tables)
}

// ---------------------------------------------------------------------------
// mn_encoder_version — return i64 address of a null-terminated build-id string.
//
// The string is a compile-time constant embedded in the .so via a literal
// heap allocation at the start of execution. Format:
//   "mind-nerve-encoder/1;mindc/0.4.4;abi/1;q16.16"
//
// The ABI version (third segment) matches the handle record layout version
// documented above. Callers should compare the full string for forward-compat.
//
// Returns i64 address of the null-terminated ASCII bytes.
// ---------------------------------------------------------------------------
pub fn mn_encoder_version() -> i64 {
    // Build-id string encoded as a sequence of ASCII bytes stored into a
    // heap buffer. The string is:
    //   "mind-nerve-encoder/1;mindc/0.4.4;abi/1;q16.16\0"
    // Length: 47 bytes + 1 null = 48 bytes → allocate 48 bytes.
    //
    // ASCII codes (decimal):
    // m=109 i=105 n=110 d=100 -=45 n=110 e=101 r=114 v=118 e=101 -=45
    // e=101 n=110 c=99 o=111 d=100 e=101 r=114 /=47 1=49 ;=59
    // m=109 i=105 n=110 d=100 c=99 /=47 0=48 .=46 4=52 .=46 4=52 ;=59
    // a=97 b=98 i=105 /=47 1=49 ;=59
    // q=113 1=49 6=54 .=46 1=49 6=54 \0=0
    let buf: i64 = __mind_alloc(384);
    write_version_bytes(buf);
    buf
}

// Write build-id bytes one i64-per-byte into the version buffer.
// Each byte occupies a full i64 slot (8 bytes) per the MIND heap layout.
// Python ctypes reads the string as consecutive bytes starting at buf.
// Because __mind_store_i64 writes 8 bytes at stride 8, each character
// is stored with 7 trailing zero bytes. The ctypes c_char_p reader
// must stride by 8 (see _NativeRuntime.version()).
pub fn write_version_bytes(buf: i64) -> i64 {
    // "mind-nerve-encoder/1;mindc/0.4.4;abi/1;q16.16\0"
    // Stored as i64 per slot (stride 8). NUL terminates at slot 47.
    __mind_store_i64(buf + 0, 109);
    // m
    __mind_store_i64(buf + 8, 105);
    // i
    __mind_store_i64(buf + 16, 110);
    // n
    __mind_store_i64(buf + 24, 100);
    // d
    __mind_store_i64(buf + 32, 45);
    // -
    __mind_store_i64(buf + 40, 110);
    // n
    __mind_store_i64(buf + 48, 101);
    // e
    __mind_store_i64(buf + 56, 114);
    // r
    __mind_store_i64(buf + 64, 118);
    // v
    __mind_store_i64(buf + 72, 101);
    // e
    __mind_store_i64(buf + 80, 45);
    // -
    __mind_store_i64(buf + 88, 101);
    // e
    __mind_store_i64(buf + 96, 110);
    // n
    __mind_store_i64(buf + 104, 99);
    // c
    __mind_store_i64(buf + 112, 111);
    // o
    __mind_store_i64(buf + 120, 100);
    // d
    __mind_store_i64(buf + 128, 101);
    // e
    __mind_store_i64(buf + 136, 114);
    // r
    __mind_store_i64(buf + 144, 47);
    // /
    __mind_store_i64(buf + 152, 49);
    // 1
    __mind_store_i64(buf + 160, 59);
    // ;
    __mind_store_i64(buf + 168, 109);
    // m
    __mind_store_i64(buf + 176, 105);
    // i
    __mind_store_i64(buf + 184, 110);
    // n
    __mind_store_i64(buf + 192, 100);
    // d
    __mind_store_i64(buf + 200, 99);
    // c
    __mind_store_i64(buf + 208, 47);
    // /
    __mind_store_i64(buf + 216, 48);
    // 0
    __mind_store_i64(buf + 224, 46);
    // .
    __mind_store_i64(buf + 232, 52);
    // 4
    __mind_store_i64(buf + 240, 46);
    // .
    __mind_store_i64(buf + 248, 52);
    // 4
    __mind_store_i64(buf + 256, 59);
    // ;
    __mind_store_i64(buf + 264, 97);
    // a
    __mind_store_i64(buf + 272, 98);
    // b
    __mind_store_i64(buf + 280, 105);
    // i
    __mind_store_i64(buf + 288, 47);
    // /
    __mind_store_i64(buf + 296, 49);
    // 1
    __mind_store_i64(buf + 304, 59);
    // ;
    __mind_store_i64(buf + 312, 113);
    // q
    __mind_store_i64(buf + 320, 49);
    // 1
    __mind_store_i64(buf + 328, 54);
    // 6
    __mind_store_i64(buf + 336, 46);
    // .
    __mind_store_i64(buf + 344, 49);
    // 1
    __mind_store_i64(buf + 352, 54);
    // 6
    __mind_store_i64(buf + 360, 0);
    // NUL terminator
    0
}

// ---------------------------------------------------------------------------
// Utility: copy n i64 elements from src to dst. Tail-recursive.
// ---------------------------------------------------------------------------
pub fn copy_vec(src: i64, dst: i64, n: i64, i: i64) -> i64 {
    if i >= n {
        return 0;
    }
    __mind_store_i64(dst + i * 8, __mind_load_i64(src + i * 8));
    copy_vec(src, dst, n, i + 1)
}
