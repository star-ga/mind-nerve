}

#[test]
fn test_boundary_128() {
    let rc: i64 = kat_pattern(128, 3530829599, 1254538108, 2729589230, 406858664, 3019503846, 1389537065, 1942141370, 297831670);
    assert rc == 0, "128-byte boundary (two exact blocks) mismatch";
}

// ── Determinism + regression-fold + mind-nerve fixtures ─────────────────────

#[test]
fn test_determinism_same_input_same_output() {
    let data: i64 = __mind_alloc(64);
    fill_pattern(data, 64);
    let out1: i64 = __mind_alloc(32);
    let out2: i64 = __mind_alloc(32);
    mn_sha256(data, 64, out1);
    mn_sha256(data, 64, out2);
    let mut diff: i64 = 0;
    let mut i: i64 = 0;
    while i < 32 {
        if __mind_load_i8(out1 + i) != __mind_load_i8(out2 + i) {
            diff = i + 1;
        }
        i = i + 1;
    }
    __mind_free(data);
    __mind_free(out1);
    __mind_free(out2);
    assert diff == 0, "same input hashed twice must be byte-identical";
}

#[test]
fn test_kernel_hash_100_fixed_inputs() {
    // Fold the digests of pattern(0..99) word-wise mod 2^32. Oracle:
    // Python hashlib replication of the identical fold.
    let mut a0: i64 = 0;
    let mut a1: i64 = 0;
    let mut a2: i64 = 0;
    let mut a3: i64 = 0;
    let mut a4: i64 = 0;
    let mut a5: i64 = 0;
    let mut a6: i64 = 0;
    let mut a7: i64 = 0;
    let out: i64 = __mind_alloc(32);
    let mut i: i64 = 0;
    while i < 100 {
        let data: i64 = __mind_alloc(i + 1);
        fill_pattern(data, i);
        mn_sha256(data, i, out);
        __mind_free(data);
        a0 = (a0 + digest_word(out, 0)) & 4294967295;
        a1 = (a1 + digest_word(out, 1)) & 4294967295;
        a2 = (a2 + digest_word(out, 2)) & 4294967295;
        a3 = (a3 + digest_word(out, 3)) & 4294967295;
        a4 = (a4 + digest_word(out, 4)) & 4294967295;
        a5 = (a5 + digest_word(out, 5)) & 4294967295;
        a6 = (a6 + digest_word(out, 6)) & 4294967295;
        a7 = (a7 + digest_word(out, 7)) & 4294967295;
        i = i + 1;
    }
    __mind_free(out);
    let rc: i64 = check_digest_word_fold(a0, a1, a2, a3, a4, a5, a6, a7);
    assert rc == 0, "100-input kernel-hash fold mismatch at word (rc-1)";
}

fn check_digest_word_fold(a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64) -> i64 {
    if a0 != 3710717963 { return 1; }
    if a1 != 2705605701 { return 2; }
    if a2 != 1983010931 { return 3; }
    if a3 != 332744890 { return 4; }
    if a4 != 2036936210 { return 5; }
    if a5 != 2901307544 { return 6; }
    if a6 != 1121260767 { return 7; }
    if a7 != 364967855 { return 8; }
    0
}

#[test]
fn test_envelope_v2_172byte_fixture() {
    // The attestation preimage is 172 bytes (envelope v2 minus the two
    // hash slots). Pattern-filled fixture; oracle from hashlib. The real
    // field layout is pinned by evidence.mind's port (wave 4) — this test
    // anchors the LENGTH + hash path that fixture depends on.
    let rc: i64 = kat_pattern(172, 3702170513, 1642925652, 336228896, 2251440665, 155437300, 2666044994, 1668856187, 1152874523);
    assert rc == 0, "172-byte attestation preimage fixture mismatch";
}

#[test]
fn test_field_sensitivity() {
    // Flipping one preimage byte must change the digest (avalanche).
    let data: i64 = __mind_alloc(172);
    fill_pattern(data, 172);
    let out1: i64 = __mind_alloc(32);
    let out2: i64 = __mind_alloc(32);
    mn_sha256(data, 172, out1);
    let b: i64 = __mind_load_i8(data + 100) & 255;
    __mind_store_i8(data + 100, (b ^ 1) & 255);
    mn_sha256(data, 172, out2);
    let mut diff: i64 = 0;
    let mut i: i64 = 0;
    while i < 32 {
        if __mind_load_i8(out1 + i) != __mind_load_i8(out2 + i) {
            diff = 1;
        }
        i = i + 1;
    }
    __mind_free(data);
    __mind_free(out1);
    __mind_free(out2);
    assert diff == 1, "one flipped preimage byte must change the digest";
}

#[test]
fn test_output_bytes_constant() {
    assert SHA256_OUTPUT_BYTES == 32, "digest length constant is 32";
    assert SHA256_BLOCK_BYTES == 64, "block length constant is 64";
}
