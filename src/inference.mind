// Inference: tokenization, forward pass, top-K extraction with
// deterministic tie-breaking, attestation envelope emission. Ported to the
// mindc 0.10.2 dialect 2026-08-12 (wave 4 of the pure-MIND migration; the
// dormant pre-port source is preserved at src/dormant/inference.mind).
//
// Composes: tokenize_bpe -> model_encoder -> mean_pool -> scoring head
// -> extract_top_k -> canonical_result_hash -> evidence_emit_inference,
// with the ChainLog threaded so every envelope's chain_prev is the previous
// envelope's chain_curr.
//
// PORT NOTES (0.10.2 reality):
//   - NO RE-EXPORT WRAPPERS. The dormant module re-exported
//     extract_top_k / canonical_result_hash / sha256 / the top_k types at
//     the inference path. Under the merged-image discipline every fn name
//     is global, so wrappers would collide with the real definitions;
//     callers use src/top_k.mind / src/sha256.mind directly. The public
//     surface ADDED here is infer_preselect / infer_preselect_pre_tokenized
//     / infer_preselect_pre_tokenized_stateless.
//   - Request/PreselectResult/ModelWeights structs become handle
//     conventions: the catalog is the loader's 5-slot table, the weights
//     are the 18-slot model weight table plus two 32-byte hash buffers,
//     results land in caller-allocated out buffers. Result<...,
//     InferenceError> becomes the signed INF_ERR_* return convention
//     below; on success the return value is the number of top-K entries
//     written (>= 1).
//   - Option<[u8; 32]> expected_model_hash becomes (expected_mh,
//     has_expected): the pin check runs iff has_expected == 1.
//   - CLOCK DECISION (wave-3 settled): timestamp_ms is a PARAMETER. The
//     dormant read the clock inside preselect via a cfg probe; the port
//     keeps inference pure — the caller picks clock_host_now_ms(),
//     clock_counter_next(state), or clock_now_ms_with_injection(v) per
//     the src/clock.mind contract. RFC-012 note preserved: request_hash
//     records the USER-SUPPLIED tokens, not the prefix-prepended sequence.
//   - exp_h / rsqrt_h (the pinned LUT handles) are explicit parameters,
//     matching src/model.mind.

import src.lib;
import src.q16_16;
import src.sha256;
import src.top_k;
import src.tokenizer;
import src.model;
import src.evidence;
import src.chain_log;
import src.loader;

// InferenceError, flattened to negative return codes.
pub const INF_ERR_INVALID_K:       i64 = -1;
pub const INF_ERR_TOO_LONG:        i64 = -2;
pub const INF_ERR_EMPTY_CATALOG:   i64 = -3;
pub const INF_ERR_MODEL_MISMATCH:  i64 = -4;
pub const INF_ERR_ENVELOPE:        i64 = -5;

// Constant-time 32-byte hash equality.
fn inf_hash_eq(a: i64, b: i64) -> i64 {
    let mut diff: i64 = 0;
    let mut i: i64 = 0;
    while i < 32 {
        diff = diff | (__mind_load_i8(a + i) ^ __mind_load_i8(b + i));
        i = i + 1;
    }
    if diff == 0 { return 1; }
    0
}

// SHA-256 over the raw u32-LE byte stream of a token-id sequence (i64
// lanes in, 4 LE bytes per token), ascending position order. Envelope
// request_hash on the pre-tokenized entry path.
fn inf_request_hash_from_tokens(tokens: i64, n: i64, out: i64) -> i64 {
    let buf: i64 = __mind_alloc(n * 4);
    let mut i: i64 = 0;
    while i < n {
        let t: i64 = __mind_load_i64(tokens + i * 8);
        __mind_store_i8(buf + i * 4 + 0, t & 255);
        __mind_store_i8(buf + i * 4 + 1, (t >> 8) & 255);
        __mind_store_i8(buf + i * 4 + 2, (t >> 16) & 255);
        __mind_store_i8(buf + i * 4 + 3, (t >> 24) & 255);
        i = i + 1;
    }
    mn_sha256(buf, n * 4, out);
    __mind_free(buf);
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// infer_preselect_pre_tokenized — forward path on pre-tokenized input.
//
// tokens: n_tokens i64 lanes at `tokens`. cat: loader 5-slot catalog table.
// wtab/mh/th: model weight table + model_hash/tokenizer_hash buffers.
// timestamp_ms: caller-supplied clock value (see header). log: ChainLog
// handle. On success (return > 0): out_ids receives n*32 bytes, out_scores
// n i64 lanes, out_envelope the 212-byte attestation envelope; the return
// value is n. Gate order preserved from the dormant source.
//
// STRUCTURAL NOTE (defensive 0.10.2 discipline): every binding in this
// function is hoisted above the first heavy call, and cross-stage values
// move through heap boxes (countbox/errbox). This was introduced while
// chasing what presented as interpreter environment loss around heavy
// callees; root-caused 2026-08-15 to an under-sized TEST FIXTURE buffer —
// the 0.10.2 test interpreter performs no bounds checking on the memory
// intrinsics, so OOB reads silently corrupt its evaluation state (repro:
// mind-flow/target/repro-0.10.2/r11_oob_interpreter_corruption/). The
// hoisted/heap discipline is retained: it is also what makes the function
// robust under both the interpreter and the native path, and it documents
// the exact state the pipeline carries. The computation is unchanged.
// ─────────────────────────────────────────────────────────────────────────────

pub fn infer_preselect_pre_tokenized(tokens: i64, n_tokens: i64,
                                     cat: i64, wtab: i64, mh: i64, th: i64,
                                     k: i64, timestamp_ms: i64,
                                     expected_mh: i64, has_expected: i64,
                                     log: i64, exp_h: i64, rsqrt_h: i64,
                                     out_ids: i64, out_scores: i64,
                                     out_envelope: i64) -> i64 {
    // (1) k range gate.
    if k == 0 { return INF_ERR_INVALID_K; }
    if k > MAX_TOP_K { return INF_ERR_INVALID_K; }

    // (1a) Token-cap fast-fail.
    if n_tokens > MAX_REQUEST_TOKENS { return INF_ERR_TOO_LONG; }
    let total_len: i64 = QUERY_PREFIX_LEN + n_tokens;
    if total_len > MAX_REQUEST_TOKENS { return INF_ERR_TOO_LONG; }

    // ── hoisted bindings (see STRUCTURAL NOTE) ──
    let num_routes: i64 = __mind_load_i64(cat + LOADER_CAT_N * 8);
    let cat_emb: i64 = __mind_load_i64(cat + LOADER_CAT_EMB * 8);
    let cat_ids: i64 = __mind_load_i64(cat + LOADER_CAT_IDS * 8);
    let cat_prior: i64 = __mind_load_i64(cat + LOADER_CAT_PRIOR * 8);
    let cat_hash: i64 = __mind_load_i64(cat + LOADER_CAT_HASH * 8);
    let eff: i64 = __mind_alloc(total_len * 8);
    let enc_out: i64 = __mind_alloc(total_len * ENCODER_HIDDEN * 8);
    let pooled_raw: i64 = __mind_alloc(ENCODER_HIDDEN * 8);
    let pooled: i64 = __mind_alloc(ENCODER_HIDDEN * 8);
    let logits: i64 = __mind_alloc(num_routes * 8);
    let coarse: i64 = __mind_alloc(num_routes * 8);
    let mask: i64 = __mind_alloc(num_routes);
    let request_hash: i64 = __mind_alloc(32);
    let result_hash: i64 = __mind_alloc(32);
    let prev: i64 = __mind_alloc(32);
    let scratch: i64 = __mind_alloc(32);
    let countbox: i64 = __mind_alloc(8);
    let errbox: i64 = __mind_alloc(8);
    let mut i: i64 = 0;

    // RFC-012 query-prefix prepend (default QUERY_PREFIX_LEN = 0: no-op).
    while i < QUERY_PREFIX_LEN {
        __mind_store_i64(eff + i * 8, QUERY_PREFIX_TOKENS[i]);
        i = i + 1;
    }
    i = 0;
    while i < n_tokens {
        __mind_store_i64(eff + (QUERY_PREFIX_LEN + i) * 8, __mind_load_i64(tokens + i * 8));
        i = i + 1;
    }

    // (2) Empty-catalog gate.
    if num_routes == 0 {
        __mind_free(errbox);
        __mind_free(countbox);
        __mind_free(scratch);
        __mind_free(prev);
        __mind_free(result_hash);
        __mind_free(request_hash);
        __mind_free(mask);
        __mind_free(coarse);
        __mind_free(logits);
        __mind_free(pooled);
        __mind_free(pooled_raw);
        __mind_free(enc_out);
        __mind_free(eff);
        return INF_ERR_EMPTY_CATALOG;
    }

    // NOTE: the model-hash pin lives only in infer_preselect, matching the
    // dormant structure (preselect_pre_tokenized has no pin check — likely
    // a dormant oversight; preserved for fidelity, flagged here).

    // ── from here on: heap-only state transfer between stages ──

    // (4) Forward pass: encoder -> mean pool (-> RFC-010 L2 normalize when
    //     enabled) -> scoring head (-> RFC-008 Matryoshka cascade when
    //     enabled).
    model_encoder(eff, total_len, wtab, exp_h, rsqrt_h, enc_out);
    __mind_free(eff);

    model_mean_pool(enc_out, total_len, exp_h, pooled_raw);
    __mind_free(enc_out);
    if COSINE_SCORING_ENABLED == 1 {
        model_l2_normalize_pooled(pooled_raw, rsqrt_h, pooled);
    } else {
        i = 0;
        while i < ENCODER_HIDDEN {
            __mind_store_i64(pooled + i * 8, __mind_load_i64(pooled_raw + i * 8));
            i = i + 1;
        }
    }
    __mind_free(pooled_raw);

    if MATRYOSHKA_COARSE_DIM < ROUTE_EMBEDDING_DIM {
        // Coarse pass + shortlist mask + fine pass. k_coarse is used only
        // within this segment (no cross-segment env state).
        model_score_against_routes_prefix(pooled, cat_emb, num_routes,
                                          MATRYOSHKA_COARSE_DIM, coarse);
        let mut k_coarse: i64 = K_COARSE_MULTIPLIER * k;
        if k_coarse > num_routes { k_coarse = num_routes; }
        extract_top_k_mask(coarse, cat_ids, num_routes, k_coarse, mask);
        model_score_against_routes_masked(pooled, cat_emb, num_routes, mask,
                                          num_routes, MIN_Q16_16, logits);
    } else {
        model_score_against_routes(pooled, cat_emb, num_routes, logits);
    }
    __mind_free(pooled);
    __mind_free(mask);
    __mind_free(coarse);

    // (4b) RFC-002 route prior: elementwise saturating add, ascending r.
    i = 0;
    while i < num_routes {
        __mind_store_i64(logits + i * 8,
                         q16_add(__mind_load_i64(logits + i * 8),
                                 __mind_load_i64(cat_prior + i * 8)));
        i = i + 1;
    }

    // (5) Deterministic top-K (saturates at num_routes when k > num_routes).
    //     The count crosses later stage boundaries, so it lives in heap.
    __mind_store_i64(countbox, extract_top_k(logits, cat_ids, num_routes, k,
                                             out_ids, out_scores));
    __mind_free(logits);

    // (6) Envelope preimage hashes. request_hash covers the USER-SUPPLIED
    //     tokens (pre-prepend — the "honest record" contract).
    inf_request_hash_from_tokens(tokens, n_tokens, request_hash);
    canonical_result_hash(out_ids, out_scores, __mind_load_i64(countbox), result_hash);

    // (7) Envelope construction, then (8) chain-log advance. chain_prev is
    //     read BEFORE emit; append runs AFTER — reversing the order breaks
    //     the chain.
    chain_prev_for_next(log, prev);
    __mind_store_i64(errbox, evidence_emit_inference(mh, th, cat_hash,
                                                     request_hash, result_hash,
                                                     prev, timestamp_ms,
                                                     ARCH_X86_64, k,
                                                     NUMERICS_WIRE_VERSION,
                                                     out_envelope));
    __mind_free(prev);
    __mind_free(result_hash);
    __mind_free(request_hash);
    if __mind_load_i64(errbox) != EV_OK {
        __mind_free(errbox);
        __mind_free(countbox);
        __mind_free(scratch);
        return INF_ERR_ENVELOPE;
    }

    chain_log_append(log, out_envelope, ATTESTATION_BYTES, scratch);
    __mind_free(scratch);
    __mind_free(errbox);

    let out_n: i64 = __mind_load_i64(countbox);
    __mind_free(countbox);
    out_n
}

// ─────────────────────────────────────────────────────────────────────────────
// infer_preselect — full pipeline (raw bytes -> envelope). Tokenizes first;
// the tokenizer error surface maps onto InferenceError exactly as dormant
// (InputEmpty -> InvalidK, TooLong -> RequestTooLong).
// ─────────────────────────────────────────────────────────────────────────────

pub fn infer_preselect(bytes: i64, n_bytes: i64,
                       cat: i64, wtab: i64, mh: i64, th: i64,
                       k: i64, timestamp_ms: i64,
                       expected_mh: i64, has_expected: i64,
                       log: i64, exp_h: i64, rsqrt_h: i64,
                       out_ids: i64, out_scores: i64,
                       out_envelope: i64) -> i64 {
    if k == 0 { return INF_ERR_INVALID_K; }
    if k > MAX_TOP_K { return INF_ERR_INVALID_K; }
    if __mind_load_i64(cat + LOADER_CAT_N * 8) == 0 { return INF_ERR_EMPTY_CATALOG; }
    if has_expected == 1 {
        if inf_hash_eq(expected_mh, mh) == 0 { return INF_ERR_MODEL_MISMATCH; }
    }

    // Hoisted bindings (same 0.10.2 interpreter discipline as
    // infer_preselect_pre_tokenized — see its STRUCTURAL NOTE).
    let tokens: i64 = __mind_alloc(MAX_REQUEST_TOKENS * 8);
    let mut ntok: i64 = 0;
    let mut rc: i64 = 0;

    ntok = tokenize_bpe(bytes, n_bytes, tokens);
    if ntok == TOKENIZE_ERR_EMPTY {
        __mind_free(tokens);
        return INF_ERR_INVALID_K;
    }
    if ntok == TOKENIZE_ERR_TOO_LONG {
        __mind_free(tokens);
        return INF_ERR_TOO_LONG;
    }
    if ntok > MAX_REQUEST_TOKENS {
        __mind_free(tokens);
        return INF_ERR_TOO_LONG;
    }
    rc = infer_preselect_pre_tokenized(tokens, ntok, cat, wtab, mh, th,
                                       k, timestamp_ms, expected_mh,
                                       has_expected, log, exp_h, rsqrt_h,
                                       out_ids, out_scores, out_envelope);
    __mind_free(tokens);
    rc
}

// ─────────────────────────────────────────────────────────────────────────────
// infer_preselect_pre_tokenized_stateless — ephemeral-log variant. Every
// call builds a fresh ChainLog with the all-zero session id (no entropy
// consumed, BitIdentical-compatible), so the envelope's chain_prev is
// always zeros32 — a chain-of-one. Production hosts that care about
// cross-call chain continuity use infer_preselect_pre_tokenized with a
// long-lived ChainLog.
// ─────────────────────────────────────────────────────────────────────────────

pub fn infer_preselect_pre_tokenized_stateless(tokens: i64, n_tokens: i64,
                                               cat: i64, wtab: i64, mh: i64, th: i64,
                                               k: i64, timestamp_ms: i64,
                                               expected_mh: i64, has_expected: i64,
                                               exp_h: i64, rsqrt_h: i64,
                                               out_ids: i64, out_scores: i64,
                                               out_envelope: i64) -> i64 {
    let zeros16: i64 = __mind_alloc(16);
    let mut i: i64 = 0;
    let mut rc: i64 = 0;
    while i < 16 {
        __mind_store_i8(zeros16 + i, 0);
        i = i + 1;
    }
    let log: i64 = chain_log_new_with_id(zeros16);
    __mind_free(zeros16);
    rc = infer_preselect_pre_tokenized(tokens, n_tokens, cat, wtab, mh, th,
                                       k, timestamp_ms, expected_mh,
                                       has_expected, log, exp_h, rsqrt_h,
                                       out_ids, out_scores, out_envelope);
    chain_log_free(log);
    rc
}
