#[test]
fn test_kat_one_million_a() {
    // RFC 6234 million-'a' vector — exercises 15,625 consecutive blocks.
    let n: i64 = 1000000;
    let data: i64 = __mind_alloc(n);
    let mut i: i64 = 0;
    while i < n {
        __mind_store_i8(data + i, 97);
        i = i + 1;
    }
    let out: i64 = __mind_alloc(32);
    mn_sha256(data, n, out);
    let rc: i64 = check_digest(out, 3452399196, 2568289170, 2174863330, 2228698727, 4051737160, 2761367566, 74267084, 3339791568);
    __mind_free(data);
    __mind_free(out);
    assert rc == 0, "sha256(1,000,000 x 'a') mismatch at word (rc-1)";
}

// ── Padding boundaries (byte[i] = (i*7+3)&255; oracles from hashlib) ────────

#[test]
fn test_boundary_55() {
    let rc: i64 = kat_pattern(55, 3878763827, 1009200739, 2675509624, 675258035, 2464695248, 4070273046, 2190193114, 2762655499);
    assert rc == 0, "55-byte boundary (max single-block payload) mismatch";
}

#[test]
fn test_boundary_56() {
    let rc: i64 = kat_pattern(56, 1126487647, 1007695207, 4116225137, 197169029, 603531689, 657341171, 1875470565, 716991527);
    assert rc == 0, "56-byte boundary (padding spills to second block) mismatch";
}

#[test]
fn test_boundary_64() {
    let rc: i64 = kat_pattern(64, 971233206, 3050337747, 2097494744, 2602873883, 4014947369, 1980531780, 2091597627, 3783795265);
    assert rc == 0, "64-byte boundary (exact block) mismatch";
}

#[test]
fn test_boundary_65() {
    let rc: i64 = kat_pattern(65, 2865538815, 1962785577, 1830181445, 3469713486, 1361558528, 2272328637, 3565160178, 3539659102);
    assert rc == 0, "65-byte boundary (block + 1) mismatch";
}

#[test]
fn test_boundary_127() {
    let rc: i64 = kat_pattern(127, 2832350837, 3644257027, 3527968909, 2601934565, 1140116399, 3402877405, 712621444, 4204862727);
