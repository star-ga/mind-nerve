// tests/unit/test_q16_16.mind — bit-identity suite for src/q16_16.mind.
// Audit marker: S-A2 (reduction-order discipline).
//
// Ported to mindc 0.10.2 (wave 1, 2026-08-11) from
// tests/unit/dormant/test_q16_16.mind. Runs through `mindc test` on a
// merged self-contained image (mind/luts/exp_q16.mind +
// mind/luts/sqrt_q16.mind + src/q16_16.mind + this file), driven by
// tests/mindc_gate.sh leg 4 with an exact-count assertion — a
// "running 0 tests" output FAILS the gate.
//
// ORACLE PROVENANCE (done-gate d): every literal expectation below is one of
//   (a) exact Q16.16 integer arithmetic replicated in Python (truncating i64
//       division, arithmetic shifts, i32-range saturation), or
//   (b) the pinned LUT values themselves — table entries parsed directly out
//       of mind/luts/exp_q16.mind / mind/luts/sqrt_q16.mind (cross-checked
//       against the tools/gen_luts.py float64-floor formula), composed
//       through the same integer pipelines.
//   The dormant suite's six PLACEHOLDER_HASH_* determinism-oracle tests
//   (SHA-256-of-result, to be filled post-green) are ported as exact-value
//   pins of the same results — strictly stronger, same inputs.
//
// Seeded commutativity/associativity vectors: the dormant file generated
// them with a Knuth LCG (M=6364136223846793005, A=1442695040888963407,
// hi/lo xor-fold to i32). The LCG outputs are precomputed by the oracle and
// embedded as literals — identical vectors, no runtime RNG.
//
// ABI: Q16.16 values are i64 lanes, one value per 8-byte slot; LUT handles
// come from exp_q16_init() / rsqrt_q16_init() (the pinned tables).

// ── helpers (tq_ prefix: no collisions in the merged image) ─────────────────

fn tq_store(buf: i64, i: i64, v: i64) -> i64 {
    __mind_store_i64(buf + i * 8, v);
    0
}

fn tq_load(buf: i64, i: i64) -> i64 {
    __mind_load_i64(buf + i * 8)
}

// ── Section 1: q16_mul — multiply with saturation, floor truncation ─────────

#[test]
fn test_q16_mul_identity_positive_three() {
    assert q16_mul(ONE_Q16_16, THREE_Q16_16) == THREE_Q16_16, "ONE * 3.0 == 3.0";
}

#[test]
fn test_q16_mul_identity_negative_three() {
    assert q16_mul(ONE_Q16_16, NEG_THREE_Q16_16) == NEG_THREE_Q16_16, "ONE * -3.0 == -3.0";
}

#[test]
fn test_q16_mul_identity_positive_one() {
    assert q16_mul(ONE_Q16_16, ONE_Q16_16) == ONE_Q16_16, "ONE * 1.0 == 1.0";
}

#[test]
fn test_q16_mul_identity_negative_one() {
    assert q16_mul(ONE_Q16_16, NEG_ONE_Q16_16) == NEG_ONE_Q16_16, "ONE * -1.0 == -1.0";
}

#[test]
fn test_q16_mul_identity_zero() {
    assert q16_mul(ONE_Q16_16, 0) == 0, "ONE * 0 == 0";
}

#[test]
fn test_q16_mul_zero_left_positive() {
    assert q16_mul(0, THREE_Q16_16) == 0, "0 * 3.0 == 0";
}

#[test]
fn test_q16_mul_zero_left_negative() {
    assert q16_mul(0, NEG_THREE_Q16_16) == 0, "0 * -3.0 == 0";
}

#[test]
fn test_q16_mul_zero_right_positive() {
    assert q16_mul(THREE_Q16_16, 0) == 0, "3.0 * 0 == 0";
}

#[test]
fn test_q16_mul_zero_right_min() {
    assert q16_mul(MIN_Q16_16, 0) == 0, "MIN * 0 == 0";
}

#[test]
fn test_q16_mul_commutativity_seeded() {
    // The 20 dormant LCG seed pairs, precomputed by the oracle (values in
    // [-4.0, 4.0] Q16.16 so neither product saturates).
    assert q16_mul(75116, -128436) == q16_mul(-128436, 75116), "pair 0";
    assert q16_mul(153496, -102392) == q16_mul(-102392, 153496), "pair 1";
    assert q16_mul(-20972, 23224) == q16_mul(23224, -20972), "pair 2";
    assert q16_mul(-136496, -7500) == q16_mul(-7500, -136496), "pair 3";
    assert q16_mul(37656, -20608) == q16_mul(-20608, 37656), "pair 4";
    assert q16_mul(-155196, -127092) == q16_mul(-127092, -155196), "pair 5";
    assert q16_mul(241352, 176016) == q16_mul(176016, 241352), "pair 6";
    assert q16_mul(-147648, -100704) == q16_mul(-100704, -147648), "pair 7";
    assert q16_mul(18244, -84300) == q16_mul(-84300, 18244), "pair 8";
    assert q16_mul(-5948, -127860) == q16_mul(-127860, -5948), "pair 9";
    assert q16_mul(173940, 174708) == q16_mul(174708, 173940), "pair 10";
    assert q16_mul(-94868, 159376) == q16_mul(159376, -94868), "pair 11";
    assert q16_mul(255208, -217360) == q16_mul(-217360, 255208), "pair 12";
    assert q16_mul(123412, 52988) == q16_mul(52988, 123412), "pair 13";
    assert q16_mul(4464, 192580) == q16_mul(192580, 4464), "pair 14";
    assert q16_mul(-134024, 46184) == q16_mul(46184, -134024), "pair 15";
    assert q16_mul(-179656, 249024) == q16_mul(249024, -179656), "pair 16";
    assert q16_mul(-48980, -151340) == q16_mul(-151340, -48980), "pair 17";
    assert q16_mul(86772, -156652) == q16_mul(-156652, 86772), "pair 18";
    assert q16_mul(-177104, 46260) == q16_mul(46260, -177104), "pair 19";
}

#[test]
fn test_q16_mul_saturation_positive_overflow() {
    assert q16_mul(MAX_Q16_16, MAX_Q16_16) == MAX_Q16_16, "MAX*MAX clamps to MAX";
}

#[test]
fn test_q16_mul_saturation_negative_overflow() {
    assert q16_mul(MIN_Q16_16, MAX_Q16_16) == MIN_Q16_16, "MIN*MAX clamps to MIN";
}

#[test]
fn test_q16_mul_saturation_min_times_min() {
    assert q16_mul(MIN_Q16_16, MIN_Q16_16) == MAX_Q16_16, "MIN*MIN clamps to MAX";
}

#[test]
fn test_q16_mul_rounding_half_times_half() {
    // 32768 * 32768 = 1073741824; >> 16 = 16384 exactly (0.5 * 0.5 = 0.25).
    assert q16_mul(HALF_Q16_16, HALF_Q16_16) == QUARTER_Q16_16, "0.5*0.5 == 0.25";
}

#[test]
fn test_q16_mul_rounding_toward_zero_not_banker() {
    // 3 * 32768 = 98304; >> 16 = 1 remainder 32768 (exact 0.5 ULP midpoint).
    // Floor/toward-zero truncation gives 1; round-half-to-even would give 2.
    assert q16_mul(3, HALF_Q16_16) == 1, "midpoint must truncate, not round-half-even";
}

#[test]
fn test_q16_mul_determinism_oracle() {
    // Ported from the dormant PLACEHOLDER_HASH_MUL test (3.0 * 0.5 = 1.5);
    // exact-value pin replaces the to-be-filled digest.
    assert q16_mul(THREE_Q16_16, HALF_Q16_16) == 98304, "3.0 * 0.5 == 1.5";
}

// ── Section 2: q16_add — add with saturation ────────────────────────────────

#[test]
fn test_q16_add_identity_positive() {
    assert q16_add(0, THREE_Q16_16) == THREE_Q16_16, "0 + 3.0 == 3.0";
}

#[test]
fn test_q16_add_identity_negative() {
    assert q16_add(0, NEG_THREE_Q16_16) == NEG_THREE_Q16_16, "0 + -3.0 == -3.0";
}

#[test]
fn test_q16_add_identity_zero() {
    assert q16_add(0, 0) == 0, "0 + 0 == 0";
}

#[test]
fn test_q16_add_identity_min() {
    assert q16_add(0, MIN_Q16_16) == MIN_Q16_16, "0 + MIN == MIN (no wraparound)";
}

#[test]
fn test_q16_add_commutativity_seeded() {
    // 10 dormant LCG seed pairs, precomputed by the oracle.
    assert q16_add(-168397, 63854) == q16_add(63854, -168397), "pair 0";
    assert q16_add(187344, 23623) == q16_add(23623, 187344), "pair 1";
    assert q16_add(-178394, -190669) == q16_add(-190669, -178394), "pair 2";
    assert q16_add(256946, -152604) == q16_add(-152604, 256946), "pair 3";
    assert q16_add(26737, 33763) == q16_add(33763, 26737), "pair 4";
    assert q16_add(-52063, 11344) == q16_add(11344, -52063), "pair 5";
    assert q16_add(-118685, -131577) == q16_add(-131577, -118685), "pair 6";
    assert q16_add(151694, -134352) == q16_add(-134352, 151694), "pair 7";
    assert q16_add(-77781, -103371) == q16_add(-103371, -77781), "pair 8";
    assert q16_add(108433, 26754) == q16_add(26754, 108433), "pair 9";
}

#[test]
fn test_q16_add_associativity_seeded() {
    // 10 dormant LCG seed triples, precomputed by the oracle. Holds only
    // because no intermediate saturates (|values| <= 2.0).
    assert q16_add(q16_add(-10561, 69589), 38607) == q16_add(-10561, q16_add(69589, 38607)), "triple 0";
    assert q16_add(q16_add(36142, -101170), -56670) == q16_add(36142, q16_add(-101170, -56670)), "triple 1";
    assert q16_add(q16_add(111514, -73270), -20072) == q16_add(111514, q16_add(-73270, -20072)), "triple 2";
    assert q16_add(q16_add(-60397, -22318), 20429) == q16_add(-60397, q16_add(-22318, 20429)), "triple 3";
    assert q16_add(q16_add(-34683, -52289), -75459) == q16_add(-34683, q16_add(-52289, -75459)), "triple 4";
    assert q16_add(q16_add(105220, 50325), 92680) == q16_add(105220, q16_add(50325, 92680)), "triple 5";
    assert q16_add(q16_add(-89708, 18827), 124626) == q16_add(-89708, q16_add(18827, 124626)), "triple 6";
    assert q16_add(q16_add(-119275, 127372), 102623) == q16_add(-119275, q16_add(127372, 102623)), "triple 7";
    assert q16_add(q16_add(-71006, 91792), 1160) == q16_add(-71006, q16_add(91792, 1160)), "triple 8";
    assert q16_add(q16_add(129338, -119876), -83530) == q16_add(129338, q16_add(-119876, -83530)), "triple 9";
}

#[test]
fn test_q16_add_saturation_positive() {
    assert q16_add(MAX_Q16_16, ULP_Q16_16) == MAX_Q16_16, "MAX + 1 ULP clamps";
}

#[test]
fn test_q16_add_saturation_positive_large() {
    assert q16_add(MAX_Q16_16, ONE_Q16_16) == MAX_Q16_16, "MAX + 1.0 clamps";
}

#[test]
fn test_q16_add_saturation_negative() {
    assert q16_add(MIN_Q16_16, 0 - ULP_Q16_16) == MIN_Q16_16, "MIN + (-1 ULP) clamps";
}

#[test]
fn test_q16_add_saturation_negative_one() {
