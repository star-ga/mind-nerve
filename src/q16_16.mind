// Q16.16 fixed-point primitives — bit-identity contract. Ported to the
// mindc 0.10.2 dialect 2026-08-11 (wave 1 of the pure-MIND migration; the
// dormant pre-port source is preserved at src/dormant/q16_16.mind).
//
// This module is the single source of truth for every Q16.16 arithmetic
// operation reachable from `preselect`. Numerical contract (spec/numerics.md
// §1, §4, §5): all operations saturating, never wrapping; the only legal
// Q16.16 multiply is `q16_mul`; reductions are sequential left-to-right;
// exp/rsqrt/sigmoid are truncated lookup tables — no polynomial
// approximations, no interpolation. No IEEE-754 anywhere.
//
// Audit marker: S-A2 (reduction-order discipline).
//
// PORT NOTES (0.10.2 reality):
//   - The dormant `use crate::mind_nerve::{…}` const block is replaced by
//     the local const definitions below (per src/dormant/README.md port
//     table: "local consts replace use crate::{…}"). Names are unchanged so
//     downstream call-sites keep their symbols; src/lib.mind re-exports them
//     when its wave lands.
//   - `Q16_16` was `i32` in the dormant dialect. The 0.10.2 surface of this
//     repo (mind/luts, mind/kernels, src/sha256.mind) carries Q16.16 values
//     sign-extended in i64 lanes, one value per 8-byte slot; this module
//     follows that convention. `q16_sat_cast` still clamps to the exact
//     i32 range [-2^31, 2^31-1], so the numeric contract is unchanged.
//   - Slices (`&[Q16_16]`) do not exist in 0.10.2; buffers cross the API as
//     (base_addr, n) i64 handle pairs, matching mind/luts and mind/kernels.
//   - `@[determinism(…)]` / `@[reduction_order(Pinned)]` lint attributes
//     have no 0.10.2 equivalent (no shipped mindc implements E_NERVE_001..
//     005); the pinned-order discipline is enforced by construction
//     (sequential loops only) and pinned by tests/unit/test_q16_16.mind.
//
// LUT DELEGATION (operator decision 2026-08-10: "delegate, never
// duplicate"): the dormant source built its own 257-entry exp / 256-entry
// rsqrt / 257-entry sigmoid tables via aspirational const-fn evaluation —
// a second, conflicting numeric surface. The canonical, CI-pinned tables
// are mind/luts/exp_q16.mind (4096 entries, stride 256 over [-16.0, 0.0])
// and the 16384-entry rsqrt table + 3 Newton steps in
// mind/luts/sqrt_q16.mind. This module DELEGATES all table lookups to those
// pinned tables (callers pass the table handles). Bit-identity oracle for
// every LUT-backed value below is the pinned table content itself
// (tests/unit/test_q16_16.mind pins exact values lifted from those tables
// via the integer pipelines replicated in the oracle script).
//
// The imports below name the end-state root-project module paths
// (mind/luts/… relative to the repo-root Mind.toml port target). The
// current per-file gate (tests/mindc_gate.sh leg 4) checks and tests this
// module as a merged self-contained image with the two luts files
// concatenated, where the same symbols resolve in-module.

import mind.luts.exp_q16;
import mind.luts.sqrt_q16;

// ─────────────────────────────────────────────────────────────────────────────
// Constants (formerly lib.mind's; see PORT NOTES above).
// ─────────────────────────────────────────────────────────────────────────────

// Q16.16 values are carried sign-extended in i64 lanes (see PORT NOTES).
pub type Q16_16 = i64;

pub const ONE_Q16_16:       Q16_16 = 65536;          // 1.0
pub const MAX_Q16_16:       Q16_16 = 2147483647;     // i32::MAX
pub const MIN_Q16_16:       Q16_16 = -2147483648;    // i32::MIN
pub const NEG_ONE_Q16_16:   Q16_16 = -65536;         // -1.0
pub const HALF_Q16_16:      Q16_16 = 32768;          // 0.5
pub const QUARTER_Q16_16:   Q16_16 = 16384;          // 0.25
pub const THREE_Q16_16:     Q16_16 = 196608;         // 3.0
pub const NEG_THREE_Q16_16: Q16_16 = -196608;        // -3.0
pub const ULP_Q16_16:       Q16_16 = 1;              // 1 ULP
pub const Q16_FRAC_BITS:    i64    = 16;

// ─────────────────────────────────────────────────────────────────────────────
// Boundary helpers — widening and saturating cast.
//
// These are the only two legal ways to cross the i32-range ↔ i64-accumulator
// boundary inside the inference path. Every saturating arithmetic operator
// below funnels through them so the clamp logic exists in exactly one place.
// ─────────────────────────────────────────────────────────────────────────────

// The accumulator type for any reduction that may transiently exceed
// [MIN_Q16_16, MAX_Q16_16] is i64. Q16.16 values are already carried in i64
// lanes on this surface, so widening is the identity; the function remains
// the named boundary anchor for callers and audits.
pub fn q16_widen(v: Q16_16) -> i64 {
    v
}

// Saturating cast i64 → Q16.16. Values above MAX_Q16_16 clamp to MAX_Q16_16;
// values below MIN_Q16_16 clamp to MIN_Q16_16. No wrapping under any input,
// including i64::MAX and i64::MIN.
pub fn q16_sat_cast(wide: i64) -> Q16_16 {
    if wide > MAX_Q16_16 {
        return MAX_Q16_16;
    }
    if wide < MIN_Q16_16 {
        return MIN_Q16_16;
    }
    wide
}

// ─────────────────────────────────────────────────────────────────────────────
// Section 1: core saturating arithmetic.
// ─────────────────────────────────────────────────────────────────────────────

// Saturating add. The i64 sum of two i32-range values never overflows i64;
// clamp at the i32 boundary using `q16_sat_cast`.
pub fn q16_add(a: Q16_16, b: Q16_16) -> Q16_16 {
    let wide: i64 = q16_widen(a) + q16_widen(b);
    q16_sat_cast(wide)
}

// Saturating sub. Same widen-then-clamp pattern.
pub fn q16_sub(a: Q16_16, b: Q16_16) -> Q16_16 {
    let wide: i64 = q16_widen(a) - q16_widen(b);
    q16_sat_cast(wide)
}

// Saturating negate. `q16_neg(MIN_Q16_16)` does not have a representable
// positive counterpart — it must saturate to MAX_Q16_16. All other inputs
// negate exactly.
pub fn q16_neg(a: Q16_16) -> Q16_16 {
    let wide: i64 = 0 - q16_widen(a);
    q16_sat_cast(wide)
}

// Saturating absolute value. `q16_abs(MIN_Q16_16)` saturates to MAX_Q16_16
// for the same reason as `q16_neg`.
pub fn q16_abs(a: Q16_16) -> Q16_16 {
    if a >= 0 {
        return a;
    }
    q16_neg(a)
}

// The only legal Q16.16 multiply (spec §4):
//
//   1. Widen both operands to i64 (the i64 product of two i32-range values
//      is always representable in i64; the multiply itself never wraps).
//   2. Arithmetic right shift by 16 — sign-extending — to undo the
//      Q16.16 fractional-bit scaling. Truncates toward negative infinity
//      for negative magnitudes; no rounding correction. Spec §4 property 2.
//   3. Saturate to [MIN_Q16_16, MAX_Q16_16]. Spec §4 property 3.
//
// MIND guarantees `>>` on signed integers is arithmetic right shift with
// sign extension (lowers to LLVM `ashr`), the same primitive on every
// backend; no C-style implementation-defined behaviour.
pub fn q16_mul(a: Q16_16, b: Q16_16) -> Q16_16 {
    let wide: i64 = q16_widen(a) * q16_widen(b);
    let shifted: i64 = wide >> Q16_FRAC_BITS;
    q16_sat_cast(shifted)
}

// Saturating divide: `q16_div_sat(num, denom) = (num << 16) / denom` with
// saturation. Divide-by-zero saturates to the boundary that matches the
// sign of the dividend (spec §4 "Companion saturating operators"). MIND i64
// division truncates toward zero (Rust semantics), matching the dormant
// contract.
pub fn q16_div_sat(num: Q16_16, denom: Q16_16) -> Q16_16 {
    if denom == 0 {
        if num >= 0 { return MAX_Q16_16; }
        return MIN_Q16_16;
    }
    let widened: i64 = q16_widen(num) << Q16_FRAC_BITS;
    let q: i64 = widened / q16_widen(denom);
    q16_sat_cast(q)
}

// ─────────────────────────────────────────────────────────────────────────────
// Section 2: pinned reductions.
//
// Each reduction is sequential left-to-right over a (base_addr, n) buffer of
// i64-lane Q16.16 values (8-byte stride).
// ─────────────────────────────────────────────────────────────────────────────

// Sequential sum (`acc = 0; acc = q16_add(acc, x[i]) for i in 0..N`). Each
// step saturates independently — saturation is not associative, which is
// the property `test_q16_dot_sequential_reduction_order` regression-guards.
pub fn q16_sum(xs_addr: i64, n: i64) -> Q16_16 {
    let mut acc: Q16_16 = 0;
    let mut i: i64 = 0;
    while i < n {
        acc = q16_add(acc, __mind_load_i64(xs_addr + i * 8));
        i = i + 1;
    }
    acc
}

// Alias requested by upstream callers — same body, same pinned order.
pub fn q16_sum_pinned(xs_addr: i64, n: i64) -> Q16_16 {
    q16_sum(xs_addr, n)
}

// Sequential max. Initial accumulator is MIN_Q16_16 so any input element
// beats it on first iteration. Tie-break is "lower index wins" implicitly
// (we update only on strict `>`).
pub fn q16_max(xs_addr: i64, n: i64) -> Q16_16 {
    let mut acc: Q16_16 = MIN_Q16_16;
    let mut i: i64 = 0;
    while i < n {
        let x: Q16_16 = __mind_load_i64(xs_addr + i * 8);
        if x > acc { acc = x; }
        i = i + 1;
    }
    acc
}

// Sequential min. Diagnostics only; not on the forward path. Spec §2.
pub fn q16_min(xs_addr: i64, n: i64) -> Q16_16 {
    let mut acc: Q16_16 = MAX_Q16_16;
    let mut i: i64 = 0;
    while i < n {
        let x: Q16_16 = __mind_load_i64(xs_addr + i * 8);
        if x < acc { acc = x; }
        i = i + 1;
    }
    acc
}

// Dot product: elementwise `q16_mul`, then sequential `q16_sum` order. Both
// stages are sequential left-to-right. Callers pass the shared length; the
// dormant "missing tail treated as zeros" case collapses to n == 0, which
// returns the additive identity 0.
pub fn q16_dot(a_addr: i64, b_addr: i64, n: i64) -> Q16_16 {
    let mut acc: Q16_16 = 0;
    let mut i: i64 = 0;
    while i < n {
        let prod: Q16_16 = q16_mul(
            __mind_load_i64(a_addr + i * 8),
            __mind_load_i64(b_addr + i * 8));
        acc = q16_add(acc, prod);
        i = i + 1;
    }
    acc
}

// Alias requested by upstream callers.
pub fn q16_dot_pinned(a_addr: i64, b_addr: i64, n: i64) -> Q16_16 {
    q16_dot(a_addr, b_addr, n)
}

// ─────────────────────────────────────────────────────────────────────────────
// Section 3: q16_exp — DELEGATED to the pinned 4096-entry table
// (mind/luts/exp_q16.mind). Truncated lookup, no interpolation.
//
// Pinned semantics (identical shape to the dormant contract, finer table):
//   - x >= 0     -> ONE_Q16_16
//   - x <= -16.0 -> table[0]
//   - else       -> table[(x + 16*ONE) / 256]   (exact floor; shifted > 0)
//
// The dormant 257-entry/stride-4096 table is NOT ported (delegate, never
// duplicate); all mid-domain values are bound to the pinned table, which is
// the CI bit-identity contract.
// ─────────────────────────────────────────────────────────────────────────────

pub const Q16_EXP_DOMAIN_LO: Q16_16 = -1048576;      // -16.0 in Q16.16

pub fn q16_exp(exp_h: i64, x: Q16_16) -> Q16_16 {
    exp_q16_lookup(exp_h, x)
}

// Alias for the LUT name requested by upstream callers.
pub fn q16_exp_lut(exp_h: i64, x: Q16_16) -> Q16_16 {
    q16_exp(exp_h, x)
}

// ─────────────────────────────────────────────────────────────────────────────
// Section 4: q16_rsqrt — DELEGATED to the pinned 16384-entry table + 3
// Newton steps (mind/luts/sqrt_q16.mind `rsqrt_q16_newton`).
//
// Sentinel preserved from the dormant contract: x <= 0 returns MAX_Q16_16
// (the inference path never legitimately rsqrts a non-positive value;
// layer-norm guards by adding epsilon to variance before this call). The
// guard lives here so the Newton pipeline below it never sees the sentinel
// path's overflowing intermediate products.
//
// Pinned domain (0, 256.0] — a superset of the dormant table's (0, 32.0];
// all values are bound to the pinned table.
// ─────────────────────────────────────────────────────────────────────────────

pub fn q16_rsqrt(rsqrt_h: i64, x: Q16_16) -> Q16_16 {
    if x <= 0 {
        return MAX_Q16_16;
    }
    rsqrt_q16_newton(rsqrt_h, x)
}

// Alias for the LUT name requested by upstream callers.
pub fn q16_rsqrt_lut(rsqrt_h: i64, x: Q16_16) -> Q16_16 {
    q16_rsqrt(rsqrt_h, x)
}

// ─────────────────────────────────────────────────────────────────────────────
// Section 5: q16_softmax — 5-stage pinned pipeline (spec §5).
//
// Stages, in order:
//   (1) max          — sequential left-to-right
//   (2) max-subtract — elementwise; uses q16_sub (saturating)
//   (3) exp lookup   — elementwise; truncated pinned LUT (no interpolation)
//   (4) sum          — sequential left-to-right
//   (5) divide       — elementwise; q16_div_sat
//
// Stage order and per-stage arithmetic are identical to the dormant
// pipeline; only the exp table is the pinned 4096-entry one (delegation).
// Intermediates reuse `out_addr` (stage 2 writes shifted, stage 3
// overwrites with exp, stage 5 overwrites with the quotient) — the values
// produced are exactly the dormant stage values. Returns 0; n == 0 is the
// identity (no writes), matching the dormant empty-slice case.
// ─────────────────────────────────────────────────────────────────────────────

pub fn q16_softmax(exp_h: i64, x_addr: i64, out_addr: i64, n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }

    // Stage 1: max (sequential).
    let m: Q16_16 = q16_max(x_addr, n);

    // Stage 2: shift = x[i] - m (saturating sub), staged into out.
    let mut i: i64 = 0;
    while i < n {
        let shifted: Q16_16 = q16_sub(__mind_load_i64(x_addr + i * 8), m);
        __mind_store_i64(out_addr + i * 8, shifted);
        i = i + 1;
    }

    // Stage 3: exp lookup (truncated, deterministic), in place over out.
    i = 0;
    while i < n {
        let e: Q16_16 = q16_exp(exp_h, __mind_load_i64(out_addr + i * 8));
        __mind_store_i64(out_addr + i * 8, e);
        i = i + 1;
    }

    // Stage 4: sequential sum.
    let s: Q16_16 = q16_sum(out_addr, n);

    // Stage 5: elementwise saturating divide, in place over out.
    i = 0;
    while i < n {
        let q: Q16_16 = q16_div_sat(__mind_load_i64(out_addr + i * 8), s);
        __mind_store_i64(out_addr + i * 8, q);
        i = i + 1;
    }
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// Section 6: q16_layernorm — pinned 5-stage pipeline (spec §2 layernorm row).
//
// Stages:
//   (1) mean             — q16_sum / N
//   (2) sum_of_squares   — sequential, (x[i] - mean)^2 accumulator
//   (3) variance         — sum_of_squares / N
//   (4) rsqrt            — q16_rsqrt(variance + epsilon)  [pinned table]
//   (5) normalize        — (x[i] - mean) * rsqrt_value
//
// Identical to the dormant pipeline; only the rsqrt table is the pinned
// 16384-entry + 3-Newton one (delegation). The gamma/beta affine remains
// composed at the call-site (model.mind wave), as documented dormant-side.
// ─────────────────────────────────────────────────────────────────────────────

// Epsilon for variance stabilization. 1 ULP in Q16.16.
pub const Q16_LAYERNORM_EPSILON: Q16_16 = 1;

pub fn q16_layernorm(rsqrt_h: i64, x_addr: i64, out_addr: i64, n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }

    // Stage 1: mean = sum / N, computed as (sum << 16) / (N << 16) = sum / N
    // via q16_div_sat. Division truncates toward zero (MIND i64 division),
    // matching the dormant contract's integer-division discipline.
    let sum_x: Q16_16 = q16_sum(x_addr, n);
    let n_q16: Q16_16 = n * ONE_Q16_16;
    let mean:  Q16_16 = q16_div_sat(sum_x, n_q16);

    // Stage 2: sum of squared deviations. Sequential left-to-right.
    let mut sum_sq: Q16_16 = 0;
    let mut i: i64 = 0;
    while i < n {
        let dev: Q16_16 = q16_sub(__mind_load_i64(x_addr + i * 8), mean);
        let sq:  Q16_16 = q16_mul(dev, dev);
        sum_sq = q16_add(sum_sq, sq);
        i = i + 1;
    }

    // Stage 3: variance = sum_sq / N.
    let variance: Q16_16 = q16_div_sat(sum_sq, n_q16);

    // Stage 4: rsqrt(variance + epsilon). Epsilon prevents the LUT sentinel
    // branch and keeps the function total when variance == 0.
    let var_eps:   Q16_16 = q16_add(variance, Q16_LAYERNORM_EPSILON);
    let inv_stddev: Q16_16 = q16_rsqrt(rsqrt_h, var_eps);

    // Stage 5: normalize. Elementwise (x[i] - mean) * inv_stddev.
    // The zero-deviation special case is preserved from the dormant source:
    // (0 * anything) = 0 exactly, avoiding a saturation surprise when
    // `inv_stddev` is large.
    i = 0;
    while i < n {
        let dev: Q16_16 = q16_sub(__mind_load_i64(x_addr + i * 8), mean);
        if dev == 0 {
            __mind_store_i64(out_addr + i * 8, 0);
        } else {
            __mind_store_i64(out_addr + i * 8, q16_mul(dev, inv_stddev));
        }
        i = i + 1;
    }
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// Section 6b: q16_rmsnorm — pinned pipeline (dormant RFC-013 section).
//
// Root-mean-square normalization. Stages:
//   (1) sum_of_squares — self-dot over the hidden axis, sequential
//   (2) mean_squared   — q16_div_sat(sum_of_squares, N_q16)
//   (3) inv_rms        — q16_rsqrt(mean_squared + epsilon)  [pinned table]
//   (4) normalize      — elementwise saturating q16_mul(x[i], inv_rms)
//
// Identical to the dormant pipeline; only the rsqrt table is pinned
// (delegation). The NORMALIZATION_KIND selection lives in
// encoder_kernels.mind (wave 4), as documented dormant-side.
// ─────────────────────────────────────────────────────────────────────────────

// Epsilon for RMS stabilization. 1 ULP in Q16.16.
pub const Q16_RMSNORM_EPSILON: Q16_16 = 1;

pub fn q16_rmsnorm(rsqrt_h: i64, x_addr: i64, out_addr: i64, n: i64) -> i64 {
    if n <= 0 {
        return 0;
    }

    // Stage 1: sum of squares via self-dot (sequential left-to-right).
    let sum_sq: Q16_16 = q16_dot_pinned(x_addr, x_addr, n);

    // Stage 2: mean_squared = sum_sq / N.
    let n_q16:   Q16_16 = n * ONE_Q16_16;
    let mean_sq: Q16_16 = q16_div_sat(sum_sq, n_q16);

    // Stage 3: inv-rms = rsqrt(mean_sq + epsilon).
    let ms_eps:  Q16_16 = q16_add(mean_sq, Q16_RMSNORM_EPSILON);
    let inv_rms: Q16_16 = q16_rsqrt(rsqrt_h, ms_eps);

    // Stage 4: normalize (elementwise scale). The x[i] == 0 special case is
    // preserved from the dormant source: exactly 0 regardless of inv_rms.
    let mut i: i64 = 0;
    while i < n {
        let x: Q16_16 = __mind_load_i64(x_addr + i * 8);
        if x == 0 {
            __mind_store_i64(out_addr + i * 8, 0);
        } else {
            __mind_store_i64(out_addr + i * 8, q16_mul(x, inv_rms));
        }
        i = i + 1;
    }
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// Section 7: q16_sigmoid_lut — truncated-lookup CONTRACT, composed over the
// pinned exp table (delegation; no second table is materialised).
//
// Domain: input x in Q16.16 covering [-8.0, +8.0]. Inputs ≤ -8.0 clamp to
// the value at -8.0; inputs ≥ +8.0 clamp to the value at +8.0.
//
// Construction (no IEEE-754, no polynomial, no interpolation — spec §5),
// identical to the dormant table-build formula but evaluated per call over
// the pinned exp table instead of a second 257-entry table:
//   sigmoid(x) = exp(x) / (1 + exp(x)) for x ≤ 0
//   sigmoid(x) = 1 - sigmoid(-x)       for x > 0   (symmetric reflection)
// Both halves compose `q16_exp` (the pinned truncated LUT) with
// `q16_div_sat` — pure integer, deterministic, cross-arch bit-identical.
// The dormant table's entries were defined by exactly this composition over
// its own exp table; clamped endpoints therefore match the dormant table[0]
// / table[256] semantics one-for-one.
// ─────────────────────────────────────────────────────────────────────────────

pub const Q16_SIGMOID_DOMAIN_LO: Q16_16 = -524288;   // -8.0 in Q16.16
pub const Q16_SIGMOID_DOMAIN_HI: Q16_16 =  524288;   // +8.0 in Q16.16

pub fn q16_sigmoid_lut(exp_h: i64, x: Q16_16) -> Q16_16 {
    let mut xc: Q16_16 = x;
    if xc < Q16_SIGMOID_DOMAIN_LO { xc = Q16_SIGMOID_DOMAIN_LO; }
    if xc > Q16_SIGMOID_DOMAIN_HI { xc = Q16_SIGMOID_DOMAIN_HI; }
    if xc <= 0 {
        // sigmoid(x) = exp(x) / (1 + exp(x)) for x ≤ 0.
        let ex:  Q16_16 = q16_exp(exp_h, xc);
        let den: Q16_16 = q16_add(ONE_Q16_16, ex);
        return q16_div_sat(ex, den);
    }
    // sigmoid(x) = 1 / (1 + exp(-x)) via symmetric reflection of the
    // x ≤ 0 case, preserving bit-identity with the lower half.
    let neg_x: Q16_16 = q16_neg(xc);
    let ex:    Q16_16 = q16_exp(exp_h, neg_x);
    let den:   Q16_16 = q16_add(ONE_Q16_16, ex);
    let lo:    Q16_16 = q16_div_sat(ex, den);
    q16_sub(ONE_Q16_16, lo)
}
