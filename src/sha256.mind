// SHA-256 — RFC 6234 / FIPS 180-4, pure MIND. Ported to the mindc 0.10.2
// dialect 2026-08-10 (wave 1 of the pure-MIND migration; the dormant
// pre-port source is preserved at src/dormant/sha256.mind).
//
// Audit anchor: FP-9 (hash-chain integrity), S-5 (catalog binding).
//
// All five call-sites in mind-nerve route through this module:
//   (1) catalog hash binding         (request -> RouteCatalog.hash)
//   (2) request hash                 (inference -> envelope.request_hash)
//   (3) canonical result hash        (top-K -> envelope.result_hash)
//   (4) attestation chain extension  (chain_curr = SHA-256(fields || chain_prev))
//   (5) deterministic tie-break      (SHA-256(route_id) ascending in extract_top_k)
//
// DELEGATION (operator decision 2026-08-10: "delegate, never duplicate"):
// the compression function is NOT re-implemented here. The dormant source
// carried a second in-tree SHA-256 over u32-typed arrays; the canonical,
// CI-pinned implementation is the compiler-bundled `std.sha256`
// (`pub fn sha256(in_addr, in_len, out_addr)` — u32-on-i64 with explicit
// `& 0xFFFFFFFF` masking, verified below against the FIPS KATs including
// the 1,000,000-byte 'a' vector). One hash = one implementation = one
// drift surface. This module is the mind-nerve-named entry point and the
// audit documentation anchor; nothing else.
//
// ABI (0.10.2 reality): byte buffers cross the API as raw i64 handles,
// one byte per offset, matching mind/luts, mind/kernels, and std.sha256
// itself. The dormant `&[u8]` / `[u8; 32]` surface was unusable: 0.10.2
// has no `&[u8; N]` reference-to-array type, no `[0u8; N]` repeat
// literal, and the `mindc test` interpreter cannot construct slices —
// an API that cannot be executed cannot be gated.
//
// deferred: the dormant streaming API (sha256_init/update/final over a
//   Sha256State struct) is NOT ported. Every mind-nerve preimage is
//   materialised by its caller before hashing (the 172-byte attestation
//   preimage is the largest), so one-shot hashing over the in-memory
//   buffer is functionally equivalent.
//   upgrade path: if a future call-site must hash without materialising
//   (e.g. a multi-MiB catalog streamed from disk), add a handle-based
//   streaming wrapper around std.sha256's block function here — with
//   chunking-equivalence KATs — rather than reviving the struct API.

import std.sha256;

// Digest size in bytes. Pinned absolutely by
// tests/unit/test_sha256.mind::test_output_bytes_constant.
pub const SHA256_OUTPUT_BYTES: i64 = 32;
pub const SHA256_BLOCK_BYTES:  i64 = 64;

// Hash `len` bytes at `data_addr`, write the 32-byte big-endian digest to
// `out_addr` (caller-allocated, >= 32 bytes, one byte per offset).
// Returns 0. Wrapping (mod 2^32) arithmetic lives inside std.sha256;
// callers never observe it.
//
// Determinism: pure integer arithmetic, no floats, no clocks, no
// allocation. The digest is part of the attestation chain — one diverging
// byte breaks downstream replay verification — so this fn is pinned by
// the FIPS KAT suite in tests/unit/test_sha256.mind.
pub fn mn_sha256(data_addr: i64, len: i64, out_addr: i64) -> i64 {
    sha256(data_addr, len, out_addr)
}

// Convenience: hash into a FRESH 32-byte heap buffer and return its
// handle. Caller owns the handle and must `__mind_free` it.
pub fn mn_sha256_alloc(data_addr: i64, len: i64) -> i64 {
    let out: i64 = __mind_alloc(32);
    sha256(data_addr, len, out);
    out
}
