#[test]
fn test_q16_softmax_max_trick_uniform_zero() {
    // Large constant input (MAX/4); x - max == 0 so the path equals the
    // all-zeros case with a different max-subtraction path.
    let big: i64 = MAX_Q16_16 / 4;   // 536870911
    let h: i64 = exp_q16_init();
    let x: i64 = __mind_alloc(24);
    let y: i64 = __mind_alloc(24);
    tq_store(x, 0, big);
    tq_store(x, 1, big);
    tq_store(x, 2, big);
    q16_softmax(h, x, y, 3);
    assert tq_load(y, 0) == 21845, "uniform [0]";
    assert tq_load(y, 1) == 21845, "uniform [1]";
    assert tq_load(y, 2) == 21845, "uniform [2]";
    let s: i64 = q16_sum(y, 3);
    assert q16_abs(q16_sub(s, ONE_Q16_16)) <= ULP_Q16_16, "sum within 1 ULP of ONE";
    __mind_free(x);
    __mind_free(y);
    exp_q16_free(h);
}

#[test]
fn test_q16_softmax_output_length_preserved() {
    // ABI adaptation: output length is the caller-supplied n (the handle ABI
    // carries no length). Ported assertion: n = 5 processes without error
    // and every written output is a valid (non-negative) probability.
    let h: i64 = exp_q16_init();
    let x: i64 = __mind_alloc(40);
    let y: i64 = __mind_alloc(40);
    tq_store(x, 0, ONE_Q16_16);
    tq_store(x, 1, HALF_Q16_16);
    tq_store(x, 2, 0);
    tq_store(x, 3, NEG_ONE_Q16_16);
    tq_store(x, 4, THREE_Q16_16);
    let rc: i64 = q16_softmax(h, x, y, 5);
    assert rc == 0, "softmax returns 0";
    let mut i: i64 = 0;
    while i < 5 {
        assert tq_load(y, i) >= 0, "probability must be non-negative";
        i = i + 1;
    }
    __mind_free(x);
    __mind_free(y);
    exp_q16_free(h);
}

#[test]
fn test_q16_softmax_determinism_oracle() {
    // Ported from the dormant PLACEHOLDER_HASH_SOFTMAX test; exact pins.
    // x = [1.0, 0.5, -1.0, 3.0] -> oracle [7177, 4352, 971, 53034].
    let h: i64 = exp_q16_init();
    let x: i64 = __mind_alloc(32);
    let y: i64 = __mind_alloc(32);
    tq_store(x, 0, ONE_Q16_16);
    tq_store(x, 1, HALF_Q16_16);
    tq_store(x, 2, NEG_ONE_Q16_16);
    tq_store(x, 3, THREE_Q16_16);
    q16_softmax(h, x, y, 4);
    assert tq_load(y, 0) == 7177, "softmax oracle [0]";
    assert tq_load(y, 1) == 4352, "softmax oracle [1]";
    assert tq_load(y, 2) == 971, "softmax oracle [2]";
    assert tq_load(y, 3) == 53034, "softmax oracle [3]";
    __mind_free(x);
    __mind_free(y);
    exp_q16_free(h);
}

// ── Section 5: q16_layernorm — pinned pipeline over the pinned rsqrt LUT ────

#[test]
fn test_q16_layernorm_zero_input() {
    let h: i64 = rsqrt_q16_init();
    let x: i64 = __mind_alloc(32);
    let y: i64 = __mind_alloc(32);
    tq_store(x, 0, 0);
    tq_store(x, 1, 0);
    tq_store(x, 2, 0);
    tq_store(x, 3, 0);
    q16_layernorm(h, x, y, 4);
    assert tq_load(y, 0) == 0, "zeros [0]";
    assert tq_load(y, 1) == 0, "zeros [1]";
    assert tq_load(y, 2) == 0, "zeros [2]";
    assert tq_load(y, 3) == 0, "zeros [3]";
    __mind_free(x);
    __mind_free(y);
    rsqrt_q16_free(h);
}

#[test]
fn test_q16_layernorm_constant_input() {
    let h: i64 = rsqrt_q16_init();
    let x: i64 = __mind_alloc(32);
    let y: i64 = __mind_alloc(32);
    tq_store(x, 0, THREE_Q16_16);
    tq_store(x, 1, THREE_Q16_16);
    tq_store(x, 2, THREE_Q16_16);
    tq_store(x, 3, THREE_Q16_16);
