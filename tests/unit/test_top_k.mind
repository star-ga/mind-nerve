// ── Section 7: negative score handling ──────────────────────────────────────

#[test]
fn test_top_k_negative_scores_ordering() {
    // scores [-3,-5,-1,-4] Q16.16, k=2 → the two least-negative: -1 then -3.
    let ids: i64 = __mind_alloc(128);
    let scores: i64 = __mind_alloc(32);
    let sbuf: i64 = __mind_alloc(16);
    let mut i: i64 = 0;
    while i < 4 {
        tt_mkid(ids, i, sbuf, tt_str_negroute(sbuf, i));
        i = i + 1;
    }
    __mind_store_i64(scores + 0, -196608);
    __mind_store_i64(scores + 8, -327680);
    __mind_store_i64(scores + 16, -65536);
    __mind_store_i64(scores + 24, -262144);
    let out_ids: i64 = __mind_alloc(64);
    let out_scores: i64 = __mind_alloc(16);

    let n: i64 = extract_top_k(scores, ids, 4, 2, out_ids, out_scores);
    assert n == 2, "two entries";
    assert tt_slot_is(out_ids, 0, sbuf, tt_str_negroute(sbuf, 2)) == 1, "neg_route_2 (score -1) first";
    assert tt_slot_is(out_ids, 1, sbuf, tt_str_negroute(sbuf, 0)) == 1, "neg_route_0 (score -3) second";
    assert __mind_load_i64(out_scores + 0) == -65536, "score -1.0";
    assert __mind_load_i64(out_scores + 8) == -196608, "score -3.0";

    let h: i64 = __mind_alloc(32);
    canonical_result_hash(out_ids, out_scores, n, h);
    // Oracle 32f88804… (published 2026-05-13, re-verified vs hashlib 2026-08-11;
    // i32-LE two's-complement score serialization).
    let rc: i64 = tt_check_hash(h, 855148548, 1419981094, 365116234, 2916537506, 2042622105, 626121915, 601690508, 1171762840);
    assert rc == 0, "canonical_result_hash negative oracle";
    __mind_free(h);
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_all_negative_scores() {
    // scores [-10,-1,-100,-2], k=3 → [n1, n3, n0]. No clamp-to-zero.
    let ids: i64 = __mind_alloc(128);
    let scores: i64 = __mind_alloc(32);
    let sbuf: i64 = __mind_alloc(16);
    let mut i: i64 = 0;
    while i < 4 {
        tt_mkid(ids, i, sbuf, tt_str_n(sbuf, i));
        i = i + 1;
    }
    __mind_store_i64(scores + 0, -655360);
    __mind_store_i64(scores + 8, -65536);
    __mind_store_i64(scores + 16, -6553600);
    __mind_store_i64(scores + 24, -131072);
    let out_ids: i64 = __mind_alloc(96);
    let out_scores: i64 = __mind_alloc(24);

    let n: i64 = extract_top_k(scores, ids, 4, 3, out_ids, out_scores);
    assert n == 3, "three entries";
    assert tt_slot_is(out_ids, 0, sbuf, tt_str_n(sbuf, 1)) == 1, "n1 (score -1) first";
    assert tt_slot_is(out_ids, 1, sbuf, tt_str_n(sbuf, 3)) == 1, "n3 (score -2) second";
    assert tt_slot_is(out_ids, 2, sbuf, tt_str_n(sbuf, 0)) == 1, "n0 (score -10) third";
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

// ── Section 8: score precision boundary (ULP) ───────────────────────────────
// Comparison is exact i64 on the raw Q16.16 value — never float, never
// epsilon. A 1-ULP difference must order.

#[test]
fn test_top_k_ulp_precision_k1() {
    // ulp_route_a = 131073 (2.0 + 1 ULP), ulp_route_b = 131072 (exactly 2.0).
    let ids: i64 = __mind_alloc(64);
    let scores: i64 = __mind_alloc(16);
    let sbuf: i64 = __mind_alloc(16);
    tt_mkid(ids, 0, sbuf, tt_str_ulp(sbuf, 97));
    tt_mkid(ids, 1, sbuf, tt_str_ulp(sbuf, 98));
    __mind_store_i64(scores + 0, 131073);
    __mind_store_i64(scores + 8, 131072);
    let out_ids: i64 = __mind_alloc(32);
    let out_scores: i64 = __mind_alloc(8);

    let n: i64 = extract_top_k(scores, ids, 2, 1, out_ids, out_scores);
    assert n == 1, "one entry";
    assert tt_slot_is(out_ids, 0, sbuf, tt_str_ulp(sbuf, 97)) == 1, "ulp_route_a wins by 1 ULP";
    assert __mind_load_i64(out_scores) == 131073, "raw score preserved";

    let h: i64 = __mind_alloc(32);
    canonical_result_hash(out_ids, out_scores, n, h);
    // Oracle bc7a9280… (published 2026-05-13, re-verified vs hashlib 2026-08-11).
    let rc: i64 = tt_check_hash(h, 3162149504, 2798060902, 4172885027, 4084429729, 3144450675, 4178997191, 4004225703, 496644115);
    assert rc == 0, "canonical_result_hash ulp k1 oracle";
    __mind_free(h);
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_ulp_equal_scores_tiebreak() {
    // Both 131072; SHA-256("ulp_route_b") = 326d… < SHA-256("ulp_route_a")
    // = a776… → ulp_route_b wins.
    let ids: i64 = __mind_alloc(64);
    let scores: i64 = __mind_alloc(16);
    let sbuf: i64 = __mind_alloc(16);
    tt_mkid(ids, 0, sbuf, tt_str_ulp(sbuf, 97));
    tt_mkid(ids, 1, sbuf, tt_str_ulp(sbuf, 98));
    __mind_store_i64(scores + 0, 131072);
    __mind_store_i64(scores + 8, 131072);
    let out_ids: i64 = __mind_alloc(32);
    let out_scores: i64 = __mind_alloc(8);

    let n: i64 = extract_top_k(scores, ids, 2, 1, out_ids, out_scores);
    assert n == 1, "one entry";
    assert tt_slot_is(out_ids, 0, sbuf, tt_str_ulp(sbuf, 98)) == 1, "ulp_route_b wins the tie-break";
    assert __mind_load_i64(out_scores) == 131072, "raw score preserved";
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

// ── Section 9: extract_top_k_mask (RFC-008 coarse shortlist) ────────────────
// The mask selects the SAME set as extract_top_k, reported positionally.
// The all-tied corpus is the adversarial case: the route_id lex tie-break
// is the sole discriminator.

#[test]
fn test_top_k_mask_basic_k3() {
    let ids: i64 = __mind_alloc(320);
    let scores: i64 = __mind_alloc(80);
    let sbuf: i64 = __mind_alloc(16);
    tt_cat10(ids, scores, sbuf);
    let mask: i64 = __mind_alloc(10);

    extract_top_k_mask(scores, ids, 10, 3, mask);
    assert tt_popcount(mask, 10) == 3, "popcount 3";
    assert __mind_load_i8(mask + 0) == 1, "route_0 shortlisted";
    assert __mind_load_i8(mask + 1) == 1, "route_1 shortlisted";
    assert __mind_load_i8(mask + 2) == 1, "route_2 shortlisted";
    let mut i: i64 = 3;
    while i < 10 {
        assert __mind_load_i8(mask + i) == 0, "outside top-3 not shortlisted";
        i = i + 1;
    }
    __mind_free(mask);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_mask_selects_by_score_not_position() {
    // scores [1,7,0,3,9,2,6,4]: highest three are idx 4 (9), idx 1 (7),
    // idx 6 (6) — the mask must follow score, not catalog position.
    let ids: i64 = __mind_alloc(256);
    let scores: i64 = __mind_alloc(64);
    let sbuf: i64 = __mind_alloc(16);
    let mut i: i64 = 0;
    while i < 8 {
        tt_mkid(ids, i, sbuf, tt_str_r(sbuf, i));
        i = i + 1;
    }
    __mind_store_i64(scores + 0, 65536);
    __mind_store_i64(scores + 8, 458752);
    __mind_store_i64(scores + 16, 0);
    __mind_store_i64(scores + 24, 196608);
    __mind_store_i64(scores + 32, 589824);
    __mind_store_i64(scores + 40, 131072);
    __mind_store_i64(scores + 48, 393216);
    __mind_store_i64(scores + 56, 262144);
    let mask: i64 = __mind_alloc(8);

    extract_top_k_mask(scores, ids, 8, 3, mask);
    assert tt_popcount(mask, 8) == 3, "popcount 3";
    assert __mind_load_i8(mask + 4) == 1, "score 9 at index 4 shortlisted";
    assert __mind_load_i8(mask + 1) == 1, "score 7 at index 1 shortlisted";
    assert __mind_load_i8(mask + 6) == 1, "score 6 at index 6 shortlisted";
    assert __mind_load_i8(mask + 0) == 0, "index 0 not shortlisted";
    assert __mind_load_i8(mask + 2) == 0, "index 2 not shortlisted";
    assert __mind_load_i8(mask + 3) == 0, "index 3 not shortlisted";
    assert __mind_load_i8(mask + 5) == 0, "index 5 not shortlisted";
    assert __mind_load_i8(mask + 7) == 0, "index 7 not shortlisted";
    __mind_free(mask);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

