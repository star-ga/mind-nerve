// tests/unit/test_wordpiece.mind — WordPiece tokenizer oracle suite for
// mind/kernels/wordpiece.mind (Task 1, 2026-08-15).
//
// Every expected id sequence below was captured from the HF fast tokenizer
// (BERT WordPiece, the runtime checkpoint) on 2026-08-15 — including
// [CLS]/[SEP] wrapping, [UNK] mapping, non-ASCII normalization, punctuation
// isolation, and 256-id truncation. Runs through `mindc test` on a merged
// image (mind/luts/vocab_wp.mind + mind/kernels/wordpiece.mind + this
// file), driven by tests/mindc_gate.sh leg 16 with an exact-count
// assertion — a "running 0 tests" output FAILS the gate.
//
// Byte fixtures are raw UTF-8 (one byte per __mind_store_i8) with the
// source string noted in a comment.

// Run wp_tokenize over a byte fixture and compare against expected ids.
// Returns 0 on match, 1000 on wrong count, else 1 + first mismatch index.
fn wt_run(t: i64, buf: i64, n: i64, exp: i64, n_exp: i64) -> i64 {
    let out: i64 = __mind_alloc(300 * 8);
    let rc: i64 = wp_tokenize(t, buf, n, out, 300);
    if rc != n_exp {
        __mind_free(out);
        return 1000;
    }
    let mut i: i64 = 0;
    while i < n_exp {
        if __mind_load_i64(out + i * 8) != __mind_load_i64(exp + i * 8) {
            __mind_free(out);
            return 1 + i;
        }
        i = i + 1;
    }
    __mind_free(out);
    0
}

#[test]
fn test_wp_case_0() {
    // 'hello world'
    let t: i64 = wp_tables_init();
    let buf: i64 = __mind_alloc(11);
    __mind_store_i8(buf + 0, 104);
    __mind_store_i8(buf + 1, 101);
    __mind_store_i8(buf + 2, 108);
    __mind_store_i8(buf + 3, 108);
    __mind_store_i8(buf + 4, 111);
    __mind_store_i8(buf + 5, 32);
    __mind_store_i8(buf + 6, 119);
    __mind_store_i8(buf + 7, 111);
    __mind_store_i8(buf + 8, 114);
    __mind_store_i8(buf + 9, 108);
    __mind_store_i8(buf + 10, 100);
    let exp: i64 = __mind_alloc(4 * 8);
    __mind_store_i64(exp + 0, 101);
    __mind_store_i64(exp + 8, 7592);
    __mind_store_i64(exp + 16, 2088);
    __mind_store_i64(exp + 24, 102);
    let rc: i64 = wt_run(t, buf, 11, exp, 4);
    assert rc == 0, "case 0 byte-ids match HF";
    __mind_free(exp);
    __mind_free(buf);
    wp_tables_free(t);
}

