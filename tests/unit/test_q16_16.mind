#[test]
fn test_q16_layernorm_output_length_preserved() {
    // ABI adaptation (see softmax length test): n = 4 processes and writes.
    let h: i64 = rsqrt_q16_init();
    let x: i64 = __mind_alloc(32);
    let y: i64 = __mind_alloc(32);
    tq_store(x, 0, ONE_Q16_16);
    tq_store(x, 1, HALF_Q16_16);
    tq_store(x, 2, NEG_ONE_Q16_16);
    tq_store(x, 3, THREE_Q16_16);
    let rc: i64 = q16_layernorm(h, x, y, 4);
    assert rc == 0, "layernorm returns 0";
    __mind_free(x);
    __mind_free(y);
    rsqrt_q16_free(h);
}

#[test]
fn test_q16_layernorm_no_panic_on_near_zero_variance() {
    // Two elements differing by 1 ULP. Dormant asserted completion only;
    // the oracle value [0, 26] is pinned here (strictly stronger).
    let h: i64 = rsqrt_q16_init();
    let x: i64 = __mind_alloc(16);
    let y: i64 = __mind_alloc(16);
    tq_store(x, 0, 0);
    tq_store(x, 1, ULP_Q16_16);
    let rc: i64 = q16_layernorm(h, x, y, 2);
    assert rc == 0, "layernorm returns 0";
    assert tq_load(y, 0) == 0, "near-zero-var [0]";
    assert tq_load(y, 1) == 26, "near-zero-var [1]";
    __mind_free(x);
    __mind_free(y);
    rsqrt_q16_free(h);
}

#[test]
fn test_q16_layernorm_determinism_oracle() {
    // Ported from the dormant PLACEHOLDER_HASH_LAYERNORM test; exact pins.
    // x = [1.0, 0.5, -1.0, 3.0] -> oracle [5725, -17178, -85889, 97339].
    let h: i64 = rsqrt_q16_init();
    let x: i64 = __mind_alloc(32);
    let y: i64 = __mind_alloc(32);
    tq_store(x, 0, ONE_Q16_16);
    tq_store(x, 1, HALF_Q16_16);
    tq_store(x, 2, NEG_ONE_Q16_16);
    tq_store(x, 3, THREE_Q16_16);
    q16_layernorm(h, x, y, 4);
    assert tq_load(y, 0) == 5725, "layernorm oracle [0]";
    assert tq_load(y, 1) == 0 - 17178, "layernorm oracle [1]";
    assert tq_load(y, 2) == 0 - 85889, "layernorm oracle [2]";
    assert tq_load(y, 3) == 97339, "layernorm oracle [3]";
    __mind_free(x);
    __mind_free(y);
    rsqrt_q16_free(h);
}

// ── Section 6: q16_sat_cast + q16_widen — accumulator boundary handling ─────

#[test]
fn test_q16_sat_cast_roundtrip_positive() {
    assert q16_sat_cast(q16_widen(THREE_Q16_16)) == THREE_Q16_16, "roundtrip +3.0";
}

#[test]
fn test_q16_sat_cast_roundtrip_negative() {
    assert q16_sat_cast(q16_widen(NEG_THREE_Q16_16)) == NEG_THREE_Q16_16, "roundtrip -3.0";
}

#[test]
fn test_q16_sat_cast_roundtrip_zero() {
    assert q16_sat_cast(q16_widen(0)) == 0, "roundtrip 0";
}

#[test]
fn test_q16_sat_cast_roundtrip_max() {
    assert q16_sat_cast(q16_widen(MAX_Q16_16)) == MAX_Q16_16, "roundtrip MAX";
}

#[test]
fn test_q16_sat_cast_roundtrip_min() {
    assert q16_sat_cast(q16_widen(MIN_Q16_16)) == MIN_Q16_16, "roundtrip MIN";
}

#[test]
fn test_q16_sat_cast_positive_saturation() {
    assert q16_sat_cast(2147483648) == MAX_Q16_16, "MAX+1 clamps to MAX";
}

#[test]
fn test_q16_sat_cast_positive_saturation_large() {
    assert q16_sat_cast(9223372036854775807) == MAX_Q16_16, "i64::MAX clamps to MAX";
}

#[test]
fn test_q16_sat_cast_negative_saturation() {
    assert q16_sat_cast(0 - 2147483649) == MIN_Q16_16, "MIN-1 clamps to MIN";
}

#[test]
fn test_q16_sat_cast_negative_saturation_large() {
    // i64::MIN written as 0 - i64::MAX - 1 (the positive literal overflows).
    assert q16_sat_cast(0 - 9223372036854775807 - 1) == MIN_Q16_16, "i64::MIN clamps to MIN";
}

#[test]
fn test_q16_widen_preserves_sign_positive() {
    assert q16_widen(THREE_Q16_16) == 196608, "widen sign-extends positive";
}

#[test]
fn test_q16_widen_preserves_sign_negative() {
    assert q16_widen(NEG_THREE_Q16_16) == 0 - 196608, "widen sign-extends negative";
}

#[test]
fn test_q16_widen_min() {
    let wide: i64 = q16_widen(MIN_Q16_16);
    assert wide < 0, "widen(MIN) must be negative";
    assert wide == 0 - 2147483648, "widen(MIN) exact i64 representation";
}

#[test]
fn test_q16_sat_cast_boundary_in_range_positive() {
    assert q16_sat_cast(2147483647) == MAX_Q16_16, "exactly MAX is not saturated";
}

#[test]
fn test_q16_sat_cast_boundary_in_range_negative() {
    assert q16_sat_cast(0 - 2147483648) == MIN_Q16_16, "exactly MIN is not saturated";
}

#[test]
fn test_q16_sat_cast_determinism_oracle() {
    // Ported from the dormant PLACEHOLDER_HASH_SAT_CAST test (3.0 * 3.0 raw
    // product >> 16 = 9.0 = 589824); exact-value pin.
    let acc: i64 = 196608 * 196608;
    assert q16_sat_cast(acc >> 16) == 589824, "sat_cast oracle == 9.0";
}

// ── Section 7: LUT delegation — exp (oracle = pinned mind/luts tables) ──────

#[test]
fn test_q16_exp_zero() {
    let h: i64 = exp_q16_init();
    assert q16_exp(h, 0) == ONE_Q16_16, "exp(0) == 1.0 (clamp)";
    exp_q16_free(h);
}

#[test]
fn test_q16_exp_clamp_high() {
    let h: i64 = exp_q16_init();
    assert q16_exp(h, 123456) == ONE_Q16_16, "x >= 0 clamps to ONE";
    exp_q16_free(h);
}

#[test]
fn test_q16_exp_clamp_low() {
    let h: i64 = exp_q16_init();
    // x <= -16.0 returns pinned table[0] == 0.
    assert q16_exp(h, 0 - 2000000) == 0, "x <= -16.0 returns table[0]";
    exp_q16_free(h);
}

#[test]
fn test_q16_exp_exact_stride_hit() {
    // x = -8.0 = -524288 -> idx (524288)/256 = 2048 exactly; pinned
    // table[2048] == 21 (floor(exp(-8.0) * 65536)).
    let h: i64 = exp_q16_init();
    assert q16_exp(h, Q16_SIGMOID_DOMAIN_LO) == 21, "exp(-8.0) == table[2048]";
    exp_q16_free(h);
}

#[test]
fn test_q16_exp_interior_minus_one() {
    // x = -1.0 = -65536 -> idx 3840; pinned table[3840] == 24109.
    let h: i64 = exp_q16_init();
    assert q16_exp(h, NEG_ONE_Q16_16) == 24109, "exp(-1.0) == table[3840]";
    exp_q16_free(h);
}

#[test]
fn test_q16_exp_interior_minus_half() {
    // x = -0.5 = -32768 -> idx 3968; pinned table[3968] == 39749.
    let h: i64 = exp_q16_init();
    assert q16_exp(h, 0 - HALF_Q16_16) == 39749, "exp(-0.5) == table[3968]";
    exp_q16_free(h);
}

#[test]
fn test_q16_exp_lut_alias() {
    let h: i64 = exp_q16_init();
    assert q16_exp_lut(h, NEG_ONE_Q16_16) == q16_exp(h, NEG_ONE_Q16_16), "alias == base";
    exp_q16_free(h);
}

// ── Section 8: LUT delegation — rsqrt (oracle = pinned table + 3 Newton) ────

#[test]
fn test_q16_rsqrt_sentinel_zero() {
    let h: i64 = rsqrt_q16_init();
    assert q16_rsqrt(h, 0) == MAX_Q16_16, "rsqrt(0) == MAX sentinel";
    rsqrt_q16_free(h);
}

#[test]
fn test_q16_rsqrt_sentinel_negative() {
    let h: i64 = rsqrt_q16_init();
    assert q16_rsqrt(h, 0 - 65536) == MAX_Q16_16, "rsqrt(neg) == MAX sentinel";
    rsqrt_q16_free(h);
}

#[test]
fn test_q16_rsqrt_one() {
    // Oracle: pinned table seed + 3 Newton steps at x = 1.0 -> 65536 exactly.
    let h: i64 = rsqrt_q16_init();
    assert q16_rsqrt(h, ONE_Q16_16) == 65536, "rsqrt(1.0) == 1.0";
    rsqrt_q16_free(h);
}

#[test]
fn test_q16_rsqrt_three() {
    // Oracle: rsqrt(3.0) -> 37837 (1/sqrt(3) = 0.57735... * 65536 = 37837.4).
    let h: i64 = rsqrt_q16_init();
    assert q16_rsqrt(h, THREE_Q16_16) == 37837, "rsqrt(3.0) == 37837";
    rsqrt_q16_free(h);
}

#[test]
fn test_q16_rsqrt_clamp_high() {
    // x = 256.0 = domain_hi -> last-entry seed; Newton converges to 4096
    // (rsqrt(256) = 1/16 = 0.0625 exactly).
    let h: i64 = rsqrt_q16_init();
    assert q16_rsqrt(h, 16777216) == 4096, "rsqrt(256.0) == 0.0625";
    rsqrt_q16_free(h);
}

#[test]
fn test_q16_rsqrt_lut_alias() {
    let h: i64 = rsqrt_q16_init();
    assert q16_rsqrt_lut(h, THREE_Q16_16) == q16_rsqrt(h, THREE_Q16_16), "alias == base";
    rsqrt_q16_free(h);
}

// ── Section 9: q16_sigmoid_lut — composed over the pinned exp table ─────────

#[test]
fn test_q16_sigmoid_domain_lo() {
    // x = -8.0 and x < -8.0 both clamp to the -8.0 composition:
    // exp(-8.0) = 21; div_sat(21, 65536 + 21) = 20.
    let h: i64 = exp_q16_init();
    assert q16_sigmoid_lut(h, Q16_SIGMOID_DOMAIN_LO) == 20, "sigmoid(-8.0) == 20";
    assert q16_sigmoid_lut(h, 0 - 600000) == 20, "below-domain clamps to -8.0 value";
    exp_q16_free(h);
}

#[test]
fn test_q16_sigmoid_minus_one() {
    // exp(-1.0) = 24109; div_sat(24109, 89645) = 17625.
    let h: i64 = exp_q16_init();
    assert q16_sigmoid_lut(h, NEG_ONE_Q16_16) == 17625, "sigmoid(-1.0) == 17625";
    exp_q16_free(h);
}

#[test]
fn test_q16_sigmoid_zero() {
    // exp(0) = 65536; div_sat(65536, 131072) = 32768 exactly (0.5).
    let h: i64 = exp_q16_init();
    assert q16_sigmoid_lut(h, 0) == 32768, "sigmoid(0) == 0.5";
    exp_q16_free(h);
}

#[test]
fn test_q16_sigmoid_plus_one() {
    // Reflection: ONE - sigmoid(-1.0) = 65536 - 17625 = 47911.
    let h: i64 = exp_q16_init();
    assert q16_sigmoid_lut(h, ONE_Q16_16) == 47911, "sigmoid(+1.0) == 47911";
    exp_q16_free(h);
}

#[test]
fn test_q16_sigmoid_domain_hi() {
    // x = +8.0 and x > +8.0 both clamp: ONE - 20 = 65516.
    let h: i64 = exp_q16_init();
    assert q16_sigmoid_lut(h, Q16_SIGMOID_DOMAIN_HI) == 65516, "sigmoid(+8.0) == 65516";
    assert q16_sigmoid_lut(h, 600000) == 65516, "above-domain clamps to +8.0 value";
    exp_q16_free(h);
}

#[test]
fn test_q16_sigmoid_symmetry() {
    // s(-x) + s(x) == ONE exactly, by the reflection construction.
    let h: i64 = exp_q16_init();
    let s: i64 = q16_add(q16_sigmoid_lut(h, NEG_ONE_Q16_16), q16_sigmoid_lut(h, ONE_Q16_16));
    assert s == ONE_Q16_16, "s(-x) + s(x) == 1.0";
    exp_q16_free(h);
}

// ── Section 10: q16_rmsnorm — pinned pipeline over the pinned rsqrt LUT ─────
// (The dormant test file carried no rmsnorm coverage; these two tests anchor
// the ported pipeline's zero and constant-input behaviour, oracle-pinned.)

#[test]
fn test_q16_rmsnorm_zero_input() {
    let h: i64 = rsqrt_q16_init();
    let x: i64 = __mind_alloc(32);
    let y: i64 = __mind_alloc(32);
    tq_store(x, 0, 0);
    tq_store(x, 1, 0);
    tq_store(x, 2, 0);
    tq_store(x, 3, 0);
    q16_rmsnorm(h, x, y, 4);
    assert tq_load(y, 0) == 0, "rmsnorm zeros [0]";
    assert tq_load(y, 1) == 0, "rmsnorm zeros [1]";
    assert tq_load(y, 2) == 0, "rmsnorm zeros [2]";
    assert tq_load(y, 3) == 0, "rmsnorm zeros [3]";
    __mind_free(x);
    __mind_free(y);
    rsqrt_q16_free(h);
}

#[test]
fn test_q16_rmsnorm_constant_input() {
    // x = [3.0; 4]: sum_sq = 4 * 9.0 = 36.0; mean_sq = 9.0 = 589824;
    // rsqrt(589824 + 1) via pinned table + Newton; out = q16_mul(3.0, inv).
    // Oracle: 65538 per element (RMSNorm preserves constant-input sign and
    // magnitude up to fixed-point rounding — the documented spec behaviour).
    let h: i64 = rsqrt_q16_init();
    let x: i64 = __mind_alloc(32);
    let y: i64 = __mind_alloc(32);
    tq_store(x, 0, THREE_Q16_16);
    tq_store(x, 1, THREE_Q16_16);
    tq_store(x, 2, THREE_Q16_16);
    tq_store(x, 3, THREE_Q16_16);
    q16_rmsnorm(h, x, y, 4);
    assert tq_load(y, 0) == 65538, "rmsnorm const [0]";
    assert tq_load(y, 1) == 65538, "rmsnorm const [1]";
    assert tq_load(y, 2) == 65538, "rmsnorm const [2]";
    assert tq_load(y, 3) == 65538, "rmsnorm const [3]";
    __mind_free(x);
    __mind_free(y);
    rsqrt_q16_free(h);
}
