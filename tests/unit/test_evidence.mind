#[test]
fn test_chain_entry_kind_discriminates_chain_curr() {
    let z: i64 = ev_zeros32();
    let e1: i64 = __mind_alloc(212);
    let e2: i64 = __mind_alloc(212);
    let e3: i64 = __mind_alloc(212);
    let cc1: i64 = __mind_alloc(32);
    let cc2: i64 = __mind_alloc(32);
    let cc3: i64 = __mind_alloc(32);
    let r1: i64 = ev_mk_verify(e1, cc1, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r1 == EV_OK, "inference";
    let r2: i64 = ev_mk_verify(e2, cc2, 3, 4, 5, 5, 1, 1000000, ENTRY_MODEL_LOAD, z, REASON_CONTINUATION);
    assert r2 == EV_OK, "model load";
    let r3: i64 = ev_mk_verify(e3, cc3, 3, 4, 5, 5, 1, 1000000, ENTRY_CATALOG_LOAD, z, REASON_CONTINUATION);
    assert r3 == EV_OK, "catalog load";
    let d12: i64 = 1 - ev_hash_eq(cc1, cc2);
    let d13: i64 = 1 - ev_hash_eq(cc1, cc3);
    let d23: i64 = 1 - ev_hash_eq(cc2, cc3);
    assert d12 == 1, "inference != model_load chain_curr";
    assert d13 == 1, "inference != catalog_load chain_curr";
    assert d23 == 1, "model_load != catalog_load chain_curr";
    __mind_free(cc3);
    __mind_free(cc2);
    __mind_free(cc1);
    __mind_free(e3);
    __mind_free(e2);
    __mind_free(e1);
    __mind_free(z);
}

// ── §5: chain reset semantics (audit A6 closure) ────────────────────────────

#[test]
fn test_chain_reset_reason_does_not_fork_cryptographic_chain() {
    let z: i64 = ev_zeros32();
    let ea: i64 = __mind_alloc(212);
    let eb: i64 = __mind_alloc(212);
    let ec: i64 = __mind_alloc(212);
    let cca: i64 = __mind_alloc(32);
    let ccb: i64 = __mind_alloc(32);
    let ccc: i64 = __mind_alloc(32);

    let ra: i64 = ev_mk_verify(ea, cca, 3, 208, 209, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert ra == EV_OK, "envelope A";
    // B: catalog_changed annotation, chain_prev still A.chain_curr.
    let rb: i64 = ev_mk_verify(eb, ccb, 255, 224, 225, 5, 1, 1000001, ENTRY_INFERENCE, cca, REASON_CATALOG_CHANGED);
    assert rb == EV_OK, "envelope B — chain unbroken by reset annotation";
    let pb: i64 = ev_hash_eq(eb + OFFSET_CHAIN_PREV, cca);
    assert pb == 1, "B.chain_prev == A.chain_curr";
    assert ev_read_u16_le(eb, OFFSET_CHAIN_RESET_REASON) == 2, "B carries CatalogChanged";
    let rc: i64 = ev_mk_verify(ec, ccc, 255, 240, 241, 5, 1, 1000002, ENTRY_INFERENCE, ccb, REASON_CONTINUATION);
    assert rc == EV_OK, "envelope C continues from B";
    let pc: i64 = ev_hash_eq(ec + OFFSET_CHAIN_PREV, ccb);
    assert pc == 1, "C.chain_prev == B.chain_curr";
    __mind_free(ccc);
    __mind_free(ccb);
    __mind_free(cca);
    __mind_free(ec);
    __mind_free(eb);
    __mind_free(ea);
    __mind_free(z);
}

#[test]
fn test_envelope_chain_reset_reasons_parse() {
    // All four discriminants round-trip (dormant §5 parse suite, folded).
    // Reason reads are let-bound BEFORE the next emit overwrites `out`
    // (r9 deferred-assert discipline).
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let cc: i64 = __mind_alloc(32);
    let r0: i64 = ev_mk_verify(out, cc, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    let reason0: i64 = ev_read_u16_le(out, OFFSET_CHAIN_RESET_REASON);
    let r1: i64 = ev_mk_verify(out, cc, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_MODEL_SWAP);
    let reason1: i64 = ev_read_u16_le(out, OFFSET_CHAIN_RESET_REASON);
    let r2: i64 = ev_mk_verify(out, cc, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CATALOG_CHANGED);
    let reason2: i64 = ev_read_u16_le(out, OFFSET_CHAIN_RESET_REASON);
    let r3: i64 = ev_mk_verify(out, cc, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CLOCK_RESET);
    let reason3: i64 = ev_read_u16_le(out, OFFSET_CHAIN_RESET_REASON);
    assert r0 == EV_OK, "continuation parses";
    assert reason0 == 0, "reason 0";
    assert r1 == EV_OK, "model_swap parses";
    assert reason1 == 1, "reason 1";
    assert r2 == EV_OK, "catalog_changed parses";
    assert reason2 == 2, "reason 2";
    assert r3 == EV_OK, "clock_reset parses";
    assert reason3 == 3, "reason 3";
    __mind_free(cc);
    __mind_free(out);
    __mind_free(z);
}

// ── §6: version field ───────────────────────────────────────────────────────

#[test]
fn test_envelope_version_2_is_accepted() {
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let cc: i64 = __mind_alloc(32);
    let rc: i64 = ev_mk_verify(out, cc, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert rc == EV_OK, "v2 accepted";
    assert __mind_load_i8(out + OFFSET_VERSION) == 2, "version byte is 2";
    __mind_free(cc);
    __mind_free(out);
    __mind_free(z);
}

#[test]
fn test_envelope_version_1_is_rejected() {
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let cc: i64 = __mind_alloc(32);
    let erc: i64 = ev_mk(out, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert erc == EV_OK, "emit ok";
    __mind_store_i8(out + OFFSET_VERSION, 1);
    let vrc: i64 = evidence_verify(out, 212, z, cc);
    assert vrc == EV_ERR_VERSION, "v1 rejected";
    __mind_free(cc);
    __mind_free(out);
    __mind_free(z);
}

#[test]
fn test_envelope_version_99_is_rejected_as_unknown() {
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let cc: i64 = __mind_alloc(32);
    let erc: i64 = ev_mk(out, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert erc == EV_OK, "emit ok";
    __mind_store_i8(out + OFFSET_VERSION, 99);
    let vrc: i64 = evidence_verify(out, 212, z, cc);
    assert vrc == EV_ERR_VERSION, "v99 rejected";
    __mind_free(cc);
    __mind_free(out);
    __mind_free(z);
}

// ── §7: reserved field ──────────────────────────────────────────────────────

#[test]
fn test_envelope_reserved_must_be_zero() {
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let cc: i64 = __mind_alloc(32);
    let erc: i64 = ev_mk(out, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert erc == EV_OK, "emit ok";
    __mind_store_i8(out + OFFSET_RESERVED, 170);
    let vrc: i64 = evidence_verify(out, 212, z, cc);
    assert vrc == EV_ERR_RESERVED, "non-zero reserved rejected";
    __mind_free(cc);
    __mind_free(out);
    __mind_free(z);
}

#[test]
fn test_envelope_emit_sets_reserved_to_zero() {
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let erc: i64 = ev_mk(out, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert erc == EV_OK, "emit ok";
    assert __mind_load_i8(out + OFFSET_RESERVED) == 0, "reserved written zero";
    __mind_free(out);
    __mind_free(z);
}

// ── §8: wire_version binding (audit A4) ─────────────────────────────────────

#[test]
fn test_chain_wire_version_enters_chain_curr() {
    let z: i64 = ev_zeros32();
    let e1: i64 = __mind_alloc(212);
    let e2: i64 = __mind_alloc(212);
    let cc1: i64 = __mind_alloc(32);
    let cc2: i64 = __mind_alloc(32);
    let r1: i64 = ev_mk_verify(e1, cc1, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r1 == EV_OK, "wire v1";
    let r2: i64 = ev_mk_verify(e2, cc2, 3, 4, 5, 5, 2, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r2 == EV_OK, "wire v2";
    let ne: i64 = 1 - ev_hash_eq(cc1, cc2);
    assert ne == 1, "wire_version enters chain_curr (no cross-phase replay)";
    __mind_free(cc2);
    __mind_free(cc1);
    __mind_free(e2);
    __mind_free(e1);
    __mind_free(z);
}

// ── §9: k binding (audit A4) ────────────────────────────────────────────────

#[test]
fn test_chain_k_enters_chain_curr() {
    let z: i64 = ev_zeros32();
    let e1: i64 = __mind_alloc(212);
    let e2: i64 = __mind_alloc(212);
    let cc1: i64 = __mind_alloc(32);
    let cc2: i64 = __mind_alloc(32);
    let r1: i64 = ev_mk_verify(e1, cc1, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r1 == EV_OK, "k5";
    let r2: i64 = ev_mk_verify(e2, cc2, 3, 4, 5, 64, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r2 == EV_OK, "k64";
    let ne: i64 = 1 - ev_hash_eq(cc1, cc2);
    assert ne == 1, "k enters chain_curr";
    __mind_free(cc2);
    __mind_free(cc1);
    __mind_free(e2);
    __mind_free(e1);
    __mind_free(z);
}

#[test]
fn test_chain_k5_envelope_cannot_be_replayed_as_k64() {
    let z: i64 = ev_zeros32();
    let e5: i64 = __mind_alloc(212);
    let e64: i64 = __mind_alloc(212);
    let cc5: i64 = __mind_alloc(32);
    let cc64: i64 = __mind_alloc(32);
    let r5: i64 = ev_mk_verify(e5, cc5, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r5 == EV_OK, "k5 envelope";
    assert ev_read_u32_le(e5, OFFSET_K) == 5, "k5 reads 5";
    // Adversarial splice: a k=64 envelope claiming k5's chain_curr as its
    // predecessor. It verifies (chain continuity is intact) but its
    // chain_curr differs — the hash encodes k, so the envelopes can never
    // be mistaken for each other.
    let r64: i64 = ev_mk_verify(e64, cc64, 3, 4, 5, 64, 1, 1000001, ENTRY_INFERENCE, cc5, REASON_CONTINUATION);
    assert r64 == EV_OK, "k64 envelope";
    assert ev_read_u32_le(e64, OFFSET_K) == 64, "k64 reads 64";
    let ne: i64 = 1 - ev_hash_eq(cc5, cc64);
    assert ne == 1, "k5 chain_curr != k64 chain_curr";
    __mind_free(cc64);
    __mind_free(cc5);
    __mind_free(e64);
    __mind_free(e5);
    __mind_free(z);
}

// ── §10: tokenizer_hash binding (audit A4) ──────────────────────────────────

#[test]
fn test_chain_tokenizer_hash_enters_chain_curr() {
    let z: i64 = ev_zeros32();
    let m: i64 = ev_fixture(1);
    let t1: i64 = ev_fixture(170);
    let t2: i64 = ev_fixture(187);
    let c: i64 = ev_fixture(3);
    let q: i64 = ev_fixture(4);
    let r: i64 = ev_fixture(5);
    let e1: i64 = __mind_alloc(212);
    let e2: i64 = __mind_alloc(212);
    let cc1: i64 = __mind_alloc(32);
    let cc2: i64 = __mind_alloc(32);
    let erc1: i64 = evidence_emit(m, t1, c, q, r, z, 5, 1, ARCH_X86_64, 1000000, ENTRY_INFERENCE, REASON_CONTINUATION, e1);
    assert erc1 == EV_OK, "emit t1";
    let erc2: i64 = evidence_emit(m, t2, c, q, r, z, 5, 1, ARCH_X86_64, 1000000, ENTRY_INFERENCE, REASON_CONTINUATION, e2);
    assert erc2 == EV_OK, "emit t2";
    let v1: i64 = evidence_verify(e1, 212, z, cc1);
    assert v1 == EV_OK, "verify t1";
    let v2: i64 = evidence_verify(e2, 212, z, cc2);
    assert v2 == EV_OK, "verify t2";
    let ne: i64 = 1 - ev_hash_eq(cc1, cc2);
    assert ne == 1, "tokenizer_hash enters chain_curr";
    __mind_free(cc2);
    __mind_free(cc1);
    __mind_free(e2);
    __mind_free(e1);
    __mind_free(r);
    __mind_free(q);
    __mind_free(c);
    __mind_free(t2);
    __mind_free(t1);
    __mind_free(m);
    __mind_free(z);
}

#[test]
fn test_chain_tokenizer_swap_produces_fresh_chain_link() {
    // Same model, same request, different BPE table (32k vs 48k candidate).
    let z: i64 = ev_zeros32();
    let m: i64 = ev_fixture(1);
    let t32: i64 = ev_fixture(192);
    let t48: i64 = ev_fixture(193);
    let c: i64 = ev_fixture(3);
    let q: i64 = ev_fixture(4);
    let r: i64 = ev_fixture(5);
    let e1: i64 = __mind_alloc(212);
    let e2: i64 = __mind_alloc(212);
    let cc1: i64 = __mind_alloc(32);
    let cc2: i64 = __mind_alloc(32);
    let v1: i64 = evidence_emit(m, t32, c, q, r, z, 5, 1, ARCH_X86_64, 1000000, ENTRY_INFERENCE, REASON_CONTINUATION, e1);
    assert v1 == EV_OK, "emit 32k";
    let v2: i64 = evidence_emit(m, t48, c, q, r, z, 5, 1, ARCH_X86_64, 1000000, ENTRY_INFERENCE, REASON_CONTINUATION, e2);
    assert v2 == EV_OK, "emit 48k";
    let w1: i64 = evidence_verify(e1, 212, z, cc1);
    assert w1 == EV_OK, "verify 32k";
    let w2: i64 = evidence_verify(e2, 212, z, cc2);
    assert w2 == EV_OK, "verify 48k";
    let ne: i64 = 1 - ev_hash_eq(cc1, cc2);
    assert ne == 1, "tokenizer swap produces a fresh chain link";
    __mind_free(cc2);
    __mind_free(cc1);
    __mind_free(e2);
    __mind_free(e1);
    __mind_free(r);
    __mind_free(q);
    __mind_free(c);
    __mind_free(t48);
    __mind_free(t32);
    __mind_free(m);
    __mind_free(z);
}

// ── §11: edge cases and error paths ─────────────────────────────────────────

#[test]
fn test_envelope_verify_rejects_bad_lengths() {
    let z: i64 = ev_zeros32();
    let buf: i64 = __mind_alloc(300);
    ev_fill(buf, 300, 0);
    let cc: i64 = __mind_alloc(32);
    let r0: i64 = evidence_verify(buf, 0, z, cc);
    assert r0 == EV_ERR_LENGTH, "empty rejected";
    let r1: i64 = evidence_verify(buf, 100, z, cc);
    assert r1 == EV_ERR_LENGTH, "truncated rejected";
    let r2: i64 = evidence_verify(buf, 300, z, cc);
    assert r2 == EV_ERR_LENGTH, "oversized rejected (no trailing garbage)";
    let r3: i64 = evidence_verify(buf, 211, z, cc);
    assert r3 == EV_ERR_LENGTH, "one short rejected";
    let r4: i64 = evidence_verify(buf, 213, z, cc);
    assert r4 == EV_ERR_LENGTH, "one over rejected";
    __mind_free(cc);
    __mind_free(buf);
    __mind_free(z);
}

#[test]
fn test_envelope_verify_rejects_unknown_entry_kind() {
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let cc: i64 = __mind_alloc(32);
    let erc: i64 = ev_mk(out, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert erc == EV_OK, "emit ok";
    __mind_store_i8(out + OFFSET_ENTRY_KIND, 0);
    let vrc: i64 = evidence_verify(out, 212, z, cc);
    assert vrc == EV_ERR_ENTRY_KIND, "entry_kind 0 rejected (1-based enum)";
    __mind_free(cc);
    __mind_free(out);
    __mind_free(z);
}

