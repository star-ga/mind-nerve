}

#[test]
fn test_chain_timestamp_discriminates_chain_curr() {
    let z: i64 = ev_zeros32();
    let e1: i64 = __mind_alloc(212);
    let e2: i64 = __mind_alloc(212);
    let cc1: i64 = __mind_alloc(32);
    let cc2: i64 = __mind_alloc(32);
    let r1: i64 = ev_mk_verify(e1, cc1, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r1 == EV_OK, "ts 1000000";
    let r2: i64 = ev_mk_verify(e2, cc2, 3, 4, 5, 5, 1, 1000001, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert r2 == EV_OK, "ts 1000001";
    let ne: i64 = 1 - ev_hash_eq(cc1, cc2);
    assert ne == 1, "timestamp enters chain_curr";
    __mind_free(cc2);
    __mind_free(cc1);
    __mind_free(e2);
    __mind_free(e1);
    __mind_free(z);
}

#[test]
fn test_chain_verify_rejects_wrong_expected_predecessor() {
    let z: i64 = ev_zeros32();
    let wrong: i64 = ev_fixture(255);
    let out: i64 = __mind_alloc(212);
    let cc: i64 = __mind_alloc(32);
    let erc: i64 = ev_mk(out, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert erc == EV_OK, "emit ok (records zeros as predecessor)";
    let vrc: i64 = evidence_verify(out, 212, wrong, cc);
    assert vrc == EV_ERR_CHAIN_BROKEN, "wrong expected predecessor rejected";
    __mind_free(cc);
    __mind_free(out);
    __mind_free(wrong);
    __mind_free(z);
}

// ── §12: request_hash non-zero invariant (SOTA-track #2) ────────────────────

#[test]
fn test_verify_rejects_zero_request_hash() {
    // Otherwise-valid envelope with request_hash scrubbed to zeros after
    // construction (the replayed / hand-crafted path).
    let z: i64 = ev_zeros32();
    let out: i64 = __mind_alloc(212);
    let cc: i64 = __mind_alloc(32);
    let erc: i64 = ev_mk(out, 3, 4, 5, 5, 1, 1000000, ENTRY_INFERENCE, z, REASON_CONTINUATION);
    assert erc == EV_OK, "emit ok (non-zero request_hash)";
    ev_fill(out + OFFSET_REQUEST_HASH, 32, 0);
    let vrc: i64 = evidence_verify(out, 212, z, cc);
    assert vrc == EV_ERR_ZERO_REQUEST_HASH, "scrubbed request_hash rejected";
    __mind_free(cc);
    __mind_free(out);
    __mind_free(z);
}

#[test]
fn test_emit_rejects_zero_request_hash() {
    let z: i64 = ev_zeros32();
    let m: i64 = ev_fixture(1);
    let t: i64 = ev_fixture(2);
    let c: i64 = ev_fixture(3);
    let r: i64 = ev_fixture(5);
    let out: i64 = __mind_alloc(212);
    let rc: i64 = evidence_emit(m, t, c, z, r, z, 5, 1, ARCH_X86_64, 1000000, ENTRY_INFERENCE, REASON_CONTINUATION, out);
    assert rc == EV_ERR_ZERO_REQUEST_HASH, "zero request_hash rejected at construction";
    __mind_free(out);
    __mind_free(r);
    __mind_free(c);
    __mind_free(t);
    __mind_free(m);
    __mind_free(z);
}

#[test]
fn test_emit_accepts_nonzero_request_hash() {
    let z: i64 = ev_zeros32();
    let nz: i64 = ev_zeros32();
    __mind_store_i8(nz, 1);
    let m: i64 = ev_fixture(1);
    let t: i64 = ev_fixture(2);
    let c: i64 = ev_fixture(3);
    let r: i64 = ev_fixture(5);
    let out: i64 = __mind_alloc(212);
    let rc: i64 = evidence_emit(m, t, c, nz, r, z, 5, 1, ARCH_X86_64, 1000000, ENTRY_INFERENCE, REASON_CONTINUATION, out);
    assert rc == EV_OK, "a single non-zero byte suffices";
    __mind_free(out);
    __mind_free(r);
    __mind_free(c);
    __mind_free(t);
    __mind_free(m);
    __mind_free(nz);
    __mind_free(z);
}
