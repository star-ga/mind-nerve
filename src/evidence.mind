// Attestation envelope v2 + tamper-evident chain integrity. Ported to the
// mindc 0.10.2 dialect 2026-08-12 (wave 4 of the pure-MIND migration; the
// dormant pre-port source is preserved at src/dormant/evidence.mind).
//
// Every mind-nerve inference emits exactly one 212-byte attestation
// envelope tying together (model_hash, tokenizer_hash, catalog_hash,
// request_hash, result_hash, chain_prev). Envelopes form a SHA-256 chain:
// envelope[i+1]'s chain_prev field MUST equal SHA-256(serialize(
// envelope[i])).
//
// chain_curr is NEVER stored inside the envelope — it is recomputed at
// verify time. Storing chain_curr inside its own preimage would either
// require a fixed sentinel (defeating the binding) or self-referential
// hashing (impossible).
//
// WIRE LAYOUT (212 bytes packed; the authoritative byte-level contract is
// tests/unit/test_evidence.mind):
//
//   offset  size  field
//   0       1     version          (= ATTESTATION_V2_VERSION = 2)
//   1       1     entry_kind       (1=Inference, 2=ModelLoad, 3=CatalogLoad)
//   2       2     wire_version     (u16, little-endian)
//   4       4     k                (u32, little-endian; 1..=MAX_TOP_K)
//   8       8     timestamp_ms     (i64, little-endian, monotonic)
//   16      1     architecture     (1=x86_64, 2=aarch64, 3=cuda)
//   17      1     reserved         (MUST be 0)
//   18      2     chain_reset_reason (u16, little-endian:
//                                    0=Continuation, 1=ModelSwap,
//                                    2=CatalogChanged, 3=ClockReset)
//   20      32    model_hash
//   52      32    tokenizer_hash
//   84      32    catalog_hash
//   116     32    request_hash
//   148     32    result_hash
//   180     32    chain_prev       (zeros if first envelope in chain)
//
// Architecture and entry_kind start at 1 so an uninitialised zero byte is
// unambiguously invalid. Reserved MUST be zero on construction AND on
// verify; non-zero reserved is rejected (catches future-version envelopes
// being forced through a v2 verifier).
//
// PORT NOTES (0.10.2 reality):
//   - The @[layout(Packed)] struct becomes direct byte-level construction
//     over a 212-byte caller buffer — the handle ABI cannot express
//     structs, and the packed layout is maintained by hand via the
//     OFFSET_* constants below (the single source of truth, pinned by the
//     §1 offset tests).
//   - Result<..., VerificationError> becomes a signed return convention:
//     0 = ok, EV_ERR_* negative codes below. Gate ORDER is preserved
//     exactly from the dormant source (verify: length → version →
//     reserved → entry_kind → architecture → k → zero-request-hash →
//     chain_prev; emit: k → architecture → entry_kind → zero-request-hash).
//   - DEVIATION (fail-closed): the port's emit also range-checks
//     entry_kind. The dormant relied on the enum type to make invalid
//     kinds unrepresentable; over the i64 ABI they are representable, so
//     the type-level gate becomes a value-level gate.
//   - Determinism attributes have no 0.10.2 equivalent; all arithmetic is
//     integer LE byte packing + SHA-256 — bit-identical by construction
//     and pinned by the oracle tests. timestamp_ms is a caller-supplied
//     parameter (see src/clock.mind); evidence itself never reads a clock.

import src.lib;
import src.sha256;

// ─────────────────────────────────────────────────────────────────────────────
// Constants
// ─────────────────────────────────────────────────────────────────────────────

pub const ATTESTATION_V2_SIZE:    i64 = 212;
pub const ATTESTATION_V2_VERSION: i64 = 2;

// Field offsets (single source of truth for emit/verify). Keep in lockstep
// with the layout comment above and the §1 pins in
// tests/unit/test_evidence.mind.
pub const OFFSET_VERSION:            i64 = 0;
pub const OFFSET_ENTRY_KIND:         i64 = 1;
pub const OFFSET_WIRE_VERSION:       i64 = 2;
pub const OFFSET_K:                  i64 = 4;
pub const OFFSET_TIMESTAMP_MS:       i64 = 8;
pub const OFFSET_ARCHITECTURE:       i64 = 16;
pub const OFFSET_RESERVED:           i64 = 17;
pub const OFFSET_CHAIN_RESET_REASON: i64 = 18;
pub const OFFSET_MODEL_HASH:         i64 = 20;
pub const OFFSET_TOKENIZER_HASH:     i64 = 52;
pub const OFFSET_CATALOG_HASH:       i64 = 84;
pub const OFFSET_REQUEST_HASH:       i64 = 116;
pub const OFFSET_RESULT_HASH:        i64 = 148;
pub const OFFSET_CHAIN_PREV:         i64 = 180;

// Minimum allowed top-K. Zero is rejected so an envelope can never claim
// "top-zero" results (which would have no result_hash preimage).
pub const MIN_TOP_K: i64 = 1;

// EntryKind discriminants (1-based; zero is invalid).
pub const ENTRY_INFERENCE:    i64 = 1;
pub const ENTRY_MODEL_LOAD:   i64 = 2;
pub const ENTRY_CATALOG_LOAD: i64 = 3;

// Architecture discriminants (1-based; zero is the uninitialised sentinel).
pub const ARCH_X86_64:  i64 = 1;
pub const ARCH_AARCH64: i64 = 2;
pub const ARCH_CUDA:    i64 = 3;

// ChainResetReason discriminants. Metadata only — the cryptographic chain
// is NOT forked by a reset annotation.
pub const REASON_CONTINUATION:    i64 = 0;
pub const REASON_MODEL_SWAP:      i64 = 1;
pub const REASON_CATALOG_CHANGED: i64 = 2;
pub const REASON_CLOCK_RESET:     i64 = 3;

// Verification failure modes (the dormant VerificationError enum, flattened
// to negative return codes for the handle ABI). The set is closed; new
// failure modes require a v3 envelope spec.
pub const EV_OK:                    i64 = 0;
pub const EV_ERR_CHAIN_BROKEN:      i64 = -1;
pub const EV_ERR_VERSION:           i64 = -2;
pub const EV_ERR_RESERVED:          i64 = -3;
pub const EV_ERR_LENGTH:            i64 = -4;
pub const EV_ERR_ENTRY_KIND:        i64 = -5;
pub const EV_ERR_INVALID_K:         i64 = -6;
pub const EV_ERR_ZERO_REQUEST_HASH: i64 = -7;

// ─────────────────────────────────────────────────────────────────────────────
// Internal little-endian helpers (pure byte packing, no FFI)
// ─────────────────────────────────────────────────────────────────────────────

fn ev_store_u16_le(buf: i64, off: i64, v: i64) -> i64 {
    __mind_store_i8(buf + off + 0, v & 255);
    __mind_store_i8(buf + off + 1, (v >> 8) & 255);
    0
}

fn ev_store_u32_le(buf: i64, off: i64, v: i64) -> i64 {
    __mind_store_i8(buf + off + 0, v & 255);
    __mind_store_i8(buf + off + 1, (v >> 8) & 255);
    __mind_store_i8(buf + off + 2, (v >> 16) & 255);
    __mind_store_i8(buf + off + 3, (v >> 24) & 255);
    0
}

fn ev_store_i64_le(buf: i64, off: i64, v: i64) -> i64 {
    __mind_store_i8(buf + off + 0, v & 255);
    __mind_store_i8(buf + off + 1, (v >> 8) & 255);
    __mind_store_i8(buf + off + 2, (v >> 16) & 255);
    __mind_store_i8(buf + off + 3, (v >> 24) & 255);
    __mind_store_i8(buf + off + 4, (v >> 32) & 255);
    __mind_store_i8(buf + off + 5, (v >> 40) & 255);
    __mind_store_i8(buf + off + 6, (v >> 48) & 255);
    __mind_store_i8(buf + off + 7, (v >> 56) & 255);
    0
}

fn ev_copy_hash(dst: i64, src: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 32 {
        __mind_store_i8(dst + i, __mind_load_i8(src + i));
        i = i + 1;
    }
    0
}

// 1 when every byte of the 32-byte hash at `addr` is zero (the
// uninitialised/scrubbed-fingerprint sentinel — SOTA-track #2).
fn ev_hash_is_zero(addr: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 32 {
        if __mind_load_i8(addr + i) != 0 { return 0; }
        i = i + 1;
    }
    1
}

fn ev_entry_kind_is_valid(raw: i64) -> i64 {
    if raw == ENTRY_INFERENCE { return 1; }
    if raw == ENTRY_MODEL_LOAD { return 1; }
    if raw == ENTRY_CATALOG_LOAD { return 1; }
    0
}

fn ev_architecture_is_valid(raw: i64) -> i64 {
    if raw == ARCH_X86_64 { return 1; }
    if raw == ARCH_AARCH64 { return 1; }
    if raw == ARCH_CUDA { return 1; }
    0
}

// Structural validation of the 212 bytes at `buf` (the dormant
// deserialize() gates, in the same order). Returns EV_OK or the first
// failing gate's error code.
fn ev_validate(buf: i64) -> i64 {
    if __mind_load_i8(buf + OFFSET_VERSION) != ATTESTATION_V2_VERSION {
        return EV_ERR_VERSION;
    }
    if __mind_load_i8(buf + OFFSET_RESERVED) != 0 {
        return EV_ERR_RESERVED;
    }
    if ev_entry_kind_is_valid(__mind_load_i8(buf + OFFSET_ENTRY_KIND)) == 0 {
        return EV_ERR_ENTRY_KIND;
    }
    // Architecture zero/out-of-range reuses the entry-kind error code to
    // keep the error set closed (dormant behaviour).
    if ev_architecture_is_valid(__mind_load_i8(buf + OFFSET_ARCHITECTURE)) == 0 {
        return EV_ERR_ENTRY_KIND;
    }
    let k: i64 = (__mind_load_i8(buf + OFFSET_K) & 255)
        + (__mind_load_i8(buf + OFFSET_K + 1) & 255) * 256
        + (__mind_load_i8(buf + OFFSET_K + 2) & 255) * 65536
        + (__mind_load_i8(buf + OFFSET_K + 3) & 255) * 16777216;
    if k < MIN_TOP_K { return EV_ERR_INVALID_K; }
    if k > MAX_TOP_K { return EV_ERR_INVALID_K; }
    if ev_hash_is_zero(buf + OFFSET_REQUEST_HASH) == 1 {
        return EV_ERR_ZERO_REQUEST_HASH;
    }
    EV_OK
}

// ─────────────────────────────────────────────────────────────────────────────
// emit
// ─────────────────────────────────────────────────────────────────────────────
//
// Construct a fresh envelope into `out_addr` (caller-allocated, 212 bytes).
// Hashes are passed as six 32-byte buffer pointers. Returns EV_OK or the
// first failing gate's error code. Pre-construction gates refuse to produce
// an envelope that would fail verify — the chain log never contains
// malformed envelopes.
//
// timestamp_ms is caller-supplied (see src/clock.mind); entry_kind and
// chain_reset_reason are the EV_* discriminants above.

pub fn evidence_emit(model_hash: i64, tokenizer_hash: i64, catalog_hash: i64,
                     request_hash: i64, result_hash: i64, chain_prev: i64,
                     k: i64, wire_version: i64, architecture: i64,
                     timestamp_ms: i64, entry_kind: i64,
                     chain_reset_reason: i64, out_addr: i64) -> i64 {
    if k < MIN_TOP_K { return EV_ERR_INVALID_K; }
    if k > MAX_TOP_K { return EV_ERR_INVALID_K; }
    if ev_architecture_is_valid(architecture) == 0 {
        return EV_ERR_ENTRY_KIND;
    }
    if ev_entry_kind_is_valid(entry_kind) == 0 {
        return EV_ERR_ENTRY_KIND;
    }
    if ev_hash_is_zero(request_hash) == 1 {
        return EV_ERR_ZERO_REQUEST_HASH;
    }

    __mind_store_i8(out_addr + OFFSET_VERSION, ATTESTATION_V2_VERSION);
    __mind_store_i8(out_addr + OFFSET_ENTRY_KIND, entry_kind);
    ev_store_u16_le(out_addr, OFFSET_WIRE_VERSION, wire_version);
    ev_store_u32_le(out_addr, OFFSET_K, k);
    ev_store_i64_le(out_addr, OFFSET_TIMESTAMP_MS, timestamp_ms);
    __mind_store_i8(out_addr + OFFSET_ARCHITECTURE, architecture);
    __mind_store_i8(out_addr + OFFSET_RESERVED, 0);
    ev_store_u16_le(out_addr, OFFSET_CHAIN_RESET_REASON, chain_reset_reason);
    ev_copy_hash(out_addr + OFFSET_MODEL_HASH, model_hash);
    ev_copy_hash(out_addr + OFFSET_TOKENIZER_HASH, tokenizer_hash);
    ev_copy_hash(out_addr + OFFSET_CATALOG_HASH, catalog_hash);
    ev_copy_hash(out_addr + OFFSET_REQUEST_HASH, request_hash);
    ev_copy_hash(out_addr + OFFSET_RESULT_HASH, result_hash);
    ev_copy_hash(out_addr + OFFSET_CHAIN_PREV, chain_prev);
    EV_OK
}

// Convenience for a normal inference entry (dormant emit_inference):
// entry_kind = Inference, chain_reset_reason = Continuation.
pub fn evidence_emit_inference(model_hash: i64, tokenizer_hash: i64,
                               catalog_hash: i64, request_hash: i64,
                               result_hash: i64, chain_prev: i64,
                               timestamp_ms: i64, architecture: i64,
                               k: i64, wire_version: i64,
                               out_addr: i64) -> i64 {
    return evidence_emit(model_hash, tokenizer_hash, catalog_hash,
                         request_hash, result_hash, chain_prev,
                         k, wire_version, architecture, timestamp_ms,
                         ENTRY_INFERENCE, REASON_CONTINUATION, out_addr);
}

// ─────────────────────────────────────────────────────────────────────────────
// verify (single envelope)
// ─────────────────────────────────────────────────────────────────────────────
//
// Parse `len` bytes at `bytes_addr`, run every structural gate, and check
// the envelope's chain_prev against the 32-byte expected predecessor at
// `expected_prev`. On EV_OK, writes chain_curr (SHA-256 of the 212 bytes)
// to `out_chain_curr` so the caller can thread it forward to envelope[i+1].

pub fn evidence_verify(bytes_addr: i64, len: i64, expected_prev: i64,
                       out_chain_curr: i64) -> i64 {
    // Length gate — must come before any byte access; rejects empty,
    // truncated, and oversized inputs alike (fixed-size wire by design).
    if len != ATTESTATION_V2_SIZE { return EV_ERR_LENGTH; }

    let structural: i64 = ev_validate(bytes_addr);
    if structural != EV_OK { return structural; }

    // Chain-binding check: the recorded predecessor must equal what the
    // caller believes it should be — covers replay and tamper paths.
    let mut j: i64 = 0;
    while j < 32 {
        if __mind_load_i8(bytes_addr + OFFSET_CHAIN_PREV + j) != __mind_load_i8(expected_prev + j) {
            return EV_ERR_CHAIN_BROKEN;
        }
        j = j + 1;
    }

    mn_sha256(bytes_addr, ATTESTATION_V2_SIZE, out_chain_curr);
    EV_OK
}

// chain_curr of a serialized envelope: SHA-256 of the 212 bytes. Recomputed
// on demand, never stored (tamper-evidence property).
pub fn evidence_chain_curr(bytes_addr: i64, out_addr: i64) -> i64 {
    mn_sha256(bytes_addr, ATTESTATION_V2_SIZE, out_addr);
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// verify_chain (sequence)
// ─────────────────────────────────────────────────────────────────────────────
//
// Walk `count` serialized envelopes packed contiguously at `envs_addr`
// (count * 212 bytes), asserting every envelope[i+1].chain_prev equals
// SHA-256(envelope[i]). The first envelope MUST have chain_prev = zeros32.
// Returns EV_OK or the first verification error encountered.

pub fn evidence_verify_chain(envs_addr: i64, count: i64) -> i64 {
    if count == 0 { return EV_OK; }
    let expected: i64 = __mind_alloc(32);
    let mut i: i64 = 0;
    while i < 32 {
        __mind_store_i8(expected + i, 0);
        i = i + 1;
    }
    let mut rc: i64 = EV_OK;
    i = 0;
    let mut cont: i64 = 1;
    while cont == 1 {
        if i >= count {
            cont = 0;
        } else {
            let step: i64 = evidence_verify(envs_addr + i * ATTESTATION_V2_SIZE,
                                            ATTESTATION_V2_SIZE, expected, expected);
            if step != EV_OK {
                rc = step;
                cont = 0;
            } else {
                i = i + 1;
            }
        }
    }
    __mind_free(expected);
    rc
}
