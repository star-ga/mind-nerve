// mind-nerve top-level const hub. Ported to the mindc 0.10.2 dialect
// 2026-08-11 (wave 1 of the pure-MIND migration; the dormant pre-port
// source is preserved at src/dormant/lib.mind).
//
// Re-exports the public surface used by `cli/main.mind` and the integration
// façades. Every name exported here is part of the stability contract; do
// not remove or change a value without bumping the API version. Every
// compile-time parameter below is bound into `model_hash`; changing any of
// them is a versioned architecture change.
//
// PORT NOTES (0.10.2 reality):
//   - The dormant `module mind_nerve { … pub mod …; }` wrapper is dropped:
//     0.10.2 derives module identity from file paths and the project
//     manifest's sources list, not from in-source module declarations.
//   - The Q16.16 canonical const block (ONE_Q16_16 … ULP_Q16_16,
//     Q16_FRAC_BITS) and the `Q16_16` type alias are NOT duplicated here.
//     Their single source of truth is src/q16_16.mind (ported first in
//     wave 1 per the dormant README's port table: "local consts replace
//     use crate::{…}"). Duplicating them in lib.mind would create a second
//     drift surface on the model_hash-binding path.
//   - Dormant u8/u16/u32 const types are carried as i64 on this surface
//     (matching mind/luts, mind/kernels, src/sha256.mind, src/q16_16.mind).
//     Original widths are noted per const; envelope packing (evidence.mind,
//     wave 4) masks to the documented width.
//   - Const-generic array lengths are not expressible in 0.10.2; the ALiBi
//     slopes array uses the literal ENCODER_HEADS value (4) with a compile
//     assertion in tests/unit/test_lib.mind that the two agree.

// ─────────────────────────────────────────────────────────────────────────────
// Compile-time parameters. Changing any of these is a model-architecture
// change and requires a new model_hash.
//
// Architecture v3 (post-pivot + fleet-consensus optimization, 2026-05-13):
//   - 2 layers (down from 12) — 12L is 7× over the 30 ms p95 budget on
//     commodity 4-core x86 CPU even with all SIMD optimizations; 2L fits
//     the budget after INT8 weight quantization + K/V overlap cache.
//   - hidden = 256 (down from 384) — reduces per-layer MACs by 56%.
//     4 heads × 64 head_dim preserves head capacity.
// ─────────────────────────────────────────────────────────────────────────────

pub const ENCODER_LAYERS:        i64 = 2;
pub const ENCODER_HIDDEN:        i64 = 256;
pub const ENCODER_HEADS:         i64 = 4;
pub const ENCODER_HEAD_DIM:      i64 = 64;   // ENCODER_HIDDEN / ENCODER_HEADS

// Sliding-window self-attention parameters. Window 256 / stride 192 yields
// 64-token overlap; at MAX_REQUEST_TOKENS = 1024 this is 5 windows worst
// case.
pub const ATTN_WINDOW_SIZE:      i64 = 256;
pub const ATTN_WINDOW_STRIDE:    i64 = 192;
pub const ATTN_WINDOW_OVERLAP:   i64 = 64;   // WINDOW_SIZE - WINDOW_STRIDE

// RFC-003 — Content-fingerprinted adaptive window stride.
//
// When ADAPTIVE_STRIDE_ENABLED = 0 (default), the inference path uses
// ATTN_WINDOW_STRIDE unconditionally. This is the compile-time constant
// path preserved for ablation and bit-identity gating.
//
// When ADAPTIVE_STRIDE_ENABLED = 1, the runtime reads STRIDE_FP_T_LOW and
// STRIDE_FP_T_HIGH from the catalog manifest's [stride] table and selects:
//   request_len < T_LOW  → ATTN_WINDOW_STRIDE_COMPACT
//   request_len > T_HIGH → ATTN_WINDOW_STRIDE_LONG
//   otherwise            → ATTN_WINDOW_STRIDE  (unchanged)
//
// Flipping ADAPTIVE_STRIDE_ENABLED to 1 is an inference-path-visible
// architecture change and REQUIRES a new model_hash. The thresholds T_LOW
// and T_HIGH are emitted by catalog-builder/calibrate_stride.py.
pub const ADAPTIVE_STRIDE_ENABLED:    i64 = 0;
pub const ATTN_WINDOW_STRIDE_COMPACT: i64 = 192;  // compact = same as default
pub const ATTN_WINDOW_STRIDE_LONG:    i64 = 128;  // more overlap for long ctx

pub const VOCAB_SIZE:            i64 = 32768;
// Hard wire-level input cap. 1024 BPE tokens covers ≥99% of realistic
// agent-CLI requests; requests exceeding the cap are rejected at the wire
// handshake with `RequestTooLong`. The cap is part of the model_hash
// discipline — changing it is a versioned architecture change, not a
// configuration tweak.
pub const MAX_REQUEST_TOKENS:    i64 = 1024;
pub const ROUTE_EMBEDDING_DIM:   i64 = 256;  // tied to ENCODER_HIDDEN
pub const DEFAULT_TOP_K:         i64 = 5;
pub const MAX_TOP_K:             i64 = 64;

// Weight storage discipline (dormant u8). Inference path uses INT8 weights
// with Q16.16 activations:
//   - WEIGHT_BITS = 8 (signed per-output-channel quantization)
//   - ACTIVATION_BITS = 32 (Q16.16 i32-range values, unchanged)
//   - MAC: (act * weight) accumulated in i64, scaled by per-channel Q16.16
//     scale, >>16 shift, saturated to the i32 range.
//   - The per-output-channel scale tensor is itself Q16.16 and is part of
//     the EncoderLayerWeights manifest hashed into model_hash.
pub const WEIGHT_BITS:           i64 = 8;
pub const ACTIVATION_BITS:       i64 = 32;

// Attestation envelope: v2 layout, 212 bytes packed (dormant u8/u32).
// The authoritative byte-level contract is tests/unit/test_evidence.mind
// §1 (wave 4); spec/architecture.md and spec/numerics.md summarise it.
pub const ATTESTATION_BYTES:     i64 = 212;
pub const ATTESTATION_VERSION:   i64 = 2;

// Wire-format version pinned into every envelope (dormant u8). Bumped only
// when the per-op reduction order table emitted by mindc changes shape.
pub const NUMERICS_WIRE_VERSION: i64 = 2;

// Entry-kind discriminant in the envelope (dormant u8). 1-based so an
// uninitialised zero byte is unambiguously invalid. Three variants in v2:
//   1 = inference     (normal classifier emission)
//   2 = model_load    (anchors model_hash binding at startup)
//   3 = catalog_load  (anchors catalog_hash binding at load time)
pub const ENTRY_KIND_INFERENCE:    i64 = 1;
pub const ENTRY_KIND_MODEL_LOAD:   i64 = 2;
pub const ENTRY_KIND_CATALOG_LOAD: i64 = 3;

// Architecture enum (dormant u8) starts at 1 so uninitialised zero byte is
// invalid. v2 covers the three backends that ship in Phase 1; WebGPU and
// NPU enter the enum at the v3 envelope spec, after bit-identity gates land
// on those backends.
pub const ARCH_X86_64:  i64 = 1;
pub const ARCH_AARCH64: i64 = 2;
pub const ARCH_CUDA:    i64 = 3;

// chain_reset_reason discriminants (dormant u16 field in the envelope).
pub const CHAIN_RESET_CONTINUATION:    i64 = 0;
pub const CHAIN_RESET_MODEL_SWAP:      i64 = 1;
pub const CHAIN_RESET_CATALOG_CHANGED: i64 = 2;
pub const CHAIN_RESET_CLOCK_RESET:     i64 = 3;

// ─────────────────────────────────────────────────────────────────────────────
// Backwards-soft architecture switches (autoresearch IMPLEMENT phase).
//
// Each constant below is bound into `model_hash` via the manifest header.
// The defaults are chosen so the binary stays byte-identical to the
// pre-RFC build until a calibrated reference checkpoint flips a flag.
// Flipping a flag is therefore a versioned architecture change (new
// `model_hash`), never a runtime knob.
//
// The corresponding kernels / scoring helpers live in
// `encoder_kernels.mind`, `model.mind`, `inference.mind`, and `top_k.mind`
// (waves 2–4); they read these constants. Keep the names in sync.
// ─────────────────────────────────────────────────────────────────────────────

// RFC-008 — Matryoshka coarse-to-fine route scoring. Default coarse dim ==
// full embedding dim disables the cascade; `K_COARSE_MULTIPLIER = 1` keeps
// the shortlist == full route set when somehow active.
pub const MATRYOSHKA_COARSE_DIM:  i64 = 256;   // == ROUTE_EMBEDDING_DIM
pub const K_COARSE_MULTIPLIER:    i64 = 1;

// RFC-010 — L2-normalized cosine similarity scoring head.
// 0 = unnormalized dot-product (today's behaviour).
pub const COSINE_SCORING_ENABLED: i64 = 0;

// RFC-011 — ALiBi per-head linear attention bias.
// Default slopes follow Press et al. geometric ladder
// (2^(-2), 2^(-4), 2^(-6), 2^(-8)) encoded in Q16.16:
// 1/4 ≈ 16384, 1/16 ≈ 4096, 1/64 ≈ 1024, 1/256 ≈ 256.
// The default-disabled gate makes the bias path dead until a reference
// checkpoint flips `ATTN_ALIBI_ENABLED = 1`.
//
// Literal length 4 == ENCODER_HEADS (0.10.2 has no const-generic array
// lengths); tests/unit/test_lib.mind pins the agreement.
pub const ATTN_ALIBI_ENABLED: i64 = 0;
pub const ATTN_ALIBI_SLOPES: [i64; 4] = [16384, 4096, 1024, 256];

// RFC-012 — Asymmetric query / passage prefix conditioning.
// 8 reserved BPE token slots (matches the catalog-builder convention).
// Default `QUERY_PREFIX_LEN = 0` makes the prepend path dead and the
// request stream byte-identical to today.
pub const QUERY_PREFIX_LEN:    i64 = 0;
pub const QUERY_PREFIX_TOKENS: [i64; 8] = [0, 0, 0, 0, 0, 0, 0, 0];

// Audit follow-up F1: model_hash binding gate.
// 0 = legacy: loader reads model_hash from disk as opaque (today's
//     behaviour, byte-identical to pre-RFC builds).
// 1 = strict: loader computes SHA-256 over the canonical compile-time
//     constant preimage and rejects the bundle with HashMismatch if the
//     on-disk model_hash doesn't match.
// Flip to 1 once the offline catalog-builder pipeline emits weights files
// whose model_hash is the SHA-256 of `compute_model_hash()`'s canonical
// preimage. Until then, leave at 0 to preserve compatibility with
// already-produced reference checkpoints.
pub const MODEL_HASH_BIND_ENABLED: i64 = 0;
