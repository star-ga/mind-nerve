// Deterministic top-K extraction with SHA-256 tie-break. Ported to the
// mindc 0.10.2 dialect 2026-08-11 (wave 2 of the pure-MIND migration; the
// dormant pre-port source is preserved at src/dormant/top_k.mind).
//
// Phase 1 contract (spec/architecture.md §"Top-K extraction",
// tests/unit/test_top_k.mind): for every (logits, catalog, k) the produced
// ordering MUST be bit-identical across runs, hosts, architectures, and
// vectorization strategies. Ordering is `score DESC, route_id ASC` (lex
// over the 32 raw bytes, byte[0] most significant). RouteId IS the SHA-256
// of the external string id (set at catalog load time, never re-hashed in
// the hot path), so the comparator is functionally "score DESC,
// SHA-256(external_id) ASC". Comparison is exact integer compare on the
// Q16.16 score (never float — 1-ULP differences must order) and unsigned
// lex over the digest bytes.
//
// Audit anchors: A3 (catalog uniqueness), A6 (top-K bit-identity).
//
// Algorithm: bounded worst-on-top heap of size K (O(N log K)), sequential
// ascending-index ingest, strict-better eviction, worst-first drain
// materialised into descending output. The heap shape is pinned by strict
// comparisons only (ties never swap) and left-child-before-right
// evaluation. See the dormant source for the full argpartition-vs-heap
// rationale.
//
// PORT NOTES (0.10.2 reality):
//   - Structs/tensors/slices do not cross this ABI. Buffers are raw i64
//     handles: route-id buffers are n*32 bytes (one byte per offset,
//     matching src/sha256.mind); score/logit buffers are i64 lanes at an
//     8-byte stride (matching mind/luts, mind/kernels, src/q16_16.mind);
//     masks are n bytes. HeapEntry is carried as three parallel buffers
//     (scores, ids, idx) — `idx` remains PURE PAYLOAD, never read by any
//     comparison (see the dormant HeapEntry notes).
//   - UniqueRouteCatalog::new's string-ids-in/Result-out surface is
//     decomposed for the handle ABI: route ids are hashed with mn_sha256
//     by the caller (loader wave), `catalog_check_unique` performs the
//     first-duplicate-wins scan over the hashed ids (returns 0 when unique,
//     else the 1-based index of the first duplicate — the duplicate's
//     route_id is then readable at that index, preserving the dormant
//     error payload without exposing the external string), and
//     `canonical_catalog_hash` computes the catalog hash
//     (SHA-256 of the concatenated route ids; empty catalog -> SHA-256("")).
//   - batch handling is unchanged: only row 0 of the logits is read
//     (Phase 1 is batch == 1 semantically).
//   - `@[determinism(BitIdentical)]` has no 0.10.2 equivalent; the
//     pinned-order discipline is by construction (sequential loops, strict
//     comparisons) and pinned by tests/unit/test_top_k.mind, including the
//     published canonical-result-hash oracles.

import src.sha256;

pub const ROUTE_ID_BYTES: i64 = 32;

// ─────────────────────────────────────────────────────────────────────────────
// Comparator primitives.
// ─────────────────────────────────────────────────────────────────────────────

// Lexicographic less-than over 32-byte digests, byte[0] most significant.
// Loads are masked to unsigned bytes (& 255) — __mind_load_i8 sign-extends.
fn lex_lt_32(a: i64, b: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 32 {
        let ba: i64 = __mind_load_i8(a + i) & 255;
        let bb: i64 = __mind_load_i8(b + i) & 255;
        if ba < bb { return 1; }
        if ba > bb { return 0; }
        i = i + 1;
    }
    0
}

// 32-byte digest equality.
fn id_eq_32(a: i64, b: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 32 {
        if __mind_load_i8(a + i) != __mind_load_i8(b + i) { return 0; }
        i = i + 1;
    }
    1
}

// `a` is strictly BETTER than `b` under the contract ordering:
//   1. Higher Q16.16 score wins (exact i64 compare — never float).
//   2. Equal score: lexicographically lower route_id wins.
//   3. Equal route_id (forbidden for well-formed catalogs) returns 0.
// Reads ONLY score and route_id; the heap's idx payload is never consulted.
fn entry_better(score_a: i64, id_a: i64, score_b: i64, id_b: i64) -> i64 {
    if score_a > score_b { return 1; }
    if score_a < score_b { return 0; }
    lex_lt_32(id_a, id_b)
}

// ─────────────────────────────────────────────────────────────────────────────
// Bounded "worst-on-top" heap over three parallel buffers:
//   hs  — scores, i64 lanes (8-byte stride)
//   hid — route ids, 32 bytes per slot
//   hix — catalog indices, i64 lanes (pure payload; never a comparator key)
// Invariant: no parent is strictly better than either child; index 0 is the
// WORST entry (evicted first under the contract ordering).
// ─────────────────────────────────────────────────────────────────────────────

fn swap_ids(hid: i64, a: i64, b: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 32 {
        let ta: i64 = __mind_load_i8(hid + a * 32 + i);
        let tb: i64 = __mind_load_i8(hid + b * 32 + i);
        __mind_store_i8(hid + a * 32 + i, tb);
        __mind_store_i8(hid + b * 32 + i, ta);
        i = i + 1;
    }
    0
}

fn swap_entries(hs: i64, hid: i64, hix: i64, a: i64, b: i64) -> i64 {
    let sa: i64 = __mind_load_i64(hs + a * 8);
    let sb: i64 = __mind_load_i64(hs + b * 8);
    __mind_store_i64(hs + a * 8, sb);
    __mind_store_i64(hs + b * 8, sa);
    let ia: i64 = __mind_load_i64(hix + a * 8);
    let ib: i64 = __mind_load_i64(hix + b * 8);
    __mind_store_i64(hix + a * 8, ib);
    __mind_store_i64(hix + b * 8, ia);
    swap_ids(hid, a, b)
}

// Sift up: swap iff the parent is strictly better than the child (the child
// is in the wrong place under worst-on-top). Equal keys never swap — this
// pins the heap shape across runs.
fn sift_up(hs: i64, hid: i64, hix: i64, idx0: i64) -> i64 {
    let mut idx: i64 = idx0;
    while idx > 0 {
        let parent: i64 = (idx - 1) / 2;
        if entry_better(__mind_load_i64(hs + parent * 8), hid + parent * 32,
                        __mind_load_i64(hs + idx * 8), hid + idx * 32) == 1 {
            swap_entries(hs, hid, hix, parent, idx);
            idx = parent;
        } else {
            return 0;
        }
    }
    0
}

// Sift down: pick the WORSE of the two children (left evaluated first; if
// the right child exists and left is better than right, pick right) and
// swap with it iff the parent is strictly better than that child.
fn sift_down(hs: i64, hid: i64, hix: i64, n: i64, idx0: i64) -> i64 {
    let mut idx: i64 = idx0;
    let mut cont: i64 = 1;
    while cont == 1 {
        let left:  i64 = 2 * idx + 1;
        let right: i64 = 2 * idx + 2;
        if left >= n {
            cont = 0;
        } else {
            let mut worse_child: i64 = left;
            if right < n {
                if entry_better(__mind_load_i64(hs + left * 8), hid + left * 32,
                                __mind_load_i64(hs + right * 8), hid + right * 32) == 1 {
                    worse_child = right;
                }
            }
            if entry_better(__mind_load_i64(hs + idx * 8), hid + idx * 32,
                            __mind_load_i64(hs + worse_child * 8), hid + worse_child * 32) == 1 {
                swap_entries(hs, hid, hix, idx, worse_child);
                idx = worse_child;
            } else {
                cont = 0;
            }
        }
    }
    0
}

// Push when below capacity (caller checked). Returns the new length.
fn heap_push(hs: i64, hid: i64, hix: i64, n: i64,
             score: i64, id_addr: i64, idx: i64) -> i64 {
    __mind_store_i64(hs + n * 8, score);
    let mut i: i64 = 0;
    while i < 32 {
        __mind_store_i8(hid + n * 32 + i, __mind_load_i8(id_addr + i));
        i = i + 1;
    }
    __mind_store_i64(hix + n * 8, idx);
    sift_up(hs, hid, hix, n);
    n + 1
}

// Replace the current worst with a candidate already proven strictly
// better. Restores the invariant by sifting down from the root.
fn heap_replace_worst(hs: i64, hid: i64, hix: i64, n: i64,
                      score: i64, id_addr: i64, idx: i64) -> i64 {
    __mind_store_i64(hs, score);
    let mut i: i64 = 0;
    while i < 32 {
        __mind_store_i8(hid + i, __mind_load_i8(id_addr + i));
        i = i + 1;
    }
    __mind_store_i64(hix, idx);
    sift_down(hs, hid, hix, n, 0)
}

// Pop the worst entry into the out-params. Returns the new length.
fn heap_pop_worst(hs: i64, hid: i64, hix: i64, n: i64,
                  out_score: i64, out_id: i64, out_idx: i64) -> i64 {
    __mind_store_i64(out_score, __mind_load_i64(hs));
    let mut i: i64 = 0;
    while i < 32 {
        __mind_store_i8(out_id + i, __mind_load_i8(hid + i));
        i = i + 1;
    }
    __mind_store_i64(out_idx, __mind_load_i64(hix));
    if n == 1 {
        return 0;
    }
    // Move the last entry to the root and restore the invariant.
    __mind_store_i64(hs, __mind_load_i64(hs + (n - 1) * 8));
    i = 0;
    while i < 32 {
        __mind_store_i8(hid + i, __mind_load_i8(hid + (n - 1) * 32 + i));
        i = i + 1;
    }
    __mind_store_i64(hix, __mind_load_i64(hix + (n - 1) * 8));
    sift_down(hs, hid, hix, n - 1, 0);
    n - 1
}

// ─────────────────────────────────────────────────────────────────────────────
// extract_top_k
//
// Writes the top-K entries of (logits, catalog ids) under score-DESC,
// sha-ASC ordering into out_ids (n*32 bytes) and out_scores (i64 lanes);
// returns the number of entries written.
//
// k semantics (unchanged from dormant):
//   k == 0 or num_routes == 0  -> 0 (empty result, no error)
//   k > num_routes             -> saturates at num_routes (all, sorted)
//   k > MAX_TOP_K              -> caller guards at preselect(); this layer
//                                 stays total and saturates at num_routes.
// out ids[0] is the best; ids[n-1] the worst of the chosen K.
// ─────────────────────────────────────────────────────────────────────────────

pub fn extract_top_k(logits: i64, ids: i64, num_routes: i64, k: i64,
                     out_ids: i64, out_scores: i64) -> i64 {
    if k == 0 { return 0; }
    if num_routes == 0 { return 0; }

    let mut effective_k: i64 = k;
    if k > num_routes { effective_k = num_routes; }

    let hs:  i64 = __mind_alloc(effective_k * 8);
    let hid: i64 = __mind_alloc(effective_k * 32);
    let hix: i64 = __mind_alloc(effective_k * 8);
    let mut hn: i64 = 0;

    // Sequential ingest, left-to-right index order. No re-hashing: the
    // catalog id bytes ARE the tie-break key.
    let mut i: i64 = 0;
    while i < num_routes {
        let s: i64 = __mind_load_i64(logits + i * 8);
        if hn < effective_k {
            hn = heap_push(hs, hid, hix, hn, s, ids + i * 32, i);
        } else {
            if entry_better(s, ids + i * 32,
                            __mind_load_i64(hs), hid) == 1 {
                heap_replace_worst(hs, hid, hix, hn, s, ids + i * 32, i);
            }
        }
        i = i + 1;
    }

    // Drain worst-first (ascending), writing each popped entry to output
    // slot (remaining - 1) — the reversal is fused into the drain, so the
    // output is strictly descending under the contract ordering.
    let n_out: i64 = hn;
    let scratch_idx: i64 = __mind_alloc(8);
    let mut remaining: i64 = hn;
    while remaining > 0 {
        remaining = heap_pop_worst(hs, hid, hix, remaining,
                                   out_scores + (remaining - 1) * 8,
                                   out_ids + (remaining - 1) * 32,
                                   scratch_idx);
    }

    __mind_free(scratch_idx);
    __mind_free(hs);
    __mind_free(hid);
    __mind_free(hix);
    n_out
}

// ─────────────────────────────────────────────────────────────────────────────
// RFC-008 — extract_top_k_mask
//
// Same bounded-heap algorithm as extract_top_k over the coarse-pass logits,
// emitting a byte mask of length num_routes (1 = route survives the coarse
// pass). Index recovery is O(1) per survivor via the inert idx payload.
//
//   k == 0 or num_routes == 0 -> all-zero mask
//   k >= num_routes           -> all-ones mask (every route survives)
// ─────────────────────────────────────────────────────────────────────────────

pub fn extract_top_k_mask(logits: i64, ids: i64, num_routes: i64, k: i64,
                          mask: i64) -> i64 {
    let mut m: i64 = 0;
    while m < num_routes {
        __mind_store_i8(mask + m, 0);
        m = m + 1;
    }

    if k == 0 { return 0; }
    if num_routes == 0 { return 0; }

    if k >= num_routes {
        m = 0;
        while m < num_routes {
            __mind_store_i8(mask + m, 1);
            m = m + 1;
        }
        return 0;
    }

    let hs:  i64 = __mind_alloc(k * 8);
    let hid: i64 = __mind_alloc(k * 32);
    let hix: i64 = __mind_alloc(k * 8);
    let mut hn: i64 = 0;

    let mut i: i64 = 0;
    while i < num_routes {
        let s: i64 = __mind_load_i64(logits + i * 8);
        if hn < k {
            hn = heap_push(hs, hid, hix, hn, s, ids + i * 32, i);
        } else {
            if entry_better(s, ids + i * 32,
                            __mind_load_i64(hs), hid) == 1 {
                heap_replace_worst(hs, hid, hix, hn, s, ids + i * 32, i);
            }
        }
        i = i + 1;
    }

    // Drain (pinned worst-first order, unchanged); each surviving entry's
    // catalog index flips its mask slot directly.
    let scratch_score: i64 = __mind_alloc(8);
    let scratch_id: i64 = __mind_alloc(32);
    let scratch_idx: i64 = __mind_alloc(8);
    let mut remaining: i64 = hn;
    while remaining > 0 {
        remaining = heap_pop_worst(hs, hid, hix, remaining,
                                   scratch_score, scratch_id, scratch_idx);
        __mind_store_i8(mask + __mind_load_i64(scratch_idx), 1);
    }

    __mind_free(scratch_score);
    __mind_free(scratch_id);
    __mind_free(scratch_idx);
    __mind_free(hs);
    __mind_free(hid);
    __mind_free(hix);
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// canonical_result_hash — SHA-256 over the top-K result (envelope.result_hash).
//
// Serialization (tests/unit/test_top_k.mind §"Canonical serialization",
// spec/architecture.md §"Catalog hashing"), per entry in top-K order:
//   u32-LE length=32 (4 bytes) || route_id (32 bytes) || i32-LE score (4)
// Per entry 40 bytes; empty result -> SHA-256(empty) = e3b0c442…
// ─────────────────────────────────────────────────────────────────────────────

pub fn canonical_result_hash(ids: i64, scores: i64, n: i64, out_addr: i64) -> i64 {
    if n == 0 {
        mn_sha256(0, 0, out_addr);
        return 0;
    }
    let buf: i64 = __mind_alloc(n * 40);
    let mut i: i64 = 0;
    while i < n {
        let base: i64 = buf + i * 40;
        // u32-LE length prefix = 32.
        __mind_store_i8(base + 0, 32);
        __mind_store_i8(base + 1, 0);
        __mind_store_i8(base + 2, 0);
        __mind_store_i8(base + 3, 0);
        // route_id (32 bytes, raw).
        let mut b: i64 = 0;
        while b < 32 {
            __mind_store_i8(base + 4 + b, __mind_load_i8(ids + i * 32 + b));
            b = b + 1;
        }
        // i32-LE score (two's complement; arithmetic shifts then mask).
        let s: i64 = __mind_load_i64(scores + i * 8);
        __mind_store_i8(base + 36, s & 255);
        __mind_store_i8(base + 37, (s >> 8) & 255);
        __mind_store_i8(base + 38, (s >> 16) & 255);
        __mind_store_i8(base + 39, (s >> 24) & 255);
        i = i + 1;
    }
    mn_sha256(buf, n * 40, out_addr);
    __mind_free(buf);
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// Catalog validation + hash (decomposed UniqueRouteCatalog; see PORT NOTES).
// ─────────────────────────────────────────────────────────────────────────────

// First-duplicate-wins scan over hashed route ids (the dormant O(n²)
// double loop, pairs visited in fixed (i, j < i) ascending order — catalog
// load is a one-shot cost, not a hot path). Returns 0 when all ids are
// distinct, else (i + 1) where i is the first index whose route_id already
// appeared at some j < i. The offending route_id is readable at ids + i*32.
pub fn catalog_check_unique(ids: i64, n: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        let mut j: i64 = 0;
        while j < i {
            if id_eq_32(ids + i * 32, ids + j * 32) == 1 {
                return i + 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    0
}

// Catalog canonical hash: SHA-256 of the concatenated route ids
// (n * 32 bytes). Empty catalog -> SHA-256("") — matches the dormant
// UniqueRouteCatalog::new empty-construction path.
pub fn canonical_catalog_hash(ids: i64, n: i64, out_addr: i64) -> i64 {
    if n == 0 {
        mn_sha256(0, 0, out_addr);
        return 0;
    }
    mn_sha256(ids, n * 32, out_addr);
    0
}
