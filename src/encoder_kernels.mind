// Encoder kernels — module-private helpers for the sliding-window encoder.
// Ported to the mindc 0.10.2 dialect 2026-08-12 (wave 4 of the pure-MIND
// migration; the dormant pre-port source is preserved at
// src/dormant/encoder_kernels.mind).
//
// Composition rules (unchanged from dormant): every reduction is sequential
// left-to-right; this module never rolls its own Q16.16 op — it composes
// the pinned primitives in src/q16_16.mind, which delegates its LUTs to the
// CI-pinned tables in mind/luts. Window iteration is ascending start index;
// overlap regions accumulate via saturating q16_add in pinned loop order.
//
// PORT NOTES (0.10.2 reality):
//   - Tensors become flat row-major i64-lane buffers: element (i, d) of an
//     [n, ENCODER_HIDDEN] activation lives at addr + (i * 256 + d) * 8.
//     Weight matrices are [H, H] row-major the same way. seq_len is always
//     an explicit parameter (the dormant `tensor<...>` carried it).
//   - LUT handles (exp_h for softmax/sigmoid, rsqrt_h for layer/rms-norm)
//     are explicit parameters, matching src/q16_16.mind's handle discipline.
//     Callers build them once (exp_q16_init / rsqrt_q16_init) and thread
//     them through.
//   - The compile-baked latent-query constants (POOL_Q_LATENT_DEFAULT et
//     al.) become zero-filled buffers built by pool_q_latent_default();
//     const arrays are not buffer addresses in 0.10.2. The backwards-soft
//     default path (POOLING_KIND_MEAN) never allocates them.
//   - The RFC const gates (NORMALIZATION_KIND, POOLING_KIND, STRIDE_FP_*,
//     HEAD_MASK, NUM_SINK_TOKENS, ATTN_ALIBI_ENABLED) are runtime-evaluated
//     const branches instead of compile-time DCE — the computation each
//     gate selects is preserved exactly; only the elimination mechanism
//     differs (interpreter evaluates the default branch at runtime).
//   - `@[determinism]` / `@[reduction_order(Pinned)]` have no 0.10.2
//     equivalent; the pinned order is by construction and gated by
//     tests/unit/test_encoder_kernels.mind.

import src.lib;
import src.q16_16;

// ─────────────────────────────────────────────────────────────────────────────
// RFC-013 — Normalization kind dispatch (backwards-soft default: LayerNorm).
// Both consts enter model_hash via the model manifest header.
// ─────────────────────────────────────────────────────────────────────────────

pub const NORMALIZATION_KIND_LAYERNORM: i64 = 0;
pub const NORMALIZATION_KIND_RMSNORM:   i64 = 1;
pub const NORMALIZATION_KIND:           i64 = 0;

// ─────────────────────────────────────────────────────────────────────────────
// RFC-009 / RFC-014 — pooling dispatch (backwards-soft default: mean pool,
// r = 1 latent query). Consts enter model_hash via the manifest header.
// ─────────────────────────────────────────────────────────────────────────────

pub const POOLING_KIND_MEAN:         i64 = 0;
pub const POOLING_KIND_LEARNED_ATTN: i64 = 1;
pub const POOLING_KIND:              i64 = 0;
pub const POOL_LATENT_QUERIES:       i64 = 1;

// The compile-baked default latent matrix (r x H, all zeros) as a fresh
// buffer. All-zero produces uniform softmax weights ≈ mean-pool within LUT
// tolerance. Caller owns the returned handle.
pub fn pool_q_latent_default() -> i64 {
    let buf: i64 = __mind_alloc(POOL_LATENT_QUERIES * ENCODER_HIDDEN * 8);
    let mut i: i64 = 0;
    while i < POOL_LATENT_QUERIES * ENCODER_HIDDEN {
        __mind_store_i64(buf + i * 8, 0);
        i = i + 1;
    }
    buf
}

// ─────────────────────────────────────────────────────────────────────────────
// Attention score scaling: 1/sqrt(head_dim) = 1/8 in Q16.16 = 8192 exactly.
// ─────────────────────────────────────────────────────────────────────────────

pub const ATTN_SCALE_Q16: i64 = 8192;

// ─────────────────────────────────────────────────────────────────────────────
// RFC-003 — content-fingerprinted adaptive window stride (backwards-soft
// default: disabled; every input selects STRIDE_MID = ATTN_WINDOW_STRIDE).
// ─────────────────────────────────────────────────────────────────────────────

pub const STRIDE_FP_ENABLED: i64 = 0;
pub const STRIDE_LOW:        i64 = 96;
pub const STRIDE_MID:        i64 = 192;
pub const STRIDE_HIGH:       i64 = 256;
pub const STRIDE_FP_WINDOW:  i64 = 16;
pub const STRIDE_FP_T_LOW:   i64 = -2147483648;
pub const STRIDE_FP_T_HIGH:  i64 = 2147483647;

// Pinned ascending-i sum of q16_abs over the leading dimension of the first
// min(STRIDE_FP_WINDOW, n) token embeddings. x is [n, ENCODER_HIDDEN].
pub fn compute_stride_fingerprint(x: i64, n: i64) -> i64 {
    let mut cap: i64 = STRIDE_FP_WINDOW;
    if n < cap { cap = n; }
    let mut acc: i64 = 0;
    let mut i: i64 = 0;
    while i < cap {
        acc = q16_add(acc, q16_abs(__mind_load_i64(x + i * ENCODER_HIDDEN * 8)));
        i = i + 1;
    }
    acc
}

// Three-way dispatch on the fingerprint scalar (see dormant header).
pub fn select_stride(fingerprint: i64) -> i64 {
    if fingerprint > STRIDE_FP_T_HIGH { return STRIDE_LOW; }
    if fingerprint < STRIDE_FP_T_LOW { return STRIDE_HIGH; }
    return STRIDE_MID;
}

// ─────────────────────────────────────────────────────────────────────────────
// RFC-005 — attention-head pruning bitmask (layer-major, little-endian bit
// packing). Default: every head alive.
// ─────────────────────────────────────────────────────────────────────────────

pub const HEAD_MASK_BITS_PER_LAYER: i64 = 4;   // ENCODER_HEADS
pub const HEAD_MASK_TOTAL_BITS:     i64 = 8;   // ENCODER_LAYERS * ENCODER_HEADS
pub const HEAD_MASK_BYTES:          i64 = 1;   // ceil(8 / 8)

// 1 iff the (layer_idx, head_i) head is alive. Out-of-range pairs return 1
// defensively (compute rather than silently drop work).
pub fn is_head_alive(mask: i64, layer_idx: i64, head_i: i64) -> i64 {
    if layer_idx >= ENCODER_LAYERS { return 1; }
    if head_i >= ENCODER_HEADS { return 1; }
    let bit_pos: i64 = layer_idx * ENCODER_HEADS + head_i;
    let byte_index: i64 = bit_pos / 8;
    if byte_index >= HEAD_MASK_BYTES { return 1; }
    let bit_index: i64 = bit_pos % 8;
    if (__mind_load_i8(mask + byte_index) >> bit_index) & 1 == 1 { return 1; }
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// RFC-007 — attention sinks (backwards-soft default: 0 sinks).
// ─────────────────────────────────────────────────────────────────────────────

pub const NUM_SINK_TOKENS: i64 = 0;
pub const SINK_POSITIONS: [i64; 2] = [0, 1];

// ─────────────────────────────────────────────────────────────────────────────
// Window iteration math: ceil coverage, total on seq_len == 0.
// ─────────────────────────────────────────────────────────────────────────────

pub fn num_windows(seq_len: i64) -> i64 {
    if seq_len == 0 { return 0; }
    if seq_len <= ATTN_WINDOW_SIZE { return 1; }
    let tail: i64 = seq_len - ATTN_WINDOW_SIZE;
    let extra: i64 = (tail + ATTN_WINDOW_STRIDE - 1) / ATTN_WINDOW_STRIDE;
    return 1 + extra;
}

// ─────────────────────────────────────────────────────────────────────────────
// Token embedding lookup: gather rows of `emb` ([VOCAB_SIZE, H]) indexed by
// the n token ids at `ids_addr` (i64 lanes) into `out` ([n, H]). Out-of-vocab
// ids clamp to row 0 (BOS/UNK convention) so the function stays total.
// ─────────────────────────────────────────────────────────────────────────────

pub fn token_embedding_lookup(ids_addr: i64, n: i64, emb: i64, out: i64) -> i64 {
    let mut i: i64 = 0;
    while i < n {
        let mut row: i64 = __mind_load_i64(ids_addr + i * 8);
        if row >= VOCAB_SIZE { row = 0; }
        if row < 0 { row = 0; }
        let mut d: i64 = 0;
        while d < ENCODER_HIDDEN {
            __mind_store_i64(out + (i * ENCODER_HIDDEN + d) * 8,
                             __mind_load_i64(emb + (row * ENCODER_HIDDEN + d) * 8));
            d = d + 1;
        }
        i = i + 1;
    }
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// LayerNorm affine: out[d] = q16_add(q16_mul(normed[d], gain[d]), bias[d]).
// ─────────────────────────────────────────────────────────────────────────────

pub fn apply_ln_affine(normed: i64, gain: i64, bias: i64, out: i64, h: i64) -> i64 {
    let mut d: i64 = 0;
    while d < h {
        __mind_store_i64(out + d * 8,
                         q16_add(q16_mul(__mind_load_i64(normed + d * 8),
                                         __mind_load_i64(gain + d * 8)),
                                 __mind_load_i64(bias + d * 8)));
        d = d + 1;
    }
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// Pre-norm: normalization + gain/bias affine per token position.
// x is [n, H]; out is [n, H]. NORMALIZATION_KIND selects the pinned
// 5-stage LayerNorm (default) or 3-stage RMSNorm pipeline.
// ─────────────────────────────────────────────────────────────────────────────

pub fn prenorm_seq(x: i64, gain: i64, bias: i64, out: i64, n: i64, rsqrt_h: i64) -> i64 {
    let scratch: i64 = __mind_alloc(ENCODER_HIDDEN * 8);
    let mut i: i64 = 0;
    while i < n {
        if NORMALIZATION_KIND == NORMALIZATION_KIND_RMSNORM {
            q16_rmsnorm(rsqrt_h, x + i * ENCODER_HIDDEN * 8, scratch, ENCODER_HIDDEN);
        } else {
            q16_layernorm(rsqrt_h, x + i * ENCODER_HIDDEN * 8, scratch, ENCODER_HIDDEN);
        }
        apply_ln_affine(scratch, gain, bias, out + i * ENCODER_HIDDEN * 8, ENCODER_HIDDEN);
        i = i + 1;
    }
    __mind_free(scratch);
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// Linear projection: out[i, :] = x[i, :] @ W, W stored [H, H] row-major.
// Per output column, q16_dot_pinned over the hidden axis — sequential
// left-to-right; cross-position results never share an accumulator.
// ─────────────────────────────────────────────────────────────────────────────

pub fn project_linear(x: i64, w: i64, out: i64, n: i64) -> i64 {
    let col: i64 = __mind_alloc(ENCODER_HIDDEN * 8);
    let mut i: i64 = 0;
    while i < n {
        let mut o: i64 = 0;
        while o < ENCODER_HIDDEN {
            let mut k: i64 = 0;
            while k < ENCODER_HIDDEN {
                __mind_store_i64(col + k * 8, __mind_load_i64(w + (k * ENCODER_HIDDEN + o) * 8));
                k = k + 1;
            }
            __mind_store_i64(out + (i * ENCODER_HIDDEN + o) * 8,
                             q16_dot_pinned(x + i * ENCODER_HIDDEN * 8, col, ENCODER_HIDDEN));
            o = o + 1;
        }
        i = i + 1;
    }
    __mind_free(col);
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// Sliding-window self-attention. Steps (pinned order, unchanged from
// dormant): Q/K/V projections; per ascending window, per head: scores =
// dot * ATTN_SCALE_Q16 (+ ALiBi when enabled), pinned softmax, value-
// weighted sum, overlap-add into the head-tiled buffer; output projection.
// x is [n, H]; wq/wk/wv/wo are [H, H]; out is [n, H]. head_mask is the
// RFC-005 bitmask buffer; layer_idx selects its layer nibble.
// ─────────────────────────────────────────────────────────────────────────────

pub fn sliding_window_attention(x: i64, wq: i64, wk: i64, wv: i64, wo: i64,
                                stride: i64, head_mask: i64, layer_idx: i64,
                                out: i64, n: i64, exp_h: i64) -> i64 {
    let h: i64 = ENCODER_HIDDEN;
    let hd: i64 = ENCODER_HEAD_DIM;
    let win: i64 = ATTN_WINDOW_SIZE;

    // Step 1: Q, K, V projections.
    let q: i64 = __mind_alloc(n * h * 8);
    let kb: i64 = __mind_alloc(n * h * 8);
    let v: i64 = __mind_alloc(n * h * 8);
    project_linear(x, wq, q, n);
    project_linear(x, wk, kb, n);
    project_linear(x, wv, v, n);

    // RFC-011: ALiBi distance-bias table, only with ATTN_ALIBI_ENABLED = 1
    // (backwards-soft default 0 — the table stays zeroed and unread).
    let alibi: i64 = __mind_alloc(ENCODER_HEADS * n * 8);
    let mut zi: i64 = 0;
    while zi < ENCODER_HEADS * n {
        __mind_store_i64(alibi + zi * 8, 0);
        zi = zi + 1;
    }
    if ATTN_ALIBI_ENABLED == 1 {
        let mut h_idx: i64 = 0;
        while h_idx < ENCODER_HEADS {
            let slope: i64 = ATTN_ALIBI_SLOPES[h_idx];
            let mut dist: i64 = 0;
            while dist < n {
                // dist ≤ 1023 → dist << 16 ≤ 2^26, no saturation.
                __mind_store_i64(alibi + (h_idx * n + dist) * 8,
                                 q16_neg(q16_mul(slope, dist * ONE_Q16_16)));
                dist = dist + 1;
            }
            h_idx = h_idx + 1;
        }
    }

    // Step 2: head-tiled output buffer (zero-initialised) + per-head scratch.
    let tiled: i64 = __mind_alloc(n * h * 8);
    zi = 0;
    while zi < n * h {
        __mind_store_i64(tiled + zi * 8, 0);
        zi = zi + 1;
    }
    let qw: i64 = __mind_alloc(win * hd * 8);
    let kw: i64 = __mind_alloc((win + 2) * hd * 8);
    let vw: i64 = __mind_alloc((win + 2) * hd * 8);
    let scores: i64 = __mind_alloc((win + 2) * 8);
    let probs: i64 = __mind_alloc((win + 2) * 8);
    let v_col: i64 = __mind_alloc((win + 2) * 8);

    let mut s: i64 = 0;
    let mut cont: i64 = 1;
    while cont == 1 {
        let mut e: i64 = s + win;
        if e > n { e = n; }
        let w_len: i64 = e - s;

        // RFC-007 sink count: window 0 already covers the sink positions.
        let mut sink_count: i64 = NUM_SINK_TOKENS;
        if s == 0 { sink_count = 0; }
        if n < NUM_SINK_TOKENS { sink_count = 0; }
        let kv_len: i64 = w_len + sink_count;

        let mut head_i: i64 = 0;
        while head_i < ENCODER_HEADS {
            if is_head_alive(head_mask, layer_idx, head_i) == 1 {
                let head_off: i64 = head_i * hd;

                // Per (i, j): scores = (qw[i] · kw[j]) * ATTN_SCALE_Q16,
                // softmax over the row, then accumulate the value-weighted
                // sum column-by-column. Scores are consumed row-by-row, so
                // only one scores/probs row is materialised at a time; the
                // reduction order is identical to the dormant full-matrix
                // form (ascending i, ascending j, ascending d).
                let mut i: i64 = 0;
                while i < w_len {
                    let mut j: i64 = 0;
                    while j < kv_len {
                        // kw/vw row for key j: sink rows at [0, sink_count)
                        // from SINK_POSITIONS, local rows from [s, e).
                        let mut src_row: i64 = 0;
                        if j < sink_count {
                            src_row = SINK_POSITIONS[j];
                        } else {
                            src_row = s + (j - sink_count);
                        }
                        let raw: i64 = q16_dot_pinned(q + ((s + i) * h + head_off) * 8,
                                                      kb + (src_row * h + head_off) * 8, hd);
                        let mut sc: i64 = q16_mul(raw, ATTN_SCALE_Q16);
                        if ATTN_ALIBI_ENABLED == 1 {
                            let abs_i: i64 = s + i;
                            let mut abs_j: i64 = 0;
                            if j < sink_count {
                                abs_j = SINK_POSITIONS[j];
                            } else {
                                abs_j = s + (j - sink_count);
                            }
                            let mut dist: i64 = abs_i - abs_j;
                            if dist < 0 { dist = 0 - dist; }
                            sc = q16_add(sc, __mind_load_i64(alibi + (head_i * n + dist) * 8));
                        }
                        __mind_store_i64(scores + j * 8, sc);
                        j = j + 1;
                    }
                    q16_softmax(exp_h, scores, probs, kv_len);

                    let mut d: i64 = 0;
                    while d < hd {
                        let mut j2: i64 = 0;
                        while j2 < kv_len {
                            let mut src_row2: i64 = 0;
                            if j2 < sink_count {
                                src_row2 = SINK_POSITIONS[j2];
                            } else {
                                src_row2 = s + (j2 - sink_count);
                            }
                            __mind_store_i64(v_col + j2 * 8,
                                             __mind_load_i64(v + (src_row2 * h + head_off + d) * 8));
                            j2 = j2 + 1;
                        }
                        let contrib: i64 = q16_dot_pinned(probs, v_col, kv_len);
                        let pos: i64 = (s + i) * h + head_off + d;
                        __mind_store_i64(tiled + pos * 8,
                                         q16_add(__mind_load_i64(tiled + pos * 8), contrib));
                        d = d + 1;
                    }
                    i = i + 1;
                }
            }
            head_i = head_i + 1;
        }

        if e >= n {
            cont = 0;
        } else {
            s = s + stride;
        }
    }

    // Step 3: output projection.
    project_linear(tiled, wo, out, n);

    __mind_free(v_col);
    __mind_free(probs);
    __mind_free(scores);
    __mind_free(vw);
    __mind_free(kw);
    __mind_free(qw);
    __mind_free(tiled);
    __mind_free(alibi);
    __mind_free(v);
    __mind_free(kb);
    __mind_free(q);
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// Gated residual: out[i, d] = in[i, d] + sigmoid(gate[d]) * attn[i, d].
// Sigmoid is the pinned exp-LUT path (q16_sigmoid_lut). The ONLY
// nonlinearity per encoder layer besides attention's softmax; there is no
// FFN sublayer.
// ─────────────────────────────────────────────────────────────────────────────

pub fn gated_residual(layer_in: i64, layer_out: i64, gate: i64, out: i64,
                      n: i64, exp_h: i64) -> i64 {
    let sig: i64 = __mind_alloc(ENCODER_HIDDEN * 8);
    let mut d: i64 = 0;
    while d < ENCODER_HIDDEN {
        __mind_store_i64(sig + d * 8, q16_sigmoid_lut(exp_h, __mind_load_i64(gate + d * 8)));
        d = d + 1;
    }
    let mut i: i64 = 0;
    while i < n {
        let mut d2: i64 = 0;
        while d2 < ENCODER_HIDDEN {
            let off: i64 = (i * ENCODER_HIDDEN + d2) * 8;
            __mind_store_i64(out + off,
                             q16_add(__mind_load_i64(layer_in + off),
                                     q16_mul(__mind_load_i64(sig + d2 * 8),
                                             __mind_load_i64(layer_out + off))));
            d2 = d2 + 1;
        }
        i = i + 1;
    }
    __mind_free(sig);
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// RFC-009 — learned single-latent-query attention pool.
// x is [n, H]; q_latent is H lanes; out is H lanes.
// ─────────────────────────────────────────────────────────────────────────────

pub fn attn_pool_seq_kernel(x: i64, q_latent: i64, out: i64, n: i64, exp_h: i64) -> i64 {
    let mut i: i64 = 0;
    while i < ENCODER_HIDDEN {
        __mind_store_i64(out + i * 8, 0);
        i = i + 1;
    }
    if n == 0 { return 0; }

    let scores: i64 = __mind_alloc(n * 8);
    let probs: i64 = __mind_alloc(n * 8);
    i = 0;
    while i < n {
        __mind_store_i64(scores + i * 8,
                         q16_dot_pinned(q_latent, x + i * ENCODER_HIDDEN * 8, ENCODER_HIDDEN));
        i = i + 1;
    }
    q16_softmax(exp_h, scores, probs, n);

    let mut d: i64 = 0;
    while d < ENCODER_HIDDEN {
        let mut acc: i64 = 0;
        i = 0;
        while i < n {
            acc = q16_add(acc, q16_mul(__mind_load_i64(probs + i * 8),
                                       __mind_load_i64(x + (i * ENCODER_HIDDEN + d) * 8)));
            i = i + 1;
        }
        __mind_store_i64(out + d * 8, acc);
        d = d + 1;
    }
    __mind_free(probs);
    __mind_free(scores);
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// RFC-014 — multi-query latent attention pooling (r >= 1 latent queries,
// row-major [r, H]). Cross-query mean via saturating divide by r * ONE.
// ─────────────────────────────────────────────────────────────────────────────

pub fn attn_pool_seq_kernel_multi(x: i64, q_latent_multi: i64, r: i64,
                                  out: i64, n: i64, exp_h: i64) -> i64 {
    let mut d: i64 = 0;
    while d < ENCODER_HIDDEN {
        __mind_store_i64(out + d * 8, 0);
        d = d + 1;
    }
    if n == 0 { return 0; }
    if r == 0 { return 0; }

    let acc_buf: i64 = __mind_alloc(ENCODER_HIDDEN * 8);
    let scores: i64 = __mind_alloc(n * 8);
    let probs: i64 = __mind_alloc(n * 8);
    d = 0;
    while d < ENCODER_HIDDEN {
        __mind_store_i64(acc_buf + d * 8, 0);
        d = d + 1;
    }

    let mut q_idx: i64 = 0;
    while q_idx < r {
        let q_row: i64 = q_latent_multi + q_idx * ENCODER_HIDDEN * 8;
        let mut i: i64 = 0;
        while i < n {
            __mind_store_i64(scores + i * 8,
                             q16_dot_pinned(q_row, x + i * ENCODER_HIDDEN * 8, ENCODER_HIDDEN));
            i = i + 1;
        }
        q16_softmax(exp_h, scores, probs, n);
        d = 0;
        while d < ENCODER_HIDDEN {
            let mut acc: i64 = 0;
            i = 0;
            while i < n {
                acc = q16_add(acc, q16_mul(__mind_load_i64(probs + i * 8),
                                           __mind_load_i64(x + (i * ENCODER_HIDDEN + d) * 8)));
                i = i + 1;
            }
            __mind_store_i64(acc_buf + d * 8,
                             q16_add(__mind_load_i64(acc_buf + d * 8), acc));
            d = d + 1;
        }
        q_idx = q_idx + 1;
    }

    let r_q16: i64 = r * ONE_Q16_16;
    d = 0;
    while d < ENCODER_HIDDEN {
        __mind_store_i64(out + d * 8, q16_div_sat(__mind_load_i64(acc_buf + d * 8), r_q16));
        d = d + 1;
    }
    __mind_free(probs);
    __mind_free(scores);
    __mind_free(acc_buf);
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// Mean-pool over the seq_len axis — dispatches on POOLING_KIND. Default
// (MEAN): per-dimension pinned sequential sum + saturating divide by n.
// x is [n, H]; out is H lanes. n == 0 returns the all-zero vector.
// ─────────────────────────────────────────────────────────────────────────────

pub fn mean_pool_seq_kernel(x: i64, out: i64, n: i64, exp_h: i64) -> i64 {
    if POOLING_KIND == POOLING_KIND_LEARNED_ATTN {
        if POOL_LATENT_QUERIES > 1 {
            let qlm: i64 = pool_q_latent_default();
            attn_pool_seq_kernel_multi(x, qlm, POOL_LATENT_QUERIES, out, n, exp_h);
            __mind_free(qlm);
            return 0;
        }
        let ql: i64 = pool_q_latent_default();
        attn_pool_seq_kernel(x, ql, out, n, exp_h);
        __mind_free(ql);
        return 0;
    }

    let mut d: i64 = 0;
    while d < ENCODER_HIDDEN {
        __mind_store_i64(out + d * 8, 0);
        d = d + 1;
    }
    if n == 0 { return 0; }

    let col: i64 = __mind_alloc(n * 8);
    let n_q16: i64 = n * ONE_Q16_16;
    d = 0;
    while d < ENCODER_HIDDEN {
        let mut i: i64 = 0;
        while i < n {
            __mind_store_i64(col + i * 8, __mind_load_i64(x + (i * ENCODER_HIDDEN + d) * 8));
            i = i + 1;
        }
        let s: i64 = q16_sum_pinned(col, n);
        __mind_store_i64(out + d * 8, q16_div_sat(s, n_q16));
        d = d + 1;
    }
    __mind_free(col);
    0
}
