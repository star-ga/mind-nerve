SESSION_START_CONTEXT = (
    "## mind-nerve ready\n\n"
    "Hub: `{hub}` — deliberately NOT auto-listed ({n} skills would cost ~115k tokens).\n"
    "Relevant routes are injected automatically on every prompt. Use the\n"
    "`mind-nerve-router` skill, or read the absolute SKILL.md paths as they arrive.\n"
)


def _session_banner_due() -> bool:
    """Throttle the SessionStart banner; the projection runs regardless.

    The sentinel lives next to the hook log so a redirected MIND_NERVE_LOG
    (tests, per-CLI state) gets an independent banner clock. Best-effort: any
    filesystem error means 'due' — a spurious banner costs a few tokens, a
    spuriously suppressed one costs orientation.
    """
    if SESSION_BANNER_MIN_INTERVAL_S <= 0:
        return True
    sentinel = LOG_PATH.parent / "last_session_banner"
    try:
        last = float(sentinel.read_text().strip())
    except Exception:
        last = 0.0
    now = time.time()
    if now - last < SESSION_BANNER_MIN_INTERVAL_S:
        return False
    try:
        sentinel.parent.mkdir(parents=True, exist_ok=True)
        sentinel.write_text(f"{now:.3f}")
    except Exception:
        pass
    return True


def main() -> None:
    t0 = time.time()
    data = read_stdin()
    event = str(
        data.get("hookEventName")
        or data.get("hook_event_name")
        or data.get("event")
        or "UserPromptSubmit"
    )
    raw_prompt = prompt_from(data)
    source = list_source_skills()

    if not source:
        log({"event": "no_source", "dir": str(SOURCE_DIR)})
        emit(event, None)
        return

    # SessionStart (or any event without a prompt): seed the projection with the
    # core set only, and say so. No routing without a query.
    if not raw_prompt:
        selected = select_for_projection([], source)
        n = write_projection(selected) if selected else 0
        log({"event": "session_start", "projected": n})
        if _session_banner_due():
            emit(event, SESSION_START_CONTEXT.format(hub=SOURCE_DIR, n=len(source)))
        else:
            emit(event, None)
        return

    should_route, reason, prompt = intent_gate(raw_prompt)
    if not should_route:
        # Emit nothing and touch nothing. The previous projection stays exactly
        # as it was, which is the correct state: the user did not ask for
        # anything new, so the skills from their actual last request remain.
        log({"event": "intent_skip", "reason": reason, "prompt_head": raw_prompt[:80]})
        telemetry(
            {
                "event": "route_decision",
                "decision": "skip",
                "reason": reason,
                "query_sha": query_digest(raw_prompt),
                "query_len": len(raw_prompt),
                "cli_event": event,
                "ms": int((time.time() - t0) * 1000),
            }
        )
        print("{}")
        return

    routes = query_daemon(prompt, OVERFETCH)
    if routes is None:
        # Daemon absent / timed out / malformed — pass through untouched.
        log({"event": "passthrough", "prompt_head": prompt[:80]})
        telemetry(
            {
                "event": "route_decision",
                "decision": "passthrough",
                "reason": "daemon_unavailable",
                "query_sha": query_digest(raw_prompt),
                "cli_event": event,
                "ms": int((time.time() - t0) * 1000),
            }
        )
        emit(event, None)
        return

    deduped = dedup_routes(routes, source)
    thresholded = apply_threshold(deduped, MIN_SCORE)
    # Drop unresolved rows BEFORE slicing top-K. An "unknown" route has no
    # path — zero routing value — and its name is unsanitized catalog text:
    # interpolating it into the injected Markdown table would let a malformed
    # (or hostile) catalog row write arbitrary instructions into the model's
    # context (2026-08-10 codex audit). Resolved names are safe by
    # construction — they matched a real hub dir or agent file on disk.
    resolved = [r for r in thresholded if r.get("kind") in ("skill", "agent")]
    kept = resolved[:TOP_K]
    ratio = top2_ratio(deduped)

    selected = select_for_projection(kept, source)
    n = write_projection(selected)
    ctx = build_context(kept, n if n > 0 else len(selected), MIN_SCORE)

    log(
        {
            "event": "auto_routed",
            "raw": len(routes),
            "deduped": len(deduped),
            "kept": len(kept),
            "projected": n,
            "top": [r.get("name") for r in kept[:5]],
            "prompt_head": prompt[:100],
            "ms": int((time.time() - t0) * 1000),
        }
    )
    telemetry(
        {
            "event": "route_decision",
            "decision": "routed" if kept else "no_match",
            "reason": reason,
            "query_sha": query_digest(raw_prompt),
            "query_len": len(raw_prompt),
            "evaluated_len": len(prompt),
            "cli_event": event,
            "min_score": MIN_SCORE,
            "top2_ratio": ratio,
            "raw": len(routes),
            "deduped": len(deduped),
            "thresholded": len(thresholded),
            "kept": len(kept),
            "projected": n,
            "generation": generation_key(selected),
            "top": [
                {
                    "name": r.get("name"),
                    "score": round(r.get("score_f", 0.0), 4),
                    "kind": r.get("kind"),
                    "path": r.get("path"),
                }
                for r in kept[:TOP_K]
            ],
            "ms": int((time.time() - t0) * 1000),
        }
    )
    emit(event, ctx)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # noqa: BLE001 — fail-open is the contract
        log({"event": "fatal", "err": str(e)})
        print("{}")
        sys.exit(0)
