    __mind_store_i64(exp + 8, 1062);
    __mind_store_i64(exp + 16, 102);
    let rc: i64 = wt_run(t, buf, 3, exp, 3);
    assert rc == 0, "case 21 byte-ids match HF";
    __mind_free(exp);
    __mind_free(buf);
    wp_tables_free(t);
}

#[test]
fn test_wp_truncation_256() {
    // "hello world " x 130 — 262 tokens untruncated; truncates to 254 +
    // CLS/SEP = 256 ids.
