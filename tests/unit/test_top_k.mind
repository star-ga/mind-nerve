// tests/unit/test_top_k.mind — determinism + uniqueness suite for
// src/top_k.mind. Audit A3 (catalog uniqueness), A6 (top-K bit-identity).
//
// Ported to mindc 0.10.2 (wave 2, 2026-08-11) from
// tests/unit/dormant/test_top_k.mind. The dormant file targeted
// src/inference.mind's re-export; this suite tests src/top_k.mind directly
// (inference.mind's re-export arrives in wave 4). Runs through `mindc test`
// on a merged image (src/sha256.mind + src/top_k.mind + this file), driven
// by tests/mindc_gate.sh leg 6 with an exact-count assertion — a
// "running 0 tests" output FAILS the gate.
//
// ORACLE PROVENANCE (done-gate d): the eight canonical-result-hash digests
// are the dormant file's published 2026-05-13 values, RE-VERIFIED byte-for-
// byte against CPython hashlib + the canonical serialization spec
// (u32-LE len=32 || route_id || i32-LE score per entry) before embedding:
//   basic k3      2255a0eabacda7217582a570d39d7f4ee5f359d8252417abce86fe5e3f6df42c
//   k == n        20b61f31c994adb67941b42a8c5fedf53aec26cdec71d37edc9ba1abb86522ab
//   single k1     dfb045eaca8d9b9b97546b180f2620b39f4a6c576fb01e903956e143e3f5aa7c
//   tiebreak      34ecc49fe44d56a736e6acd6766f7381cacb8e845593be624fce91f2618f87fa
//   all-tied k2   51ea94f034c83a64fe76d0d7512b3d36dab1f516d2ec60c63e2605d30fe575da
//   100 runs      712b0abc728c6510421f273b1cacf10e504b5c0f8a6cd8a61334e9a5ee2898f2
//   negative      32f8880454a3312615c33b4aadd6d4a279bff0992551dcbb23dd118c45d7ae98
//   ulp k1        bc7a9280a6c70566f8b92c23f37373a1bb6c8273f9166fc7eeaba2a71d9a3013
// Route ids are computed IN-TEST via mn_sha256 (route_id_of), exactly as the
// dormant suite did — the hashing path stays under test.
//
// NOTE (0.10.2 test-interpreter hazard, repro
// mind-flow/target/repro-0.10.2/r9_test_assert_deferred.mind): `assert`
// conditions are evaluated LAZILY — a condition that reads state mutated
// later in the same test is mis-evaluated. Discipline in this file: any
// assert whose read state is mutated afterwards (the 100-run loops) binds
// the condition with `let` first, forcing eager evaluation.
//
// ABI: route-id buffers are n*32 bytes; scores are i64 lanes (8-byte
// stride); masks are n bytes. q16(v) == v << 16.

// ── helpers (tt_ prefix) ────────────────────────────────────────────────────

fn tt_id_eq(a: i64, b: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 32 {
        if __mind_load_i8(a + i) != __mind_load_i8(b + i) { return 0; }
        i = i + 1;
    }
    1
}

// Hash the external id bytes into catalog slot i (route_id_of).
fn tt_mkid(ids: i64, i: i64, sbuf: i64, slen: i64) -> i64 {
    mn_sha256(sbuf, slen, ids + i * 32);
    0
}

// Assert helper: returns 1 when out_ids slot `slot` equals SHA-256(sbuf).
fn tt_slot_is(out_ids: i64, slot: i64, sbuf: i64, slen: i64) -> i64 {
    let tmp: i64 = __mind_alloc(32);
    mn_sha256(sbuf, slen, tmp);
    let eq: i64 = tt_id_eq(out_ids + slot * 32, tmp);
    __mind_free(tmp);
    eq
}

fn tt_digest_word(out: i64, w: i64) -> i64 {
    let b0: i64 = __mind_load_i8(out + w * 4) & 255;
    let b1: i64 = __mind_load_i8(out + w * 4 + 1) & 255;
    let b2: i64 = __mind_load_i8(out + w * 4 + 2) & 255;
    let b3: i64 = __mind_load_i8(out + w * 4 + 3) & 255;
    b0 * 16777216 + b1 * 65536 + b2 * 256 + b3
}

fn tt_check_hash(out: i64, w0: i64, w1: i64, w2: i64, w3: i64, w4: i64, w5: i64, w6: i64, w7: i64) -> i64 {
    if tt_digest_word(out, 0) != w0 { return 1; }
    if tt_digest_word(out, 1) != w1 { return 2; }
    if tt_digest_word(out, 2) != w2 { return 3; }
    if tt_digest_word(out, 3) != w3 { return 4; }
    if tt_digest_word(out, 4) != w4 { return 5; }
    if tt_digest_word(out, 5) != w5 { return 6; }
    if tt_digest_word(out, 6) != w6 { return 7; }
    if tt_digest_word(out, 7) != w7 { return 8; }
    0
}

// External-id string builders (byte stores; return length).
fn tt_str1(buf: i64, c: i64) -> i64 {
    __mind_store_i8(buf, c);
    1
}
fn tt_str_route(buf: i64, d: i64) -> i64 {
    __mind_store_i8(buf + 0, 114);
    __mind_store_i8(buf + 1, 111);
    __mind_store_i8(buf + 2, 117);
    __mind_store_i8(buf + 3, 116);
    __mind_store_i8(buf + 4, 101);
    __mind_store_i8(buf + 5, 95);
    __mind_store_i8(buf + 6, 48 + d);
    7
}
fn tt_str_negroute(buf: i64, d: i64) -> i64 {
    __mind_store_i8(buf + 0, 110);
    __mind_store_i8(buf + 1, 101);
    __mind_store_i8(buf + 2, 103);
    __mind_store_i8(buf + 3, 95);
    __mind_store_i8(buf + 4, 114);
    __mind_store_i8(buf + 5, 111);
    __mind_store_i8(buf + 6, 117);
    __mind_store_i8(buf + 7, 116);
    __mind_store_i8(buf + 8, 101);
    __mind_store_i8(buf + 9, 95);
    __mind_store_i8(buf + 10, 48 + d);
    11
}
fn tt_str_r(buf: i64, d: i64) -> i64 {
    __mind_store_i8(buf + 0, 114);
    __mind_store_i8(buf + 1, 48 + d);
    2
}
fn tt_str_n(buf: i64, d: i64) -> i64 {
    __mind_store_i8(buf + 0, 110);
    __mind_store_i8(buf + 1, 48 + d);
    2
}
fn tt_str_ulp(buf: i64, c: i64) -> i64 {
    __mind_store_i8(buf + 0, 117);
    __mind_store_i8(buf + 1, 108);
    __mind_store_i8(buf + 2, 112);
    __mind_store_i8(buf + 3, 95);
    __mind_store_i8(buf + 4, 114);
    __mind_store_i8(buf + 5, 111);
    __mind_store_i8(buf + 6, 117);
    __mind_store_i8(buf + 7, 116);
    __mind_store_i8(buf + 8, 101);
    __mind_store_i8(buf + 9, 95);
    __mind_store_i8(buf + 10, c);
    11
}
fn tt_str_apple(buf: i64) -> i64 {
    __mind_store_i8(buf + 0, 97);
    __mind_store_i8(buf + 1, 112);
    __mind_store_i8(buf + 2, 112);
    __mind_store_i8(buf + 3, 108);
    __mind_store_i8(buf + 4, 101);
    5
}
fn tt_str_zebra(buf: i64) -> i64 {
    __mind_store_i8(buf + 0, 122);
    __mind_store_i8(buf + 1, 101);
    __mind_store_i8(buf + 2, 98);
    __mind_store_i8(buf + 3, 114);
    __mind_store_i8(buf + 4, 97);
    5
}
fn tt_str_banana(buf: i64) -> i64 {
    __mind_store_i8(buf + 0, 98);
    __mind_store_i8(buf + 1, 97);
    __mind_store_i8(buf + 2, 110);
    __mind_store_i8(buf + 3, 97);
    __mind_store_i8(buf + 4, 110);
    __mind_store_i8(buf + 5, 97);
    6
}
fn tt_str_solo(buf: i64) -> i64 {
    __mind_store_i8(buf + 0, 115);
    __mind_store_i8(buf + 1, 111);
    __mind_store_i8(buf + 2, 108);
    __mind_store_i8(buf + 3, 111);
    4
}

// The standard 10-route fixture: ids route_0..route_9, scores 9..0 in Q16.16.
fn tt_cat10(ids: i64, scores: i64, sbuf: i64) -> i64 {
    let mut i: i64 = 0;
    while i < 10 {
        let len: i64 = tt_str_route(sbuf, i);
        tt_mkid(ids, i, sbuf, len);
        __mind_store_i64(scores + i * 8, (9 - i) * 65536);
        i = i + 1;
    }
    0
}

fn tt_popcount(mask: i64, n: i64) -> i64 {
    let mut c: i64 = 0;
    let mut i: i64 = 0;
    while i < n {
        if __mind_load_i8(mask + i) == 1 { c = c + 1; }
        i = i + 1;
    }
    c
}

// ── Section 1: basic top-K extraction ───────────────────────────────────────

#[test]
fn test_top_k_basic_k3() {
    let ids: i64 = __mind_alloc(320);
    let scores: i64 = __mind_alloc(80);
    let sbuf: i64 = __mind_alloc(16);
    tt_cat10(ids, scores, sbuf);
    let out_ids: i64 = __mind_alloc(96);
    let out_scores: i64 = __mind_alloc(24);

    let n: i64 = extract_top_k(scores, ids, 10, 3, out_ids, out_scores);
    assert n == 3, "k=3 returns 3 entries";
    assert tt_slot_is(out_ids, 0, sbuf, tt_str_route(sbuf, 0)) == 1, "route_0 first";
    assert tt_slot_is(out_ids, 1, sbuf, tt_str_route(sbuf, 1)) == 1, "route_1 second";
    assert tt_slot_is(out_ids, 2, sbuf, tt_str_route(sbuf, 2)) == 1, "route_2 third";
    assert __mind_load_i64(out_scores + 0) == 589824, "score 9.0";
    assert __mind_load_i64(out_scores + 8) == 524288, "score 8.0";
    assert __mind_load_i64(out_scores + 16) == 458752, "score 7.0";

    let h: i64 = __mind_alloc(32);
    canonical_result_hash(out_ids, out_scores, n, h);
    // Oracle 2255a0ea… (published 2026-05-13, re-verified vs hashlib).
    let rc: i64 = tt_check_hash(h, 576037098, 3134039841, 1971496304, 3550314318, 3857930712, 623122347, 3464953438, 1064170540);
    assert rc == 0, "canonical_result_hash basic k3 oracle";
    __mind_free(h);
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_basic_k_equals_n() {
    let ids: i64 = __mind_alloc(320);
    let scores: i64 = __mind_alloc(80);
    let sbuf: i64 = __mind_alloc(16);
    tt_cat10(ids, scores, sbuf);
    let out_ids: i64 = __mind_alloc(320);
    let out_scores: i64 = __mind_alloc(80);

    let n: i64 = extract_top_k(scores, ids, 10, 10, out_ids, out_scores);
    assert n == 10, "k=N returns all 10";
    let mut i: i64 = 0;
    while i < 10 {
        assert tt_slot_is(out_ids, i, sbuf, tt_str_route(sbuf, i)) == 1, "route_i at position i";
        assert __mind_load_i64(out_scores + i * 8) == (9 - i) * 65536, "descending scores";
        i = i + 1;
    }

    let h: i64 = __mind_alloc(32);
    canonical_result_hash(out_ids, out_scores, n, h);
    // Oracle 20b61f31…
    let rc: i64 = tt_check_hash(h, 548806449, 3381964214, 2034349098, 2355097077, 988554957, 3966882686, 3701186987, 3093635755);
    assert rc == 0, "canonical_result_hash k==N oracle";
    __mind_free(h);
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_k_zero() {
    let ids: i64 = __mind_alloc(96);
    let scores: i64 = __mind_alloc(24);
    let sbuf: i64 = __mind_alloc(16);
    let mut i: i64 = 0;
    while i < 3 {
        let len: i64 = tt_str_route(sbuf, i);
        tt_mkid(ids, i, sbuf, len);
        __mind_store_i64(scores + i * 8, (9 - i) * 65536);
        i = i + 1;
    }
    let out_ids: i64 = __mind_alloc(32);
    let out_scores: i64 = __mind_alloc(8);
    let n: i64 = extract_top_k(scores, ids, 3, 0, out_ids, out_scores);
    assert n == 0, "k=0 returns empty result, not an error";
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_k_exceeds_n() {
    let ids: i64 = __mind_alloc(320);
    let scores: i64 = __mind_alloc(80);
    let sbuf: i64 = __mind_alloc(16);
    tt_cat10(ids, scores, sbuf);
    let out_ids: i64 = __mind_alloc(320);
    let out_scores: i64 = __mind_alloc(80);

    let n: i64 = extract_top_k(scores, ids, 10, 15, out_ids, out_scores);
    assert n == 10, "k>N saturates at N (all 10, no padding)";
    assert tt_slot_is(out_ids, 0, sbuf, tt_str_route(sbuf, 0)) == 1, "route_0 first";
    assert tt_slot_is(out_ids, 9, sbuf, tt_str_route(sbuf, 9)) == 1, "route_9 last";

    let h: i64 = __mind_alloc(32);
    canonical_result_hash(out_ids, out_scores, n, h);
    // Same oracle as k==N: 20b61f31…
    let rc: i64 = tt_check_hash(h, 548806449, 3381964214, 2034349098, 2355097077, 988554957, 3966882686, 3701186987, 3093635755);
    assert rc == 0, "canonical_result_hash k>N oracle";
    __mind_free(h);
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_single_route_k1() {
    let ids: i64 = __mind_alloc(32);
    let scores: i64 = __mind_alloc(8);
    let sbuf: i64 = __mind_alloc(16);
    let len: i64 = tt_str_route(sbuf, 0);
    tt_mkid(ids, 0, sbuf, len);
    __mind_store_i64(scores, 589824);
    let out_ids: i64 = __mind_alloc(32);
    let out_scores: i64 = __mind_alloc(8);

    let n: i64 = extract_top_k(scores, ids, 1, 1, out_ids, out_scores);
    assert n == 1, "single route returned";
    assert tt_slot_is(out_ids, 0, sbuf, tt_str_route(sbuf, 0)) == 1, "route_0";
    assert __mind_load_i64(out_scores) == 589824, "score 9.0";

    let h: i64 = __mind_alloc(32);
    canonical_result_hash(out_ids, out_scores, n, h);
    // Oracle dfb045ea…
    let rc: i64 = tt_check_hash(h, 3752871402, 3398278043, 2538892056, 254156979, 2672454743, 1873813136, 961995075, 3824527996);
    assert rc == 0, "canonical_result_hash single k1 oracle";
    __mind_free(h);
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

// ── Section 2: tie-break determinism ────────────────────────────────────────

#[test]
fn test_top_k_tiebreak_two_tied_one_clear() {
    // scores [5,5,4] over ids [zebra, apple, banana], k=2.
    // SHA-256("apple") = 3a7b… < SHA-256("zebra") = 676c… → apple wins.
    let ids: i64 = __mind_alloc(96);
    let scores: i64 = __mind_alloc(24);
    let sbuf: i64 = __mind_alloc(16);
    tt_mkid(ids, 0, sbuf, tt_str_zebra(sbuf));
    tt_mkid(ids, 1, sbuf, tt_str_apple(sbuf));
    tt_mkid(ids, 2, sbuf, tt_str_banana(sbuf));
    __mind_store_i64(scores + 0, 327680);
    __mind_store_i64(scores + 8, 327680);
    __mind_store_i64(scores + 16, 262144);
    let out_ids: i64 = __mind_alloc(64);
    let out_scores: i64 = __mind_alloc(16);

    let n: i64 = extract_top_k(scores, ids, 3, 2, out_ids, out_scores);
    assert n == 2, "two entries";
    assert tt_slot_is(out_ids, 0, sbuf, tt_str_apple(sbuf)) == 1, "apple wins the tie";
    assert tt_slot_is(out_ids, 1, sbuf, tt_str_zebra(sbuf)) == 1, "zebra second";
    assert __mind_load_i64(out_scores + 0) == 327680, "score 5.0";
    assert __mind_load_i64(out_scores + 8) == 327680, "score 5.0";

    let h: i64 = __mind_alloc(32);
    canonical_result_hash(out_ids, out_scores, n, h);
    // Oracle 34ecc49f…
    let rc: i64 = tt_check_hash(h, 887932063, 3830273703, 921087190, 1987015553, 3402337924, 1435745890, 1338937842, 1636796410);
    assert rc == 0, "canonical_result_hash tiebreak oracle";
    __mind_free(h);
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_tiebreak_all_tied_k2() {
    // All five tied; ascending SHA-256 order is d < c < b < e < a → [d, c].
    let ids: i64 = __mind_alloc(160);
    let scores: i64 = __mind_alloc(40);
    let sbuf: i64 = __mind_alloc(16);
    let mut i: i64 = 0;
    while i < 5 {
        tt_mkid(ids, i, sbuf, tt_str1(sbuf, 97 + i));
        __mind_store_i64(scores + i * 8, 196608);
        i = i + 1;
    }
    let out_ids: i64 = __mind_alloc(64);
    let out_scores: i64 = __mind_alloc(16);

    let n: i64 = extract_top_k(scores, ids, 5, 2, out_ids, out_scores);
    assert n == 2, "two entries";
    assert tt_slot_is(out_ids, 0, sbuf, tt_str1(sbuf, 100)) == 1, "d first (lowest sha)";
    assert tt_slot_is(out_ids, 1, sbuf, tt_str1(sbuf, 99)) == 1, "c second";
    assert __mind_load_i64(out_scores + 0) == 196608, "score 3.0";
    assert __mind_load_i64(out_scores + 8) == 196608, "score 3.0";

    let h: i64 = __mind_alloc(32);
    canonical_result_hash(out_ids, out_scores, n, h);
    // Oracle 51ea94f0…
    let rc: i64 = tt_check_hash(h, 1374328048, 885537380, 4269199575, 1361788214, 3669095702, 3538706630, 1042679251, 266696154);
    assert rc == 0, "canonical_result_hash all-tied oracle";
    __mind_free(h);
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

// ── Section 3: determinism across runs ──────────────────────────────────────

#[test]
fn test_top_k_determinism_100_runs() {
    // 100 invocations of the same (scores, catalog, k): every run must
    // reproduce the reference ids bit-for-bit; the concatenated id bytes
    // hash to the published 100-run oracle.
    let ids: i64 = __mind_alloc(320);
    let scores: i64 = __mind_alloc(80);
    let sbuf: i64 = __mind_alloc(16);
    tt_cat10(ids, scores, sbuf);
    let ref_ids: i64 = __mind_alloc(96);
    let ref_scores: i64 = __mind_alloc(24);
    let rn: i64 = extract_top_k(scores, ids, 10, 3, ref_ids, ref_scores);
    assert rn == 3, "reference run returns 3";

    let acc: i64 = __mind_alloc(9600);
    let out_ids: i64 = __mind_alloc(96);
    let out_scores: i64 = __mind_alloc(24);
    let mut run: i64 = 0;
    while run < 100 {
        let n: i64 = extract_top_k(scores, ids, 10, 3, out_ids, out_scores);
        assert n == 3, "every run returns 3";
        let mut e: i64 = 0;
        while e < 3 {
            let ids_eq: i64 = tt_id_eq(out_ids + e * 32, ref_ids + e * 32);
            assert ids_eq == 1, "bit-identical ids across runs";
            e = e + 1;
        }
        let mut b: i64 = 0;
        while b < 96 {
            __mind_store_i8(acc + run * 96 + b, __mind_load_i8(out_ids + b));
            b = b + 1;
        }
        run = run + 1;
    }

    let h: i64 = __mind_alloc(32);
    mn_sha256(acc, 9600, h);
    // Oracle 712b0abc… (published 2026-05-13, re-verified vs hashlib 2026-08-11).
    let rc: i64 = tt_check_hash(h, 1898646204, 1921803536, 1109337915, 481095950, 1347116047, 2322389158, 322234789, 3995638002);
    assert rc == 0, "100-run concatenated hash oracle";
    __mind_free(h);
    __mind_free(acc);
    __mind_free(out_ids);
    __mind_free(out_scores);
    __mind_free(ref_ids);
    __mind_free(ref_scores);
    __mind_free(ids);
    __mind_free(scores);
    __mind_free(sbuf);
}

// ── Section 4: catalog uniqueness (audit A3) ────────────────────────────────
// catalog_check_unique returns 0 when all ids are distinct, else (i + 1)
// where i is the first index whose route_id already appeared at some j < i.

#[test]
fn test_top_k_unique_catalog_rejects_duplicate() {
    let ids: i64 = __mind_alloc(96);
    let sbuf: i64 = __mind_alloc(16);
    tt_mkid(ids, 0, sbuf, tt_str1(sbuf, 97));
    tt_mkid(ids, 1, sbuf, tt_str1(sbuf, 98));
    tt_mkid(ids, 2, sbuf, tt_str1(sbuf, 97));
    let rc: i64 = catalog_check_unique(ids, 3);
    assert rc == 3, "duplicate at index 2 reported as (i + 1)";
    // The offending route_id is readable at ids + 2*32 and is SHA-256("a").
    assert tt_slot_is(ids, 2, sbuf, tt_str1(sbuf, 97)) == 1, "error identifies the duplicate route_id";
    __mind_free(ids);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_unique_catalog_allows_empty() {
    let ids: i64 = __mind_alloc(32);
    assert catalog_check_unique(ids, 0) == 0, "empty catalog is valid";
    // Empty catalog hash is SHA-256("") = e3b0c442…
    let h: i64 = __mind_alloc(32);
    canonical_catalog_hash(ids, 0, h);
    let rc: i64 = tt_check_hash(h, 3820012610, 2566659092, 2600203464, 2574235940, 665731556, 1687917388, 2761267483, 2018687061);
    assert rc == 0, "empty catalog hash is SHA-256 of the empty string";
    __mind_free(h);
    __mind_free(ids);
}

#[test]
fn test_top_k_unique_catalog_allows_single() {
    let ids: i64 = __mind_alloc(32);
    let sbuf: i64 = __mind_alloc(16);
    tt_mkid(ids, 0, sbuf, tt_str1(sbuf, 97));
    assert catalog_check_unique(ids, 1) == 0, "single-entry catalog is valid";
    __mind_free(ids);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_unique_catalog_allows_distinct_ids() {
    let ids: i64 = __mind_alloc(160);
    let sbuf: i64 = __mind_alloc(16);
    let mut i: i64 = 0;
    while i < 5 {
        tt_mkid(ids, i, sbuf, tt_str1(sbuf, 97 + i));
        i = i + 1;
    }
    assert catalog_check_unique(ids, 5) == 0, "all-distinct catalog is valid";
    __mind_free(ids);
    __mind_free(sbuf);
}

#[test]
fn test_top_k_unique_catalog_first_duplicate_reported() {
    // [x, y, x, z, y]: the (i, j < i) ascending scan hits (2, 0) first.
    let ids: i64 = __mind_alloc(160);
    let sbuf: i64 = __mind_alloc(16);
    tt_mkid(ids, 0, sbuf, tt_str1(sbuf, 120));
    tt_mkid(ids, 1, sbuf, tt_str1(sbuf, 121));
    tt_mkid(ids, 2, sbuf, tt_str1(sbuf, 120));
    tt_mkid(ids, 3, sbuf, tt_str1(sbuf, 122));
    tt_mkid(ids, 4, sbuf, tt_str1(sbuf, 121));
    let rc: i64 = catalog_check_unique(ids, 5);
    assert rc == 3, "first duplicate encountered is at index 2";
    assert tt_slot_is(ids, 2, sbuf, tt_str1(sbuf, 120)) == 1, "reported duplicate is x";
    __mind_free(ids);
    __mind_free(sbuf);
}

