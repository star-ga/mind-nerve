// tests/luts_smoke_test.mind — mindc 0.10.2 #[test] harness for the LUT
// smoke suite.
//
// tests/luts_smoke.mind is auto-generated by tools/gen_luts.py and exposes
// its checks as `pub fn smoke_*() -> i64` (0 = pass, failing input on
// mismatch) — a v0.4.4-era convention that 0.10.2's `mindc test` does not
// discover (it runs `#[test]` fns with `assert`s). This file provides the
// `#[test]` wrappers WITHOUT editing the generated fixture.
//
// `mindc test` evaluates each test file as a SELF-CONTAINED module (only
// bundled `std.*` imports are resolved for the interpreter), so the LUT
// sources and the smoke fixture must be textually merged with this file.
// tests/mindc_gate.sh performs that merge into a temp file and runs it —
// do not run `mindc test tests/luts_smoke_test.mind` standalone (the
// smoke_* callees live in the merged image, and a standalone run reports
// "running 0 tests" — the gate treats that as a HARD failure).
//
// Numeric contract: every smoke_* call below executes the pinned LUT
// tables (exp 4096-entry, tanh 4096-entry, sqrt/rsqrt 16384-entry,
// recip 512-entry Q32.32) and the exact lookup/Newton arithmetic through
// the mindc interpreter. A 1-ULP drift in any table value or lookup step
// fails the corresponding test. This is the executable bit-identity
// canary for the LUT family.

#[test]
fn test_smoke_recip_q32() {
    let rc: i64 = smoke_recip_q32();
    assert rc == 0, "smoke_recip_q32: LUT pair mismatch (return value = failing input)";
}

#[test]
fn test_smoke_exp_q16() {
    let rc: i64 = smoke_exp_q16();
    assert rc == 0, "smoke_exp_q16: LUT pair mismatch (return value = failing input)";
}

#[test]
fn test_smoke_tanh_q16() {
    let rc: i64 = smoke_tanh_q16();
    assert rc == 0, "smoke_tanh_q16: LUT pair mismatch (return value = failing input)";
}

#[test]
fn test_smoke_softmax_q16() {
    let rc: i64 = smoke_softmax_q16();
    assert rc == 0, "smoke_softmax_q16: pipeline mismatch (return value = failing stage)";
}

#[test]
fn test_smoke_sqrt_q16() {
    let rc: i64 = smoke_sqrt_q16();
    assert rc == 0, "smoke_sqrt_q16: LUT pair mismatch (return value = failing input)";
}
