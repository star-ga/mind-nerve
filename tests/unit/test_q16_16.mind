}

#[test]
fn test_q16_add_cancellation() {
    assert q16_add(THREE_Q16_16, NEG_THREE_Q16_16) == 0, "x + (-x) == 0";
}

#[test]
fn test_q16_add_determinism_oracle() {
    // Ported from the dormant PLACEHOLDER_HASH_ADD test (3.0 + -1.0 = 2.0).
    assert q16_add(THREE_Q16_16, NEG_ONE_Q16_16) == 131072, "3.0 + -1.0 == 2.0";
}

// ── Section 3: q16_dot — pinned-order dot product ───────────────────────────

#[test]
fn test_q16_dot_empty() {
    let a: i64 = __mind_alloc(8);
    assert q16_dot(a, a, 0) == 0, "dot of empty buffers is 0";
    __mind_free(a);
}

#[test]
fn test_q16_dot_length_one_positive() {
    let a: i64 = __mind_alloc(8);
    let b: i64 = __mind_alloc(8);
    tq_store(a, 0, THREE_Q16_16);
    tq_store(b, 0, HALF_Q16_16);
    assert q16_dot(a, b, 1) == q16_mul(THREE_Q16_16, HALF_Q16_16), "dot([x],[y]) == x*y";
    __mind_free(a);
    __mind_free(b);
}

#[test]
fn test_q16_dot_length_one_negative() {
    let a: i64 = __mind_alloc(8);
    let b: i64 = __mind_alloc(8);
    tq_store(a, 0, NEG_THREE_Q16_16);
    tq_store(b, 0, HALF_Q16_16);
    assert q16_dot(a, b, 1) == q16_mul(NEG_THREE_Q16_16, HALF_Q16_16), "dot([-x],[y]) == -x*y";
    __mind_free(a);
    __mind_free(b);
}

#[test]
fn test_q16_dot_length_one_zero() {
    let a: i64 = __mind_alloc(8);
    let b: i64 = __mind_alloc(8);
    tq_store(a, 0, 0);
    tq_store(b, 0, MAX_Q16_16);
    assert q16_dot(a, b, 1) == 0, "dot([0],[y]) == 0";
    __mind_free(a);
    __mind_free(b);
}

#[test]
fn test_q16_dot_length_one_both_one() {
    let a: i64 = __mind_alloc(8);
    let b: i64 = __mind_alloc(8);
    tq_store(a, 0, ONE_Q16_16);
    tq_store(b, 0, ONE_Q16_16);
    assert q16_dot(a, b, 1) == ONE_Q16_16, "dot([1.0],[1.0]) == 1.0";
    __mind_free(a);
    __mind_free(b);
}

#[test]
fn test_q16_dot_sequential_reduction_order() {
    // Saturation makes the reduction order observable: sequential
    // left-to-right saturates to MAX here; a tree-parallel reduction would
    // not. See the dormant file for the full construction proof.
    let half_max: i64 = MAX_Q16_16 / 2;   // 1073741823 (integer division)
    let a: i64 = __mind_alloc(24);
    let b: i64 = __mind_alloc(24);
    tq_store(a, 0, half_max);
    tq_store(a, 1, half_max);
    tq_store(a, 2, ONE_Q16_16);
    tq_store(b, 0, ONE_Q16_16);
    tq_store(b, 1, ONE_Q16_16);
    tq_store(b, 2, ONE_Q16_16);
    // Oracle: step = half_max; add(step, step) = 2147483646;
    // add(2147483646, ONE) saturates to MAX_Q16_16.
    assert q16_dot(a, b, 3) == MAX_Q16_16, "sequential reduction must saturate to MAX";
    __mind_free(a);
    __mind_free(b);
}

#[test]
fn test_q16_dot_determinism_oracle() {
    // Ported from the dormant PLACEHOLDER_HASH_DOT test; exact-value pin.
    // a = [1.0, 0.5, -1.0, 3.0], b = [0.5, 1.0, 3.0, -1.0]
    //   = 0.5 + 0.5 + -3.0 + -3.0 = -5.0 = -327680.
    let a: i64 = __mind_alloc(32);
    let b: i64 = __mind_alloc(32);
    tq_store(a, 0, ONE_Q16_16);
    tq_store(a, 1, HALF_Q16_16);
    tq_store(a, 2, NEG_ONE_Q16_16);
    tq_store(a, 3, THREE_Q16_16);
    tq_store(b, 0, HALF_Q16_16);
    tq_store(b, 1, ONE_Q16_16);
    tq_store(b, 2, THREE_Q16_16);
    tq_store(b, 3, NEG_ONE_Q16_16);
    assert q16_dot(a, b, 4) == 0 - 327680, "dot oracle == -5.0";
    __mind_free(a);
    __mind_free(b);
}

// ── Section 4: q16_softmax — pinned 5-stage pipeline over the pinned exp LUT
//
// All exact outputs below are oracle-computed: pinned exp table entries
// composed through the dormant 5-stage integer pipeline. Sum tolerance is
// the dormant ±1 ULP bound for N=3 (integer division truncates per
// element); the oracle confirms every N=3 case sums to 65535 = ONE - 1.
// ─────────────────────────────────────────────────────────────────────────────

#[test]
fn test_q16_softmax_sum_to_one_basic() {
    let h: i64 = exp_q16_init();
    let x: i64 = __mind_alloc(24);
    let y: i64 = __mind_alloc(24);
    tq_store(x, 0, ONE_Q16_16);
    tq_store(x, 1, HALF_Q16_16);
    tq_store(x, 2, THREE_Q16_16);
    q16_softmax(h, x, y, 3);
    // Oracle: [7285, 4418, 53832], sum 65535.
    assert tq_load(y, 0) == 7285, "softmax basic [0]";
    assert tq_load(y, 1) == 4418, "softmax basic [1]";
    assert tq_load(y, 2) == 53832, "softmax basic [2]";
    let s: i64 = q16_sum(y, 3);
    assert q16_abs(q16_sub(s, ONE_Q16_16)) <= ULP_Q16_16, "sum within 1 ULP of ONE";
    __mind_free(x);
    __mind_free(y);
    exp_q16_free(h);
}

#[test]
fn test_q16_softmax_sum_to_one_negative_inputs() {
    let h: i64 = exp_q16_init();
    let x: i64 = __mind_alloc(24);
    let y: i64 = __mind_alloc(24);
    tq_store(x, 0, NEG_THREE_Q16_16);
    tq_store(x, 1, NEG_ONE_Q16_16);
    tq_store(x, 2, NEG_ONE_Q16_16);
    q16_softmax(h, x, y, 3);
    // Oracle: [4153, 30691, 30691], sum 65535.
    assert tq_load(y, 0) == 4153, "softmax neg [0]";
    assert tq_load(y, 1) == 30691, "softmax neg [1]";
    assert tq_load(y, 2) == 30691, "softmax neg [2]";
    let s: i64 = q16_sum(y, 3);
    assert q16_abs(q16_sub(s, ONE_Q16_16)) <= ULP_Q16_16, "sum within 1 ULP of ONE";
    __mind_free(x);
    __mind_free(y);
    exp_q16_free(h);
}

#[test]
fn test_q16_softmax_permutation_non_equivariance() {
    // INTENTIONAL non-equivariance (dormant contract): pinned stage order
    // means softmax([a,b,c]) and softmax([c,b,a]) differ byte-level when
    // a != c. Oracle: fwd = [53832, 7285, 4418]; rev = [4418, 7285, 53832].
    let h: i64 = exp_q16_init();
    let xf: i64 = __mind_alloc(24);
    let xr: i64 = __mind_alloc(24);
    let yf: i64 = __mind_alloc(24);
    let yr: i64 = __mind_alloc(24);
    tq_store(xf, 0, THREE_Q16_16);
    tq_store(xf, 1, ONE_Q16_16);
    tq_store(xf, 2, HALF_Q16_16);
    tq_store(xr, 0, HALF_Q16_16);
    tq_store(xr, 1, ONE_Q16_16);
    tq_store(xr, 2, THREE_Q16_16);
    q16_softmax(h, xf, yf, 3);
    q16_softmax(h, xr, yr, 3);
    assert tq_load(yf, 0) == 53832, "fwd[0] oracle";
    assert tq_load(yr, 0) == 4418, "rev[0] oracle";
    assert tq_load(yf, 0) != tq_load(yr, 0), "permuted inputs must differ";
    __mind_free(xf);
    __mind_free(xr);
    __mind_free(yf);
    __mind_free(yr);
    exp_q16_free(h);
}

#[test]
fn test_q16_softmax_all_zeros_uniform() {
    // exp(0) = ONE for every element; div_sat(ONE, 3*ONE) = 21845 (trunc).
    let h: i64 = exp_q16_init();
    let x: i64 = __mind_alloc(24);
    let y: i64 = __mind_alloc(24);
    tq_store(x, 0, 0);
    tq_store(x, 1, 0);
    tq_store(x, 2, 0);
    q16_softmax(h, x, y, 3);
    assert tq_load(y, 0) == 21845, "uniform [0]";
    assert tq_load(y, 1) == 21845, "uniform [1]";
    assert tq_load(y, 2) == 21845, "uniform [2]";
    let s: i64 = q16_sum(y, 3);
    assert q16_abs(q16_sub(s, ONE_Q16_16)) <= ULP_Q16_16, "sum within 1 ULP of ONE";
    __mind_free(x);
    __mind_free(y);
    exp_q16_free(h);
}

