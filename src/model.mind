// Model: encoder + scoring head. No decoder. Ported to the mindc 0.10.2
// dialect 2026-08-12 (wave 4 of the pure-MIND migration; the dormant
// pre-port source is preserved at src/dormant/model.mind).
//
// Architectural decision (spec/architecture.md, unchanged): a decoder
// cross-attending to a fixed route table has identical expressive power to
// a single matmul between a pooled query vector and the route table, at a
// fraction of the FLOPs. The decoder is omitted; the scoring head is a
// mean-pool plus direct dot-product against the route embeddings.
//
// Encoder: 2 layers (ENCODER_LAYERS), sliding-window self-attention
// (window=256, stride=192), gated residual, no FFN sublayer.
//
// PORT NOTES (0.10.2 reality):
//   - Tensors are flat row-major i64-lane buffers (see
//     src/encoder_kernels.mind). batch == 1 in Phase 1 — the dormant batch
//     axis is dropped from the signatures rather than iterated trivially;
//     the Phase 2 batched surface can re-add it as an outer loop over the
//     same per-request entry points.
//   - The EncoderWeights struct becomes a WEIGHT TABLE: a 18-slot buffer
//     of i64 buffer handles, laid out as:
//       slot 0       token_embedding   [VOCAB_SIZE, H]
//       slots 1..7   layer 0: wq, wk, wv, wo [H, H] each;
//                    ln_gain, ln_bias, residual_gate [H] each
//       slots 8..14  layer 1, same order
//       slot 15      final_ln_gain     [H]
//       slot 16      final_ln_bias     [H]
//       slot 17      head_mask         [HEAD_MASK_BYTES bytes]
//     The loader (wave 4) builds this table; MODEL_WTAB_* slot constants
//     below are the single source of truth.
//   - `@[determinism]` / `@[reduction_order(Pinned)]` have no 0.10.2
//     equivalent; every reduction funnels through the pinned q16_16
//     primitives, and tests/unit/test_model.mind pins the compositions.
//   - HEAD_MASK_BYTES is re-exported here (the dormant `pub use`), so
//     callers size the mask field without reaching into encoder_kernels.

import src.lib;
import src.q16_16;
import src.encoder_kernels;

// Weight-table slot layout (single source of truth).
pub const MODEL_WTAB_SLOTS:       i64 = 18;
pub const MODEL_WTAB_EMBEDDING:   i64 = 0;
pub const MODEL_WTAB_L0_WQ:       i64 = 1;
pub const MODEL_WTAB_L0_WK:       i64 = 2;
pub const MODEL_WTAB_L0_WV:       i64 = 3;
pub const MODEL_WTAB_L0_WO:       i64 = 4;
pub const MODEL_WTAB_L0_LN_GAIN:  i64 = 5;
pub const MODEL_WTAB_L0_LN_BIAS:  i64 = 6;
pub const MODEL_WTAB_L0_GATE:     i64 = 7;
pub const MODEL_WTAB_L1_WQ:       i64 = 8;
pub const MODEL_WTAB_L1_WK:       i64 = 9;
pub const MODEL_WTAB_L1_WV:       i64 = 10;
pub const MODEL_WTAB_L1_WO:       i64 = 11;
pub const MODEL_WTAB_L1_LN_GAIN:  i64 = 12;
pub const MODEL_WTAB_L1_LN_BIAS:  i64 = 13;
pub const MODEL_WTAB_L1_GATE:     i64 = 14;
pub const MODEL_WTAB_FINAL_GAIN:  i64 = 15;
pub const MODEL_WTAB_FINAL_BIAS:  i64 = 16;
pub const MODEL_WTAB_HEAD_MASK:   i64 = 17;

// ─────────────────────────────────────────────────────────────────────────────
// encoder — 2-layer sliding-window encoder, pre-norm, gated residual, no
// FFN sublayer. token_ids at `ids_addr` (n i64 lanes); output is [n, H] at
// `out` (caller-allocated). exp_h / rsqrt_h are the pinned LUT handles.
// ─────────────────────────────────────────────────────────────────────────────

pub fn model_encoder(ids_addr: i64, n: i64, wtab: i64,
                     exp_h: i64, rsqrt_h: i64, out: i64) -> i64 {
    let h: i64 = ENCODER_HIDDEN;

    // Token embedding lookup (OOV clamps to row 0 — see encoder_kernels).
    let x: i64 = __mind_alloc(n * h * 8);
    token_embedding_lookup(ids_addr, n, __mind_load_i64(wtab + MODEL_WTAB_EMBEDDING * 8), x);

    // RFC-003 stride selection. With STRIDE_FP_ENABLED = 0 the fingerprint
    // is never computed and stride = ATTN_WINDOW_STRIDE (byte-identical to
    // the pre-RFC-003 path).
    let mut stride: i64 = ATTN_WINDOW_STRIDE;
    if STRIDE_FP_ENABLED == 1 {
        stride = select_stride(compute_stride_fingerprint(x, n));
    }

    let ln: i64 = __mind_alloc(n * h * 8);
    let attn: i64 = __mind_alloc(n * h * 8);
    let x2: i64 = __mind_alloc(n * h * 8);

    let mut layer_i: i64 = 0;
    while layer_i < ENCODER_LAYERS {
        let base: i64 = 1 + layer_i * 7;
        let xcur: i64 = if layer_i == 0 { x } else { x2 };

        // Pre-norm + affine, then sliding-window attention, then gated
        // residual: x = x + sigmoid(gate) * attn.
        prenorm_seq(xcur, __mind_load_i64(wtab + (base + 4) * 8),
                    __mind_load_i64(wtab + (base + 5) * 8), ln, n, rsqrt_h);
        sliding_window_attention(ln, __mind_load_i64(wtab + base * 8),
                                 __mind_load_i64(wtab + (base + 1) * 8),
                                 __mind_load_i64(wtab + (base + 2) * 8),
                                 __mind_load_i64(wtab + (base + 3) * 8),
                                 stride, __mind_load_i64(wtab + MODEL_WTAB_HEAD_MASK * 8),
                                 layer_i, attn, n, exp_h);
        gated_residual(xcur, attn, __mind_load_i64(wtab + (base + 6) * 8), x2, n, exp_h);
        layer_i = layer_i + 1;
    }

    // Final layer-norm + affine before the scoring head.
    prenorm_seq(x2, __mind_load_i64(wtab + MODEL_WTAB_FINAL_GAIN * 8),
                __mind_load_i64(wtab + MODEL_WTAB_FINAL_BIAS * 8), out, n, rsqrt_h);

    __mind_free(x2);
    __mind_free(attn);
    __mind_free(ln);
    __mind_free(x);
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// mean-pool over the sequence axis (pinned reduction order; see
// encoder_kernels.mean_pool_seq_kernel for the dispatch contract).
// ─────────────────────────────────────────────────────────────────────────────

pub fn model_mean_pool(enc_out: i64, n: i64, exp_h: i64, out: i64) -> i64 {
    return mean_pool_seq_kernel(enc_out, out, n, exp_h);
}

// ─────────────────────────────────────────────────────────────────────────────
// RFC-010 — L2-normalize the pooled query for the cosine-similarity scoring
// head: sq_norm = q16_dot_pinned(row, row); guarded = sq_norm + 1 ULP;
// inv_norm = q16_rsqrt(guarded); out[d] = q16_mul(row[d], inv_norm).
// The zero-vector guard keeps the function total (multiplying the zero row
// still yields zero).
// ─────────────────────────────────────────────────────────────────────────────

pub fn model_l2_normalize_pooled(pooled: i64, rsqrt_h: i64, out: i64) -> i64 {
    let sq_norm: i64 = q16_dot_pinned(pooled, pooled, ENCODER_HIDDEN);
    let guarded: i64 = q16_add(sq_norm, Q16_LAYERNORM_EPSILON);
    let inv_norm: i64 = q16_rsqrt(rsqrt_h, guarded);
    let mut d: i64 = 0;
    while d < ENCODER_HIDDEN {
        __mind_store_i64(out + d * 8,
                         q16_mul(__mind_load_i64(pooled + d * 8), inv_norm));
        d = d + 1;
    }
    0
}

// ─────────────────────────────────────────────────────────────────────────────
// Scoring head: out[r] = <pooled_query, route_embeddings[r]> via
// q16_dot_pinned over the hidden axis. routes is [nr, H] row-major; out is
// nr i64 lanes. Adding routes is appending rows — the encoder does not
// retrain.
// ─────────────────────────────────────────────────────────────────────────────

pub fn model_score_against_routes(pooled: i64, routes: i64, nr: i64, out: i64) -> i64 {
    let mut r: i64 = 0;
    while r < nr {
        __mind_store_i64(out + r * 8,
                         q16_dot_pinned(pooled, routes + r * ENCODER_HIDDEN * 8, ENCODER_HIDDEN));
        r = r + 1;
    }
    0
}

// RFC-008 — Matryoshka coarse pass: contract only the first min(dim_cap,
// ROUTE_EMBEDDING_DIM) dimensions. dim_cap >= ROUTE_EMBEDDING_DIM
// degenerates to the full-rank dot (byte-identical to
// model_score_against_routes).
pub fn model_score_against_routes_prefix(pooled: i64, routes: i64, nr: i64,
                                         dim_cap: i64, out: i64) -> i64 {
    let mut cap: i64 = dim_cap;
    if cap > ROUTE_EMBEDDING_DIM { cap = ROUTE_EMBEDDING_DIM; }
    if cap < 0 { cap = 0; }
    let mut r: i64 = 0;
    while r < nr {
        __mind_store_i64(out + r * 8,
                         q16_dot_pinned(pooled, routes + r * ENCODER_HIDDEN * 8, cap));
        r = r + 1;
    }
    0
}

// RFC-008 — Matryoshka fine pass over a shortlist mask (n bytes at
// `mask`, 1 = rescore). Masked-out positions get `fill_value` (callers
// pass MIN_Q16_16 so unselected routes can never beat a shortlisted one
// downstream). r >= mask_len is treated as not-selected (defensive guard;
// well-formed callers pass mask_len == nr).
pub fn model_score_against_routes_masked(pooled: i64, routes: i64, nr: i64,
                                         mask: i64, mask_len: i64,
                                         fill_value: i64, out: i64) -> i64 {
    let mut r: i64 = 0;
    while r < nr {
        let mut selected: i64 = 0;
        if r < mask_len {
            if __mind_load_i8(mask + r) == 1 { selected = 1; }
        }
        if selected == 1 {
            __mind_store_i64(out + r * 8,
                             q16_dot_pinned(pooled, routes + r * ENCODER_HIDDEN * 8, ENCODER_HIDDEN));
        } else {
            __mind_store_i64(out + r * 8, fill_value);
        }
        r = r + 1;
    }
    0
}
